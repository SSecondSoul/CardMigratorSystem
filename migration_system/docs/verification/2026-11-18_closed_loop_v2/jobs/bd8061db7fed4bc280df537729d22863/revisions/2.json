{
  "code": "<template><section class=\"capacity-planning-board\"><header><div><p class=\"muted\">{{saved ? '\u89c4\u5212\u5df2\u4fdd\u5b58' : '\u6709\u672a\u4fdd\u5b58\u53d8\u66f4'}}</p><h2>{{boardTitle}}</h2></div><div class=\"actions\"><select on-change=\"updateCycle\" value=\"{{cycle}}\"><option s-for=\"item in cycles trackby item\" value=\"{{item}}\">{{item}}</option></select><button class=\"primary\" on-click=\"save\">\u4fdd\u5b58</button></div></header><div class=\"capacity-summary\"><span>\u603b\u5de5\u4f5c\u91cf {{totalPoints}} \u70b9</span><select on-change=\"updateSkill\" value=\"{{skillFilter}}\"><option value=\"all\">\u5168\u90e8\u6280\u80fd</option><option value=\"\u524d\u7aef\">\u524d\u7aef</option><option value=\"\u540e\u7aef\">\u540e\u7aef</option><option value=\"\u6d4b\u8bd5\">\u6d4b\u8bd5</option></select></div><div class=\"planning-layout\"><aside><h3>\u5f85\u5206\u914d {{unassigned.length}}</h3><button s-for=\"item in unassigned trackby item.id\" class=\"{{isSelected(item.id) ? 'selected' : ''}}\" on-click=\"selectWork(item.id)\"><strong>{{item.title}}</strong><small>{{item.points}} \u70b9</small></button><p class=\"empty\" s-if=\"!unassigned.length\">\u5168\u90e8\u5df2\u5206\u914d</p><section s-if=\"selectedWork\"><h3>\u5f53\u524d\u5de5\u4f5c\u9879</h3><p>{{selectedWork.title}}</p><strong>{{selectedWork.points}} \u70b9</strong></section></aside><main><article s-for=\"lane in lanes trackby lane.member.id\" class=\"{{'member-lane ' + laneClass(lane)}}\"><header><div><strong>{{lane.member.name}}</strong><small>{{joinValues(lane.member.skills, ' / ')}}</small></div><div><button on-click=\"changeCapacity(lane.member.id, -1)\">\u2212</button><span>{{lane.load}}/{{lane.member.capacity}}</span><button on-click=\"changeCapacity(lane.member.id, 1)\">\uff0b</button><button on-click=\"assign(lane.member.id)\" disabled=\"{{selectedWorkId === null}}\">\u5206\u914d\u5230\u6b64</button></div></header><div class=\"capacity-bar\"><span style=\"{{lane.bar}}\"></span></div><div class=\"lane-items\"><button s-for=\"item in lane.items trackby item.id\" class=\"{{isSelected(item.id) ? 'selected' : ''}}\" on-click=\"selectWork(item.id)\">{{item.title}} \u00b7 {{item.points}}</button></div></article></main></div><footer><span s-for=\"entry in changeLog trackby entry.id\">{{entry.message}}</span></footer></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"CapacityPlanningBoard\",dataTypes:{boardTitle:DataTypes.string,cycles:DataTypes.array,initialMembers:DataTypes.array,initialWork:DataTypes.array},initData(){return {boardTitle:\"\u8fed\u4ee3\u5bb9\u91cf\u89c4\u5212\",cycles:[\"Sprint 21\",\"Sprint 22\"],initialMembers:[{\"id\":1,\"name\":\"\u6797\u6653\",\"capacity\":8,\"skills\":[\"\u524d\u7aef\"]},{\"id\":2,\"name\":\"\u5468\u5b81\",\"capacity\":10,\"skills\":[\"\u540e\u7aef\"]},{\"id\":3,\"name\":\"\u9648\u96e8\",\"capacity\":6,\"skills\":[\"\u6d4b\u8bd5\"]}],initialWork:[{\"id\":1,\"title\":\"\u767b\u5f55\u9875\u6539\u9020\",\"points\":5,\"assigneeId\":1,\"cycle\":\"Sprint 21\"},{\"id\":2,\"title\":\"\u63a5\u53e3\u7f13\u5b58\",\"points\":8,\"assigneeId\":null,\"cycle\":\"Sprint 21\"},{\"id\":3,\"title\":\"\u56de\u5f52\u6d4b\u8bd5\",\"points\":3,\"assigneeId\":3,\"cycle\":\"Sprint 21\"},{\"id\":4,\"title\":\"\u57cb\u70b9\u65b9\u6848\",\"points\":5,\"assigneeId\":null,\"cycle\":\"Sprint 22\"}],members:[],workItems:[],cycle:\"Sprint 21\",selectedWorkId:null,skillFilter:\"all\",saved:true,changeLog:[]}},inited(){this.data.set(\"members\",this.data.get(\"initialMembers\").map(item=>Object.assign({},item,{skills:item.skills.slice()})));this.data.set(\"workItems\",this.data.get(\"initialWork\").map(item=>Object.assign({},item)));this.data.set(\"cycle\",this.data.get(\"cycles\")[0]||\"\");},setValue(key,value){this.data.set(key,value);},emitEvent(name,payload){this.fire(name,payload);},updateCycle(event){this.data.set(\"cycle\",event.target.value);this.data.set(\"selectedWorkId\",null);},updateSkill(event){this.data.set(\"skillFilter\",event.target.value);},selectWork(id){this.data.set(\"selectedWorkId\",id);},assign(memberId){const id=this.data.get(\"selectedWorkId\");if(id===null)return;this.data.set(\"workItems\",this.data.get(\"workItems\").map(item=>item.id===id?Object.assign({},item,{assigneeId:memberId}):item));this.data.set(\"saved\",false);this.log(\"\u5df2\u5206\u914d\u5de5\u4f5c\u9879\");this.emitEvent(\"assignment\",{workId:id,memberId});},unassign(id){this.data.set(\"workItems\",this.data.get(\"workItems\").map(item=>item.id===id?Object.assign({},item,{assigneeId:null}):item));this.data.set(\"saved\",false);this.log(\"\u5de5\u4f5c\u9879\u9000\u56de\u5f85\u5206\u914d\u6c60\");},changeCapacity(memberId,delta){this.data.set(\"members\",this.data.get(\"members\").map(member=>member.id===memberId?Object.assign({},member,{capacity:Math.max(1,member.capacity+delta)}):member));this.data.set(\"saved\",false);this.emitEvent(\"capacity\",{memberId,delta});},save(){this.data.set(\"saved\",true);this.log(\"\u89c4\u5212\u5df2\u4fdd\u5b58\");this.emitEvent(\"save\",{members:this.data.get(\"members\"),workItems:this.data.get(\"workItems\")});},log(message){this.data.set(\"changeLog\",[{\"id\":Date.now(),\"message\":message}].concat(this.data.get(\"changeLog\")).slice(0,4));},laneClass(lane){return lane.percent>100?\"overloaded\":lane.percent>80?\"near-limit\":\"\";},isSelected(id){return this.data.get(\"selectedWorkId\")===id;},joinValues(values,separator){return values.join(separator);}});</script><style>\n.capacity-planning-board { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.capacity-planning-board * { box-sizing: border-box; }\n.capacity-planning-board h2, .capacity-planning-board h3, .capacity-planning-board p { margin-top: 0; }\n.capacity-planning-board h2 { margin-bottom: 14px; font-size: 21px; }\n.capacity-planning-board button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.capacity-planning-board button.primary { border-color: #047857; background: #047857; color: #fff; }\n.capacity-planning-board button:disabled { opacity: .45; cursor: not-allowed; }\n.capacity-planning-board input, .capacity-planning-board select, .capacity-planning-board textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.capacity-planning-board .toolbar, .capacity-planning-board .summary, .capacity-planning-board .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.capacity-planning-board .muted { color: #71808e; font-size: 12px; }\n.capacity-planning-board .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\nheader,.capacity-summary{display:flex;justify-content:space-between}.capacity-summary{padding:10px;background:#ecfdf5}.planning-layout{display:grid;grid-template-columns:175px 1fr;gap:14px;margin-top:12px}.planning-layout>aside{padding:10px;background:#f6f8f8}.planning-layout>aside>button{display:block;width:100%;margin:6px 0}.planning-layout button.selected{background:#d1fae5}.member-lane{margin-bottom:10px;padding:12px;border:1px solid #dce3df}.member-lane.near-limit{border-color:#d97706}.member-lane.overloaded{border-color:#dc2626;background:#fef2f2}.capacity-bar{height:6px;margin:8px 0;background:#e5e7eb}.capacity-bar span{display:block;height:100%;background:#047857}.lane-items{display:flex;gap:7px;flex-wrap:wrap}.lane-items i{margin-left:6px;color:#b91c1c}footer{display:flex;gap:8px;font-size:11px}\n</style>",
