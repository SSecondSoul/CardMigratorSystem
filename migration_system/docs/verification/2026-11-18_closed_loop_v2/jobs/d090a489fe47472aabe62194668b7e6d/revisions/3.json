{
  "code": "<template><section class=\"dependency-release-planner\"><header><div><small>{{environment}} \u00b7 {{releaseStatus}}</small><h2>{{releaseName}}</h2></div><select on-change=\"setEnvironment\" value=\"{{environment}}\"><option s-for=\"env in environments trackby env\" value=\"{{env}}\">{{env}}</option></select></header><div class=\"release-layout\"><aside><h3>\u672a\u7f16\u6392\u670d\u52a1</h3><button s-for=\"service in unplanned trackby service.id\" class=\"{{selectedServiceId === service.id ? 'selected' : ''}}\" on-click=\"chooseService(service.id)\"><strong>{{service.id}}</strong><span>{{service.version}} \u00b7 {{service.health}}</span></button><h3>\u4f9d\u8d56\u8fb9</h3><p s-for=\"edge in dependencies trackby edge.from + edge.to\">{{edge.from}} \u2192 {{edge.to}}</p></aside><main><section class=\"wave\" s-for=\"wave, index in waves trackby index\"><header><h3>\u6ce2\u6b21 {{index + 1}}</h3><button on-click=\"assignWave(index)\" disabled=\"{{!selectedServiceId}}\">\u653e\u5165\u6b64\u6ce2\u6b21</button></header><article s-for=\"id in wave trackby id\"><strong>{{serviceLabel(id)}}</strong><button on-click=\"removeFromWave(id)\">\u79fb\u51fa</button></article></section></main><aside class=\"gate\"><h3>\u53d1\u5e03\u95e8\u7981</h3><p class=\"{{unplanned.length ? 'bad' : 'good'}}\">\u672a\u7f16\u6392 {{unplanned.length}}</p><p class=\"{{dependencyViolations.length ? 'bad' : 'good'}}\">\u4f9d\u8d56\u51b2\u7a81 {{dependencyViolations.length}}</p><p>\u5ba1\u6279 {{approvals.length}}/{{requiredApprovals}}</p><button on-click=\"approve('\u6280\u672f\u8d1f\u8d23\u4eba')\">\u6280\u672f\u5ba1\u6279</button><button on-click=\"approve('\u8fd0\u7ef4\u8d1f\u8d23\u4eba')\">\u8fd0\u7ef4\u5ba1\u6279</button><button class=\"primary\" on-click=\"release\" disabled=\"{{!canRelease}}\">\u6267\u884c\u53d1\u5e03</button><button on-click=\"rollback\" disabled=\"{{releaseStatus !== 'released'}}\">\u56de\u6eda</button></aside></div></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: \"DependencyReleasePlanner\",dataTypes: {releaseName: DataTypes.string,initialServices: DataTypes.array,dependencies: DataTypes.array,environments: DataTypes.array,requiredApprovals: DataTypes.number},initData() {return {releaseName: \"\u79cb\u5b63\u5e73\u53f0\u53d1\u5e03\",initialServices: [{\"id\": \"web\",\"version\": \"2.4.0\"},{\"id\": \"api\",\"version\": \"3.1.0\"},{\"id\": \"billing\",\"version\": \"1.8.2\"},{\"id\": \"notify\",\"version\": \"1.3.5\"}],dependencies: [{\"from\": \"web\",\"to\": \"api\"},{\"from\": \"api\",\"to\": \"billing\"},{\"from\": \"api\",\"to\": \"notify\"}],environments: [\"\u6d4b\u8bd5\", \"\u9884\u53d1\", \"\u751f\u4ea7\"],requiredApprovals: 2,services: [],waves: [[],[],[]],selectedServiceId: null,environment: \"\u6d4b\u8bd5\",approvals: [],releaseStatus: \"planning\",history: []}},inited() {this.data.set(\"services\", this.data.get(\"initialServices\").map(item => Object.assign({}, item, {health: \"ready\"})));},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},chooseService(id) {this.data.set(\"selectedServiceId\", id);},assignWave(index) {if (!this.data.get(\"selectedServiceId\")) return;const id = this.data.get(\"selectedServiceId\");this.data.set(\"waves\", this.data.get(\"waves\").map((wave, waveIndex) => waveIndex === index ? wave.filter(item => item !== id).concat(id) : wave.filter(item => item !== id)));this.data.set(\"selectedServiceId\", null);this.data.set(\"approvals\", []);this.emitEvent(\"plan\", this.data.get(\"waves\"));},removeFromWave(id) {this.data.set(\"waves\", this.data.get(\"waves\").map(wave => wave.filter(item => item !== id)));this.data.set(\"approvals\", []);},approve(role) {if (this.data.get(\"approvals\").indexOf(role) >= 0) return;this.data.set(\"approvals\", this.data.get(\"approvals\").concat(role));this.emitEvent(\"approve\", this.data.get(\"approvals\"));},setEnvironment(event) {this.data.set(\"environment\", event.target.value);this.data.set(\"approvals\", []);},release() {if (!this.data.get(\"canRelease\")) return;this.data.set(\"history\", [{\"id\": Date.now(),\"environment\": this.data.get(\"environment\"),\"waves\": this.data.get(\"waves\").map(wave => wave.slice())}].concat(this.data.get(\"history\")));this.data.set(\"releaseStatus\", \"released\");this.emitEvent(\"release\", this.data.get(\"history\")[0]);},rollback() {if (!this.data.get(\"history\").length) return;this.data.set(\"releaseStatus\", \"rolled-back\");this.emitEvent(\"rollback\", this.data.get(\"history\")[0]);},serviceLabel(id) {const service = this.data.get(\"services\").find(item => item.id === id);return service ? service.id + \"@\" + service.version : id;},computed: {plannedIds() {return this.data.get(\"waves\").reduce((out, wave) => out.concat(wave), []);},unplanned() {return this.data.get(\"services\").filter(service => this.data.get(\"plannedIds\").indexOf(service.id) < 0);},dependencyViolations() {const position = {};this.data.get(\"waves\").forEach((wave, index) => wave.forEach(id => {position[id] = index;}));return this.data.get(\"dependencies\").filter(edge => position[edge.from] !== undefined && (position[edge.to] === undefined || position[edge.to] > position[edge.from]));},canRelease() {return this.data.get(\"unplanned\").length === 0 && this.data.get(\"dependencyViolations\").length === 0 && this.data.get(\"approvals\").length >= this.data.get(\"requiredApprovals\") && this.data.get(\"releaseStatus\") !== \"released\";}}});</script><style>.dependency-release-planner{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.dependency-release-planner *{box-sizing:border-box}.dependency-release-planner h2,.dependency-release-planner h3,.dependency-release-planner p{margin-top:0}.dependency-release-planner button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.dependency-release-planner button.primary{border-color:#4f46e5;background:#4f46e5;color:#fff}.dependency-release-planner button:disabled{opacity:.45;cursor:not-allowed}.dependency-release-planner input,.dependency-release-planner select,.dependency-release-planner textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.dependency-release-planner .muted{color:#71808e;font-size:12px}.dependency-release-planner .toolbar,.dependency-release-planner .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.release-layout{display:grid;grid-template-columns:180px 1fr 190px;gap:12px}.release-layout>aside{padding:10px;background:#f8fafc}.release-layout>aside>button{display:grid;width:100%;margin:6px 0;text-align:left}.release-layout>aside>button.selected{background:#e0e7ff}.release-layout main{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.wave{min-height:260px;padding:9px;border:1px dashed #818cf8}.wave header{display:block}.wave article{display:flex;justify-content:space-between;padding:8px;margin-top:7px;background:#eef2ff}.gate button{width:100%;margin:4px 0}.good{color:#15803d}.bad{color:#b91c1c}</style>",
