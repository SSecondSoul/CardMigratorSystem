9ab105ed_6($event, lane)" disabled="{{ selectedWorkId === null }}">分配到此</button></div></header><div class="capacity-bar"><span style="{{ lane.bar | __businessStyle }}"></span></div><div class="lane-items"><button class="{{ __businessEvent_d1ea9ab105ed_expression_3(0, lane, item) | __businessClass }}" on-click="__businessEvent_d1ea9ab105ed_7($event, lane, item)" s-for="item in lane.items trackBy item.id">{{ item.title | __businessDisplay }} · {{ item.points | __businessDisplay }}<i on-click="__businessEvent_d1ea9ab105ed_8($event, lane, item)">×</i></button></div></article></main></div><footer><span s-for="entry in changeLog trackBy entry.id">{{ entry.message | __businessDisplay }}</span></footer></section></template>

