{
  "code": "<template><section class=\"habit-week-tracker\"><header><h2>\u672c\u5468\u4e60\u60ef</h2><button on-click=\"resetWeek\">\u91cd\u7f6e</button></header><div class=\"week-head\"><span></span><b s-for=\"day in dayLabels trackby day\">{{day}}</b><span>\u5b8c\u6210</span></div><div s-for=\"habit in habits trackby habit.id\" class=\"{{'habit-row ' + (habit.id === selectedHabit ? 'active' : '')}}\" on-click=\"selectHabit(habit.id)\"><strong>{{habit.name}}</strong><button s-for=\"day, index in dayLabels trackby day\" class=\"{{isDone(habit.id, index, records) ? 'done' : ''}}\" on-click=\"toggle(habit.id, index)\">\u2713</button><span>{{rowCount(habit.id, records)}}/{{habit.goal}}</span></div><div class=\"progress\"><span style=\"{{barStyle}}\"></span></div><p>\u603b\u5b8c\u6210\u7387 {{percent}}%</p></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"HabitWeekTracker\",dataTypes:{habits:DataTypes.array,dayLabels:DataTypes.array},initData(){return {\nhabits: [{\n  \"id\": \"read\",\n  \"name\": \"\u9605\u8bfb\",\n  \"goal\": 5\n}, {\n  \"id\": \"walk\",\n  \"name\": \"\u6b65\u884c\",\n  \"goal\": 7\n}, {\n  \"id\": \"sleep\",\n  \"name\": \"\u65e9\u7761\",\n  \"goal\": 4\n}],\ndayLabels: [\"\u4e00\", \"\u4e8c\", \"\u4e09\", \"\u56db\", \"\u4e94\", \"\u516d\", \"\u65e5\"],\nrecords:{},selectedHabit:\"read\"}},inited(){const records={};this.data.get(\"habits\").forEach(habit=>records[habit.id]=[false,false,false,false,false,false,false]);this.data.set(\"records\",records);this.data.set(\"selectedHabit\",this.data.get(\"habits\")[0]?this.data.get(\"habits\")[0].id:\"\")},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},toggle(habitId,index){const records=Object.assign({},this.data.get(\"records\"));const row=records[habitId].slice();row[index]=!row[index];records[habitId]=row;this.data.set(\"records\",records);this.emitEvent(\"change\",records)},selectHabit(id){this.data.set(\"selectedHabit\",id)},resetWeek(){const records={};this.data.get(\"habits\").forEach(habit=>records[habit.id]=this.data.get(\"dayLabels\").map(()=>false));this.data.set(\"records\",records)},isDone(habitId,index,records){return !!(records[habitId]&&records[habitId][index])},rowCount(habitId,records){return records[habitId]?records[habitId].filter(Boolean).length:0},computed:{totalDone(){const records=this.data.get(\"records\");return Object.keys(records).reduce((sum,key)=>sum+records[key].filter(Boolean).length,0)},percent(){const total=this.data.get(\"habits\").length*this.data.get(\"dayLabels\").length||1;return Math.round(this.data.get(\"totalDone\")/total*100)},barStyle(){return \"width:\"+this.data.get(\"percent\")+\"%\"}}});</script><style>\n.habit-week-tracker{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}\n.habit-week-tracker *{box-sizing:border-box}\n.habit-week-tracker h2,.habit-week-tracker h3,.habit-week-tracker p{margin-top:0}\n.habit-week-tracker button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}\n.habit-week-tracker button.primary{border-color:#16a34a;background:#16a34a;color:#fff}\n.habit-week-tracker button:disabled{opacity:.45;cursor:not-allowed}\n.habit-week-tracker input,.habit-week-tracker select,.habit-week-tracker textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}\n.habit-week-tracker .muted{color:#71808e;font-size:12px}\n.habit-week-tracker .toolbar,.habit-week-tracker .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}\nheader{display:flex;justify-content:space-between}.week-head,.habit-row{display:grid;grid-template-columns:90px repeat(7,1fr) 55px;gap:5px;align-items:center}.week-head{text-align:center}.habit-row{padding:7px;border-left:3px solid transparent}.habit-row.active{border-color:#16a34a;background:#f0fdf4}.habit-row button.done{background:#16a34a;color:#fff}.progress{height:7px;background:#e5e7eb}.progress span{display:block;height:100%;background:#16a34a}\n</style>",
