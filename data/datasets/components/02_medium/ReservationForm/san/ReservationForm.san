<template>
  <form class="reservation-form" on-submit="submit">
    <header>
      <div>
        <span class="eyebrow">预约申请</span>
        <h2>{{ title }}</h2>
      </div>
      <span class="guest-summary">{{ guestLabel }}</span>
    </header>
    <div class="form-grid">
      <label>联系人<input value="{{ form.contact }}" on-input="updateContact" /></label>
      <label>地点
        <select value="{{ form.location }}" on-change="updateLocation">
          <option s-for="location in locations" value="{{ location }}">{{ location }}</option>
        </select>
      </label>
      <label>日期<input type="date" value="{{ form.date }}" on-input="updateDate" /></label>
      <label>人数<input type="number" min="1" max="12" value="{{ form.guests }}" on-input="updateGuests" /></label>
    </div>
    <p s-if="error" class="form-error">{{ error }}</p>
    <p s-if="confirmation" class="form-success">{{ confirmation }}</p>
    <footer>
      <button type="button" class="secondary" on-click="reset">重置</button>
      <button type="submit">提交预约</button>
    </footer>
  </form>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'ReservationForm',
  dataTypes: {
    title: DataTypes.string,
    locations: DataTypes.array,
    initialDate: DataTypes.string,
    initialGuests: DataTypes.number
  },
  initData() {
    return {
      title: '会议室预约',
      locations: ['东区 201', '西区 305', '共享空间'],
      initialDate: '2026-09-08',
      initialGuests: 2,
      form: { contact: '', location: '东区 201', date: '2026-09-08', guests: 2 },
      error: '',
      confirmation: ''
    };
  },
  inited() {
    this.data.set('form', {
      contact: '',
      location: this.data.get('locations')[0],
      date: this.data.get('initialDate'),
      guests: this.data.get('initialGuests')
    });
  },
  computed: {
    guestLabel() {
      const form = this.data.get('form');
      return `${form.guests} 人 · ${form.location}`;
    }
  },
  updateContact(event) { this.data.set('form.contact', event.target.value); },
  updateLocation(event) { this.data.set('form.location', event.target.value); },
  updateDate(event) { this.data.set('form.date', event.target.value); },
  updateGuests(event) { this.data.set('form.guests', Number(event.target.value)); },
  validate() {
    const form = this.data.get('form');
    if (!form.contact.trim()) return '请填写联系人';
    if (!form.date) return '请选择日期';
    if (form.guests < 1) return '预约人数至少为 1';
    return '';
  },
  submit(event) {
    event.preventDefault();
    const error = this.validate();
    this.data.set('error', error);
    if (error) return;
    const form = this.data.get('form');
    this.data.set('confirmation', `已为 ${form.contact} 提交预约`);
    this.fire('submit', Object.assign({}, form));
  },
  reset() {
    this.data.set('form', {
      contact: '',
      location: this.data.get('locations')[0],
      date: this.data.get('initialDate'),
      guests: this.data.get('initialGuests')
    });
    this.data.set('error', '');
    this.data.set('confirmation', '');
    this.fire('reset');
  }
});
</script>

<style>
.reservation-form { width: 520px; padding: 22px; border: 1px solid #cbd5e1; border-radius: 7px; background: #f8fafc; color: #172026; font-family: Arial, sans-serif; }
.reservation-form header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
.reservation-form h2 { margin: 3px 0 0; font-size: 21px; }
.eyebrow { color: #64748b; font-size: 12px; }
.guest-summary { padding: 6px 9px; background: #e0f2fe; color: #075985; font-size: 12px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.form-grid label { display: grid; gap: 6px; color: #475569; font-size: 13px; }
.form-grid input, .form-grid select { padding: 9px; border: 1px solid #94a3b8; border-radius: 4px; background: #ffffff; }
.form-error { color: #b91c1c; }
.form-success { color: #166534; }
.reservation-form footer { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
.reservation-form button { padding: 9px 14px; border: 1px solid #075985; border-radius: 4px; background: #075985; color: #ffffff; cursor: pointer; }
.reservation-form button.secondary { background: #ffffff; color: #334155; border-color: #94a3b8; }
</style>
