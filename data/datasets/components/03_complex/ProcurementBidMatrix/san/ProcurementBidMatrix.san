<template>
  <section class="procurement-bid-matrix"><header><div><small>权重合计 {{ weightTotal }}% · {{ reviewer }}</small><h2>{{ projectName }}</h2></div><div><select value="{{ reviewer }}" on-change="setReviewer"><option s-for="person in reviewers trackby person" value="{{ person }}">{{ person }}</option></select><button on-click="toggleLock">{{ isLocked ? '解锁本评委' : '锁定本评委' }}</button></div></header><div class="matrix-wrap"><table><thead><tr><th>供应商</th><th>报价/万元</th><th s-for="criterion in criteria trackby criterion.id"><span>{{ criterion.name }}</span><input type="number" value="{{ weights[criterion.id] }}" on-input="updateWeight(criterion.id, $event)" disabled="{{ isLocked }}"></th><th>总分</th><th>排名</th></tr></thead><tbody><tr s-for="supplier in suppliers trackby supplier.id" class="{{ selectedSupplierId === supplier.id ? 'selected' : '' }}"><th>{{ supplier.name }}</th><td>{{ supplier.price }}</td><td s-for="criterion in criteria trackby criterion.id"><input type="number" value="{{ scores[supplier.id][criterion.id] }}" on-input="updateScore(supplier.id, criterion.id, $event)" disabled="{{ isLocked }}"></td><td><strong>{{ supplierTotal(supplier.id) }}</strong></td><td>#{{ rankOf(supplier.id) }}</td></tr></tbody></table></div><div class="ranking"><article s-for="supplier, index in rankings trackby supplier.id" class="{{ awardedSupplierId === supplier.id ? 'winner' : '' }}"><b>#{{ index + 1 }}</b><strong>{{ supplier.name }}</strong><span>{{ supplier.total }} 分</span><textarea value="{{ comments[supplier.id] || '' }}" on-input="updateComment(supplier.id, $event)" placeholder="评审意见"></textarea><button on-click="award(supplier.id)" disabled="{{ !canAward(supplier) }}">选定供应商</button></article></div><footer s-if="winner">已选定：{{ winner.name }}，综合得分 {{ winner.total }}</footer></section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'ProcurementBidMatrix',
  dataTypes: {
    projectName: DataTypes.string,
    suppliers: DataTypes.array,
    criteria: DataTypes.array,
    reviewers: DataTypes.array,
    passingScore: DataTypes.number
  },
  initData() {
    return {
      projectName: "园区安防采购评审",
      suppliers: [
        {
          "id": "S1",
          "name": "远见科技",
          "price": 86
        },
        {
          "id": "S2",
          "name": "安域系统",
          "price": 92
        },
        {
          "id": "S3",
          "name": "云盾智能",
          "price": 79
        }
      ],
      criteria: [
        {
          "id": "tech",
          "name": "技术",
          "weight": 40
        },
        {
          "id": "service",
          "name": "服务",
          "weight": 25
        },
        {
          "id": "delivery",
          "name": "交付",
          "weight": 15
        },
        {
          "id": "price",
          "name": "价格",
          "weight": 20
        }
      ],
      reviewers: [
        "评委甲",
        "评委乙",
        "评委丙"
      ],
      passingScore: 70,
      weights: {},
      scores: {},
      reviewer: "评委甲",
      lockedReviewers: [],
      selectedSupplierId: null,
      comments: {},
      awardedSupplierId: null
    };
  },
  computed: {
    weightTotal() {
      const weights = this.data.get('weights') || {}; return this.data.get('criteria').reduce((sum, item) => sum + Number(weights[item.id] || 0), 0);
    },
    rankings() {
      const scores = this.data.get('scores') || {}; const weights = this.data.get('weights') || {}; return this.data.get('suppliers').map(supplier => { const row = scores[supplier.id] || {}; const weighted = this.data.get('criteria').reduce((sum, criterion) => sum + Number(row[criterion.id] || 0) * Number(weights[criterion.id] || 0), 0) / (this.data.get('weightTotal') || 1); return Object.assign({}, supplier, { total: weighted.toFixed(1) }); }).sort((a, b) => Number(b.total) - Number(a.total));
    },
    winner() {
      return this.data.get('rankings').find(item => item.id === this.data.get('awardedSupplierId')) || null;
    },
    isLocked() {
      return this.data.get('lockedReviewers').indexOf(this.data.get('reviewer')) >= 0;
    }
  },
  inited() {
    const weights = {}; this.data.get('criteria').forEach(item => { weights[item.id] = item.weight; }); const scores = {}; this.data.get('suppliers').forEach((supplier, sIndex) => { scores[supplier.id] = {}; this.data.get('criteria').forEach((criterion, cIndex) => { scores[supplier.id][criterion.id] = 72 + (sIndex * 7 + cIndex * 5) % 24; }); }); this.setValue('weights', weights); this.setValue('scores', scores);
  },
  setValue(key, value) { this.data.set(key, value); },
  emitEvent(name, payload) { this.fire(name, payload); },
  setReviewer(event) {
    this.setValue('reviewer', event.target.value);
  },
  updateWeight(id, event) {
    if (this.data.get('isLocked')) return; this.setValue('weights', Object.assign({}, this.data.get('weights'), { [id]: Number(event.target.value) || 0 })); this.emitEvent('score', { weights: this.data.get('weights'), scores: this.data.get('scores') });
  },
  updateScore(supplierId, criterionId, event) {
    if (this.data.get('isLocked')) return; const row = Object.assign({}, this.data.get('scores')[supplierId], { [criterionId]: Math.max(0, Math.min(100, Number(event.target.value) || 0)) }); this.setValue('scores', Object.assign({}, this.data.get('scores'), { [supplierId]: row })); this.setValue('selectedSupplierId', supplierId);
  },
  toggleLock() {
    const list = this.data.get('lockedReviewers'); this.setValue('lockedReviewers', list.indexOf(this.data.get('reviewer')) >= 0 ? list.filter(item => item !== this.data.get('reviewer')) : list.concat(this.data.get('reviewer'))); this.emitEvent('lock', { reviewer: this.data.get('reviewer'), locked: !this.data.get('isLocked') });
  },
  updateComment(supplierId, event) {
    this.setValue('comments', Object.assign({}, this.data.get('comments'), { [supplierId]: event.target.value }));
  },
  award(supplierId) {
    const supplier = this.data.get('rankings').find(item => item.id === supplierId); if (!supplier || Number(supplier.total) < this.data.get('passingScore') || this.data.get('weightTotal') !== 100) return; this.setValue('awardedSupplierId', supplierId); this.emitEvent('award', supplier);
  },
  rankOf(id) {
    return this.data.get('rankings').findIndex(item => item.id === id) + 1;
  },
  supplierTotal(id) {
    const supplier = this.data.get('rankings').find(item => item.id === id); return supplier ? supplier.total : '0.0';
  },
  canAward(supplier) {
    return Number(this.supplierTotal(supplier.id)) >= this.data.get('passingScore') && this.data.get('weightTotal') === 100;
  }
});
</script>

<style>

.procurement-bid-matrix{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}
.procurement-bid-matrix *{box-sizing:border-box}
.procurement-bid-matrix h2,.procurement-bid-matrix h3,.procurement-bid-matrix p{margin-top:0}
.procurement-bid-matrix button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}
.procurement-bid-matrix button.primary{border-color:#0f766e;background:#0f766e;color:#fff}
.procurement-bid-matrix button:disabled{opacity:.45;cursor:not-allowed}
.procurement-bid-matrix input,.procurement-bid-matrix select,.procurement-bid-matrix textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}
.procurement-bid-matrix .muted{color:#71808e;font-size:12px}
.procurement-bid-matrix .toolbar,.procurement-bid-matrix .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
header{display:flex;justify-content:space-between}.matrix-wrap{overflow:auto;margin:12px 0}table{width:100%;border-collapse:collapse}th,td{padding:8px;border:1px solid #cbd5e1;text-align:center}thead th input,tbody td input{width:60px}tbody tr.selected{background:#f0fdfa}.ranking{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.ranking article{display:grid;grid-template-columns:35px 1fr auto;gap:7px;align-items:center;padding:10px;background:#f8fafc}.ranking textarea{grid-column:1/-1}.ranking button{grid-column:1/-1}.ranking article.winner{background:#dcfce7;box-shadow:0 0 0 2px #16a34a}footer{margin-top:10px;padding:12px;background:#dcfce7;color:#166534}
</style>
