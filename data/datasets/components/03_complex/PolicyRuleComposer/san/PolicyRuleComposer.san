<template>
  <section class="policy-rule-composer"><header><div><small>v{{ publishedVersion || '草稿' }}</small><h2>{{ policyName }}</h2></div><button class="primary" on-click="publish" disabled="{{ !canPublish }}">发布策略</button></header><div class="policy-layout"><main><div class="join-row">规则组之间 <button on-click="toggleJoin">{{ groupJoin }}</button></div><article s-for="group in groups trackby group.id" class="rule-group"><h3>规则组 {{ group.id }} <button on-click="toggleGroup(group.id)">{{ group.operator }}</button></h3><div s-for="condition in group.conditions trackby condition.id" class="condition"><select value="{{ condition.field }}" on-change="updateCondition(group.id, condition.id, 'field', $event)"><option s-for="field in fields trackby field" value="{{ field }}">{{ field }}</option></select><select value="{{ condition.comparator }}" on-change="updateCondition(group.id, condition.id, 'comparator', $event)"><option value="equals">等于</option><option value="less">小于</option></select><input value="{{ condition.value }}" on-input="updateCondition(group.id, condition.id, 'value', $event)"><button on-click="removeCondition(group.id, condition.id)">删除</button></div><button on-click="addCondition(group.id)">添加条件</button></article></main><aside><h3>测试上下文</h3><label s-for="field in fields trackby field">{{ field }}<input value="{{ context[field] }}" on-input="setContext(field, $event)"></label><button on-click="testPolicy">运行判定</button><output class="{{ testResult ? 'pass' : 'deny' }}">{{ decisionLabel }}</output><ul><li s-for="trace in testTrace trackby trace.id">组 {{ trace.id }}：{{ trace.passed ? '通过' : '未通过' }}</li></ul></aside></div><footer>条件 {{ conditionCount }} 条 · 无效 {{ invalidConditions.length }} 条 · 效果 {{ effect }}</footer></section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'PolicyRuleComposer',
  dataTypes: {
    policyName: DataTypes.string,
    initialGroups: DataTypes.array,
    fields: DataTypes.array,
    effect: DataTypes.string,
    publishable: DataTypes.bool
  },
  initData() {
    return {
      policyName: "研发仓库访问策略",
      initialGroups: [
        {
          "id": 1,
          "operator": "AND",
          "conditions": [
            {
              "id": 11,
              "field": "role",
              "comparator": "equals",
              "value": "developer"
            },
            {
              "id": 12,
              "field": "hour",
              "comparator": "less",
              "value": "20"
            }
          ]
        },
        {
          "id": 2,
          "operator": "OR",
          "conditions": [
            {
              "id": 21,
              "field": "network",
              "comparator": "equals",
              "value": "office"
            }
          ]
        }
      ],
      fields: [
        "role",
        "hour",
        "network"
      ],
      effect: "allow",
      publishable: true,
      groups: [],
      context: {
        "role": "developer",
        "hour": "16",
        "network": "office"
      },
      groupJoin: "AND",
      testResult: null,
      testTrace: [],
      publishedVersion: 0,
      nextConditionId: 100
    };
  },
  computed: {
    conditionCount() {
      return this.data.get('groups').reduce((sum, group) => sum + group.conditions.length, 0);
    },
    invalidConditions() {
      return this.data.get('groups').reduce((out, group) => out.concat(group.conditions.filter(item => !item.field || !item.value)), []);
    },
    decisionLabel() {
      return this.data.get('testResult') === null ? '尚未测试' : this.data.get('testResult') ? '允许访问' : '拒绝访问';
    },
    canPublish() {
      return this.data.get('publishable') && this.data.get('invalidConditions').length === 0 && this.data.get('testResult') !== null;
    }
  },
  inited() {
    this.setValue('groups', this.data.get('initialGroups').map(group => Object.assign({}, group, { conditions: group.conditions.map(item => Object.assign({}, item)) })));
  },
  setValue(key, value) { this.data.set(key, value); },
  emitEvent(name, payload) { this.fire(name, payload); },
  setContext(field, event) {
    this.setValue('context', Object.assign({}, this.data.get('context'), { [field]: event.target.value })); this.setValue('testResult', null);
  },
  toggleJoin() {
    this.setValue('groupJoin', this.data.get('groupJoin') === 'AND' ? 'OR' : 'AND'); this.setValue('testResult', null);
  },
  toggleGroup(id) {
    this.setValue('groups', this.data.get('groups').map(group => group.id === id ? Object.assign({}, group, { operator: group.operator === 'AND' ? 'OR' : 'AND' }) : group)); this.setValue('testResult', null);
  },
  updateCondition(groupId, conditionId, field, event) {
    this.setValue('groups', this.data.get('groups').map(group => group.id !== groupId ? group : Object.assign({}, group, { conditions: group.conditions.map(condition => condition.id === conditionId ? Object.assign({}, condition, { [field]: event.target.value }) : condition) }))); this.setValue('testResult', null); this.emitEvent('change', this.data.get('groups'));
  },
  addCondition(groupId) {
    const id = this.data.get('nextConditionId'); this.setValue('groups', this.data.get('groups').map(group => group.id === groupId ? Object.assign({}, group, { conditions: group.conditions.concat({ id, field: 'role', comparator: 'equals', value: '' }) }) : group)); this.setValue('nextConditionId', id + 1);
  },
  removeCondition(groupId, conditionId) {
    this.setValue('groups', this.data.get('groups').map(group => group.id === groupId ? Object.assign({}, group, { conditions: group.conditions.filter(item => item.id !== conditionId) }) : group));
  },
  evaluateCondition(condition) {
    const actual = this.data.get('context')[condition.field]; if (condition.comparator === 'less') return Number(actual) < Number(condition.value); return String(actual) === String(condition.value);
  },
  testPolicy() {
    const traces = this.data.get('groups').map(group => { const values = group.conditions.map(condition => this.evaluateCondition(condition)); return { id: group.id, passed: group.operator === 'AND' ? values.every(Boolean) : values.some(Boolean) }; }); const passed = this.data.get('groupJoin') === 'AND' ? traces.every(item => item.passed) : traces.some(item => item.passed); this.setValue('testTrace', traces); this.setValue('testResult', passed); this.emitEvent('test', { passed, traces });
  },
  publish() {
    if (!this.data.get('canPublish')) return; this.setValue('publishedVersion', this.data.get('publishedVersion') + 1); this.emitEvent('publish', { version: this.data.get('publishedVersion'), groups: this.data.get('groups'), effect: this.data.get('effect') });
  }
});
</script>

<style>

.policy-rule-composer{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}
.policy-rule-composer *{box-sizing:border-box}
.policy-rule-composer h2,.policy-rule-composer h3,.policy-rule-composer p{margin-top:0}
.policy-rule-composer button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}
.policy-rule-composer button.primary{border-color:#b45309;background:#b45309;color:#fff}
.policy-rule-composer button:disabled{opacity:.45;cursor:not-allowed}
.policy-rule-composer input,.policy-rule-composer select,.policy-rule-composer textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}
.policy-rule-composer .muted{color:#71808e;font-size:12px}
.policy-rule-composer .toolbar,.policy-rule-composer .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
header{display:flex;justify-content:space-between}.policy-layout{display:grid;grid-template-columns:1fr 240px;gap:14px}.join-row{padding:10px;background:#fffbeb}.rule-group{margin:10px 0;padding:12px;border:1px solid #fcd34d}.condition{display:grid;grid-template-columns:110px 90px 1fr auto;gap:6px;margin:7px 0}.policy-layout aside{padding:12px;background:#f8fafc}.policy-layout label{display:grid;margin:8px 0}.policy-layout output{display:block;padding:12px;margin-top:10px;text-align:center}.policy-layout output.pass{background:#dcfce7;color:#166534}.policy-layout output.deny{background:#fee2e2;color:#991b1b}footer{margin-top:10px;color:#64748b}
</style>
