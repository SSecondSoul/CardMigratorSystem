<template>
  <div class="{{ dashboardClass }}">
    <!-- 顶部导航栏 -->
    <div class="dashboard-navbar">
      <div class="logo-section">
        <span class="logo-icon">📈</span>
        <h1 class="logo-text">Analytics Pro</h1>
      </div>
      <div class="nav-controls">
        <button class="view-toggle" on-click="toggleView">
          {{ isCompactView ? '📊 展开视图' : '📋 紧凑视图' }}
        </button>
        <button class="theme-toggle" on-click="toggleTheme">
          {{ isDarkMode ? '☀️ 亮色' : '🌙 暗色' }}
        </button>
        <button s-if="isLoading" class="refresh-btn" disabled>
          ⏳ 加载中...
        </button>
        <button s-else class="refresh-btn" on-click="manualRefresh">
          🔄 刷新数据
        </button>
      </div>
    </div>

    <!-- 主要数据卡片区域 -->
    <div class="stats-grid">
      <stat-card
        s-for="stat in statistics"
        title="{{ stat.title }}"
        value="{{ stat.value }}"
        change="{{ stat.change }}"
        icon="{{ stat.icon }}"
        loading="{{ isLoading }}"
        on-click="onStatClick(stat)"
      />
    </div>

    <!-- 图表与数据可视化区域 -->
    <div class="visualization-section">
      <div class="chart-container">
        <h3 class="section-title">
          <span>📊 实时访问趋势</span>
          <select value="{= selectedPeriod =}" on-change="onPeriodChange" class="period-selector">
            <option value="7d">最近7天</option>
            <option value="30d">最近30天</option>
            <option value="90d">最近90天</option>
          </select>
        </h3>
        <trend-chart
          data="{{ chartData }}"
          height="{{ 300 }}"
          loading="{{ isLoading }}"
          on-data-point-click="onDataPointClick($event)"
        />
      </div>
      
      <div class="insights-panel">
        <h3 class="section-title">💡 智能洞察</h3>
        <insight-list
          insights="{{ insights }}"
          loading="{{ isLoading }}"
          on-insight-click="onInsightClick($event)"
        />
      </div>
    </div>

    <!-- 用户活动日志表格 -->
    <div class="activity-section">
      <div class="activity-header">
        <h3 class="section-title">📋 实时用户活动</h3>
        <div class="filter-controls">
          <input 
            value="{= searchQuery =}"
            type="text" 
            placeholder="搜索用户或操作..."
            class="search-input"
            on-input="onSearchChange"
          />
          <select value="{= activityFilter =}" on-change="onFilterChange" class="filter-select">
            <option value="all">所有活动</option>
            <option value="login">登录</option>
            <option value="purchase">购买</option>
            <option value="view">浏览</option>
            <option value="share">分享</option>
          </select>
        </div>
      </div>
      <activity-table
        activities="{{ filteredActivities }}"
        loading="{{ isLoading }}"
        on-row-click="onActivityClick($event)"
      />
    </div>

    <!-- 加载遮罩层 -->
    <div s-if="isLoading" class="loading-overlay">
      <div class="spinner"></div>
      <p>正在加载最新数据...</p>
    </div>
  </div>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

// 子组件1：统计卡片
const StatCard = san.defineComponent({
  name: 'StatCard',
  template: `
    <div class="{{ cardClass }}" on-click="handleClick">
      <div class="stat-icon">{{ icon }}</div>
      <div class="stat-content">
        <div class="stat-title">{{ title }}</div>
        <div class="stat-value">{{ formattedValue }}</div>
        <div class="stat-change {{ changeClass }}">
          {{ changeIcon }} {{ absChange }}%
        </div>
      </div>
    </div>
  `,
  dataTypes: {
    title: DataTypes.string,
    value: DataTypes.number,
    change: DataTypes.number,
    icon: DataTypes.string,
    loading: DataTypes.bool
  },
  initData() {
    return {
      title: '',
      value: 0,
      change: 0,
      icon: '',
      loading: false
    };
  },
  computed: {
    cardClass() {
      return this.data.get('loading') ? 'stat-card loading' : 'stat-card';
    },
    changeClass() {
      const change = this.data.get('change');
      if (change > 0) return 'positive';
      if (change < 0) return 'negative';
      return 'neutral';
    },
    changeIcon() {
      const change = this.data.get('change');
      if (change > 0) return '▲';
      if (change < 0) return '▼';
      return '●';
    },
    absChange() {
      return Math.abs(this.data.get('change'));
    },
    formattedValue() {
      const value = this.data.get('value');
      if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
      if (value >= 1000) return (value / 1000).toFixed(1) + 'K';
      return String(value);
    }
  },
  handleClick() {
    this.fire('click');
  }
});

// 子组件2：趋势图表（模拟高级图表）
const TrendChart = san.defineComponent({
  name: 'TrendChart',
  template: `
    <div class="{{ chartClass }}">
      <svg width="100%" height="{{ height }}" viewBox="0 0 800 300" preserveAspectRatio="none">
        <!-- 网格线 -->
        <g s-for="i in gridLines">
          <line 
            x1="0" y1="{{ i * 60 }}" x2="800" y2="{{ i * 60 }}" 
            stroke="#e2e8f0" stroke-width="0.5" stroke-dasharray="4,4"
          />
        </g>
        
        <!-- 面积填充 -->
        <polygon
          points="{{ areaPoints }}"
          fill="rgba(59, 130, 246, 0.1)"
          stroke="none"
        />
        
        <!-- 数据线条 -->
        <polyline
          points="{{ linePoints }}"
          fill="none"
          stroke="#3b82f6"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        
        <!-- 数据点 -->
        <g s-for="point in normalizedData">
          <circle
            cx="{{ point.x }}"
            cy="{{ point.y }}"
            r="4"
            fill="#ef4444"
            stroke="white"
            stroke-width="2"
            on-mouseenter="setHoveredIndex(point.index)"
            on-mouseleave="clearHoveredIndex"
            on-click="onPointClick(point.index, point, $event)"
            style="cursor: pointer;"
          />
          <text
            s-if="hoveredIndex === point.index"
            x="{{ point.x }}"
            y="{{ point.y - 10 }}"
            text-anchor="middle"
            font-size="10"
            fill="#475569"
          >
            {{ point.value }}
          </text>
        </g>
      </svg>
      <div class="chart-legend">
        <span class="legend-item">📈 访问量</span>
        <span class="legend-item">🖱️ 点击数据点查看详情</span>
      </div>
    </div>
  `,
  dataTypes: {
    data: DataTypes.array,
    height: DataTypes.number,
    loading: DataTypes.bool
  },
  initData() {
    return {
      data: [],
      height: 300,
      loading: false,
      hoveredIndex: null,
      gridLines: [1, 2, 3, 4, 5]
    };
  },
  computed: {
    chartClass() {
      return this.data.get('loading') ? 'trend-chart chart-loading' : 'trend-chart';
    },
    maxValue() {
      const data = this.data.get('data') || [];
      return Math.max.apply(null, data.map(item => item.value).concat(100));
    },
    minValue() {
      const data = this.data.get('data') || [];
      return Math.min.apply(null, data.map(item => item.value).concat(0));
    },
    normalizedData() {
      const data = this.data.get('data') || [];
      const maxValue = this.data.get('maxValue');
      const minValue = this.data.get('minValue');
      const range = maxValue - minValue;

      return data.map((point, idx) => {
        const x = data.length <= 1 ? 400 : (idx / (data.length - 1)) * 800;
        const y = range === 0 ? 150 : 300 - ((point.value - minValue) / range) * 280;

        return Object.assign({}, point, {
          index: idx,
          x,
          y
        });
      });
    },
    linePoints() {
      return this.data.get('normalizedData').map(point => point.x + ',' + point.y).join(' ');
    },
    areaPoints() {
      const points = this.data.get('normalizedData').map(point => point.x + ',' + point.y);
      return '0,300 ' + points.join(' ') + ' 800,300';
    }
  },
  setHoveredIndex(index) {
    this.data.set('hoveredIndex', index);
  },
  clearHoveredIndex() {
    this.data.set('hoveredIndex', null);
  },
  onPointClick(index, point, event) {
    if (event && typeof event.stopPropagation === 'function') {
      event.stopPropagation();
    }
    this.fire('data-point-click', {
      index,
      value: point.value,
      date: point.date,
      label: point.label
    });
  }
});

// 子组件3：洞察列表
const InsightList = san.defineComponent({
  name: 'InsightList',
  template: `
    <div class="{{ listClass }}">
      <div s-for="insight in insights" class="insight-item" on-click="handleInsightClick(insight)">
        <div class="insight-icon" style="background-color: {{ insight.color }};">
          {{ insight.icon }}
        </div>
        <div class="insight-content">
          <div class="insight-title">{{ insight.title }}</div>
          <div class="insight-desc">{{ insight.description }}</div>
          <div class="insight-meta">{{ insight.timestamp }}</div>
        </div>
        <div class="insight-trend {{ insight.trend > 0 ? 'up' : 'down' }}">
          {{ insight.trend > 0 ? '+' : '' }}{{ insight.trend }}%
        </div>
      </div>
      <div s-if="insights.length === 0 && !loading" class="empty-insights">
        暂无智能洞察数据
      </div>
    </div>
  `,
  dataTypes: {
    insights: DataTypes.array,
    loading: DataTypes.bool
  },
  initData() {
    return {
      insights: [],
      loading: false
    };
  },
  computed: {
    listClass() {
      return this.data.get('loading') ? 'insight-list loading' : 'insight-list';
    }
  },
  handleInsightClick(insight) {
    this.fire('insight-click', insight);
  }
});

// 子组件4：活动表格
const ActivityTable = san.defineComponent({
  name: 'ActivityTable',
  template: `
    <div class="activity-table-wrapper">
      <table class="activity-table">
        <thead>
          <tr>
            <th>时间</th>
            <th>用户</th>
            <th>操作类型</th>
            <th>详细信息</th>
            <th>状态</th>
          </tr>
        </thead>
        <tbody>
          <tr s-for="activity in activities" on-click="handleRowClick(activity)" class="activity-row">
            <td class="time-cell">{{ activity.timeText }}</td>
            <td class="user-cell">{{ activity.user }}</td>
            <td class="type-cell">
              <span class="activity-badge {{ activity.type }}">{{ activity.typeLabel }}</span>
            </td>
            <td class="detail-cell">{{ activity.detail }}</td>
            <td class="status-cell">
              <span class="status-badge {{ activity.status }}">{{ activity.statusLabel }}</span>
            </td>
          </tr>
          <tr s-if="activities.length === 0 && !loading">
            <td colspan="5" class="empty-cell">暂无活动记录</td>
          </tr>
        </tbody>
      </table>
    </div>
  `,
  dataTypes: {
    activities: DataTypes.array,
    loading: DataTypes.bool
  },
  initData() {
    return {
      activities: [],
      loading: false
    };
  },
  handleRowClick(activity) {
    this.fire('row-click', activity);
  }
});

// 主组件
module.exports = san.defineComponent({
  name: 'AnalyticsDashboard',
  components: {
    'stat-card': StatCard,
    'trend-chart': TrendChart,
    'insight-list': InsightList,
    'activity-table': ActivityTable
  },
  dataTypes: {
    userId: DataTypes.string,
    apiEndpoint: DataTypes.string
  },
  initData() {
    return {
      userId: 'anonymous',
      apiEndpoint: 'https://api.example.com/analytics',
      isDarkMode: false,
      isCompactView: false,
      isLoading: false,
      selectedPeriod: '30d',
      searchQuery: '',
      activityFilter: 'all',
      statistics: [
        { id: 1, title: '总访问量', value: 28450, change: 12.5, icon: '👥' },
        { id: 2, title: '新增用户', value: 3240, change: -2.3, icon: '🆕' },
        { id: 3, title: '转化率', value: 3.8, change: 0.7, icon: '🎯' },
        { id: 4, title: '总收入', value: 187500, change: 18.9, icon: '💰' }
      ],
      chartData: [],
      insights: [],
      activities: [],
      dataCache: {
        '7d': null,
        '30d': null,
        '90d': null
      },
      eventHistory: [],
      refreshInterval: null
    };
  },
  computed: {
    dashboardClass() {
      const classNames = ['analytics-dashboard'];
      if (this.data.get('isDarkMode')) {
        classNames.push('dark-mode');
      }
      if (this.data.get('isCompactView')) {
        classNames.push('compact');
      }
      return classNames.join(' ');
    },
    filteredActivities() {
      let filtered = (this.data.get('activities') || []).slice();
      const searchQuery = this.data.get('searchQuery');
      const activityFilter = this.data.get('activityFilter');

      if (searchQuery) {
        const query = searchQuery.toLowerCase();
        filtered = filtered.filter(activity =>
          activity.user.toLowerCase().indexOf(query) !== -1 ||
          activity.detail.toLowerCase().indexOf(query) !== -1
        );
      }

      if (activityFilter !== 'all') {
        filtered = filtered.filter(activity => activity.type === activityFilter);
      }

      return filtered;
    }
  },
  inited() {
    this.watch('isDarkMode', newVal => {
      this.addEventToHistory('theme', '主题切换为 ' + (newVal ? '暗色' : '亮色') + ' 模式');
      this.fire('theme-changed', { darkMode: newVal, timestamp: Date.now() });
    });

    this.watch('isCompactView', newVal => {
      this.addEventToHistory('view', '视图切换为 ' + (newVal ? '紧凑' : '展开') + ' 模式');
    });
  },
  attached() {
    this.initializeDashboard();
    this.startAutoRefresh();
    this.addEventToHistory('system', '仪表盘初始化完成');
  },
  disposed() {
    const refreshInterval = this.data.get('refreshInterval');
    if (refreshInterval) {
      clearInterval(refreshInterval);
    }
    this.addEventToHistory('system', '仪表盘组件即将销毁');
  },
  initializeDashboard() {
    this.data.set('isLoading', true);
    return Promise.all([
      this.loadChartData(),
      this.loadInsights(),
      this.loadActivities()
    ])
      .then(() => {
        this.addEventToHistory('success', '所有数据加载成功');
      })
      .catch(error => {
        this.addEventToHistory('error', '数据加载失败: ' + error.message);
        this.fire('error', { message: error.message, timestamp: Date.now() });
      })
      .then(() => {
        this.data.set('isLoading', false);
      });
  },
  loadChartData() {
    const selectedPeriod = this.data.get('selectedPeriod');
    const dataCache = this.data.get('dataCache');

    if (dataCache[selectedPeriod]) {
      this.data.set('chartData', dataCache[selectedPeriod]);
      this.addEventToHistory('cache', '使用缓存的 ' + selectedPeriod + ' 图表数据');
      return Promise.resolve();
    }

    return new Promise(resolve => {
      setTimeout(() => {
        const days = selectedPeriod === '7d' ? 7 : (selectedPeriod === '30d' ? 30 : 90);
        const data = [];
        let baseValue = 1000;

        for (let i = 0; i < days; i++) {
          const variance = Math.sin(i * 0.2) * 200;
          const trend = i * 2;
          baseValue += Math.random() * 30 - 15;
          const value = Math.max(100, Math.floor(baseValue + variance + trend));

          const date = new Date();
          date.setDate(date.getDate() - (days - i));

          data.push({
            date: date.toISOString().split('T')[0],
            label: this.formatDateLabel(date, days),
            value
          });
        }

        const nextCache = Object.assign({}, dataCache);
        nextCache[selectedPeriod] = data;
        this.data.set('chartData', data);
        this.data.set('dataCache', nextCache);
        this.addEventToHistory('fetch', '加载了 ' + days + ' 天的图表数据');
        resolve();
      }, 800);
    });
  },
  loadInsights() {
    return new Promise(resolve => {
      setTimeout(() => {
        this.data.set('insights', [
          {
            id: 1,
            title: '用户活跃度提升',
            description: '过去7天用户访问时长增加了23%，主要集中在移动端',
            icon: '🚀',
            color: '#10b981',
            trend: 23,
            timestamp: '2分钟前'
          },
          {
            id: 2,
            title: '转化率优化建议',
            description: '购物车放弃率较高，建议优化结账流程',
            icon: '🛒',
            color: '#f59e0b',
            trend: -5,
            timestamp: '15分钟前'
          },
          {
            id: 3,
            title: '新用户增长高峰',
            description: '社交媒体渠道带来大量新用户，增长42%',
            icon: '📱',
            color: '#3b82f6',
            trend: 42,
            timestamp: '1小时前'
          },
          {
            id: 4,
            title: '服务器响应优化',
            description: 'API响应时间降低15%，用户体验改善',
            icon: '⚡',
            color: '#8b5cf6',
            trend: 15,
            timestamp: '3小时前'
          }
        ]);
        resolve();
      }, 600);
    });
  },
  loadActivities() {
    return new Promise(resolve => {
      setTimeout(() => {
        const activities = [];
        const users = ['张三', '李四', '王五', '赵六', '钱七'];
        const types = ['login', 'purchase', 'view', 'share'];
        const details = {
          login: ['登录成功', '登录失败', '异地登录'],
          purchase: ['购买商品A', '购买商品B', '订阅会员'],
          view: ['浏览首页', '查看详情页', '搜索关键词'],
          share: ['分享链接', '邀请好友', '发布评论']
        };

        for (let i = 0; i < 15; i++) {
          const type = types[Math.floor(Math.random() * types.length)];
          const status = Math.random() > 0.8 ? 'failed' : (Math.random() > 0.9 ? 'pending' : 'success');
          const timestamp = Date.now() - Math.random() * 3600000;

          activities.push({
            id: Date.now() + i,
            timestamp,
            timeText: new Date(timestamp).toLocaleTimeString(),
            user: users[Math.floor(Math.random() * users.length)],
            type,
            typeLabel: this.getTypeLabel(type),
            detail: details[type][Math.floor(Math.random() * details[type].length)],
            status,
            statusLabel: this.getStatusLabel(status)
          });
        }

        this.data.set('activities', activities.sort((a, b) => b.timestamp - a.timestamp));
        resolve();
      }, 500);
    });
  },
  manualRefresh() {
    if (this.data.get('isLoading')) return;

    this.data.set('isLoading', true);
    this.addEventToHistory('action', '用户手动刷新数据');

    const selectedPeriod = this.data.get('selectedPeriod');
    const dataCache = Object.assign({}, this.data.get('dataCache'));
    dataCache[selectedPeriod] = null;
    this.data.set('dataCache', dataCache);

    return Promise.all([
      this.loadChartData(),
      this.loadInsights(),
      this.loadActivities()
    ])
      .then(() => {
        this.addEventToHistory('success', '数据刷新完成');
        this.fire('data-refreshed', {
          timestamp: Date.now(),
          period: this.data.get('selectedPeriod'),
          statistics: this.data.get('statistics')
        });
      })
      .catch(error => {
        this.addEventToHistory('error', '刷新失败: ' + error.message);
        this.fire('error', { message: error.message });
      })
      .then(() => {
        this.data.set('isLoading', false);
      });
  },
  startAutoRefresh() {
    const refreshInterval = setInterval(() => {
      if (!this.data.get('isLoading')) {
        this.autoRefresh();
      }
    }, 30000);
    this.data.set('refreshInterval', refreshInterval);
  },
  autoRefresh() {
    this.addEventToHistory('system', '自动刷新数据');
    const selectedPeriod = this.data.get('selectedPeriod');
    const dataCache = Object.assign({}, this.data.get('dataCache'));
    dataCache[selectedPeriod] = null;
    this.data.set('dataCache', dataCache);

    return this.loadChartData()
      .then(() => this.loadInsights())
      .then(() => this.loadActivities())
      .then(() => {
        this.addEventToHistory('success', '自动数据同步完成');
      })
      .catch(error => {
        this.addEventToHistory('error', '自动刷新失败: ' + error.message);
      });
  },
  toggleTheme() {
    this.data.set('isDarkMode', !this.data.get('isDarkMode'));
  },
  toggleView() {
    this.data.set('isCompactView', !this.data.get('isCompactView'));
  },
  onPeriodChange() {
    this.addEventToHistory('filter', '切换时间段为: ' + this.data.get('selectedPeriod'));
    this.loadChartData();
  },
  onSearchChange() {
    this.addEventToHistory('filter', '搜索关键词: ' + (this.data.get('searchQuery') || '清空'));
  },
  onFilterChange() {
    this.addEventToHistory('filter', '活动类型过滤: ' + this.data.get('activityFilter'));
  },
  onStatClick(stat) {
    this.addEventToHistory('click', '点击统计卡片: ' + stat.title + ' (' + stat.value + ')');
    this.fire('stat-click', { stat, timestamp: Date.now() });
  },
  onDataPointClick(data) {
    this.addEventToHistory('chart', '点击数据点: 日期 ' + data.date + ', 值 ' + data.value);
    this.fire('chart-point-click', data);
  },
  onInsightClick(insight) {
    this.addEventToHistory('insight', '查看洞察: ' + insight.title);
    this.fire('insight-click', insight);
  },
  onActivityClick(activity) {
    this.addEventToHistory('activity', '查看活动: ' + activity.user + ' - ' + activity.type);
    this.fire('activity-click', activity);
  },
  formatDateLabel(date, totalDays) {
    if (totalDays <= 30) {
      return (date.getMonth() + 1) + '/' + date.getDate();
    }
    return (date.getMonth() + 1) + '月';
  },
  getTypeLabel(type) {
    const labels = { login: '登录', purchase: '购买', view: '浏览', share: '分享' };
    return labels[type] || type;
  },
  getStatusLabel(status) {
    const labels = { success: '成功', pending: '处理中', failed: '失败' };
    return labels[status] || status;
  },
  addEventToHistory(type, message) {
    const event = {
      type,
      message,
      timestamp: Date.now(),
      timeStr: new Date().toLocaleTimeString()
    };

    const eventHistory = this.data.get('eventHistory').slice();
    eventHistory.unshift(event);
    if (eventHistory.length > 50) {
      eventHistory.pop();
    }
    this.data.set('eventHistory', eventHistory);

    if (typeof console !== 'undefined') {
      console.log('[' + event.timeStr + '] ' + message);
    }
  }
});
</script>

<style>
/* 主容器样式 */
.analytics-dashboard {
  max-width: 1400px;
  margin: 0 auto;
  padding: 20px;
  background: #f8fafc;
  color: #1e293b;
  transition: all 0.3s ease;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.analytics-dashboard.dark-mode {
  background: #0f172a;
  color: #e2e8f0;
}

.analytics-dashboard.compact {
  padding: 12px;
}

/* 导航栏 */
.dashboard-navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  padding: 16px 20px;
  background: white;
  border-radius: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.dark-mode .dashboard-navbar {
  background: #1e293b;
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.logo-section {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-icon {
  font-size: 28px;
}

.logo-text {
  font-size: 20px;
  font-weight: 700;
  margin: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.nav-controls {
  display: flex;
  gap: 12px;
}

.nav-controls button {
  padding: 8px 16px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.2s;
  background: #f1f5f9;
  color: #475569;
}

.dark-mode .nav-controls button {
  background: #334155;
  color: #cbd5e1;
}

.nav-controls button:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.refresh-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* 统计卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

.stat-card {
  background: white;
  border-radius: 16px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.dark-mode .stat-card {
  background: #1e293b;
}

.stat-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

.stat-card.loading {
  opacity: 0.6;
  pointer-events: none;
}

.stat-icon {
  font-size: 32px;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 12px;
}

.stat-content {
  flex: 1;
}

.stat-title {
  font-size: 14px;
  color: #64748b;
  margin-bottom: 8px;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 4px;
}

.dark-mode .stat-value {
  color: #f1f5f9;
}

.stat-change {
  font-size: 12px;
  font-weight: 600;
}

.stat-change.positive {
  color: #10b981;
}

.stat-change.negative {
  color: #ef4444;
}

.stat-change.neutral {
  color: #f59e0b;
}

/* 可视化区域 */
.visualization-section {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 24px;
  margin-bottom: 32px;
}

.chart-container, .insights-panel {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.dark-mode .chart-container,
.dark-mode .insights-panel {
  background: #1e293b;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  font-size: 18px;
  font-weight: 600;
}

.period-selector {
  padding: 6px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: white;
  cursor: pointer;
}

.dark-mode .period-selector {
  background: #334155;
  border-color: #475569;
  color: #e2e8f0;
}

/* 趋势图表 */
.trend-chart {
  position: relative;
}

.trend-chart.chart-loading {
  opacity: 0.6;
  pointer-events: none;
}

.chart-legend {
  margin-top: 16px;
  display: flex;
  justify-content: center;
  gap: 20px;
  font-size: 12px;
  color: #64748b;
}

/* 洞察列表 */
.insight-list {
  max-height: 320px;
  overflow-y: auto;
}

.insight-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px;
  border-radius: 12px;
  cursor: pointer;
  transition: background 0.2s;
}

.insight-item:hover {
  background: #f8fafc;
}

.dark-mode .insight-item:hover {
  background: #334155;
}

.insight-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  font-size: 16px;
}

.insight-content {
  flex: 1;
}

.insight-title {
  font-weight: 600;
  margin-bottom: 4px;
}

.insight-desc {
  font-size: 12px;
  color: #64748b;
  margin-bottom: 4px;
}

.insight-meta {
  font-size: 10px;
  color: #94a3b8;
}

.insight-trend {
  font-size: 14px;
  font-weight: 600;
}

.insight-trend.up {
  color: #10b981;
}

.insight-trend.down {
  color: #ef4444;
}

/* 活动区域 */
.activity-section {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.dark-mode .activity-section {
  background: #1e293b;
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  flex-wrap: wrap;
  gap: 12px;
}

.filter-controls {
  display: flex;
  gap: 12px;
}

.search-input, .filter-select {
  padding: 8px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 14px;
}

.dark-mode .search-input,
.dark-mode .filter-select {
  background: #334155;
  border-color: #475569;
  color: #e2e8f0;
}

/* 活动表格 */
.activity-table-wrapper {
  overflow-x: auto;
}

.activity-table {
  width: 100%;
  border-collapse: collapse;
}

.activity-table th {
  text-align: left;
  padding: 12px;
  background: #f8fafc;
  font-weight: 600;
  font-size: 14px;
  border-bottom: 2px solid #e2e8f0;
}

.dark-mode .activity-table th {
  background: #334155;
  border-bottom-color: #475569;
}

.activity-row {
  cursor: pointer;
  transition: background 0.2s;
}

.activity-row:hover {
  background: #f8fafc;
}

.dark-mode .activity-row:hover {
  background: #334155;
}

.activity-table td {
  padding: 12px;
  border-bottom: 1px solid #e2e8f0;
  font-size: 14px;
}

.activity-badge {
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
}

.activity-badge.login { background: #dbeafe; color: #1e40af; }
.activity-badge.purchase { background: #dcfce7; color: #166534; }
.activity-badge.view { background: #fef3c7; color: #92400e; }
.activity-badge.share { background: #f3e8ff; color: #6b21a5; }

.status-badge {
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
}

.status-badge.success { background: #dcfce7; color: #166534; }
.status-badge.pending { background: #fef3c7; color: #92400e; }
.status-badge.failed { background: #fee2e2; color: #991b1b; }

.empty-cell {
  text-align: center;
  padding: 40px;
  color: #94a3b8;
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.spinner {
  width: 48px;
  height: 48px;
  border: 4px solid #f3f4f6;
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-overlay p {
  margin-top: 16px;
  color: white;
  font-size: 14px;
}

/* 响应式设计 */
@media (max-width: 768px) {
  .visualization-section {
    grid-template-columns: 1fr;
  }
  
  .stats-grid {
    grid-template-columns: 1fr;
  }
  
  .dashboard-navbar {
    flex-direction: column;
    gap: 12px;
  }
  
  .nav-controls {
    width: 100%;
    justify-content: center;
  }
  
  .section-title {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
</style>
