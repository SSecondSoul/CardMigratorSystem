<template>
  <div class="{{ dashboardClass }}">
    <div class="dashboard-header">
      <h2 class="title">
        <span class="icon">📊</span> 智能仪表盘
      </h2>
      <div class="header-actions">
        <button class="theme-btn" on-click="toggleTheme">
          {{ isDarkMode ? '☀️' : '🌙' }}
        </button>
        <button s-if="isRefreshing" class="refresh-all" disabled>
          🔄 刷新中...
        </button>
        <button s-else class="refresh-all" on-click="refreshAllData">
          🔄 刷新所有
        </button>
      </div>
    </div>

    <div class="metrics-grid">
      <metric-card
        s-for="metric in metrics"
        title="{{ metric.title }}"
        value="{{ metric.value }}"
        unit="{{ metric.unit }}"
        trend="{{ metric.trend }}"
        color="{{ metric.color }}"
        on-click="onMetricClick(metric)"
      />
    </div>

    <div class="chart-section">
      <h3 class="section-title">实时数据趋势</h3>
      <simulated-chart
        data-points="{{ chartData }}"
        height="{{ chartHeight }}"
        on-point-click="onChartPointClick($event)"
      />
    </div>

    <div class="event-log">
      <div class="log-header">
        <span>📝 事件日志</span>
        <button class="clear-log" on-click="clearLogs">清空</button>
      </div>
      <div class="log-list">
        <div s-for="log in eventLogs" class="log-item">
          <span class="log-time">{{ log.time }}</span>
          <span class="log-text">{{ log.text }}</span>
        </div>
        <div s-if="!eventLogs.length" class="log-empty">暂无事件</div>
      </div>
    </div>
  </div>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

const MetricCard = san.defineComponent({
  name: 'MetricCard',

  template: `
    <div class="metric-card" style="{{ cardStyle }}" on-click="handleClick">
      <div class="metric-title">{{ title }}</div>
      <div class="metric-value"><span>{{ value }}</span><span class="metric-unit">{{ unit }}</span></div>
      <div class="metric-trend {{ trendClass }}">
        {{ trendIcon }} {{ absTrend }}%
      </div>
    </div>
  `,

  dataTypes: {
    title: DataTypes.string,
    value: DataTypes.number,
    unit: DataTypes.string,
    trend: DataTypes.number,
    color: DataTypes.string
  },

  initData() {
    return {
      title: '',
      value: 0,
      unit: '',
      trend: 0,
      color: ''
    };
  },

  computed: {
    cardStyle() {
      return 'border-left-color: ' + this.data.get('color') + ';';
    },
    trendClass() {
      const trend = this.data.get('trend');
      if (trend > 0) {
        return 'up';
      }
      if (trend < 0) {
        return 'down';
      }
      return 'flat';
    },
    trendIcon() {
      const trend = this.data.get('trend');
      if (trend > 0) {
        return '▲';
      }
      if (trend < 0) {
        return '▼';
      }
      return '●';
    },
    absTrend() {
      return Math.abs(this.data.get('trend'));
    }
  },

  handleClick() {
    this.fire('click');
  }
});

const SimulatedChart = san.defineComponent({
  name: 'SimulatedChart',

  template: `
    <div class="chart-container" on-click="handleChartClick($event)">
      <svg width="100%" height="{{ height }}" viewBox="0 0 500 200" preserveAspectRatio="none">
        <line s-for="gridY in gridLines" x1="0" y1="{{ gridY }}" x2="500" y2="{{ gridY }}" stroke="#ddd" stroke-width="0.5"></line>
        <polyline
          points="{{ polylinePoints }}"
          fill="none"
          stroke="#3b82f6"
          stroke-width="2"
        ></polyline>
        <circle
          s-for="point in normalizedPoints"
          cx="{{ point.x }}"
          cy="{{ point.y }}"
          r="4"
          fill="#ef4444"
          on-click="onPointClick(point.index, point.value, $event)"
        ></circle>
      </svg>
      <div class="chart-label">点击数据点查看详情</div>
    </div>
  `,

  dataTypes: {
    dataPoints: DataTypes.array,
    height: DataTypes.number
  },

  initData() {
    return {
      dataPoints: [],
      height: 200,
      gridLines: [0, 50, 100, 150, 200]
    };
  },

  computed: {
    normalizedPoints() {
      const dataPoints = this.data.get('dataPoints') || [];
      const min = Math.min.apply(null, dataPoints.concat(0));
      const max = Math.max.apply(null, dataPoints.concat(100));
      const range = max - min || 1;
      const step = 500 / ((dataPoints.length - 1) || 1);

      return dataPoints.map((value, index) => ({
        index,
        value,
        x: index * step,
        y: 200 - ((value - min) / range) * 200
      }));
    },
    polylinePoints() {
      return this.data.get('normalizedPoints').map(function (point) {
        return point.x + ',' + point.y;
      }).join(' ');
    }
  },

  handleChartClick(event) {
    const target = event && event.target;
    const tagName = target && target.tagName ? String(target.tagName).toLowerCase() : '';

    if (tagName !== 'circle') {
      this.fire('point-click', {type: 'chart_background', message: '点击了图表背景'});
    }
  },

  onPointClick(index, value, event) {
    if (event && typeof event.stopPropagation === 'function') {
      event.stopPropagation();
    }
    this.fire('point-click', {type: 'data_point', index, value});
  }
});

module.exports = san.defineComponent({
  name: 'SmartDashboard',

  components: {
    'metric-card': MetricCard,
    'simulated-chart': SimulatedChart
  },

  dataTypes: {
    initialTheme: DataTypes.bool,
    autoRefreshInterval: DataTypes.number
  },

  initData() {
    return {
      initialTheme: false,
      autoRefreshInterval: 10000,
      isDarkMode: false,
      isRefreshing: false,
      metrics: [
        {id: 1, title: '总销售额', value: 12450, unit: '元', trend: 8.5, color: '#f97316'},
        {id: 2, title: '访问量', value: 3240, unit: '次', trend: -2.3, color: '#3b82f6'},
        {id: 3, title: '转化率', value: 3.2, unit: '%', trend: 0.4, color: '#10b981'},
        {id: 4, title: '活跃用户', value: 1870, unit: '人', trend: 12.1, color: '#8b5cf6'}
      ],
      chartData: [25, 40, 38, 55, 48, 62, 70, 58, 65, 72],
      chartHeight: 200,
      eventLogs: [],
      refreshTimer: null
    };
  },

  computed: {
    dashboardClass() {
      return this.data.get('isDarkMode') ? 'dashboard dark-theme' : 'dashboard';
    }
  },

  inited() {
    this.data.set('isDarkMode', this.data.get('initialTheme'));
    this.watch('isDarkMode', value => {
      this.addLog('系统', '主题切换为 ' + (value ? '暗色' : '亮色') + ' 模式');
    });
  },

  attached() {
    this.addLog('系统', '仪表盘已加载');

    const autoRefreshInterval = this.data.get('autoRefreshInterval');
    if (autoRefreshInterval > 0) {
      const refreshTimer = setInterval(() => {
        this.refreshAllData();
      }, autoRefreshInterval);
      this.data.set('refreshTimer', refreshTimer);
      this.addLog('系统', '已开启自动刷新 (间隔 ' + autoRefreshInterval / 1000 + ' 秒)');
    }

    this.simulateDataFetch();
  },

  disposed() {
    const refreshTimer = this.data.get('refreshTimer');
    if (refreshTimer) {
      clearInterval(refreshTimer);
      this.addLog('系统', '组件销毁，已清除自动刷新定时器');
    }
  },

  addLog(source, text) {
    const time = new Date().toLocaleTimeString();
    const nextLogs = this.data.get('eventLogs').slice();
    nextLogs.unshift({time, text: '[' + source + '] ' + text});
    if (nextLogs.length > 20) {
      nextLogs.pop();
    }
    this.data.set('eventLogs', nextLogs);
  },

  clearLogs() {
    this.data.set('eventLogs', []);
    this.addLog('用户', '清空了事件日志');
  },

  toggleTheme() {
    this.data.set('isDarkMode', !this.data.get('isDarkMode'));
  },

  simulateDataFetch() {
    return new Promise(resolve => {
      setTimeout(() => {
        const nextMetrics = this.data.get('metrics').map(function (metric) {
          return Object.assign({}, metric, {
            value: Math.floor(metric.value * (0.9 + Math.random() * 0.2)),
            trend: parseFloat((Math.random() * 10 - 5).toFixed(1))
          });
        });
        this.data.set('metrics', nextMetrics);

        const newChartData = this.data.get('chartData').map(function () {
          return Math.floor(Math.random() * 80 + 20);
        });
        this.data.set('chartData', newChartData);
        resolve(true);
      }, 500);
    });
  },

  refreshAllData() {
    if (this.data.get('isRefreshing')) {
      return;
    }

    this.data.set('isRefreshing', true);
    this.addLog('系统', '开始刷新所有数据...');

    this.simulateDataFetch()
      .then(() => {
        this.addLog('系统', '数据刷新完成');
        this.fire('data-refreshed', {
          time: new Date().toISOString(),
          metrics: this.data.get('metrics')
        });
      })
      .catch(err => {
        this.addLog('错误', '刷新失败: ' + err.message);
        this.fire('error', err);
      })
      .finally(() => {
        this.data.set('isRefreshing', false);
      });
  },

  onMetricClick(metric) {
    this.addLog('指标', '点击了 ' + metric.title + '，当前值 ' + metric.value + metric.unit);
    this.fire('metric-click', metric);
  },

  onChartPointClick(detail) {
    if (detail.type === 'data_point') {
      this.addLog('图表', '点击数据点: 索引 ' + detail.index + '，值 ' + detail.value);
    } else {
      this.addLog('图表', detail.message);
    }
    this.fire('chart-interaction', detail);
  }
});
</script>

<style>
.dashboard {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #f8fafc;
  color: #0f172a;
  border-radius: 24px;
  padding: 24px;
  transition: background 0.3s, color 0.3s;
  box-shadow: 0 20px 35px -10px rgba(0,0,0,0.1);
  max-width: 900px;
  margin: 20px auto;
}

.dashboard.dark-theme {
  background: #1e293b;
  color: #f1f5f9;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  flex-wrap: wrap;
}
.title {
  margin: 0;
  font-size: 1.8rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.header-actions {
  display: flex;
  gap: 12px;
}
.theme-btn, .refresh-all {
  padding: 8px 16px;
  border: none;
  border-radius: 40px;
  font-size: 0.9rem;
  cursor: pointer;
  background: #e2e8f0;
  transition: 0.2s;
}
.dark-theme .theme-btn, .dark-theme .refresh-all {
  background: #334155;
  color: #e2e8f0;
}
.refresh-all:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 32px;
}
.metric-card {
  background: rgba(255,255,255,0.9);
  border-left: 6px solid;
  border-radius: 16px;
  padding: 12px 16px;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
}
.dark-theme .metric-card {
  background: #0f172a;
}
.metric-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}
.metric-title {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #475569;
}
.dark-theme .metric-title {
  color: #94a3b8;
}
.metric-value {
  font-size: 1.8rem;
  font-weight: 700;
  margin: 8px 0;
}
.metric-unit {
  font-size: 0.9rem;
  margin-left: 4px;
}
.metric-trend {
  font-size: 0.8rem;
}
.metric-trend.up { color: #10b981; }
.metric-trend.down { color: #ef4444; }
.metric-trend.flat { color: #f59e0b; }

.chart-section {
  background: rgba(255,255,255,0.7);
  border-radius: 20px;
  padding: 16px;
  margin-bottom: 24px;
}
.dark-theme .chart-section {
  background: #0f172a;
}
.section-title {
  margin-bottom: 16px;
  font-size: 1.2rem;
}
.chart-container {
  cursor: pointer;
}
.chart-label {
  text-align: center;
  font-size: 0.75rem;
  margin-top: 8px;
  color: #64748b;
}

.event-log {
  background: rgba(0,0,0,0.05);
  border-radius: 20px;
  padding: 12px;
}
.dark-theme .event-log {
  background: #0f172a;
}
.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  font-weight: bold;
}
.clear-log {
  background: none;
  border: none;
  cursor: pointer;
  color: #ef4444;
  font-size: 0.8rem;
}
.log-list {
  max-height: 150px;
  overflow-y: auto;
  font-size: 0.8rem;
}
.log-item {
  display: flex;
  gap: 12px;
  padding: 4px 0;
  border-bottom: 1px solid rgba(0,0,0,0.1);
}
.log-time {
  font-family: monospace;
  color: #64748b;
}
.log-empty {
  text-align: center;
  color: #94a3b8;
  padding: 12px;
}
</style>
