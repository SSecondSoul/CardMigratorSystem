<template>
  <section class="color-contrast-badge"><h2>色彩可读性</h2><div class="sample" style="{{ sampleStyle }}">Aa 示例文本</div><p class="{{ rating === '对比明显' ? 'good' : 'warn' }}">{{ rating }}</p><button class="primary" on-click="swap">交换前景与背景</button></section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'ColorContrastBadge',
  dataTypes: {
    foreground: DataTypes.string,
    background: DataTypes.string
  },
  initData() {
    return {
      foreground: "#172554",
      background: "#dbeafe",
      swapped: false
    };
  },
  computed: {
    front() {
      return this.data.get('swapped') ? this.data.get('background') : this.data.get('foreground');
    },
    back() {
      return this.data.get('swapped') ? this.data.get('foreground') : this.data.get('background');
    },
    sampleStyle() {
      return 'color:' + this.data.get('front') + ';background:' + this.data.get('back');
    },
    rating() {
      const a = parseInt(this.data.get('front').slice(1), 16); const b = parseInt(this.data.get('back').slice(1), 16); return Math.abs(a - b) > 5000000 ? '对比明显' : '建议复核';
    }
  },
  setValue(key, value) { this.data.set(key, value); },
  emitEvent(name, payload) { this.fire(name, payload); },
  swap() {
    this.setValue('swapped', !this.data.get('swapped'));
  }
});
</script>

<style>

.color-contrast-badge{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}
.color-contrast-badge *{box-sizing:border-box}
.color-contrast-badge h2,.color-contrast-badge h3,.color-contrast-badge p{margin-top:0}
.color-contrast-badge button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}
.color-contrast-badge button.primary{border-color:#9333ea;background:#9333ea;color:#fff}
.color-contrast-badge button:disabled{opacity:.45;cursor:not-allowed}
.color-contrast-badge input,.color-contrast-badge select,.color-contrast-badge textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}
.color-contrast-badge .muted{color:#71808e;font-size:12px}
.color-contrast-badge .toolbar,.color-contrast-badge .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.sample{padding:24px;text-align:center;font-size:26px}.good{color:#15803d}.warn{color:#b45309}
</style>
