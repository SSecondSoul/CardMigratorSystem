<template>
<section class="energy-load-scheduler">
  <header>
    <div>
      <small>{{optimized ? '已自动优化' : '手工排程'}}</small>
      <h2>{{siteName}}</h2>
    </div>
    <button class="primary" on-click="optimize">平衡峰值</button>
  </header>
  <div class="energy-layout">
    <main>
      <div class="matrix-head">
        <span>设备 / 小时</span>
        <button s-for="hour in hours trackby hour" class="{{selectedHour === hour ? 'active' : ''}}" on-click="selectHour(hour)">{{hour}}时</button>
      </div>
      <div class="device-row" s-for="device in devices trackby device.id">
        <strong>
          {{device.name}}
          <small>{{device.kw}} kW</small>
        </strong>
        <button s-for="hour in hours trackby hour" class="{{slotClass(device.id, hour)}}" on-click="toggleSlot(device.id, hour)">{{schedule[device.id][hour] ? '开' : '—'}}</button>
      </div>
      <div class="load-chart">
        <i s-for="load, index in hourlyLoads trackby index" class="{{load > capacity ? 'over' : ''}}" style="{{loadStyle(load)}}">
          <span>{{load}}</span>
        </i>
      </div>
    </main>
    <aside>
      <h3>{{selectedHour}}:00 详情</h3>
      <strong>{{selectedLoad}} / {{capacity}} kW</strong>
      <p>峰值 {{peakLoad}} kW</p>
      <p>预计成本 ¥{{totalCost}}</p>
      <p s-if="violations.length" class="warn">超限时段：{{violationsLabel}}</p>
      <input value="{= scenarioName =}" on-input="updateScenarioName" />
      <button on-click="saveScenario">保存情景</button>
      <ul>
        <li s-for="scenario in savedScenarios trackby scenario.id">{{scenario.name}} · ¥{{scenario.cost}} · {{scenario.peak}}kW</li>
      </ul>
    </aside>
  </div>
</section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'EnergyLoadScheduler',
  dataTypes: {
    siteName: DataTypes.string,
    devices: DataTypes.array,
    hours: DataTypes.array,
    rates: DataTypes.array,
    capacity: DataTypes.number
  },
  initData() {
    return {
      schedule: {},
      selectedHour: 0,
      scenarioName: '基准方案',
      savedScenarios: [],
      optimized: false
    };
  },
  inited() {
    const schedule = {};
    const devices = this.data.get('devices') || [];
    const hours = this.data.get('hours') || [];
    devices.forEach((device, d) => {
      schedule[device.id] = {};
      hours.forEach(hour => {
        schedule[device.id][hour] = (hour + d) % 3 === 0;
      });
    });
    this.data.set('schedule', schedule);
  },
  computed: {
    hourlyLoads() {
      const hours = this.data.get('hours') || [];
      const devices = this.data.get('devices') || [];
      const schedule = this.data.get('schedule') || {};
      return hours.map(hour =>
        devices.reduce((sum, device) =>
          sum + (schedule[device.id] && schedule[device.id][hour] ? device.kw : 0), 0)
      );
    },
    totalCost() {
      const hourlyLoads = this.data.get('hourlyLoads') || [];
      const rates = this.data.get('rates') || [];
      return hourlyLoads.reduce((sum, load, index) =>
        sum + load * (rates[index] || 0), 0).toFixed(2);
    },
    peakLoad() {
      const hourlyLoads = this.data.get('hourlyLoads') || [];
      return Math.max.apply(Math, hourlyLoads.concat(0));
    },
    violations() {
      const hours = this.data.get('hours') || [];
      const hourlyLoads = this.data.get('hourlyLoads') || [];
      const capacity = this.data.get('capacity') || 0;
      return hours.filter((hour, index) => hourlyLoads[index] > capacity);
    },
    violationsLabel() {
      const violations = this.data.get('violations') || [];
      return violations.join('、');
    },
    selectedLoad() {
      const hours = this.data.get('hours') || [];
      const selectedHour = this.data.get('selectedHour');
      const hourlyLoads = this.data.get('hourlyLoads') || [];
      const index = hours.indexOf(selectedHour);
      return index < 0 ? 0 : hourlyLoads[index];
    }
  },
  setValue(key, value) {
    this.data.set(key, value);
  },
  emitEvent(name, payload) {
    this.fire(name, payload);
  },
  toggleSlot(deviceId, hour) {
    const schedule = this.data.get('schedule') || {};
    const deviceSchedule = Object.assign({}, schedule[deviceId] || {}, { [hour]: !(schedule[deviceId] && schedule[deviceId][hour]) });
    this.data.set('schedule', Object.assign({}, schedule, { [deviceId]: deviceSchedule }));
    this.data.set('selectedHour', hour);
    this.data.set('optimized', false);
    this.fire('schedule', this.data.get('schedule'));
  },
  selectHour(hour) {
    this.data.set('selectedHour', hour);
  },
  optimize() {
    const devices = this.data.get('devices') || [];
    const hours = this.data.get('hours') || [];
    const rates = this.data.get('rates') || [];
    const schedule = {};
    devices.forEach((device, deviceIndex) => {
      schedule[device.id] = {};
      hours.forEach((hour, hourIndex) => {
        schedule[device.id][hour] = (hourIndex + deviceIndex * 2) % 5 === 0 && rates[hourIndex] < 0.7;
      });
    });
    this.data.set('schedule', schedule);
    this.data.set('optimized', true);
    this.fire('optimize', { schedule, cost: this.data.get('totalCost') });
  },
  updateScenarioName(event) {
    this.data.set('scenarioName', event.target.value);
  },
  saveScenario() {
    const scenarioName = this.data.get('scenarioName');
    const totalCost = this.data.get('totalCost');
    const peakLoad = this.data.get('peakLoad');
    const schedule = this.data.get('schedule');
    const savedScenarios = this.data.get('savedScenarios') || [];
    const scenario = {
      id: Date.now(),
      name: scenarioName,
      cost: totalCost,
      peak: peakLoad,
      schedule: JSON.parse(JSON.stringify(schedule))
    };
    this.data.set('savedScenarios', [scenario].concat(savedScenarios).slice(0, 4));
    this.fire('save', scenario);
  },
  slotClass(deviceId, hour) {
    const schedule = this.data.get('schedule') || {};
    return schedule[deviceId] && schedule[deviceId][hour] ? 'on' : 'off';
  },
  loadStyle(load) {
    const capacity = this.data.get('capacity') || 1;
    return 'height:' + Math.min(100, load / capacity * 100) + '%';
  }
});
</script>

<style>
.energy-load-scheduler{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}
.energy-load-scheduler *{box-sizing:border-box}
.energy-load-scheduler h2,.energy-load-scheduler h3,.energy-load-scheduler p{margin-top:0}
.energy-load-scheduler button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}
.energy-load-scheduler button.primary{border-color:#059669;background:#059669;color:#fff}
.energy-load-scheduler button:disabled{opacity:.45;cursor:not-allowed}
.energy-load-scheduler input,.energy-load-scheduler select,.energy-load-scheduler textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}
.energy-load-scheduler .muted{color:#71808e;font-size:12px}
.energy-load-scheduler .toolbar,.energy-load-scheduler .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
header{display:flex;justify-content:space-between}.energy-layout{display:grid;grid-template-columns:1fr 220px;gap:14px}.matrix-head,.device-row{display:grid;grid-template-columns:130px repeat(8,1fr);gap:4px;margin-bottom:4px}.matrix-head button.active{background:#d1fae5}.device-row strong{display:grid}.device-row button.on{background:#059669;color:white}.device-row button.off{background:#f1f5f9;color:#94a3b8}.load-chart{height:130px;display:flex;align-items:flex-end;gap:8px;padding:16px 8px 0;border-bottom:1px solid}.load-chart i{flex:1;min-height:3px;background:#34d399;position:relative}.load-chart i.over{background:#ef4444}.load-chart span{position:absolute;top:-16px;font-size:10px}.energy-layout aside{padding:12px;background:#f8fafc}.energy-layout aside input,.energy-layout aside button{width:100%;margin:5px 0}.warn{color:#b91c1c}
</style>
