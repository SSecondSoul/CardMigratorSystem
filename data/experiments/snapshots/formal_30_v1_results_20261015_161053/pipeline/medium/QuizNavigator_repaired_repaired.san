<template>
<section class="quiz-navigator">
    <header>
        <div>
            <span class="eyebrow">知识测验</span>
            <h2>{{title}}</h2>
        </div>
        <span>{{answeredCount}}/{{questions.length}}</span>
    </header>
    <div class="quiz-progress">
        <span style="{{'width: ' + progress + '%'}}"></span>
    </div>
    <div class="question-panel" s-if="{{!finished}}">
        <small>第 {{currentIndex + 1}} 题</small>
        <h3>{{currentQuestion.prompt}}</h3>
        <div class="option-list">
            <button type="button" s-for="option in currentQuestion.options trackby option" class="{{answers[currentQuestion.id] === option ? 'selected' : ''}}" on-click="choose(option)">{{option}}</button>
        </div>
        <footer>
            <button type="button" disabled="{{currentIndex === 0}}" on-click="previous">上一题</button>
            <button type="button" s-if="{{currentIndex < questions.length - 1}}" on-click="next">下一题</button>
            <button type="button" s-else on-click="finish">提交答案</button>
        </footer>
    </div>
    <div class="result-panel" s-else>
        <strong>{{score}} / {{questions.length}}</strong>
        <p>测验已完成，可重新作答。</p>
        <button type="button" on-click="restart">重新开始</button>
    </div>
</section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
    name: 'QuizNavigator',
    dataTypes: {
        title: DataTypes.string,
        questions: DataTypes.array
    },
    initData() {
        return {
            currentIndex: 0,
            answers: {},
            finished: false
        };
    },
    computed: {
        currentQuestion() {
            const questions = this.data.get('questions') || [];
            const currentIndex = this.data.get('currentIndex') || 0;
            return questions[currentIndex];
        },
        answeredCount() {
            const answers = this.data.get('answers') || {};
            return Object.keys(answers).length;
        },
        score() {
            const questions = this.data.get('questions') || [];
            const answers = this.data.get('answers') || {};
            return questions.filter(question => answers[question.id] === question.answer).length;
        },
        progress() {
            const answeredCount = this.data.get('answeredCount') || 0;
            const questions = this.data.get('questions') || [];
            const len = questions.length;
            return len ? Math.round((answeredCount / len) * 100) : 0;
        }
    },
    choose(option) {
        const currentQuestion = this.data.get('currentQuestion');
        const answers = this.data.get('answers');
        const newAnswers = { ...answers };
        newAnswers[currentQuestion.id] = option;
        this.data.set('answers', newAnswers);
    },
    previous() {
        const currentIndex = this.data.get('currentIndex');
        this.data.set('currentIndex', Math.max(0, currentIndex - 1));
    },
    next() {
        const currentIndex = this.data.get('currentIndex');
        const questions = this.data.get('questions') || [];
        this.data.set('currentIndex', Math.min(questions.length - 1, currentIndex + 1));
    },
    finish() {
        this.data.set('finished', true);
    },
    restart() {
        this.data.set('currentIndex', 0);
        this.data.set('answers', {});
        this.data.set('finished', false);
    }
});
</script>

<style>
.quiz-navigator { width: 520px; padding: 22px; border: 1px solid #d1d5db; border-radius: 7px; background: #fdfdfd; color: #1f2937; font-family: Arial, sans-serif; }
.quiz-navigator header { display: flex; justify-content: space-between; align-items: flex-start; }
.quiz-navigator h2 { margin: 3px 0 0; font-size: 21px; }
.eyebrow, .question-panel small { color: #6b7280; font-size: 12px; }
.quiz-progress { height: 6px; margin: 16px 0 20px; background: #e5e7eb; }
.quiz-progress span { display: block; height: 100%; background: #7c3aed; transition: width 0.2s ease; }
.question-panel h3 { min-height: 48px; }
.option-list { display: grid; gap: 8px; }
.option-list button { padding: 10px; border: 1px solid #c4b5fd; border-radius: 4px; background: #ffffff; cursor: pointer; text-align: left; }
.option-list button.selected { border-color: #7c3aed; background: #ede9fe; }
.question-panel footer { display: flex; justify-content: space-between; margin-top: 18px; }
.question-panel footer button, .result-panel button { padding: 8px 12px; border: 1px solid #6d28d9; background: #6d28d9; color: #ffffff; cursor: pointer; }
.result-panel { padding: 30px; text-align: center; background: #f5f3ff; }
.result-panel strong { font-size: 30px; color: #5b21b6; }
</style>
