<template>
<section class="workflow-diagram-editor">
  <header>
    <div>
      <small>图校验 · {{validationErrors.length}} 个问题</small>
      <h2>{{title}}</h2>
    </div>
    <div>
      <button disabled="{{!undoStack.length}}" on-click="undo">撤销</button>
      <button class="primary" disabled="{{!canRun}}" on-click="run">模拟运行</button>
    </div>
  </header>
  <nav>
    <button s-for="type in nodeTypes" key="{{type}}" on-click="addNode(type)">新增 {{type}}</button>
    <span>连线：{{edgeSummary || '暂无'}}</span>
  </nav>
  <div class="diagram-layout">
    <main class="canvas">
      <article s-for="node in nodes" key="{{node.id}}" class="{{(selectedId === node.id ? 'selected ' : '') + (node.enabled ? '' : 'disabled')}}" style="{{nodeStyle(node)}}" on-click="selectNode(node.id)">
        <strong>{{node.label}}</strong>
        <small>{{node.type}} #{{node.id}}</small>
        <button on-click="beginConnect(node.id)">{{connectFrom === node.id ? '选择目标' : '连线'}}</button>
      </article>
    </main>
    <aside>
      <h3>节点属性</h3>
      <div s-if="selectedNode">
        <strong>{{selectedNode.label}}</strong>
        <p>位置 {{selectedNode.x}}, {{selectedNode.y}}</p>
        <div class="nudge">
          <button on-click="nudgeNode(selectedNode.id, -5, 0)">←</button>
          <button on-click="nudgeNode(selectedNode.id, 0, -5)">↑</button>
          <button on-click="nudgeNode(selectedNode.id, 0, 5)">↓</button>
          <button on-click="nudgeNode(selectedNode.id, 5, 0)">→</button>
        </div>
        <button on-click="toggleNode(selectedNode.id)">{{selectedNode.enabled ? '停用' : '启用'}}</button>
      </div>
      <ul>
        <li s-for="error in validationErrors" key="{{error}}">{{error}}</li>
      </ul>
    </aside>
  </div>
  <footer>
    <span s-for="entry in runLog" key="{{entry.id}}">{{entry.text}}</span>
  </footer>
</section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'WorkflowDiagramEditor',
  dataTypes: {
    title: DataTypes.string,
    initialNodes: DataTypes.array,
    initialEdges: DataTypes.array,
    nodeTypes: DataTypes.array,
    readonly: DataTypes.bool
  },
  initData() {
    return {
      nodes: [],
      edges: [],
      selectedId: null,
      connectFrom: null,
      undoStack: [],
      validationErrors: [],
      runLog: [],
      nextId: 10
    };
  },
  inited() {
    const initialNodes = this.data.get('initialNodes') || [];
    const initialEdges = this.data.get('initialEdges') || [];
    this.data.set('nodes', initialNodes.map(item => Object.assign({}, item)));
    this.data.set('edges', initialEdges.map(item => Object.assign({}, item)));
    this.validateGraph();
  },
  computed: {
    selectedNode() {
      const nodes = this.data.get('nodes');
      const selectedId = this.data.get('selectedId');
      return nodes.find(item => item.id === selectedId) || null;
    },
    enabledNodes() {
      const nodes = this.data.get('nodes');
      return nodes.filter(item => item.enabled);
    },
    canRun() {
      const validationErrors = this.data.get('validationErrors');
      const nodes = this.data.get('nodes');
      return validationErrors.length === 0 && nodes.length > 1;
    },
    edgeSummary() {
      const edges = this.data.get('edges');
      return edges.map(edge => edge.from + '→' + edge.to).join('，');
    }
  },
  setValue(key, value) {
    this.data.set(key, value);
  },
  emitEvent(name, payload) {
    this.fire(name, payload);
  },
  snapshot() {
    const nodes = this.data.get('nodes');
    const edges = this.data.get('edges');
    const undoStack = this.data.get('undoStack');
    const newUndoStack = [{ 
      nodes: nodes.map(item => Object.assign({}, item)), 
      edges: edges.map(item => Object.assign({}, item)) 
    }].concat(undoStack).slice(0, 8);
    this.data.set('undoStack', newUndoStack);
  },
  selectNode(id) {
    this.data.set('selectedId', id);
  },
  addNode(type) {
    if (this.data.get('readonly')) return;
    this.snapshot();
    const id = this.data.get('nextId');
    const nodes = this.data.get('nodes');
    const newNode = { 
      id, 
      label: '新' + type, 
      type, 
      x: 12 + id * 5 % 70, 
      y: 15 + id * 9 % 60, 
      enabled: true 
    };
    this.data.set('nodes', nodes.concat(newNode));
    this.data.set('nextId', id + 1);
    this.validateGraph();
  },
  nudgeNode(id, dx, dy) {
    if (this.data.get('readonly')) return;
    this.snapshot();
    const nodes = this.data.get('nodes');
    const newNodes = nodes.map(node => {
      if (node.id === id) {
        const newX = Math.max(0, Math.min(86, node.x + dx));
        const newY = Math.max(0, Math.min(75, node.y + dy));
        return Object.assign({}, node, { x: newX, y: newY });
      }
      return node;
    });
    this.data.set('nodes', newNodes);
    this.emitEvent('graph-change', { nodes: newNodes, edges: this.data.get('edges') });
  },
  beginConnect(id) {
    const connectFrom = this.data.get('connectFrom');
    if (connectFrom === null) {
      this.data.set('connectFrom', id);
      return;
    }
    if (connectFrom !== id) {
      const edges = this.data.get('edges');
      const exists = edges.some(edge => edge.from === connectFrom && edge.to === id);
      if (!exists) {
        this.snapshot();
        this.data.set('edges', edges.concat({ from: connectFrom, to: id }));
      }
    }
    this.data.set('connectFrom', null);
    this.validateGraph();
  },
  toggleNode(id) {
    this.snapshot();
    const nodes = this.data.get('nodes');
    const newNodes = nodes.map(node => {
      if (node.id === id) {
        return Object.assign({}, node, { enabled: !node.enabled });
      }
      return node;
    });
    this.data.set('nodes', newNodes);
    this.validateGraph();
  },
  validateGraph() {
    const nodes = this.data.get('nodes');
    const edges = this.data.get('edges');
    const ids = nodes.map(item => item.id);
    const incoming = {};
    edges.forEach(edge => { incoming[edge.to] = true; });
    const errors = [];
    if (!nodes.some(item => item.type === 'trigger')) {
      errors.push('缺少触发节点');
    }
    nodes.forEach((node, index) => {
      if (index && !incoming[node.id]) {
        errors.push(node.label + ' 没有入边');
      }
    });
    if (edges.some(edge => ids.indexOf(edge.from) < 0 || ids.indexOf(edge.to) < 0)) {
      errors.push('存在悬空连线');
    }
    this.data.set('validationErrors', errors);
    this.emitEvent('validate', errors);
  },
  run() {
    if (!this.data.get('canRun')) return;
    const enabledNodes = this.data.get('enabledNodes');
    const runLog = enabledNodes.map((node, index) => ({ id: index + 1, text: '执行：' + node.label }));
    this.data.set('runLog', runLog);
    this.emitEvent('run', enabledNodes);
  },
  undo() {
    const undoStack = this.data.get('undoStack');
    if (!undoStack.length) return;
    const previous = undoStack[0];
    this.data.set('nodes', previous.nodes);
    this.data.set('edges', previous.edges);
    this.data.set('undoStack', undoStack.slice(1));
    this.validateGraph();
  },
  nodeStyle(node) {
    return 'left:' + node.x + '%;top:' + node.y + '%';
  }
});
</script>

<style>
.workflow-diagram-editor{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}
.workflow-diagram-editor *{box-sizing:border-box}
.workflow-diagram-editor h2,.workflow-diagram-editor h3,.workflow-diagram-editor p{margin-top:0}
.workflow-diagram-editor button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}
.workflow-diagram-editor button.primary{border-color:#7c3aed;background:#7c3aed;color:#fff}
.workflow-diagram-editor button:disabled{opacity:.45;cursor:not-allowed}
.workflow-diagram-editor input,.workflow-diagram-editor select,.workflow-diagram-editor textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}
.workflow-diagram-editor .muted{color:#71808e;font-size:12px}
.workflow-diagram-editor .toolbar,.workflow-diagram-editor .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
header,nav{display:flex;justify-content:space-between;gap:8px;align-items:center}.diagram-layout{display:grid;grid-template-columns:1fr 210px;gap:12px;margin-top:12px}.canvas{position:relative;min-height:360px;background:linear-gradient(#eef2ff 1px,transparent 1px),linear-gradient(90deg,#eef2ff 1px,transparent 1px);background-size:24px 24px}.canvas article{position:absolute;width:130px;padding:10px;background:white;border:2px solid #a5b4fc;border-radius:10px}.canvas article.selected{border-color:#4f46e5;box-shadow:0 0 0 3px #e0e7ff}.canvas article.disabled{opacity:.45}.canvas small,.canvas button{display:block;margin-top:5px}.diagram-layout aside{padding:12px;background:#f8fafc}.nudge{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}.diagram-layout ul{padding-left:18px;color:#b91c1c}footer{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}footer span{padding:5px 8px;background:#ecfdf5}
</style>
