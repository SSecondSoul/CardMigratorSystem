<template>
<section class="incident-response-board">
  <header class="incident-head">
    <div>
      <span class="{{'severity ' + severity}}">{{severity}}</span>
      <small>{{incidentId}}</small>
      <h2>{{serviceName}}异常</h2>
    </div>
    <div>
      <strong>{{elapsedLabel}}</strong>
      <button on-click="escalate" disabled="{{status === 'resolved'}}">升级</button>
    </div>
  </header>
  <div class="stage-track">
    <div s-for="stage, index in stages trackby stage" class="{{index === stageIndex ? 'active' : ''}} {{index < stageIndex ? 'done' : ''}}">
      <i></i>
      <span>{{statusText(stage)}}</span>
    </div>
  </div>
  <div class="response-grid">
    <main>
      <div class="owner-card">
        <div>
          <span>事件负责人</span>
          <strong>{{owner || '尚未认领'}}</strong>
        </div>
        <button on-click="claim">{{owner ? '释放' : '认领'}}</button>
      </div>
      <section class="check-panel">
        <h3>处置检查项 {{completedChecks}}/{{checklist.length}}</h3>
        <label s-for="item in checklist trackby item.id" class="{{item.done ? 'done' : ''}}">
          <input type="checkbox" checked="{{item.done}}" on-change="toggleCheck(item.id)">
          {{item.text}}
        </label>
      </section>
      <div class="actions">
        <button on-click="advance">推进阶段</button>
        <button class="primary" on-click="resolve" disabled="{{!canResolve}}">关闭事件</button>
      </div>
    </main>
    <aside>
      <h3>响应时间线</h3>
      <form on-submit="addNote">
        <textarea placeholder="记录处置进展" value="{{note}}" on-input="updateNote"></textarea>
        <button type="submit">添加</button>
      </form>
      <ol>
        <li s-for="entry in timeline trackby entry.id">
          <time>{{entry.time}}</time>
          <span>{{entry.text}}</span>
        </li>
      </ol>
    </aside>
  </div>
</section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'IncidentResponseBoard',

  dataTypes: {
    incidentId: DataTypes.string,
    serviceName: DataTypes.string,
    initialSeverity: DataTypes.string
  },

  initData() {
    return {
      status: 'detected',
      severity: 'P1',
      owner: '',
      elapsed: 0,
      checklist: [
        { id: 1, text: '确认监控告警', done: true },
        { id: 2, text: '隔离异常节点', done: false },
        { id: 3, text: '通知业务负责人', done: false }
      ],
      timeline: [
        { id: 1, time: '09:20', text: '监控触发错误率告警' }
      ],
      note: '',
      timer: null,
      stages: ['detected', 'triage', 'mitigation', 'resolved'],
      incidentId: 'INC-2048',
      serviceName: '支付网关',
      initialSeverity: 'P1'
    };
  },

  computed: {
    stageIndex() {
      return this.data.get('stages').indexOf(this.data.get('status'));
    },
    completedChecks() {
      return this.data.get('checklist').filter(item => item.done).length;
    },
    canResolve() {
      const owner = this.data.get('owner');
      const completed = this.data.get('completedChecks');
      const checklist = this.data.get('checklist');
      return !!owner && completed === checklist.length;
    },
    elapsedLabel() {
      const elapsed = this.data.get('elapsed');
      return Math.floor(elapsed / 60) + 'h ' + (elapsed % 60) + 'm';
    }
  },

  inited() {
    this.data.set('severity', this.data.get('initialSeverity') || 'P1');
  },

  attached() {
    this._timer = setInterval(() => {
      const elapsed = this.data.get('elapsed');
      this.data.set('elapsed', elapsed + 1);
    }, 60000);
  },

  disposed() {
    if (this._timer) {
      clearInterval(this._timer);
      this._timer = null;
    }
  },

  setValue(key, value) {
    this.data.set(key, value);
  },

  emitEvent(name, payload) {
    this.fire(name, payload);
  },

  claim() {
    const owner = this.data.get('owner');
    const newOwner = owner ? '' : '当前值班员';
    this.data.set('owner', newOwner);
    const text = owner ? '事件已认领' : '已取消认领';
    this.addTimeline(text);
  },

  advance() {
    const index = this.data.get('stageIndex');
    const stages = this.data.get('stages');
    if (index >= stages.length - 1) return;
    const next = stages[index + 1];
    this.data.set('status', next);
    this.addTimeline('推进至' + this.statusText(next));
    this.fire('status-change', next);
  },

  toggleCheck(id) {
    const checklist = this.data.get('checklist');
    const updated = checklist.map(item =>
      item.id === id ? Object.assign({}, item, { done: !item.done }) : item
    );
    this.data.set('checklist', updated);
  },

  updateNote(event) {
    this.data.set('note', event.target.value);
  },

  addNote(event) {
    event.preventDefault();
    const text = this.data.get('note').trim();
    if (!text) return;
    this.addTimeline(text);
    this.data.set('note', '');
  },

  escalate() {
    const severity = this.data.get('severity');
    const next = severity === 'P2' ? 'P1' : 'P0';
    this.data.set('severity', next);
    this.addTimeline('严重度升级为 ' + next);
    this.fire('escalate', next);
  },

  resolve() {
    if (!this.data.get('canResolve')) return;
    this.data.set('status', 'resolved');
    this.addTimeline('事件已关闭');
    this.fire('resolve', {
      id: this.data.get('incidentId'),
      elapsed: this.data.get('elapsed')
    });
  },

  addTimeline(text) {
    const now = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
    const timeline = this.data.get('timeline');
    const newItem = { id: Date.now(), time: now, text };
    this.data.set('timeline', [newItem].concat(timeline));
  },

  statusText(status) {
    const map = { detected: '已发现', triage: '排查中', mitigation: '处置中', resolved: '已恢复' };
    return map[status] || status;
  }
});
</script>

<style>
.incident-response-board { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }
.incident-response-board * { box-sizing: border-box; }
.incident-response-board h2, .incident-response-board h3, .incident-response-board p { margin-top: 0; }
.incident-response-board h2 { margin-bottom: 14px; font-size: 21px; }
.incident-response-board button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }
.incident-response-board button.primary { border-color: #b91c1c; background: #b91c1c; color: #fff; }
.incident-response-board button:disabled { opacity: .45; cursor: not-allowed; }
.incident-response-board input, .incident-response-board select, .incident-response-board textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }
.incident-response-board .toolbar, .incident-response-board .summary, .incident-response-board .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.incident-response-board .muted { color: #71808e; font-size: 12px; }
.incident-response-board .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }
.incident-head{display:flex;justify-content:space-between}.severity{padding:4px 7px;background:#fee2e2;color:#991b1b}.severity.P0{background:#991b1b;color:#fff}.stage-track{display:grid;grid-template-columns:repeat(4,1fr);margin:18px 0}.stage-track div{display:grid;gap:5px;text-align:center}.stage-track i{height:6px;background:#d9dee3}.stage-track .active i,.stage-track .done i{background:#b91c1c}.response-grid{display:grid;grid-template-columns:1fr 280px;gap:14px}.owner-card{display:flex;justify-content:space-between;padding:14px;background:#f8fafc}.check-panel{margin:12px 0;padding:14px;border:1px solid #e2e5e9}.check-panel label{display:block;padding:7px}.check-panel label.done{text-decoration:line-through;color:#77818b}aside{padding:12px;background:#f8fafc}aside textarea{width:100%}aside ol{padding:0;list-style:none}aside li{display:grid;grid-template-columns:48px 1fr;gap:7px;padding:8px 0}
</style>
