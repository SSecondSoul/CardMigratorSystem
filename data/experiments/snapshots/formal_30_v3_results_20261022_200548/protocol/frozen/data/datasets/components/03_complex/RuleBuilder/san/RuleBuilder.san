<template>
  <main class="rule-builder">
    <header class="builder-header">
      <div><span class="eyebrow">自动化配置</span><h1>{{ title }}</h1><p>将业务条件组合为可执行规则</p></div>
      <div class="header-actions">
        <button type="button" class="secondary" on-click="togglePreview">{{ previewOpen ? '关闭预览' : '预览表达式' }}</button>
        <button type="button" disabled="{{ readonly || invalidRuleCount > 0 }}" on-click="save">保存规则</button>
      </div>
    </header>
    <section class="builder-stats">
      <article><span>条件组</span><strong>{{ groups.length }}</strong></article>
      <article><span>规则数</span><strong>{{ ruleCount }}</strong></article>
      <article class="{{ invalidRuleCount ? 'warning' : '' }}"><span>待修正</span><strong>{{ invalidRuleCount }}</strong></article>
    </section>
    <section class="builder-workspace">
      <aside class="group-sidebar">
        <div class="sidebar-title"><strong>条件组</strong><button type="button" disabled="{{ readonly }}" on-click="addGroup">+</button></div>
        <button
          s-for="group in groups"
          type="button"
          class="group-tab {{ selectedGroupId === group.id ? 'active' : '' }}"
          on-click="selectGroup(group.id)"
        ><span>{{ group.name }}</span><small>{{ group.rules.length }} 条</small></button>
      </aside>
      <div s-if="selectedGroup" class="group-editor">
        <div class="group-toolbar">
          <input value="{{ selectedGroup.name }}" disabled="{{ readonly }}" on-input="renameGroup($event.target.value)" />
          <select value="{{ selectedGroup.mode }}" disabled="{{ readonly }}" on-change="changeMode($event.target.value)">
            <option value="all">满足全部</option><option value="any">满足任一</option>
          </select>
          <button type="button" disabled="{{ readonly || groups.length === 1 }}" on-click="removeGroup(selectedGroup.id)">删除组</button>
        </div>
        <div class="rule-list">
          <article s-for="rule, index in selectedGroup.rules" class="rule-row {{ !rule.value ? 'invalid' : '' }}">
            <span class="rule-index">{{ index + 1 }}</span>
            <select value="{{ rule.field }}" disabled="{{ readonly }}" on-change="updateRule(rule.id, 'field', $event.target.value)">
              <option s-for="field in availableFields" value="{{ field.key }}">{{ field.label }}</option>
            </select>
            <select value="{{ rule.operator }}" disabled="{{ readonly }}" on-change="updateRule(rule.id, 'operator', $event.target.value)">
              <option value="equals">等于</option><option value="contains">包含</option><option value="greater">大于</option>
            </select>
            <input value="{{ rule.value }}" disabled="{{ readonly }}" placeholder="比较值" on-input="updateRule(rule.id, 'value', $event.target.value)" />
            <button type="button" disabled="{{ readonly }}" on-click="removeRule(rule.id)">移除</button>
          </article>
        </div>
        <button type="button" class="add-rule" disabled="{{ readonly }}" on-click="addRule">添加条件</button>
      </div>
      <div s-else class="empty-editor">请选择条件组</div>
    </section>
    <section s-if="previewOpen" class="expression-preview">
      <div><strong>逻辑表达式</strong><button type="button" on-click="validate">重新校验</button></div>
      <code>{{ expression }}</code>
      <ul s-if="errors.length"><li s-for="error in errors">{{ error }}</li></ul>
      <p s-else>表达式校验通过</p>
    </section>
    <footer class="builder-footer"><span>最近保存：{{ savedAt || '尚未保存' }}</span><span>{{ readonly ? '只读模式' : '自动保存已开启' }}</span></footer>
  </main>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'RuleBuilder',
  dataTypes: {
    title: DataTypes.string,
    availableFields: DataTypes.array,
    initialGroups: DataTypes.array,
    readonly: DataTypes.bool
  },
  initData() {
    return {
      title: '客户分群规则',
      availableFields: [{ key: 'region', label: '地区' }, { key: 'score', label: '活跃分' }, { key: 'tag', label: '标签' }],
      initialGroups: [
        { id: 1, name: '基础条件', mode: 'all', rules: [{ id: 1, field: 'region', operator: 'equals', value: '西南' }] },
        { id: 2, name: '行为条件', mode: 'any', rules: [{ id: 2, field: 'score', operator: 'greater', value: '80' }] }
      ],
      readonly: false,
      groups: [],
      selectedGroupId: 0,
      previewOpen: false,
      errors: [],
      nextGroupId: 3,
      nextRuleId: 3,
      savedAt: '',
      autosaveTimer: null,
      draftName: '',
      testPayload: {}
    };
  },
  inited() {
    const groups = JSON.parse(JSON.stringify(this.data.get('initialGroups')));
    this.data.set('groups', groups);
    this.data.set('selectedGroupId', groups.length ? groups[0].id : 0);
  },
  computed: {
    selectedGroup() { return this.data.get('groups').find((group) => group.id === this.data.get('selectedGroupId')); },
    ruleCount() { return this.data.get('groups').reduce((sum, group) => sum + group.rules.length, 0); },
    invalidRuleCount() { return this.data.get('groups').reduce((sum, group) => sum + group.rules.filter((rule) => !String(rule.value).trim()).length, 0); },
    expression() {
      return this.data.get('groups').map((group) => {
        const joiner = group.mode === 'all' ? ' AND ' : ' OR ';
        return `(${group.rules.map((rule) => `${rule.field} ${rule.operator} "${rule.value}"`).join(joiner)})`;
      }).join(' AND ');
    }
  },
  attached() { this.validate(); this.scheduleAutosave(); },
  disposed() { clearTimeout(this.data.get('autosaveTimer')); },
  selectGroup(id) { this.data.set('selectedGroupId', id); },
  addGroup() {
    const groups = this.data.get('groups').slice();
    const group = { id: this.data.get('nextGroupId'), name: `条件组 ${groups.length + 1}`, mode: 'all', rules: [] };
    groups.push(group);
    this.data.set('groups', groups);
    this.data.set('nextGroupId', group.id + 1);
    this.data.set('selectedGroupId', group.id);
    this.changed();
  },
  removeGroup(id) {
    const groups = this.data.get('groups').filter((group) => group.id !== id);
    this.data.set('groups', groups);
    this.data.set('selectedGroupId', groups.length ? groups[0].id : 0);
    this.changed();
  },
  updateSelectedGroup(updater) {
    const selectedId = this.data.get('selectedGroupId');
    this.data.set('groups', this.data.get('groups').map((group) => group.id === selectedId ? updater(group) : group));
  },
  renameGroup(value) { this.updateSelectedGroup((group) => Object.assign({}, group, { name: value })); this.changed(); },
  changeMode(value) { this.updateSelectedGroup((group) => Object.assign({}, group, { mode: value })); this.changed(); },
  addRule() {
    const id = this.data.get('nextRuleId');
    const field = this.data.get('availableFields')[0].key;
    this.updateSelectedGroup((group) => Object.assign({}, group, { rules: group.rules.concat({ id: id, field: field, operator: 'equals', value: '' }) }));
    this.data.set('nextRuleId', id + 1);
    this.changed();
  },
  removeRule(id) {
    this.updateSelectedGroup((group) => Object.assign({}, group, { rules: group.rules.filter((rule) => rule.id !== id) }));
    this.changed();
  },
  updateRule(id, key, value) {
    this.updateSelectedGroup((group) => Object.assign({}, group, {
      rules: group.rules.map((rule) => rule.id === id ? Object.assign({}, rule, { [key]: value }) : rule)
    }));
    this.changed();
  },
  validate() {
    const errors = [];
    this.data.get('groups').forEach((group) => {
      if (!group.name.trim()) errors.push('条件组名称不能为空');
      group.rules.forEach((rule) => { if (!String(rule.value).trim()) errors.push(`${group.name} 存在空比较值`); });
    });
    this.data.set('errors', errors);
    return !errors.length;
  },
  changed() { this.validate(); this.scheduleAutosave(); },
  scheduleAutosave() {
    clearTimeout(this.data.get('autosaveTimer'));
    if (!this.data.get('readonly')) {
      this.data.set('autosaveTimer', setTimeout(() => this.data.set('savedAt', '自动保存完成'), 400));
    }
  },
  save() {
    if (!this.validate()) return;
    this.data.set('savedAt', new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }));
    this.fire('save', { groups: JSON.parse(JSON.stringify(this.data.get('groups'))), expression: this.data.get('expression') });
  },
  togglePreview() { this.data.set('previewOpen', !this.data.get('previewOpen')); }
});
</script>

<style>
.rule-builder { width: 820px; padding: 24px; border: 1px solid #cbd5e1; border-radius: 7px; background: #f8fafc; color: #172026; font-family: Arial, sans-serif; }
.builder-header { display: flex; justify-content: space-between; gap: 24px; }
.builder-header h1 { margin: 3px 0; font-size: 24px; }
.builder-header p, .eyebrow { color: #64748b; font-size: 12px; }
.header-actions { display: flex; gap: 8px; }
.rule-builder button { padding: 8px 11px; border: 1px solid #334155; border-radius: 4px; background: #334155; color: #ffffff; cursor: pointer; }
.rule-builder button.secondary, .group-toolbar button, .rule-row button { background: #ffffff; color: #334155; border-color: #94a3b8; }
.builder-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px 0; }
.builder-stats article { padding: 12px; border-left: 3px solid #0f766e; background: #ffffff; }
.builder-stats article.warning { border-left-color: #dc2626; }
.builder-stats span { display: block; color: #64748b; font-size: 12px; }
.builder-stats strong { font-size: 22px; }
.builder-workspace { display: grid; grid-template-columns: 180px 1fr; min-height: 310px; border: 1px solid #d1d5db; background: #ffffff; }
.group-sidebar { padding: 12px; border-right: 1px solid #e2e8f0; background: #f1f5f9; }
.sidebar-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.group-tab { width: 100%; display: flex; justify-content: space-between; margin-bottom: 6px; background: #ffffff !important; color: #334155 !important; border-color: #cbd5e1 !important; text-align: left; }
.group-tab.active { border-color: #0f766e !important; background: #ccfbf1 !important; }
.group-editor { padding: 16px; }
.group-toolbar { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; }
.group-toolbar input, .group-toolbar select, .rule-row input, .rule-row select { padding: 8px; border: 1px solid #94a3b8; }
.rule-list { display: grid; gap: 8px; margin: 16px 0; }
.rule-row { display: grid; grid-template-columns: 28px 1fr 1fr 1fr auto; gap: 7px; padding: 9px; border: 1px solid #e2e8f0; }
.rule-row.invalid { border-color: #fca5a5; background: #fff1f2; }
.rule-index { display: grid; place-items: center; color: #64748b; }
.add-rule { background: #0f766e !important; border-color: #0f766e !important; }
.empty-editor { display: grid; place-items: center; color: #94a3b8; }
.expression-preview { margin-top: 16px; padding: 14px; border: 1px solid #a7f3d0; background: #ecfdf5; }
.expression-preview > div { display: flex; justify-content: space-between; }
.expression-preview code { display: block; margin: 12px 0; white-space: normal; color: #065f46; }
.expression-preview ul { color: #b91c1c; }
.builder-footer { display: flex; justify-content: space-between; margin-top: 14px; color: #64748b; font-size: 12px; }
</style>
