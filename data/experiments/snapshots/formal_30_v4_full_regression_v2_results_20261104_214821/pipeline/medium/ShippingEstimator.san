<template>
<form class="shipping-estimator" on-submit="estimate">
    <h2>配送费用估算</h2>
    <div class="shipping-grid">
        <label>
            目的地区
            <select value="{{regionCode}}" on-change="updateRegion">
                <option s-for="region in regions trackby region.code" value="{{region.code}}">{{region.name}}</option>
            </select>
        </label>
        <label>
            重量（kg）
            <input type="number" min="0" value="{{weight}}" on-input="updateWeight">
        </label>
        <label class="check-line">
             加急配送
            <input type="checkbox" checked="{{express}}" on-change="toggleExpress">
        </label>
    </div>
    <p class="muted">{{weightBand}}</p>
    <p class="error" s-if="error">{{error}}</p>
    <div class="quote" s-if="result">
        <strong>¥{{result.fee}}</strong>
        <span>预计 {{result.days}} 天送达</span>
    </div>
    <div class="actions">
        <button type="button" on-click="reset">重置</button>
        <button class="primary" type="submit">计算运费</button>
    </div>
</form>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

function findRegion(regions, code) {
    for (let i = 0; i < regions.length; i++) {
        if (regions[i].code === code) {
            return regions[i];
        }
    }
    return regions[0] || null;
}

function computeWeightBand(weight) {
    return weight <= 1 ? '首重' : '续重 ' + Math.ceil(weight - 1) + ' kg';
}

function computeFee(region, weight, express) {
    const base = region.base || 0;
    const extra = Math.max(0, Math.ceil(weight - 1)) * 5;
    const fee = (base + extra) * (express ? 1.5 : 1);
    return fee.toFixed(2);
}

function computeDays(express, regionCode) {
    if (express) return 1;
    if (regionCode === 'remote') return 5;
    return 3;
}

module.exports = san.defineComponent({
    name: 'ShippingEstimator',
    components: {},
    initData() {
        return {
            regionCode: 'near',
            weight: 1,
            express: false,
            result: null,
            error: ''
        };
    },
    dataTypes: {
        regions: DataTypes.array
    },
    inited() {
        const regions = this.data.get('regions');
        if (!regions || !Array.isArray(regions) || regions.length === 0) {
            this.data.set('regions', [
                { code: 'near', name: '同城', base: 8 },
                { code: 'domestic', name: '国内', base: 16 },
                { code: 'remote', name: '偏远', base: 28 }
            ]);
        }
    },
    computed: {
        selectedRegion() {
            const regions = this.data.get('regions');
            const regionCode = this.data.get('regionCode');
            return findRegion(regions, regionCode);
        },
        weightBand() {
            const weight = this.data.get('weight');
            return computeWeightBand(weight);
        }
    },
    setValue(key, value) {
        this.data.set(key, value);
    },
    emitEvent(name, payload) {
        this.fire(name, payload);
    },
    updateRegion(event) {
        this.data.set('regionCode', event.target.value);
    },
    updateWeight(event) {
        const val = Number(event.target.value);
        this.data.set('weight', isNaN(val) ? 0 : val);
    },
    toggleExpress(event) {
        this.data.set('express', event.target.checked);
    },
    estimate(event) {
        event.preventDefault();
        const weight = this.data.get('weight');
        if (weight <= 0) {
            this.data.set('error', '重量必须大于 0');
            this.data.set('result', null);
            return;
        }
        const regions = this.data.get('regions');
        const regionCode = this.data.get('regionCode');
        const region = findRegion(regions, regionCode);
        if (!region) return;
        const express = this.data.get('express');
        const fee = computeFee(region, weight, express);
        const days = computeDays(express, regionCode);
        const result = { fee, days };
        this.data.set('error', '');
        this.data.set('result', result);
        this.fire('estimate', result);
    },
    reset() {
        this.data.set('weight', 1);
        this.data.set('express', false);
        this.data.set('result', null);
        this.data.set('error', '');
    }
});
</script>

<style>
.shipping-estimator { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }
.shipping-estimator * { box-sizing: border-box; }
.shipping-estimator h2, .shipping-estimator h3, .shipping-estimator p { margin-top: 0; }
.shipping-estimator h2 { margin-bottom: 14px; font-size: 21px; }
.shipping-estimator button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }
.shipping-estimator button.primary { border-color: #0369a1; background: #0369a1; color: #fff; }
.shipping-estimator button:disabled { opacity: .45; cursor: not-allowed; }
.shipping-estimator input, .shipping-estimator select, .shipping-estimator textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }
.shipping-estimator .toolbar, .shipping-estimator .summary, .shipping-estimator .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.shipping-estimator .muted { color: #71808e; font-size: 12px; }
.shipping-estimator .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }
.shipping-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.shipping-grid label{display:grid;gap:5px}.check-line{display:flex!important;align-items:center}.quote{display:flex;justify-content:space-between;padding:16px;background:#e0f2fe}.quote strong{font-size:24px}.error{color:#b42318}
</style>
