<template>
<div class="task-manager" class="{{isDarkMode ? 'dark-theme' : ''}} {{isCompactMode ? 'compact-mode' : ''}}">
    <header class="app-header">
        <div class="logo-area">
            <span class="logo">✅</span>
            <h1 class="title">智能任务管家</h1>
            <span class="version">v3.0</span>
        </div>
        <div class="header-actions">
            <button class="icon-btn" title="{{isCompactMode ? '展开模式' : '紧凑模式'}}" on-click="toggleCompactMode">{{isCompactMode ? '📐' : '📏'}}</button>
            <button class="icon-btn" title="{{isDarkMode ? '亮色模式' : '暗色模式'}}" on-click="toggleTheme">{{isDarkMode ? '☀️' : '🌙'}}</button>
            <button class="icon-btn" title="导出数据" on-click="exportData">📥</button>
            <button class="icon-btn" title="设置" on-click="showSettings = true">⚙️</button>
        </div>
    </header>
    <div class="stats-section">
        <stat-card s-for="stat in statistics trackby stat.id" label="{{stat.label}}" value="{{stat.value}}" icon="{{stat.icon}}" trend="{{stat.trend}}" color="{{stat.color}}" on-click="onStatClick(stat)"></stat-card>
    </div>
    <div class="main-workspace">
        <div class="tasks-panel">
            <div class="panel-header">
                <h2>📋 任务列表</h2>
                <div class="task-controls">
                    <button class="primary-btn" on-click="openTaskModal">+ 新建任务</button>
                    <div class="search-box">
                        <input type="text" placeholder="搜索任务..." value="{= searchKeyword =}" on-input="onSearchChange"/>
                        <span class="search-icon">🔍</span>
                    </div>
                </div>
            </div>
            <div class="filter-tabs">
                <button class="filter-tab" s-for="filter in filters trackby filter.value" class="{{currentFilter === filter.value ? 'active' : ''}}" on-click="setFilter(filter.value)">{{filter.label}}<span class="count">{{getTaskCount(filter.value, tasks)}}</span></button>
            </div>
            <div class="task-list" on-dragover.prevent="" on-drop="onDropToEnd">
                <task-item s-for="(task, index) in filteredTasks trackby task.id" task="{{task}}" index="{{index}}" draggable="{{true}}" on-toggle="toggleTaskStatus" on-edit="editTask" on-view="selectTask" on-delete="deleteTask" on-drag-start="onDragStart" on-drag-end="onDragEnd" on-drop-on="onDropOnTask"></task-item>
                <div class="empty-state" s-if="filteredTasks.length === 0">
                    <span class="empty-icon">📭</span>
                    <p>暂无任务，创建一个吧！</p>
                </div>
            </div>
        </div>
        <div class="detail-panel" s-if="selectedTask">
            <task-detail task="{{selectedTask}}" on-close="closeDetail" on-update="updateTask" on-comment="addComment"></task-detail>
        </div>
    </div>
    <div class="modal-overlay" s-if="isModalOpen" on-click.self="closeModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>{{editingTask ? '编辑任务' : '新建任务'}}</h3>
                <button class="close-btn" on-click="closeModal">✕</button>
            </div>
            <task-form key="{{editingTask ? editingTask.id : 'new-task'}}" task="{{editingTask}}" users="{{users}}" tags="{{availableTags}}" on-submit="handleTaskSubmit" on-cancel="closeModal"></task-form>
        </div>
    </div>
    <div class="modal-overlay" s-if="showSettings" on-click.self="showSettings = false">
        <div class="modal-content">
            <div class="modal-header">
                <h3>⚙️ 系统设置</h3>
                <button class="close-btn" on-click="showSettings = false">✕</button>
            </div>
            <settings-panel settings="{{settings}}" on-update="updateSettings"></settings-panel>
        </div>
    </div>
    <div class="notification" s-if="notification.show" class="{{notification.type}}">
        <span>{{notification.message}}</span>
        <button on-click="hideNotification">✕</button>
    </div>
</div>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
    name: 'StatCard',
    components: {
        'stat-card': require('./StatCard'),
        'task-item': require('./TaskItem'),
        'task-detail': require('./TaskDetail'),
        'task-form': require('./TaskForm'),
        'settings-panel': require('./SettingsPanel')
    },
    dataTypes: {
        label: DataTypes.string,
        value: DataTypes.string,
        icon: DataTypes.string,
        trend: DataTypes.string,
        color: DataTypes.string
    },
    initData() {
        return {
            newComment: '',
            isDarkMode: false,
            isCompactMode: false,
            statistics: [],
            filters: [],
            currentFilter: 'all',
            searchKeyword: '',
            tasks: [],
            selectedTask: null,
            isModalOpen: false,
            editingTask: null,
            users: [],
            availableTags: [],
            settings: {},
            showSettings: false,
            notification: {
                show: false,
                message: '',
                type: ''
            }
        };
    },
    computed: {
        filteredTasks() {
            let result = [...this.data.get('tasks')];

            if (this.data.get('currentFilter') !== 'all') {
                result = result.filter(task => {
                    switch (this.data.get('currentFilter')) {
                        case 'active': return !task.completed && !this.isOverdue(task);
                        case 'completed': return task.completed;
                        case 'overdue': return this.isOverdue(task) && !task.completed;
                        case 'urgent': return task.priority === 'high' && !task.completed;
                        default: return true;
                    }
                });
            }

            if (this.data.get('searchKeyword')) {
                const keyword = this.data.get('searchKeyword').toLowerCase();
                result = result.filter(task =>
                    task.title.toLowerCase().includes(keyword) ||
                    (task.description && task.description.toLowerCase().includes(keyword))
                );
            }
            
            return result;
        }
    },
    methods: {
        getPriorityLabel(priority) {
            const labels = { high: '高优先级', medium: '中优先级', low: '低优先级' };
            return labels[priority] || priority;
        },
        formatDate(date) {
            if (!date) return '无截止日期';
            const d = new Date(date);
            return `${d.getMonth() + 1}/${d.getDate()}`;
        },
        onDragStart(e) {
            if (!this.data.get('draggable')) return;
            e.dataTransfer.setData('text/plain', this.data.get('index'));
            e.dataTransfer.effectAllowed = 'move';
            this.fire('drag-start', this.data.get('index'));
        },
        onDrop() {
            this.fire('drop-on', this.data.get('index'));
        },
        onDragEnd() {
            this.fire('drag-end');
        },
        toggleCompactMode() {
            this.data.set('isCompactMode', !this.data.get('isCompactMode'));
        },
        toggleTheme() {
            this.data.set('isDarkMode', !this.data.get('isDarkMode'));
        },
        exportData() {
            // stub
        },
        openTaskModal() {
            this.data.set('isModalOpen', true);
            this.data.set('editingTask', null);
        },
        onSearchChange() {
            // stub
        },
        setFilter(value) {
            this.data.set('currentFilter', value);
        },
        onDropToEnd() {
            // stub
        },
        toggleTaskStatus() {
            // stub
        },
        editTask() {
            // stub
        },
        selectTask() {
            // stub
        },
        deleteTask() {
            // stub
        },
        closeDetail() {
            this.data.set('selectedTask', null);
        },
        updateTask() {
            // stub
        },
        addComment() {
            // stub
        },
        closeModal() {
            this.data.set('isModalOpen', false);
            this.data.set('editingTask', null);
        },
        handleTaskSubmit() {
            // stub
        },
        updateSettings() {
            // stub
        },
        hideNotification() {
            this.data.set('notification.show', false);
        },
        showNotification(message, type) {
            this.data.set('notification', {
                show: true,
                message,
                type
            });
        },
        isOverdue(task) {
            if (!task.dueDate) return false;
            const due = new Date(task.dueDate);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            return due < today;
        },
        getTaskCount(filterValue, tasks) {
            const taskList = tasks || this.data.get('tasks');
            switch (filterValue) {
                case 'all': return taskList.length;
                case 'active': return taskList.filter(t => !t.completed && !this.isOverdue(t)).length;
                case 'completed': return taskList.filter(t => t.completed).length;
                case 'overdue': return taskList.filter(t => this.isOverdue(t) && !t.completed).length;
                case 'urgent': return taskList.filter(t => t.priority === 'high' && !t.completed).length;
                default: return 0;
            }
        },
        onStatClick(stat) {
            // stub
        },
        onDropOnTask() {
            // stub
        },
        showSettings() {
            this.data.set('showSettings', true);
        },
        hideSettings() {
            this.data.set('showSettings', false);
        }
    },
    inited() {
        this.watch('task', function (task) {
            this.data.set('formData', this.createFormData(task));
        });
    },
    attached() {
        this.loadInitialData();
        this.startAutoSync();
        this.showNotification('系统初始化完成', 'success');
    },
    disposed() {
        if (this.syncTimer) {
            clearInterval(this.syncTimer);
        }
        this.saveToLocalStorage();
    },
    loadInitialData() {
        // stub
    },
    startAutoSync() {
        // stub
    },
    saveToLocalStorage() {
        // stub
    },
    createFormData(task) {
        // stub
        return {};
    }
});
</script>

<style>
/* 主容器 */
.task-manager {
  max-width: 1400px;
  margin: 0 auto;
  padding: 20px;
  background: #f7f9fc;
  min-height: 100vh;
  transition: all 0.3s ease;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.task-manager.dark-theme {
  background: #1a1a2e;
  color: #e0e0e0;
}

.task-manager.compact-mode {
  padding: 12px;
}

