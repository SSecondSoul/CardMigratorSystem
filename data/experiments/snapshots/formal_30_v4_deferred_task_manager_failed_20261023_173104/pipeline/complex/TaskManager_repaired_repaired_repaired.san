  font-size: 20px;
  cursor: pointer;
}

.detail-content {
  flex: 1;
}

.detail-field {
  margin-bottom: 16px;
}

.detail-field label {
  font-weight: 600;
  font-size: 12px;
  color: #64748b;
  display: block;
  margin-bottom: 4px;
}

.field-value {
  font-size: 14px;
}

.detail-tag {
  display: inline-block;
  padding: 4px 8px;
