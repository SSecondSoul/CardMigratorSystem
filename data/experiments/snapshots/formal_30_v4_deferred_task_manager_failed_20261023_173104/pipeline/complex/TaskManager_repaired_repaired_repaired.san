}

.task-item.urgent {
  border-left: 4px solid #ef4444;
}

.task-checkbox {
  cursor: pointer;
}

.checkbox {
  font-size: 20px;
}

.task-content {
  flex: 1;
  cursor: pointer;
}

.task-title {
  font-weight: 600;
  margin-bottom: 4px;
}

.task-meta {
  display: flex;
  gap: 12px;
  font-size: 12px;
  margin-bottom: 4px;
}

.task-priority {
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 11px;
}

.task-priority.high {
  background: #fee2e2;
  color: #991b1b;
}

.task-priority.medium {
  background: #fef3c7;
  color: #92400e;
}

.task-priority.low {
  background: #dcfce7;
  color: #166534;
}

.task-tags {
  display: flex;
  gap: 6px;
