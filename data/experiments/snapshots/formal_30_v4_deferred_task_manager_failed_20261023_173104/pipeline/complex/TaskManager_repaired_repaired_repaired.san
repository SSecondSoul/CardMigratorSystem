  font-size: 28px;
  font-weight: 700;
}

.stat-card-trend {
  font-size: 12px;
  font-weight: 600;
  margin-top: 4px;
}

.stat-card-trend.positive {
  color: #10b981;
}

.stat-card-trend.negative {
  color: #ef4444;
}

/* 主要工作区 */
.main-workspace {
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: 24px;
}

.tasks-panel, .detail-panel {
  background: white;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.dark-theme .tasks-panel,
.dark-theme .detail-panel {
  background: #16213e;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  flex-wrap: wrap;
  gap: 16px;
}

.panel-header h2 {
  font-size: 20px;
  margin: 0;
}

.task-controls {
  display: flex;
