    const formData = this.data.get('formData');
    const tags = formData.tags || [];
    if (tags.includes(tag)) {
      this.data.set('formData.tags', tags.filter(t => t !== tag));
    } else {
      this.data.set('formData.tags', [...tags, tag]);
