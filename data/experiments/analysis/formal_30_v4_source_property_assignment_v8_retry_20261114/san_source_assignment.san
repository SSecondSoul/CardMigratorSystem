formatDate(date) {
  if (!date) return '无截止日期';
  const d = new Date(date);
  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
},
formatTime(time) {
  const d = new Date(time);
  return d.toLocaleTimeString();
},

  name: 'TaskDetail',
  template: `<div class="task-detail"><div class="detail-header"><h3>任务详情</h3><div class="detail-actions"><button class="edit-detail" on-click="fire('update', task)">编辑</button><button class="close-detail" on-click="fire('close')">✕</button></div></div><div class="detail-content"><div class="detail-field"><label>标题</label><div class="field-value">{{ task.title }}</div></div><div class="detail-field"><label>描述</label><div class="field-value">{{ task.description || '无描述' }}</div></div><div class="detail-field"><label>优先级</label><div class="field-value {{ task.priority }}">{{ getPriorityLabel(task.priority) }}</div></div><div class="detail-field"><label>截止日期</label><div class="field-value">{{ formatDate(task.dueDate) }}</div></div><div class="detail-field"><label>标签</label><div class="field-value"><span s-for="tag in task.tags trackby tag" class="detail-tag">{{ tag }}</span></div></div><div class="detail-field"><label>评论</label><div class="comments-section"><div s-for="comment, idx in task.comments trackby idx" class="comment-item"><strong>{{ comment.user }}</strong>: {{ comment.text }}<small>{{ formatTime(comment.time) }}</small></div><div class="comment-input"><input type="text" placeholder="添加评论..." value="{= newComment =}" on-keyup="__sourceDomEnter_0($event)" /><button on-click="addComment">发送</button></div></div></div></div></div>`,
  dataTypes: {
