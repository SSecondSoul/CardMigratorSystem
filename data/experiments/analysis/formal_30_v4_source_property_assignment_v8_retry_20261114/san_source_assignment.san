  name: 'TaskManager',
  components: {
    'stat-card': StatCard,
    'task-item': TaskItem,
    'task-detail': TaskDetail,
    'task-form': TaskForm,
    'settings-panel': SettingsPanel
  ,
    'StatCard': StatCard,
    'TaskItem': TaskItem,
    'TaskDetail': TaskDetail,
    'TaskForm': TaskForm,
    'SettingsPanel': SettingsPanel
  },
  dataTypes: {
    isDarkMode: DataTypes.bool,
    isCompactMode: DataTypes.bool,
    showSettings: DataTypes.bool,
    isModalOpen: DataTypes.bool,
    tasks: DataTypes.array,
    selectedTask: DataTypes.object,
    editingTask: DataTypes.object,
    currentFilter: DataTypes.string,
    searchKeyword: DataTypes.string,
    dragStartIndex: DataTypes.any,
    users: DataTypes.array,
    availableTags: DataTypes.array,
    statistics: DataTypes.array,
    filters: DataTypes.array,
    settings: DataTypes.object,
    notification: DataTypes.object,
    syncTimer: DataTypes.any,
    storageKey: DataTypes.string
  },
  initData() {
    return {
      isDarkMode: false,
      isCompactMode: false,
      showSettings: false,
      isModalOpen: false,
      tasks: [],
      selectedTask: null,
      editingTask: null,
      currentFilter: 'all',
      searchKeyword: '',
      dragStartIndex: null,
      users: [
        { id: 1, name: '张三' },
        { id: 2, name: '李四' },
        { id: 3, name: '王五' }
      ],
      availableTags: ['工作', '个人', '紧急', '学习', '休闲', '会议'],
      statistics: [
        { id: 1, label: '总任务', value: 0, icon: '📊', trend: 12, color: '#3b82f6' },
        { id: 2, label: '已完成', value: 0, icon: '✅', trend: 8, color: '#10b981' },
        { id: 3, label: '进行中', value: 0, icon: '🔄', trend: -3, color: '#f59e0b' },
        { id: 4, label: '逾期任务', value: 0, icon: '⚠️', trend: 5, color: '#ef4444' }
      ],
      filters: [
        { value: 'all', label: '全部' },
        { value: 'active', label: '进行中' },
        { value: 'completed', label: '已完成' },
        { value: 'overdue', label: '已逾期' },
        { value: 'urgent', label: '紧急' }
      ],
      settings: {
        defaultView: 'list',
        autoSave: true,
        notifications: true,
        syncInterval: 60
      },
      notification: {
        show: false,
        message: '',
        type: 'info'
      },
      syncTimer: null,
      storageKey: 'task_manager_data'
    };
  },
  computed: {
    filteredTasks() {
      const tasks = this.data.get('tasks');
      const currentFilter = this.data.get('currentFilter');
      const searchKeyword = this.data.get('searchKeyword');
      let result = [...tasks];

      // 状态过滤
      if (currentFilter !== 'all') {
        result = result.filter(task => {
          switch (currentFilter) {
            case 'active': return !task.completed && !__sanComputed_isOverdue_0(task);
            case 'completed': return task.completed;
            case 'overdue': return __sanComputed_isOverdue_0(task) && !task.completed;
            case 'urgent': return task.priority === 'high' && !task.completed;
            default: return true;
          }
        });
      }

      // 搜索过滤
      if (searchKeyword) {
        const keyword = searchKeyword.toLowerCase();
        result = result.filter(task =>
          task.title.toLowerCase().includes(keyword) ||
          (task.description && task.description.toLowerCase().includes(keyword))
        );
      }

      return result;
    }
  },
