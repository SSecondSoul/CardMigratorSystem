const SettingsPanel = san.defineComponent({
  name: 'SettingsPanel',
  template: `<div class="settings-panel"><div class="setting-group"><label>默认视图</label><select value="{= settings.defaultView =}" on-change="updateDefaultView($event.target.value)"><option value="list">列表视图</option><option value="board">看板视图</option></select></div><div class="setting-group"><label>自动保存</label><input type="checkbox" checked="{= settings.autoSave =}" on-change="updateAutoSave($event.target.checked)" /></div><div class="setting-group"><label>通知提醒</label><input type="checkbox" checked="{= settings.notifications =}" on-change="updateNotifications($event.target.checked)" /></div><div class="setting-group"><label>数据同步间隔</label><select value="{= settings.syncInterval =}" on-change="updateSyncInterval($event.target.value)"><option value="0">手动同步</option><option value="30">30秒</option><option value="60">1分钟</option><option value="300">5分钟</option></select></div></div>`,
  dataTypes: {
    settings: DataTypes.object
  },
  initData() {
    return {
      settings: {
        defaultView: 'list',
        autoSave: true,
        notifications: true,
        syncInterval: 60
      }
    };
  },
  updateDefaultView(value) {
    const settings = this.data.get('settings');
    this.fire('update',{key:'defaultView',value:value});
  },
  updateAutoSave(value) {
    this.fire('update',{key:'autoSave',value:value});
  },
  updateNotifications(value) {
    this.fire('update',{key:'notifications',value:value});
  },
  updateSyncInterval(value) {
    this.fire('update',{key:'syncInterval',value:value});
  }
});

