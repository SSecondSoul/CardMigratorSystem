{
  "code": "<template><section class=\"product-filter-panel\"><header><h2>\u5546\u54c1\u7b5b\u9009</h2><strong>{{resultCount}} \u9879</strong></header><div class=\"filters\"><input placeholder=\"\u641c\u7d22\u5546\u54c1\" on-input=\"updateQuery\" value=\"{{query}}\"><select on-change=\"updateCategory\" value=\"{{category}}\"><option value=\"all\">\u5168\u90e8\u5206\u7c7b</option><option s-for=\"item in categories trackby item\" value=\"{{item}}\">{{item}}</option></select><label>\u6700\u9ad8 \u00a5{{maxPrice}}<input max=\"1000\" min=\"100\" step=\"50\" type=\"range\" on-input=\"updatePrice\" value=\"{{maxPrice}}\"></label><label> \u4ec5\u770b\u6709\u8d27<input type=\"checkbox\" on-change=\"toggleStock\" checked=\"{{inStockOnly}}\"></label><select on-change=\"updateSort\" value=\"{{sort}}\"><option value=\"name\">\u6309\u540d\u79f0</option><option value=\"price\">\u6309\u4ef7\u683c</option></select><button on-click=\"clear\">\u6e05\u7a7a</button></div><div class=\"products\"><button s-for=\"product in visibleProducts trackby product.id\"  class=\"{{product.id === selectedId ? 'selected' : ''}}\" on-click=\"select(product.id)\"><strong>{{product.name}}</strong><span>\u00a5{{product.price}} \u00b7 \u5e93\u5b58 {{product.stock}}</span></button></div><p class=\"empty\" s-if=\"!visibleProducts.length\">\u65e0\u5339\u914d\u5546\u54c1</p></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"ProductFilterPanel\",dataTypes:{products:DataTypes.array,categories:DataTypes.array},initData(){return {\nproducts: [{\n  \"id\": 1,\n  \"name\": \"\u673a\u68b0\u952e\u76d8\",\n  \"category\": \"\u5916\u8bbe\",\n  \"price\": 499,\n  \"stock\": 8\n}, {\n  \"id\": 2,\n  \"name\": \"\u663e\u793a\u5668\u652f\u67b6\",\n  \"category\": \"\u529e\u516c\",\n  \"price\": 269,\n  \"stock\": 0\n}, {\n  \"id\": 3,\n  \"name\": \"\u964d\u566a\u8033\u673a\",\n  \"category\": \"\u97f3\u9891\",\n  \"price\": 899,\n  \"stock\": 4\n}, {\n  \"id\": 4,\n  \"name\": \"\u684c\u9762\u706f\",\n  \"category\": \"\u529e\u516c\",\n  \"price\": 159,\n  \"stock\": 12\n}],\ncategories: [\"\u5916\u8bbe\", \"\u529e\u516c\", \"\u97f3\u9891\"],\nquery:\"\",category:\"all\",maxPrice:1000,inStockOnly:!1,sort:\"name\",selectedId:null}},computed:{visibleProducts(){const q=this.data.get(\"query\").toLowerCase();return this.data.get(\"products\").filter(item=>item.name.toLowerCase().indexOf(q)>=0&&(this.data.get(\"category\")===\"all\"||item.category===this.data.get(\"category\"))&&item.price<=this.data.get(\"maxPrice\")&&(!this.data.get(\"inStockOnly\")||item.stock>0)).slice().sort((a,b)=>this.data.get(\"sort\")===\"price\"?a.price-b.price:a.name.localeCompare(b.name,\"zh-CN\"))},resultCount(){return this.data.get(\"visibleProducts\").length}},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},updateQuery(event){this.setValue(\"query\",event.target.value)},updateCategory(event){this.setValue(\"category\",event.target.value)},updatePrice(event){this.setValue(\"maxPrice\",Number(event.target.value)||0)},toggleStock(event){this.setValue(\"inStockOnly\",event.target.checked)},updateSort(event){this.setValue(\"sort\",event.target.value)},select(id){this.setValue(\"selectedId\",id);this.emitEvent(\"select\",id)},clear(){this.setValue(\"query\",\"\");this.setValue(\"category\",\"all\");this.setValue(\"maxPrice\",1000);this.setValue(\"inStockOnly\",!1)}});</script><style>\n.product-filter-panel{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}\n.product-filter-panel *{box-sizing:border-box}\n.product-filter-panel h2,.product-filter-panel h3,.product-filter-panel p{margin-top:0}\n.product-filter-panel button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}\n.product-filter-panel button.primary{border-color:#2563eb;background:#2563eb;color:#fff}\n.product-filter-panel button:disabled{opacity:.45;cursor:not-allowed}\n.product-filter-panel input,.product-filter-panel select,.product-filter-panel textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}\n.product-filter-panel .muted{color:#71808e;font-size:12px}\n.product-filter-panel .toolbar,.product-filter-panel .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}\nheader{display:flex;justify-content:space-between}.filters{display:flex;gap:8px;flex-wrap:wrap}.filters label{display:flex;align-items:center;gap:6px}.products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:14px}.products button{text-align:left}.products button span{display:block}.products button.selected{background:#dbeafe;border-color:#2563eb}.empty{text-align:center}\n</style>",
