<template>
<section class="fleet-dispatch-console">
  <header>
    <div>
      <small>待配送 {{pendingUnits}} 件</small>
      <h2>{{depotName}}</h2>
    </div>
    <select value="{= zone =}" on-change="setZone">
      <option s-for="item in zones trackby item" value="{= item =}">{{item}}</option>
    </select>
  </header>
  <div class="dispatch-grid">
    <aside>
      <h3>车辆</h3>
      <button s-for="vehicle in vehicles trackby vehicle.id" class="{{(selectedVehicleId === vehicle.id ? 'selected ' : '') + vehicle.status}}" on-click="chooseVehicle(vehicle.id)">
        <strong>{{vehicle.id}} · {{vehicle.driver}}</strong>
        <span>容量 {{vehicle.capacity}} · {{vehicle.status}}</span>
        <i>{{vehicle.status === 'idle' ? '可派单' : '运输中'}}</i>
      </button>
    </aside>
    <main>
      <h3>订单池</h3>
      <article s-for="order in visibleOrders trackby order.id" class="{{isSelected(order.id, selectedOrderIds) ? 'selected' : ''}}" on-click="toggleOrder(order.id)">
        <b>P{{order.priority}}</b>
        <strong>{{order.id}}</strong>
        <span>{{order.zone}}</span>
        <em>{{order.units}} 件</em>
      </article>
      <p s-if="!visibleOrders.length">当前区域无待分配订单</p>
    </main>
    <aside class="summary">
      <h3>派单摘要</h3>
      <p>车辆：{{selectedVehicle ? selectedVehicle.id : '未选择'}}</p>
      <p>订单：{{selectedOrderIds.length}}/{{maxBatch}}</p>
      <p>载荷：{{selectedUnits}} / {{selectedVehicle ? selectedVehicle.capacity : 0}}</p>
      <button class="primary" disabled="{{!canDispatch}}" on-click="confirmDispatch">确认派单</button>
      <small>{{alert}}</small>
    </aside>
  </div>
  <section class="routes">
    <article s-for="route in dispatches trackby route.id">
      <span>{{route.vehicleId}} → {{routeOrders(route)}}</span>
      <strong>{{route.units}} 件</strong>
      <button on-click="returnVehicle(route.vehicleId)">完成返仓</button>
    </article>
  </section>
</section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'FleetDispatchConsole',
  dataTypes: {
    depotName: DataTypes.string,
    initialVehicles: DataTypes.array,
    initialOrders: DataTypes.array,
    zones: DataTypes.array,
    maxBatch: DataTypes.number
  },
  initData() {
    return {
      vehicles: [],
      orders: [],
      selectedVehicleId: null,
      selectedOrderIds: [],
      zone: '全部',
      dispatches: [],
      alert: ''
    };
  },
  inited() {
    const initialVehicles = this.data.get('initialVehicles') || [];
    const initialOrders = this.data.get('initialOrders') || [];
    this.data.set('vehicles', initialVehicles.map(item => Object.assign({}, item)));
    this.data.set('orders', initialOrders.map(item => Object.assign({}, item, { status: 'pending' })));
  },
  computed: {
    visibleOrders() {
      return this.data.get('orders').filter(order => order.status === 'pending' && (this.data.get('zone') === '全部' || order.zone === this.data.get('zone'))).sort((a, b) => a.priority - b.priority);
    },
    selectedVehicle() {
      return this.data.get('vehicles').find(item => item.id === this.data.get('selectedVehicleId')) || null;
    },
    selectedUnits() {
      return this.data.get('orders').filter(item => this.data.get('selectedOrderIds').indexOf(item.id) >= 0).reduce((sum, item) => sum + item.units, 0);
    },
    canDispatch() {
      const selectedVehicle = this.data.get('selectedVehicle');
      const selectedOrderIds = this.data.get('selectedOrderIds');
      const maxBatch = this.data.get('maxBatch');
      const selectedUnits = this.data.get('selectedUnits');
      return !!selectedVehicle && selectedVehicle.status === 'idle' && selectedOrderIds.length > 0 && selectedOrderIds.length <= maxBatch && selectedUnits <= selectedVehicle.capacity;
    },
    pendingUnits() {
      return this.data.get('orders').filter(item => item.status === 'pending').reduce((sum, item) => sum + item.units, 0);
    }
  },
  setValue(key, value) {
    this.data.set(key, value);
  },
  emitEvent(name, payload) {
    this.fire(name, payload);
  },
  setZone(event) {
    this.setValue('zone', event.target.value);
    this.setValue('selectedOrderIds', []);
  },
  chooseVehicle(id) {
    this.setValue('selectedVehicleId', id);
    this.setValue('alert', '');
  },
  toggleOrder(id) {
    const list = this.data.get('selectedOrderIds');
    const idx = list.indexOf(id);
    if (idx >= 0) {
      this.setValue('selectedOrderIds', list.filter(item => item !== id));
    } else {
      this.setValue('selectedOrderIds', list.concat(id));
    }
  },
  confirmDispatch() {
    if (!this.data.get('canDispatch')) {
      this.setValue('alert', '请选择空闲车辆，并检查容量与批量上限');
      return;
    }
    const ids = this.data.get('selectedOrderIds').slice();
    const vehicleId = this.data.get('selectedVehicleId');
    const orders = this.data.get('orders').map(order =>
      ids.indexOf(order.id) >= 0
        ? Object.assign({}, order, { status: 'assigned', vehicleId })
        : order
    );
    const vehicles = this.data.get('vehicles').map(vehicle =>
      vehicle.id === vehicleId
        ? Object.assign({}, vehicle, { status: 'route' })
        : vehicle
    );
    const dispatches = [{ id: Date.now(), vehicleId, orderIds: ids, units: this.data.get('selectedUnits') }].concat(this.data.get('dispatches'));
    this.setValue('orders', orders);
    this.setValue('vehicles', vehicles);
    this.setValue('dispatches', dispatches);
    this.setValue('selectedOrderIds', []);
    this.setValue('selectedVehicleId', null);
    this.emitEvent('dispatch', { vehicleId, orderIds: ids });
  },
  returnVehicle(id) {
    const vehicles = this.data.get('vehicles').map(vehicle =>
      vehicle.id === id
        ? Object.assign({}, vehicle, { status: 'idle' })
        : vehicle
    );
    const orders = this.data.get('orders').map(order =>
      order.vehicleId === id
        ? Object.assign({}, order, { status: 'delivered' })
        : order
    );
    this.setValue('vehicles', vehicles);
    this.setValue('orders', orders);
    this.emitEvent('return', id);
  },
  isSelected(id, selectedOrderIds) {
    return selectedOrderIds.indexOf(id) >= 0;
  },
  routeOrders(route) {
    return route.orderIds.join('、');
  }
});
</script>

<style>
.fleet-dispatch-console{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}
.fleet-dispatch-console *{box-sizing:border-box}
.fleet-dispatch-console h2,.fleet-dispatch-console h3,.fleet-dispatch-console p{margin-top:0}
.fleet-dispatch-console button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}
.fleet-dispatch-console button.primary{border-color:#0369a1;background:#0369a1;color:#fff}
.fleet-dispatch-console button:disabled{opacity:.45;cursor:not-allowed}
.fleet-dispatch-console input,.fleet-dispatch-console select,.fleet-dispatch-console textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}
.fleet-dispatch-console .muted{color:#71808e;font-size:12px}
.fleet-dispatch-console .toolbar,.fleet-dispatch-console .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
header{display:flex;justify-content:space-between}.dispatch-grid{display:grid;grid-template-columns:200px 1fr 210px;gap:12px}.dispatch-grid>aside{padding:10px;background:#f8fafc}.dispatch-grid>aside>button{display:grid;width:100%;text-align:left;margin:7px 0}.dispatch-grid>aside>button.selected{border-color:#0284c7;background:#e0f2fe}.dispatch-grid>aside>button.route{opacity:.6}.dispatch-grid main article{display:grid;grid-template-columns:40px 1fr 70px 60px;gap:8px;padding:10px;border-bottom:1px solid #e2e8f0}.dispatch-grid main article.selected{background:#dbeafe}.dispatch-grid .summary p{display:flex;justify-content:space-between}.routes article{display:flex;gap:12px;align-items:center;padding:8px;margin-top:6px;background:#ecfeff}.routes article button{margin-left:auto}
</style>
