<template>
<section class="warehouse-picking-wave">
  <header>
    <div>
      <small>开放订单 {{openOrders.length}} · 异常 {{unresolvedExceptions.length}}</small>
      <h2>{{warehouseName}} 拣选波次</h2>
    </div>
    <div>
      <select value="{= picker =}" on-change="setPicker">
        <option s-for="person in pickers" key="{= person =}" value="{= person =}">{{person}}</option>
      </select>
      <button class="primary" disabled="{{!selectedOrderIds.length || selectedLineCount > maxLinesPerWave}}" on-click="createWave">组建波次（{{selectedLineCount}}/{{maxLinesPerWave}}行）</button>
    </div>
  </header>
  <div class="wave-layout">
    <aside>
      <h3>订单池</h3>
      <button s-for="order in openOrders" key="{= order.id =}" class="{{isOrderSelected(order.id, selectedOrderIds) ? 'selected' : ''}}" on-click="toggleOrder(order.id)">
        <strong>{{order.id}}</strong>
        <span>{{order.lines.length}} 行</span>
      </button>
      <h3>波次</h3>
      <button s-for="wave in waves" key="{= wave.id =}" class="{{activeWaveId === wave.id ? 'selected' : ''}}" on-click="selectWave(wave.id)">波次 {{wave.id}} · {{wave.picker}} · {{wave.status}}</button>
    </aside>
    <main>
      <h3>拣选路径 · {{waveProgress}}%</h3>
      <article s-for="task in activeTasks" key="{= task.id =}" class="{{task.picked ? 'picked' : ''}">
        <button on-click="togglePicked(task.orderId, task.id)">{{task.picked ? '✓' : '○'}}</button>
        <b>{{task.bin}}</b>
        <strong>{{task.sku}}</strong>
        <span>{{task.qty}} 件 · {{task.orderId}}</span>
        <button on-click="reportException(task)">报异常</button>
      </article>
      <p s-if="!activeWave">请选择或创建波次</p>
      <button class="primary complete" disabled="{{waveProgress < 100 || unresolvedExceptions.length > 0}}" on-click="completeWave">完成波次</button>
    </main>
    <aside class="exceptions">
      <h3>异常流</h3>
      <article s-for="item in exceptions" key="{= item.id =}" class="{{item.resolved ? 'resolved' : ''}">
        <strong>{{item.orderId}} · {{item.reason}}</strong>
        <button disabled="{{item.resolved}}" on-click="resolveException(item.id)">{{item.resolved ? '已处理' : '补货完成'}}</button>
      </article>
    </aside>
  </div>
</section>
</template>

<script>
const san = require('san');
const DataTypes = san.DataTypes;

module.exports = san.defineComponent({
  name: 'WarehousePickingWave',

  dataTypes: {
    warehouseName: DataTypes.string,
    initialOrders: DataTypes.array,
    pickers: DataTypes.array,
    maxLinesPerWave: DataTypes.number,
    zones: DataTypes.array
  },

  initData() {
    return {
      orders: [],
      waves: [],
      selectedOrderIds: [],
      activeWaveId: null,
      picker: '刘佳',
      exceptions: [],
      nextWaveId: 1
    };
  },

  inited() {
    const initialOrders = this.data.get('initialOrders') || [];
    const orders = initialOrders.map(order => Object.assign({}, order, {
      status: 'open',
      lines: (order.lines || []).map((line, index) => Object.assign({}, line, {
        id: order.id + '-' + index,
        picked: false
      }))
    }));
    this.data.set('orders', orders);
  },

  computed: {
    openOrders() {
      return this.data.get('orders').filter(item => item.status === 'open');
    },
    selectedLineCount() {
      const orders = this.data.get('orders');
      const selectedOrderIds = this.data.get('selectedOrderIds');
      return orders.filter(order => selectedOrderIds.indexOf(order.id) >= 0)
        .reduce((sum, order) => sum + (order.lines || []).length, 0);
    },
    activeWave() {
      const waves = this.data.get('waves');
      const activeWaveId = this.data.get('activeWaveId');
      return waves.find(item => item.id === activeWaveId) || null;
    },
    activeTasks() {
      const activeWave = this.data.get('activeWave');
      if (!activeWave) return [];
      const ids = activeWave.orderIds;
      const orders = this.data.get('orders');
      return orders.filter(order => ids.indexOf(order.id) >= 0)
        .reduce((out, order) => out.concat((order.lines || []).map(line => Object.assign({}, line, { orderId: order.id }))), []);
    },
    waveProgress() {
      const activeTasks = this.data.get('activeTasks');
      const pickedCount = activeTasks.filter(item => item.picked).length;
      const totalCount = activeTasks.length || 1;
      return Math.round(pickedCount / totalCount * 100);
    },
    unresolvedExceptions() {
      const exceptions = this.data.get('exceptions');
      return exceptions.filter(item => !item.resolved);
    }
  },

  setValue(key, value) {
    this.data.set(key, value);
  },

  emitEvent(name, payload) {
    this.fire(name, payload);
  },

  toggleOrder(id) {
    const selectedOrderIds = this.data.get('selectedOrderIds');
    const idx = selectedOrderIds.indexOf(id);
    if (idx >= 0) {
      this.data.set('selectedOrderIds', selectedOrderIds.filter(item => item !== id));
    } else {
      this.data.set('selectedOrderIds', selectedOrderIds.concat(id));
    }
  },

  setPicker(event) {
    this.data.set('picker', event.target.value);
  },

  createWave() {
    const selectedOrderIds = this.data.get('selectedOrderIds');
    const selectedLineCount = this.data.get('selectedLineCount');
    const maxLinesPerWave = this.data.get('maxLinesPerWave');
    if (!selectedOrderIds.length || selectedLineCount > maxLinesPerWave) return;

    const nextWaveId = this.data.get('nextWaveId');
    const picker = this.data.get('picker');
    const waves = this.data.get('waves');
    const orders = this.data.get('orders');

    const wave = {
      id: nextWaveId,
      orderIds: selectedOrderIds.slice(),
      picker,
      status: 'picking'
    };

    const newWaves = waves.concat(wave);
    const newOrders = orders.map(order =>
      selectedOrderIds.indexOf(order.id) >= 0
        ? Object.assign({}, order, { status: 'assigned', waveId: wave.id })
        : order
    );

    this.data.set('waves', newWaves);
    this.data.set('orders', newOrders);
    this.data.set('activeWaveId', wave.id);
    this.data.set('nextWaveId', wave.id + 1);
    this.data.set('selectedOrderIds', []);

    this.fire('wave', wave);
  },

  selectWave(id) {
    this.data.set('activeWaveId', id);
  },

  togglePicked(orderId, lineId) {
    const orders = this.data.get('orders');
    const newOrders = orders.map(order =>
      order.id !== orderId
        ? order
        : Object.assign({}, order, {
            lines: (order.lines || []).map(line =>
              line.id === lineId
                ? Object.assign({}, line, { picked: !line.picked })
                : line
            )
          })
    );
    this.data.set('orders', newOrders);
    this.fire('pick', { orderId, lineId });
  },

  reportException(task) {
    const exceptions = this.data.get('exceptions');
    const newItem = {
      id: Date.now(),
      orderId: task.orderId,
      lineId: task.id,
      reason: '库位缺货',
      resolved: false
    };
    this.data.set('exceptions', [newItem].concat(exceptions));
  },

  resolveException(id) {
    const exceptions = this.data.get('exceptions');
    const newExceptions = exceptions.map(item =>
      item.id === id ? Object.assign({}, item, { resolved: true }) : item
    );
    this.data.set('exceptions', newExceptions);
    this.fire('exception', id);
  },

  completeWave() {
    const activeWave = this.data.get('activeWave');
    const waveProgress = this.data.get('waveProgress');
    const unresolvedExceptions = this.data.get('unresolvedExceptions');
    if (!activeWave || waveProgress < 100 || unresolvedExceptions.length > 0) return;

    const waveId = this.data.get('activeWaveId');
    const waves = this.data.get('waves');
    const orders = this.data.get('orders');

    const newWaves = waves.map(wave =>
      wave.id === waveId ? Object.assign({}, wave, { status: 'completed' }) : wave
    );

    const newOrders = orders.map(order =>
      order.waveId === waveId ? Object.assign({}, order, { status: 'completed' }) : order
    );

    this.data.set('waves', newWaves);
    this.data.set('orders', newOrders);
    this.fire('complete', waveId);
  },

  isOrderSelected(id, selectedOrderIds) {
    return selectedOrderIds.indexOf(id) >= 0;
  }
});
</script>

<style>
.warehouse-picking-wave{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}
.warehouse-picking-wave *{box-sizing:border-box}
.warehouse-picking-wave h2,.warehouse-picking-wave h3,.warehouse-picking-wave p{margin-top:0}
.warehouse-picking-wave button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}
.warehouse-picking-wave button.primary{border-color:#ea580c;background:#ea580c;color:#fff}
.warehouse-picking-wave button:disabled{opacity:.45;cursor:not-allowed}
.warehouse-picking-wave input,.warehouse-picking-wave select,.warehouse-picking-wave textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}
.warehouse-picking-wave .muted{color:#71808e;font-size:12px}
.warehouse-picking-wave .toolbar,.warehouse-picking-wave .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
header{display:flex;justify-content:space-between}
.wave-layout{display:grid;grid-template-columns:200px 1fr 210px;gap:12px}
.wave-layout>aside{padding:10px;background:#f8fafc}
.wave-layout>aside>button{display:flex;justify-content:space-between;width:100%;margin:6px 0;text-align:left}
.wave-layout>aside>button.selected{background:#fef3c7;border-color:#d97706}
.wave-layout main article{display:grid;grid-template-columns:40px 70px 1fr 150px auto;gap:8px;align-items:center;padding:10px;border-bottom:1px solid #e2e8f0}
.wave-layout main article.picked{background:#ecfdf5;text-decoration:line-through}
.complete{width:100%;margin-top:12px}
.exceptions article{padding:8px;margin:7px 0;background:#fee2e2}
.exceptions article.resolved{background:#dcfce7;opacity:.7}
.exceptions button{display:block;margin-top:5px}
</style>
