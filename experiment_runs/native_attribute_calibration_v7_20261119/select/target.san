<template><div><select value="{{value}}" VALUE="{{value}}"><option value="a">A</option><option value="b">B</option></select><button on-click="change">next</button><button on-click="clear">clear</button></div></template><script>const san=require("san");module.exports=san.defineComponent({initData(){return {value:null}},change(){this.data.set("value","b")},clear(){this.data.set("value",null)}})</script>