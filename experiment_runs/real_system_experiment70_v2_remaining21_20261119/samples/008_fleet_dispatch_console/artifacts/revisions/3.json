{
  "code": "<template><section class=\"fleet-dispatch-console\"><header><div><small>\u5f85\u914d\u9001 {{pendingUnits}} \u4ef6</small><h2>{{depotName}}</h2></div><select on-change=\"setZone\" value=\"{{zone}}\"><option s-for=\"item in zones trackby item\" value=\"{{item}}\">{{item}}</option></select></header><div class=\"dispatch-grid\"><aside><h3>\u8f66\u8f86</h3><button s-for=\"vehicle in vehicles trackby vehicle.id\" class=\"{{selectedVehicleId === vehicle.id ? 'selected ' : ''}}{{vehicle.status}}\" on-click=\"chooseVehicle(vehicle.id)\"><strong>{{vehicle.id}} \u00b7 {{vehicle.driver}}</strong><span>\u5bb9\u91cf {{vehicle.capacity}} \u00b7 {{vehicle.status}}</span><i>{{vehicle.status === 'idle' ? '\u53ef\u6d3e\u5355' : '\u8fd0\u8f93\u4e2d'}}</i></button></aside><main><h3>\u8ba2\u5355\u6c60</h3><article s-for=\"order in visibleOrders trackby order.id\" class=\"{{isSelected(order.id, selectedOrderIds) ? 'selected' : ''}}\" on-click=\"toggleOrder(order.id)\"><b>P{{order.priority}}</b><strong>{{order.id}}</strong><span>{{order.zone}}</span><em>{{order.units}} \u4ef6</em></article><p s-if=\"!visibleOrders.length\">\u5f53\u524d\u533a\u57df\u65e0\u5f85\u5206\u914d\u8ba2\u5355</p></main><aside class=\"summary\"><h3>\u6d3e\u5355\u6458\u8981</h3><p>\u8f66\u8f86\uff1a{{selectedVehicle ? selectedVehicle.id : '\u672a\u9009\u62e9'}}</p><p>\u8ba2\u5355\uff1a{{selectedOrderIds.length}}/{{maxBatch}}</p><p>\u8f7d\u8377\uff1a{{selectedUnits}} / {{selectedVehicle ? selectedVehicle.capacity : 0}}</p><button class=\"primary\" on-click=\"confirmDispatch\" disabled=\"{{!canDispatch}}\">\u786e\u8ba4\u6d3e\u5355</button><small>{{alert}}</small></aside></div><section class=\"routes\"><article s-for=\"route in dispatches trackby route.id\"><span>{{route.vehicleId}} \u2192 {{routeOrders(route)}}</span><strong>{{route.units}} \u4ef6</strong><button on-click=\"returnVehicle(route.vehicleId)\">\u5b8c\u6210\u8fd4\u4ed3</button></article></section></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: \"FleetDispatchConsole\",dataTypes: {depotName: DataTypes.string,initialVehicles: DataTypes.array,initialOrders: DataTypes.array,zones: DataTypes.array,maxBatch: DataTypes.number},initData() {return {depotName: \"\u57ce\u5317\u914d\u9001\u4e2d\u5fc3\",initialVehicles: [{\"id\": \"V1\",\"driver\": \"\u674e\u822a\",\"capacity\": 12,\"status\": \"idle\"},{\"id\": \"V2\",\"driver\": \"\u5468\u654f\",\"capacity\": 8,\"status\": \"idle\"},{\"id\": \"V3\",\"driver\": \"\u4f55\u9752\",\"capacity\": 16,\"status\": \"route\"}],initialOrders: [{\"id\": \"O101\",\"zone\": \"\u4e1c\u533a\",\"units\": 4,\"priority\": 2},{\"id\": \"O102\",\"zone\": \"\u897f\u533a\",\"units\": 7,\"priority\": 1},{\"id\": \"O103\",\"zone\": \"\u4e1c\u533a\",\"units\": 5,\"priority\": 3},{\"id\": \"O104\",\"zone\": \"\u5357\u533a\",\"units\": 3,\"priority\": 2}],zones: [\"\u5168\u90e8\", \"\u4e1c\u533a\", \"\u897f\u533a\", \"\u5357\u533a\"],maxBatch: 3,vehicles: [],orders: [],selectedVehicleId: null,selectedOrderIds: [],zone: \"\u5168\u90e8\",dispatches: [],alert: \"\"}},inited() {const initialVehicles = this.data.get('initialVehicles') || [];const initialOrders = this.data.get('initialOrders') || [];this.data.set('vehicles', initialVehicles.map(item => Object.assign({}, item)));this.data.set('orders', initialOrders.map(item => Object.assign({}, item, {status: 'pending'})));},computed: {visibleOrders() {return this.data.get('orders').filter(order => order.status === 'pending' && (this.data.get('zone') === '\u5168\u90e8' || order.zone === this.data.get('zone'))).sort((a, b) => a.priority - b.priority);},selectedVehicle() {return this.data.get('vehicles').find(item => item.id === this.data.get('selectedVehicleId')) || null;},selectedUnits() {return this.data.get('orders').filter(item => this.data.get('selectedOrderIds').indexOf(item.id) >= 0).reduce((sum, item) => sum + item.units, 0);},canDispatch() {const selectedVehicle = this.data.get('selectedVehicle');const selectedOrderIds = this.data.get('selectedOrderIds');const maxBatch = this.data.get('maxBatch');const selectedUnits = this.data.get('selectedUnits');return !!selectedVehicle && selectedVehicle.status === 'idle' && selectedOrderIds.length > 0 && selectedOrderIds.length <= maxBatch && selectedUnits <= selectedVehicle.capacity;},pendingUnits() {return this.data.get('orders').filter(item => item.status === 'pending').reduce((sum, item) => sum + item.units, 0);}},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},setZone(event) {this.data.set('zone', event.target.value);this.data.set('selectedOrderIds', []);},chooseVehicle(id) {this.data.set('selectedVehicleId', id);this.data.set('alert', '');},toggleOrder(id) {const list = this.data.get('selectedOrderIds');this.data.set('selectedOrderIds', list.indexOf(id) >= 0 ? list.filter(item => item !== id) : list.concat(id));},confirmDispatch() {if (!this.data.get('canDispatch')) {this.data.set('alert', '\u8bf7\u9009\u62e9\u7a7a\u95f2\u8f66\u8f86\uff0c\u5e76\u68c0\u67e5\u5bb9\u91cf\u4e0e\u6279\u91cf\u4e0a\u9650');return;}const ids = this.data.get('selectedOrderIds').slice();const vehicleId = this.data.get('selectedVehicleId');this.data.set('orders', this.data.get('orders').map(order => ids.indexOf(order.id) >= 0 ? Object.assign({}, order, {status: 'assigned', vehicleId}) : order));this.data.set('vehicles', this.data.get('vehicles').map(vehicle => vehicle.id === vehicleId ? Object.assign({}, vehicle, {status: 'route'}) : vehicle));this.data.set('dispatches', [{id: Date.now(), vehicleId, orderIds: ids, units: this.data.get('selectedUnits')}].concat(this.data.get('dispatches')));this.data.set('selectedOrderIds', []);this.data.set('selectedVehicleId', null);this.emitEvent('dispatch', {vehicleId, orderIds: ids});},returnVehicle(id) {this.data.set('vehicles', this.data.get('vehicles').map(vehicle => vehicle.id === id ? Object.assign({}, vehicle, {status: 'idle'}) : vehicle));this.data.set('orders', this.data.get('orders').map(order => order.vehicleId === id ? Object.assign({}, order, {status: 'delivered'}) : order));this.emitEvent('return', id);},isSelected(id, selectedOrderIds) {return selectedOrderIds.indexOf(id) >= 0;},routeOrders(route) {return route.orderIds.join('\u3001');}});</script><style>.fleet-dispatch-console{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.fleet-dispatch-console *{box-sizing:border-box}.fleet-dispatch-console h2,.fleet-dispatch-console h3,.fleet-dispatch-console p{margin-top:0}.fleet-dispatch-console button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.fleet-dispatch-console button.primary{border-color:#0369a1;background:#0369a1;color:#fff}.fleet-dispatch-console button:disabled{opacity:.45;cursor:not-allowed}.fleet-dispatch-console input,.fleet-dispatch-console select,.fleet-dispatch-console textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.fleet-dispatch-console .muted{color:#71808e;font-size:12px}.fleet-dispatch-console .toolbar,.fleet-dispatch-console .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.dispatch-grid{display:grid;grid-template-columns:200px 1fr 210px;gap:12px}.dispatch-grid>aside{padding:10px;background:#f8fafc}.dispatch-grid>aside>button{display:grid;width:100%;text-align:left;margin:7px 0}.dispatch-grid>aside>button.selected{border-color:#0284c7;background:#e0f2fe}.dispatch-grid>aside>button.route{opacity:.6}.dispatch-grid main article{display:grid;grid-template-columns:40px 1fr 70px 60px;gap:8px;padding:10px;border-bottom:1px solid #e2e8f0}.dispatch-grid main article.selected{background:#dbeafe}.dispatch-grid .summary p{display:flex;justify-content:space-between}.routes article{display:flex;gap:12px;align-items:center;padding:8px;margin-top:6px;background:#ecfeff}.routes article button{margin-left:auto}</style>",
