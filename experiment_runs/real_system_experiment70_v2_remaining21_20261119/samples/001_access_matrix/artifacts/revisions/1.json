{
  "code": "<template><main class=\"access-matrix\"><header class=\"matrix-header\"><div><span class=\"eyebrow\">\u8bbf\u95ee\u6cbb\u7406</span><h1>{{title}}</h1><p>\u6309\u89d2\u8272\u548c\u8d44\u6e90\u7ef4\u62a4\u6700\u5c0f\u6743\u9650\u96c6\u5408</p></div><div class=\"header-actions\"><button class=\"secondary\" type=\"button\" on-click=\"toggleAudit\">{{showAudit ? '\u9690\u85cf\u5ba1\u8ba1' : '\u67e5\u770b\u5ba1\u8ba1'}}</button><button type=\"button\" on-click=\"save\" disabled=\"{{locked || !dirty}}\">{{saveState === 'saving' ? '\u4fdd\u5b58\u4e2d' : '\u4fdd\u5b58\u53d8\u66f4'}}</button></div></header><section class=\"matrix-stats\"><article><span>\u5df2\u6388\u6743\u5355\u5143</span><strong>{{grantedCount}}</strong></article><article><span>\u6388\u6743\u8986\u76d6\u7387</span><strong>{{coverage}}%</strong></article><article><span>\u5f53\u524d\u89d2\u8272</span><strong>{{selectedRoleName}}</strong></article></section><section class=\"matrix-toolbar\"><label><span>\u7b5b\u9009\u8d44\u6e90</span><input placeholder=\"\u540d\u79f0\u6216\u5206\u7ec4\" value=\"{{query}}\" on-input=\"updateQuery\"></label><div class=\"role-tabs\"><button type=\"button\" s-for=\"role in roles trackby role.id\" on-click=\"selectRole(role.id)\" class=\"{{selectedRoleId === role.id ? 'active' : ''}}\">{{role.name}}</button></div><button class=\"secondary\" type=\"button\" on-click=\"setAllForRole(true)\" disabled=\"{{locked}}\">\u5f53\u524d\u89d2\u8272\u5168\u9009</button><button class=\"secondary\" type=\"button\" on-click=\"setAllForRole(false)\" disabled=\"{{locked}}\">\u5f53\u524d\u89d2\u8272\u6e05\u7a7a</button></section><section class=\"matrix-shell\"><table><thead><tr><th>\u8d44\u6e90</th><th s-for=\"role in roles trackby role.id\"><span>{{role.name}}</span><button type=\"button\" on-click=\"toggleColumn(role.id)\" disabled=\"{{locked}}\">\u6574\u5217\u5207\u6362</button></th><th>\u6279\u91cf</th></tr></thead><tbody><tr s-for=\"row in matrixRows trackby row.id\"><th><strong>{{row.name}}</strong><small>{{row.group}}</small></th><td s-for=\"cell in row.cells trackby cell.roleId\"><button class=\"grant-cell {{cell.granted ? 'granted' : ''}}\" type=\"button\" on-click=\"toggleCell(row.id, cell.roleId)\" disabled=\"{{locked}}\">{{cell.granted ? '\u5141\u8bb8' : '\u62d2\u7edd'}}</button></td><td><button class=\"row-toggle\" type=\"button\" on-click=\"toggleRow(row.id)\" disabled=\"{{locked}}\">\u6574\u884c\u5207\u6362</button></td></tr></tbody></table><div class=\"empty-matrix\" s-if=\"!matrixRows.length\">\u6ca1\u6709\u5339\u914d\u8d44\u6e90</div></section><aside class=\"audit-panel\" s-if=\"showAudit\"><div><strong>\u6700\u8fd1\u64cd\u4f5c</strong><button type=\"button\" on-click=\"clearAudit\">\u6e05\u7a7a</button></div><ol><li s-for=\"entry in audit trackby entry.id\"><span>{{entry.message}}</span><small>{{entry.time}}</small></li></ol><p s-if=\"!audit.length\">\u6682\u65e0\u64cd\u4f5c\u8bb0\u5f55</p></aside><footer class=\"matrix-footer\"><span>{{locked ? '\u77e9\u9635\u5df2\u9501\u5b9a' : dirty ? '\u5b58\u5728\u672a\u4fdd\u5b58\u66f4\u6539' : '\u6240\u6709\u66f4\u6539\u5df2\u4fdd\u5b58'}}</span><span>\u6700\u8fd1\u4fdd\u5b58\uff1a{{lastSaved || '\u5c1a\u672a\u4fdd\u5b58'}}</span></footer></main></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"AccessMatrix\",dataTypes:{title:DataTypes.string,roles:DataTypes.array,resources:DataTypes.array,initialGrants:DataTypes.object,locked:DataTypes.bool},initData(){return {\ntitle: '\u9879\u76ee\u7a7a\u95f4\u6743\u9650',\nroles: [{\n  id: 'owner',\n  name: '\u7ba1\u7406\u5458'\n}, {\n  id: 'editor',\n  name: '\u7f16\u8f91\u8005'\n}, {\n  id: 'viewer',\n  name: '\u8bbf\u5ba2'\n}],\nresources: [{\n  id: 'docs',\n  name: '\u6587\u6863\u5e93',\n  group: '\u5185\u5bb9'\n}, {\n  id: 'data',\n  name: '\u6570\u636e\u96c6',\n  group: '\u8d44\u4ea7'\n}, {\n  id: 'runs',\n  name: '\u5b9e\u9a8c\u4efb\u52a1',\n  group: '\u8fd0\u884c'\n}, {\n  id: 'reports',\n  name: '\u8bc4\u4f30\u62a5\u544a',\n  group: '\u5185\u5bb9'\n}, {\n  id: 'settings',\n  name: '\u7cfb\u7edf\u8bbe\u7f6e',\n  group: '\u7ba1\u7406'\n}],\ninitialGrants: {\n  owner: ['docs', 'data', 'runs', 'reports', 'settings'],\n  editor: ['docs', 'data', 'runs'],\n  viewer: ['docs', 'reports']\n},\nlocked: false,\ngrants:JSON.parse(JSON.stringify(this.initialGrants)),query:\"\",selectedRoleId:this.roles[0].id,audit:[],dirty:false,saveState:\"idle\",lastSaved:\"\",showAudit:false,autosaveTimer:null,nextAuditId:1}},inited(){this.data.set(\"grants\",JSON.parse(JSON.stringify(this.initialGrants)));this.data.set(\"selectedRoleId\",this.roles[0].id);this.watch(\"grants\",()=>{this.fire(\"change\",JSON.parse(JSON.stringify(this.data.get(\"grants\"))));});this.watch(\"locked\",()=>{if(!this.data.get(\"locked\")&&this.data.get(\"dirty\")){this.scheduleAutosave();}});this.watch(\"dirty\",()=>{if(!this.data.get(\"locked\")&&this.data.get(\"dirty\")){this.scheduleAutosave();}});},attached(){this.scheduleAutosave();},disposed(){clearTimeout(this.data.get(\"autosaveTimer\"));},computed:{filteredResources(){const query=this.data.get(\"query\").trim().toLowerCase();return this.data.get(\"resources\").filter((resource)=>!query||resource.name.toLowerCase().includes(query)||resource.group.toLowerCase().includes(query));},matrixRows(){return this.data.get(\"filteredResources\").map((resource)=>({id:resource.id,name:resource.name,group:resource.group,cells:this.data.get(\"roles\").map((role)=>({roleId:role.id,granted:(this.data.get(\"grants\")[role.id]||[]).indexOf(resource.id)>=0}))}));},grantedCount(){return this.data.get(\"roles\").reduce((sum,role)=>sum+(this.data.get(\"grants\")[role.id]||[]).length,0);},coverage(){return Math.round((this.data.get(\"grantedCount\")/(this.data.get(\"roles\").length*this.data.get(\"resources\").length))*100);},selectedRoleName(){const role=this.data.get(\"roles\").find((item)=>item.id===this.data.get(\"selectedRoleId\"));return role?role.name:\"--\";}},updateQuery(event){this.data.set(\"query\",event.target.value);},selectRole(id){this.data.set(\"selectedRoleId\",id);},hasGrant(roleId,resourceId){return(this.data.get(\"grants\")[roleId]||[]).indexOf(resourceId)>=0;},setGrant(roleId,resourceId,granted){const current=(this.data.get(\"grants\")[roleId]||[]).slice();const next=granted?Array.from(new Set(current.concat(resourceId))):current.filter((id)=>id!==resourceId);const grants={...this.data.get(\"grants\")};grants[roleId]=next;this.data.set(\"grants\",grants);},toggleCell(resourceId,roleId){const granted=!this.hasGrant(roleId,resourceId);this.setGrant(roleId,resourceId,granted);this.record(`${roleId} \u5bf9 ${resourceId} ${granted?'\u6388\u6743':'\u64a4\u6743'}`);this.changed();},toggleRow(resourceId){const grantAll=this.data.get(\"roles\").some((role)=>!this.hasGrant(role.id,resourceId));this.data.get(\"roles\").forEach((role)=>this.setGrant(role.id,resourceId,grantAll));this.record(`${resourceId} \u6574\u884c${grantAll?'\u6388\u6743':'\u6e05\u7a7a'}`);this.changed();},toggleColumn(roleId){const grantAll=this.data.get(\"resources\").some((resource)=>!this.hasGrant(roleId,resource.id));const grants={...this.data.get(\"grants\")};grants[roleId]=grantAll?this.data.get(\"resources\").map((resource)=>resource.id):[];this.data.set(\"grants\",grants);this.record(`${roleId} \u6574\u5217${grantAll?'\u6388\u6743':'\u6e05\u7a7a'}`);this.changed();},setAllForRole(granted){const grants={...this.data.get(\"grants\")};grants[this.data.get(\"selectedRoleId\")]=granted?this.data.get(\"resources\").map((resource)=>resource.id):[];this.data.set(\"grants\",grants);this.record(`${this.data.get(\"selectedRoleId\")} ${granted?'\u5168\u9009':'\u6e05\u7a7a'}`);this.changed();},record(message){const id=this.data.get(\"nextAuditId\");const time=new Date().toLocaleTimeString(\"zh-CN\",{hour:\"2-digit\",minute:\"2-digit\"});const newEntry={id,message,time};const audit=[newEntry,...this.data.get(\"audit\")];this.data.set(\"audit\",audit.slice(0,8));this.data.set(\"nextAuditId\",id+1);},changed(){this.data.set(\"dirty\",true);this.scheduleAutosave();this.fire(\"change\",JSON.parse(JSON.stringify(this.data.get(\"grants\"))));},scheduleAutosave(){clearTimeout(this.data.get(\"autosaveTimer\"));if(!this.data.get(\"locked\")&&this.data.get(\"dirty\")){this.data.set(\"autosaveTimer\",setTimeout(()=>{this.save();},800));}},async save(){if(this.data.get(\"locked\")||!this.data.get(\"dirty\"))return;this.data.set(\"saveState\",\"saving\");await Promise.resolve();this.data.set(\"dirty\",false);this.data.set(\"saveState\",\"saved\");this.data.set(\"lastSaved\",new Date().toLocaleTimeString(\"zh-CN\",{hour:\"2-digit\",minute:\"2-digit\"}));this.fire(\"save\",JSON.parse(JSON.stringify(this.data.get(\"grants\"))));},toggleAudit(){this.data.set(\"showAudit\",!this.data.get(\"showAudit\"));},clearAudit(){this.data.set(\"audit\",[]);}});</script><style scoped>.access-matrix { width: 860px; padding: 24px; border: 1px solid #cbd5e1; border-radius: 7px; background: #f8fafc; color: #172026; font-family: Arial, sans-serif; }\n.matrix-header { display: flex; justify-content: space-between; gap: 24px; }\n.matrix-header h1 { margin: 3px 0; font-size: 24px; }\n.matrix-header p, .eyebrow { color: #64748b; font-size: 12px; }\n.header-actions { display: flex; gap: 8px; }\n.access-matrix button { padding: 7px 10px; border: 1px solid #1d4ed8; border-radius: 4px; background: #1d4ed8; color: #ffffff; cursor: pointer; }\n.access-matrix button.secondary { border-color: #94a3b8; background: #ffffff; color: #334155; }\n.matrix-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px 0; }\n.matrix-stats article { padding: 12px; border-left: 3px solid #1d4ed8; background: #ffffff; }\n.matrix-stats span { display: block; color: #64748b; font-size: 12px; }\n.matrix-stats strong { font-size: 21px; }\n.matrix-toolbar { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; align-items: end; margin-bottom: 12px; }\n.matrix-toolbar label { display: grid; gap: 5px; color: #475569; font-size: 12px; }\n.matrix-toolbar input { padding: 8px; border: 1px solid #94a3b8; }\n.role-tabs { grid-column: 1 / -1; display: flex; gap: 5px; }\n.role-tabs button { background: #ffffff; color: #334155; border-color: #cbd5e1; }\n.role-tabs button.active { background: #dbeafe; border-color: #2563eb; color: #1e40af; }\n.matrix-shell { overflow-x: auto; border: 1px solid #d1d5db; background: #ffffff; }\n.matrix-shell table { width: 100%; border-collapse: collapse; }\n.matrix-shell th, .matrix-shell td { padding: 9px; border: 1px solid #e5e7eb; text-align: center; }\n.matrix-shell th:first-child { text-align: left; }\n.matrix-shell th small { display: block; color: #64748b; }\n.matrix-shell thead { background: #eff6ff; }\n.matrix-shell thead th span { display: block; margin-bottom: 6px; }\n.matrix-shell thead button, .row-toggle { padding: 4px 6px; border-color: #94a3b8; background: #ffffff; color: #475569; font-size: 11px; }\n.grant-cell { min-width: 58px; border-color: #cbd5e1 !important; background: #f8fafc !important; color: #64748b !important; }\n.grant-cell.granted { border-color: #16a34a !important; background: #dcfce7 !important; color: #166534 !important; }\n.empty-matrix { padding: 28px; text-align: center; color: #94a3b8; }\n.audit-panel { margin-top: 14px; padding: 14px; border: 1px solid #fde68a; background: #fffbeb; }\n.audit-panel > div, .audit-panel li { display: flex; justify-content: space-between; gap: 16px; }\n.audit-panel ol { padding-left: 20px; }\n.audit-panel li { margin: 6px 0; }\n.audit-panel small { color: #78716c; }\n.matrix-footer { display: flex; justify-content: space-between; margin-top: 14px; color: #64748b; font-size: 12px; }\n</style>",
