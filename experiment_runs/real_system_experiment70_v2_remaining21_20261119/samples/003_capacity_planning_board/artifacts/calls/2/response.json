{"model":"qwen-plus","id":"chatcmpl-302efc9b-3c10-9a4e-ba64-dddd984b2398","choices":[{"message":{"content":"<template><section class=\"capacity-planning-board\"><header><div><p class=\"muted\">{{saved ? '规划已保存' : '有未保存变更'}}</p><h2>{{boardTitle}}</h2></div><div class=\"actions\"><select on-change=\"updateCycle\" value=\"{{cycle}}\"><option s-for=\"item in cycles trackby item\" key=\"{{item}}\" value=\"{{item}}\">{{item}}</option></select><button class=\"primary\" on-click=\"save\">保存</button></div></header><div class=\"capacity-summary\"><span>总工作量 {{totalPoints}} 点</span><select on-change=\"updateSkill\" value=\"{{skillFilter}}\"><option value=\"all\">全部技能</option><option>前端</option><option>后端</option><option>测试</option></select></div><div class=\"planning-layout\"><aside><h3>待分配 {{unassigned.length}}</h3><button s-for=\"item in unassigned trackby item.id\" key=\"{{item.id}}\" class=\"{{isSelected(item.id) ? 'selected' : ''}}\" on-click=\"selectWork(item.id)\"><strong>{{item.title}}</strong><small>{{item.points}} 点</small></button><p class=\"empty\" s-if=\"!unassigned.length\">全部已分配</p><section s-if=\"selectedWork\"><h3>当前工作项</h3><p>{{selectedWork.title}}</p><strong>{{selectedWork.points}} 点</strong></section></aside><main><article s-for=\"lane in lanes trackby lane.member.id\" key=\"{{lane.member.id}}\" class=\"{{'member-lane ' + laneClass(lane)}}\"><header><div><strong>{{lane.member.name}}</strong><small>{{lane.member.skills.join(' / ')}}</small></div><div><button on-click=\"changeCapacity(lane.member.id, -1)\">−</button><span>{{lane.load}}/{{lane.member.capacity}}</span><button on-click=\"changeCapacity(lane.member.id, 1)\">＋</button><button on-click=\"assign(lane.member.id)\" disabled=\"{{selectedWorkId === null}}\">分配到此</button></div></header><div class=\"capacity-bar\"><span style=\"{{lane.bar}}\"></span></div><div class=\"lane-items\"><button s-for=\"item in lane.items trackby item.id\" key=\"{{item.id}}\" class=\"{{isSelected(item.id) ? 'selected' : ''}}\" on-click=\"selectWork(item.id)\">{{item.title}} · {{item.points}}</button></div></article></main></div><footer><span s-for=\"entry in changeLog trackby entry.id\">{{entry.message}}</span></footer></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: 'CapacityPlanningBoard',dataTypes: {boardTitle: DataTypes.string,cycles: DataTypes.array,initialMembers: DataTypes.array,initialWork: DataTypes.array},initData() {return {boardTitle: \"迭代容量规划\",cycles: [\"Sprint 21\", \"Sprint 22\"],initialMembers: [{\"id\": 1,\"name\": \"林晓\",\"capacity\": 8,\"skills\": [\"前端\"]},{\"id\": 2,\"name\": \"周宁\",\"capacity\": 10,\"skills\": [\"后端\"]},{\"id\": 3,\"name\": \"陈雨\",\"capacity\": 6,\"skills\": [\"测试\"]}],initialWork: [{\"id\": 1,\"title\": \"登录页改造\",\"points\": 5,\"assigneeId\": 1,\"cycle\": \"Sprint 21\"},{\"id\": 2,\"title\": \"接口缓存\",\"points\": 8,\"assigneeId\": null,\"cycle\": \"Sprint 21\"},{\"id\": 3,\"title\": \"回归测试\",\"points\": 3,\"assigneeId\": 3,\"cycle\": \"Sprint 21\"},{\"id\": 4,\"title\": \"埋点方案\",\"points\": 5,\"assigneeId\": null,\"cycle\": \"Sprint 22\"}],members: [],workItems: [],cycle: \"Sprint 21\",selectedWorkId: null,skillFilter: \"all\",saved: true,changeLog: []};},inited() {this.data.set('members', this.initialMembers.map(item => Object.assign({}, item, {skills: item.skills.slice()})));this.data.set('workItems', this.initialWork.map(item => Object.assign({}, item)));this.data.set('cycle', this.cycles[0] || '');},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},updateCycle(event) {this.data.set('cycle', event.target.value);this.data.set('selectedWorkId', null);},updateSkill(event) {this.data.set('skillFilter', event.target.value);},selectWork(id) {this.data.set('selectedWorkId', id);},assign(memberId) {const id = this.data.get('selectedWorkId');if (id === null) return;this.data.set('workItems', this.data.get('workItems').map(item => item.id === id ? Object.assign({}, item, {assigneeId: memberId}) : item));this.data.set('saved', false);this.log('已分配工作项');this.emitEvent('assignment', {workId: id, memberId});},unassign(id) {this.data.set('workItems', this.data.get('workItems').map(item => item.id === id ? Object.assign({}, item, {assigneeId: null}) : item));this.data.set('saved', false);this.log('工作项退回待分配池');},changeCapacity(memberId, delta) {this.data.set('members', this.data.get('members').map(member => member.id === memberId ? Object.assign({}, member, {capacity: Math.max(1, member.capacity + delta)}) : member));this.data.set('saved', false);this.emitEvent('capacity', {memberId, delta});},save() {this.data.set('saved', true);this.log('规划已保存');this.emitEvent('save', {members: this.data.get('members'), workItems: this.data.get('workItems')});},log(message) {this.data.set('changeLog', [{id: Date.now(), message}].concat(this.data.get('changeLog')).slice(0, 4));},laneClass(lane) {return lane.percent > 100 ? 'overloaded' : lane.percent > 80 ? 'near-limit' : '';},isSelected(id) {return this.data.get('selectedWorkId') === id;},joinValues(values, separator) {return values.join(separator);}});</script><style>.capacity-planning-board { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.capacity-planning-board * { box-sizing: border-box; }\n.capacity-planning-board h2, .capacity-planning-board h3, .capacity-planning-board p { margin-top: 0; }\n.capacity-planning-board h2 { margin-bottom: 14px; font-size: 21px; }\n.capacity-planning-board button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.capacity-planning-board button.primary { border-color: #047857; background: #047857; color: #fff; }\n.capacity-planning-board button:disabled { opacity: .45; cursor: not-allowed; }\n.capacity-planning-board input, .capacity-planning-board select, .capacity-planning-board textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.capacity-planning-board .toolbar, .capacity-planning-board .summary, .capacity-planning-board .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.capacity-planning-board .muted { color: #71808e; font-size: 12px; }\n.capacity-planning-board .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\nheader,.capacity-summary{display:flex;justify-content:space-between}.capacity-summary{padding:10px;background:#ecfdf5}.planning-layout{display:grid;grid-template-columns:175px 1fr;gap:14px;margin-top:12px}.planning-layout>aside{padding:10px;background:#f6f8f8}.planning-layout>aside>button{display:block;width:100%;margin:6px 0}.planning-layout button.selected{background:#d1fae5}.member-lane{margin-bottom:10px;padding:12px;border:1px solid #dce3df}.member-lane.near-limit{border-color:#d97706}.member-lane.overloaded{border-color:#dc2626;background:#fef2f2}.capacity-bar{height:6px;margin:8px 0;background:#e5e7eb}.capacity-bar span{display:block;height:100%;background:#047857}.lane-items{display:flex;gap:7px;flex-wrap:wrap}.lane-items i{margin-left:6px;color:#b91c1c}footer{display:flex;gap:8px;font-size:11px}</style>","role":"assistant"},"index":0,"finish_reason":"stop"}],"created":1795020950,"object":"chat.completion","usage":{"total_tokens":40307,"completion_tokens":2113,"prompt_tokens":38194,"prompt_tokens_details":{"cached_tokens":0}}}