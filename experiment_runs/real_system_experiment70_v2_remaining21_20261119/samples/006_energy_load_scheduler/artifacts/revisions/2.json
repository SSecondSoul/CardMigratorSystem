{
  "code": "<template><section class=\"energy-load-scheduler\"><header><div><small>{{optimized ? '\u5df2\u81ea\u52a8\u4f18\u5316' : '\u624b\u5de5\u6392\u7a0b'}}</small><h2>{{siteName}}</h2></div><button class=\"primary\" on-click=\"optimize\">\u5e73\u8861\u5cf0\u503c</button></header><div class=\"energy-layout\"><main><div class=\"matrix-head\"><span>\u8bbe\u5907 / \u5c0f\u65f6</span><button s-for=\"hour in hours trackby hour\" class=\"{{selectedHour === hour ? 'active' : ''}}\" on-click=\"selectHour(hour)\">{{hour}}\u65f6</button></div><div class=\"device-row\" s-for=\"device in devices trackby device.id\"><strong>{{device.name}}<small>{{device.kw}} kW</small></strong><button s-for=\"hour in hours trackby hour\" class=\"{{slotClass(device.id, hour, schedule)}}\" on-click=\"toggleSlot(device.id, hour)\">{{schedule[device.id][hour] ? '\u5f00' : '\u2014'}}</button></div><div class=\"load-chart\"><i s-for=\"load, index in hourlyLoads trackby index\" class=\"{{load > capacity ? 'over' : ''}}\" style=\"{{loadStyle(load, capacity)}}\"><span>{{load}}</span></i></div></main><aside><h3>{{selectedHour}}:00 \u8be6\u60c5</h3><strong>{{selectedLoad}} / {{capacity}} kW</strong><p>\u5cf0\u503c {{peakLoad}} kW</p><p>\u9884\u8ba1\u6210\u672c \u00a5{{totalCost}}</p><p s-if=\"violations.length\" class=\"warn\">\u8d85\u9650\u65f6\u6bb5\uff1a{{violationsLabel}}</p><input value=\"{{scenarioName}}\" on-input=\"updateScenarioName\"/><button on-click=\"saveScenario\">\u4fdd\u5b58\u60c5\u666f</button><ul><li s-for=\"scenario in savedScenarios trackby scenario.id\">{{scenario.name}} \u00b7 \u00a5{{scenario.cost}} \u00b7 {{scenario.peak}}kW</li></ul></aside></div></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"EnergyLoadScheduler\",dataTypes:{siteName:DataTypes.string,devices:DataTypes.array,hours:DataTypes.array,rates:DataTypes.array,capacity:DataTypes.number},initData(){return {\nsiteName: \"\u5fae\u7535\u7f51\u8d1f\u8f7d\u8ba1\u5212\",\ndevices: [{\n  \"id\": \"pump\",\n  \"name\": \"\u5faa\u73af\u6cf5\",\n  \"kw\": 20\n}, {\n  \"id\": \"chiller\",\n  \"name\": \"\u51b7\u6c34\u673a\",\n  \"kw\": 35\n}, {\n  \"id\": \"charge\",\n  \"name\": \"\u5145\u7535\u6869\",\n  \"kw\": 15\n}],\nhours: [0, 1, 2, 3, 4, 5, 6, 7],\nrates: [0.42, 0.38, 0.36, 0.4, 0.55, 0.72, 0.9, 0.8],\ncapacity: 55,\nschedule:{},selectedHour:0,scenarioName:\"\u57fa\u51c6\u65b9\u6848\",savedScenarios:[],optimized:false}},inited(){const schedule={};this.data.get(\"devices\").forEach((device,d)=>{schedule[device.id]={};this.data.get(\"hours\").forEach(hour=>{schedule[device.id][hour]=(hour+d)%3===0;});});this.data.set(\"schedule\",schedule);},setValue(key,value){this.data.set(key,value);},emitEvent(name,payload){this.fire(name,payload);},toggleSlot(deviceId,hour){const deviceSchedule=Object.assign({},this.data.get(\"schedule\")[deviceId],{[hour]:!this.data.get(\"schedule\")[deviceId][hour]});this.data.set(\"schedule\",Object.assign({},this.data.get(\"schedule\"),{[deviceId]:deviceSchedule}));this.data.set(\"selectedHour\",hour);this.data.set(\"optimized\",false);this.fire(\"schedule\",this.data.get(\"schedule\"));},selectHour(hour){this.data.set(\"selectedHour\",hour);},optimize(){const schedule={};this.data.get(\"devices\").forEach((device,deviceIndex)=>{schedule[device.id]={};this.data.get(\"hours\").forEach((hour,hourIndex)=>{schedule[device.id][hour]=(hourIndex+deviceIndex*2)%5===0&&this.data.get(\"rates\")[hourIndex]<0.7;});});this.data.set(\"schedule\",schedule);this.data.set(\"optimized\",true);this.fire(\"optimize\",{schedule,cost:this.data.get(\"totalCost\")});},updateScenarioName(event){this.data.set(\"scenarioName\",event.target.value);},saveScenario(){const scenario={id:Date.now(),name:this.data.get(\"scenarioName\"),cost:this.data.get(\"totalCost\"),peak:this.data.get(\"peakLoad\"),schedule:JSON.parse(JSON.stringify(this.data.get(\"schedule\")))};this.data.set(\"savedScenarios\",[scenario].concat(this.data.get(\"savedScenarios\")).slice(0,4));this.fire(\"save\",scenario);},slotClass(deviceId,hour,schedule){return schedule[deviceId]&&schedule[deviceId][hour]?\"on\":\"off\";},loadStyle(load,capacity){return \"height:\"+Math.min(100,load/capacity*100)+\"%\";},computed:{hourlyLoads:{get(){return this.data.get(\"hours\").map(hour=>this.data.get(\"devices\").reduce((sum,device)=>sum+(this.data.get(\"schedule\")[device.id]&&this.data.get(\"schedule\")[device.id][hour]?device.kw:0),0));}},totalCost:{get(){return this.data.get(\"hourlyLoads\").reduce((sum,load,index)=>sum+load*(this.data.get(\"rates\")[index]||0),0).toFixed(2);}},peakLoad:{get(){return Math.max.apply(Math,this.data.get(\"hourlyLoads\").concat(0));}},violations:{get(){return this.data.get(\"hours\").filter((hour,index)=>this.data.get(\"hourlyLoads\")[index]>this.data.get(\"capacity\"));}},violationsLabel:{get(){return this.data.get(\"violations\").join(\"\u3001\");}},selectedLoad:{get(){const index=this.data.get(\"hours\").indexOf(this.data.get(\"selectedHour\"));return index<0?0:this.data.get(\"hourlyLoads\")[index];}}}});</script><style>.energy-load-scheduler{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.energy-load-scheduler *{box-sizing:border-box}.energy-load-scheduler h2,.energy-load-scheduler h3,.energy-load-scheduler p{margin-top:0}.energy-load-scheduler button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.energy-load-scheduler button.primary{border-color:#059669;background:#059669;color:#fff}.energy-load-scheduler button:disabled{opacity:.45;cursor:not-allowed}.energy-load-scheduler input,.energy-load-scheduler select,.energy-load-scheduler textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.energy-load-scheduler .muted{color:#71808e;font-size:12px}.energy-load-scheduler .toolbar,.energy-load-scheduler .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.energy-layout{display:grid;grid-template-columns:1fr 220px;gap:14px}.matrix-head,.device-row{display:grid;grid-template-columns:130px repeat(8,1fr);gap:4px;margin-bottom:4px}.matrix-head button.active{background:#d1fae5}.device-row strong{display:grid}.device-row button.on{background:#059669;color:white}.device-row button.off{background:#f1f5f9;color:#94a3b8}.load-chart{height:130px;display:flex;align-items:flex-end;gap:8px;padding:16px 8px 0;border-bottom:1px solid}.load-chart i{flex:1;min-height:3px;background:#34d399;position:relative}.load-chart i.over{background:#ef4444}.load-chart span{position:absolute;top:-16px;font-size:10px}.energy-layout aside{padding:12px;background:#f8fafc}.energy-layout aside input,.energy-layout aside button{width:100%;margin:5px 0}.warn{color:#b91c1c}</style>",
