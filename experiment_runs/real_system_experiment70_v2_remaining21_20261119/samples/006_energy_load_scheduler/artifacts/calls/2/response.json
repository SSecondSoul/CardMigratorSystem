{"model":"qwen-plus","id":"chatcmpl-c0f3b350-7e05-9514-a4db-e1c030b6badc","choices":[{"message":{"content":"<template><section class=\"energy-load-scheduler\"><header><div><small>{{optimized ? '已自动优化' : '手工排程'}}</small><h2>{{siteName}}</h2></div><button class=\"primary\" on-click=\"optimize\">平衡峰值</button></header><div class=\"energy-layout\"><main><div class=\"matrix-head\"><span>设备 / 小时</span><button s-for=\"hour in hours trackby hour\" class=\"{{selectedHour === hour ? 'active' : ''}}\" on-click=\"selectHour(hour)\">{{hour}}时</button></div><div class=\"device-row\" s-for=\"device in devices trackby device.id\"><strong>{{device.name}}<small>{{device.kw}} kW</small></strong><button s-for=\"hour in hours trackby hour\" class=\"{{slotClass(device.id, hour, schedule)}}\" on-click=\"toggleSlot(device.id, hour)\">{{schedule[device.id][hour] ? '开' : '—'}}</button></div><div class=\"load-chart\"><i s-for=\"load, index in hourlyLoads trackby index\" class=\"{{load > capacity ? 'over' : ''}}\" style=\"{{loadStyle(load, capacity)}}\"><span>{{load}}</span></i></div></main><aside><h3>{{selectedHour}}:00 详情</h3><strong>{{selectedLoad}} / {{capacity}} kW</strong><p>峰值 {{peakLoad}} kW</p><p>预计成本 ¥{{totalCost}}</p><p s-if=\"violations.length\" class=\"warn\">超限时段：{{violationsLabel}}</p><input value=\"{{scenarioName}}\" on-input=\"updateScenarioName\"/><button on-click=\"saveScenario\">保存情景</button><ul><li s-for=\"scenario in savedScenarios trackby scenario.id\">{{scenario.name}} · ¥{{scenario.cost}} · {{scenario.peak}}kW</li></ul></aside></div></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"EnergyLoadScheduler\",dataTypes:{siteName:DataTypes.string,devices:DataTypes.array,hours:DataTypes.array,rates:DataTypes.array,capacity:DataTypes.number},initData(){return {\nsiteName: \"微电网负载计划\",\ndevices: [{\n  \"id\": \"pump\",\n  \"name\": \"循环泵\",\n  \"kw\": 20\n}, {\n  \"id\": \"chiller\",\n  \"name\": \"冷水机\",\n  \"kw\": 35\n}, {\n  \"id\": \"charge\",\n  \"name\": \"充电桩\",\n  \"kw\": 15\n}],\nhours: [0, 1, 2, 3, 4, 5, 6, 7],\nrates: [0.42, 0.38, 0.36, 0.4, 0.55, 0.72, 0.9, 0.8],\ncapacity: 55,\nschedule:{},selectedHour:0,scenarioName:\"基准方案\",savedScenarios:[],optimized:false}},inited(){const schedule={};this.data.get(\"devices\").forEach((device,d)=>{schedule[device.id]={};this.data.get(\"hours\").forEach(hour=>{schedule[device.id][hour]=(hour+d)%3===0;});});this.data.set(\"schedule\",schedule);},setValue(key,value){this.data.set(key,value);},emitEvent(name,payload){this.fire(name,payload);},toggleSlot(deviceId,hour){const deviceSchedule=Object.assign({},this.data.get(\"schedule\")[deviceId],{[hour]:!this.data.get(\"schedule\")[deviceId][hour]});this.data.set(\"schedule\",Object.assign({},this.data.get(\"schedule\"),{[deviceId]:deviceSchedule}));this.data.set(\"selectedHour\",hour);this.data.set(\"optimized\",false);this.fire(\"schedule\",this.data.get(\"schedule\"));},selectHour(hour){this.data.set(\"selectedHour\",hour);},optimize(){const schedule={};this.data.get(\"devices\").forEach((device,deviceIndex)=>{schedule[device.id]={};this.data.get(\"hours\").forEach((hour,hourIndex)=>{schedule[device.id][hour]=(hourIndex+deviceIndex*2)%5===0&&this.data.get(\"rates\")[hourIndex]<0.7;});});this.data.set(\"schedule\",schedule);this.data.set(\"optimized\",true);this.fire(\"optimize\",{schedule,cost:this.data.get(\"totalCost\")});},updateScenarioName(event){this.data.set(\"scenarioName\",event.target.value);},saveScenario(){const scenario={id:Date.now(),name:this.data.get(\"scenarioName\"),cost:this.data.get(\"totalCost\"),peak:this.data.get(\"peakLoad\"),schedule:JSON.parse(JSON.stringify(this.data.get(\"schedule\")))};this.data.set(\"savedScenarios\",[scenario].concat(this.data.get(\"savedScenarios\")).slice(0,4));this.fire(\"save\",scenario);},slotClass(deviceId,hour,schedule){return schedule[deviceId]&&schedule[deviceId][hour]?\"on\":\"off\";},loadStyle(load,capacity){return \"height:\"+Math.min(100,load/capacity*100)+\"%\";},computed:{hourlyLoads:{get(){return this.data.get(\"hours\").map(hour=>this.data.get(\"devices\").reduce((sum,device)=>sum+(this.data.get(\"schedule\")[device.id]&&this.data.get(\"schedule\")[device.id][hour]?device.kw:0),0));}},totalCost:{get(){return this.data.get(\"hourlyLoads\").reduce((sum,load,index)=>sum+load*(this.data.get(\"rates\")[index]||0),0).toFixed(2);}},peakLoad:{get(){return Math.max.apply(Math,this.data.get(\"hourlyLoads\").concat(0));}},violations:{get(){return this.data.get(\"hours\").filter((hour,index)=>this.data.get(\"hourlyLoads\")[index]>this.data.get(\"capacity\"));}},violationsLabel:{get(){return this.data.get(\"violations\").join(\"、\");}},selectedLoad:{get(){const index=this.data.get(\"hours\").indexOf(this.data.get(\"selectedHour\"));return index<0?0:this.data.get(\"hourlyLoads\")[index];}}}});</script><style>.energy-load-scheduler{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.energy-load-scheduler *{box-sizing:border-box}.energy-load-scheduler h2,.energy-load-scheduler h3,.energy-load-scheduler p{margin-top:0}.energy-load-scheduler button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.energy-load-scheduler button.primary{border-color:#059669;background:#059669;color:#fff}.energy-load-scheduler button:disabled{opacity:.45;cursor:not-allowed}.energy-load-scheduler input,.energy-load-scheduler select,.energy-load-scheduler textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.energy-load-scheduler .muted{color:#71808e;font-size:12px}.energy-load-scheduler .toolbar,.energy-load-scheduler .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.energy-layout{display:grid;grid-template-columns:1fr 220px;gap:14px}.matrix-head,.device-row{display:grid;grid-template-columns:130px repeat(8,1fr);gap:4px;margin-bottom:4px}.matrix-head button.active{background:#d1fae5}.device-row strong{display:grid}.device-row button.on{background:#059669;color:white}.device-row button.off{background:#f1f5f9;color:#94a3b8}.load-chart{height:130px;display:flex;align-items:flex-end;gap:8px;padding:16px 8px 0;border-bottom:1px solid}.load-chart i{flex:1;min-height:3px;background:#34d399;position:relative}.load-chart i.over{background:#ef4444}.load-chart span{position:absolute;top:-16px;font-size:10px}.energy-layout aside{padding:12px;background:#f8fafc}.energy-layout aside input,.energy-layout aside button{width:100%;margin:5px 0}.warn{color:#b91c1c}</style>","role":"assistant"},"index":0,"finish_reason":"stop"}],"created":1795021789,"object":"chat.completion","usage":{"total_tokens":33434,"completion_tokens":1907,"prompt_tokens":31527,"prompt_tokens_details":{"cached_tokens":0}}}