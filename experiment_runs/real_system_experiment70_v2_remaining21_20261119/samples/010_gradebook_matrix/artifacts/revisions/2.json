{
  "code": "<template><section class=\"gradebook-matrix\"><header><div><p class=\"muted\">{{published ? '\u6210\u7ee9\u5df2\u53d1\u5e03' : changeCount + ' \u9879\u672a\u53d1\u5e03\u53d8\u66f4'}}</p><h2>{{courseTitle}}</h2></div><button class=\"primary\" on-click=\"publish\">\u53d1\u5e03\u6210\u7ee9</button></header><div class=\"metric-strip\"><article><span>\u73ed\u7ea7\u5747\u5206</span><strong>{{classAverage}}</strong></article><article><span>\u901a\u8fc7\u7387</span><strong>{{passRate}}%</strong></article><article><span>\u5b66\u751f\u6570</span><strong>{{students.length}}</strong></article></div><div class=\"toolbar\"><select on-change=\"updateSort\" value=\"{{sortMode}}\"><option value=\"name\">\u6309\u59d3\u540d</option><option value=\"score\">\u6309\u603b\u5206</option></select><label><input type=\"checkbox\" on-change=\"toggleFailing\" checked=\"{{failingOnly}}\"/> \u4ec5\u770b\u4e0d\u53ca\u683c</label><button on-click=\"resetWeights\">\u6062\u590d\u6743\u91cd</button></div><div class=\"gradebook-layout\"><table><thead><tr><th>\u5b66\u751f</th><th s-for=\"assignment in assignments trackby assignment.id\">{{assignment.label}}<input type=\"number\" on-input=\"updateWeight(assignment.id, $event)\" value=\"{{weights[assignment.id]}}\"/>%</th><th>\u603b\u5206</th></tr></thead><tbody><tr s-for=\"student in rows trackby student.id\" class=\"{{student.failing ? 'failing' : ''}}\"><th><button on-click=\"selectStudent(student.id)\">{{student.name}}</button></th><td s-for=\"assignment in assignments trackby assignment.id\"><input type=\"number\" on-input=\"updateGrade(student.id, assignment.id, $event)\" value=\"{{student.grades[assignment.id]}}\" class=\"{{gradeClass(student.grades[assignment.id])}}\"/></td><td><strong>{{student.total}}</strong><small>{{letterGrade(student.total)}}</small></td></tr></tbody></table><aside s-if=\"selectedStudent\"><button on-click=\"closeDetail\">\u00d7</button><h3>{{selectedStudent.name}}</h3><dl><div s-for=\"assignment in assignments trackby assignment.id\"><dt>{{assignment.label}}</dt><dd>{{selectedStudent.grades[assignment.id]}}</dd></div></dl><p>\u6700\u8fd1\u7f16\u8f91\uff1a{{lastEdited || '\u65e0'}}</p></aside></div></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: \"GradebookMatrix\",dataTypes: {courseTitle: DataTypes.string,assignments: DataTypes.array,initialStudents: DataTypes.array},initData() {return {students: [],weights: {},sortMode: \"name\",failingOnly: false,selectedId: null,published: false,changeCount: 0,lastEdited: \"\"}},inited() {const initialStudents = this.data.get('initialStudents');const students = initialStudents.map(item => ({id: item.id,name: item.name,grades: Object.assign({}, item.grades)}));this.data.set('students', students);const assignments = this.data.get('assignments');const weights = {};assignments.forEach(item => {weights[item.id] = item.weight});this.data.set('weights', weights);this.watch('changeCount', () => {this.data.set('published', false);})},setValue(key, value) {this.data.set(key, value)},emitEvent(name, payload) {this.fire(name, payload)},updateSort(event) {this.data.set('sortMode', event.target.value)},toggleFailing(event) {this.data.set('failingOnly', event.target.checked)},selectStudent(id) {this.data.set('selectedId', id)},closeDetail() {this.data.set('selectedId', null)},updateGrade(studentId, assignmentId, event) {const value = Math.max(0, Math.min(100, Number(event.target.value) || 0));const students = this.data.get('students');const nextStudents = students.map(student => student.id === studentId ? Object.assign({}, student, {grades: Object.assign({}, student.grades, {[assignmentId]: value})}) : student);this.data.set('students', nextStudents);this.data.set('changeCount', this.data.get('changeCount') + 1);this.data.set('lastEdited', studentId + ':' + assignmentId);this.emitEvent('grade-change', {studentId, assignmentId, value})},updateWeight(id, event) {const weights = this.data.get('weights');const nextWeights = Object.assign({}, weights, {[id]: Number(event.target.value) || 0});this.data.set('weights', nextWeights);this.data.set('changeCount', this.data.get('changeCount') + 1)},resetWeights() {const assignments = this.data.get('assignments');const next = {};assignments.forEach(item => {next[item.id] = item.weight});this.data.set('weights', next);this.data.set('changeCount', this.data.get('changeCount') + 1)},publish() {this.data.set('published', true);const rows = this.data.get('rows');const payload = rows.map(row => ({id: row.id, total: row.total}));this.emitEvent('publish', payload)},gradeClass(value) {return value < 60 ? 'low' : value >= 90 ? 'high' : ''},letterGrade(value) {return value >= 90 ? 'A' : value >= 80 ? 'B' : value >= 70 ? 'C' : value >= 60 ? 'D' : 'F'},computed: {rows() {const weights = this.data.get('weights');const totalWeight = Object.keys(weights).reduce((sum, key) => sum + weights[key], 0) || 1;const students = this.data.get('students');const assignments = this.data.get('assignments');const rows = students.map(student => {const total = assignments.reduce((sum, item) => sum + (student.grades[item.id] || 0) * (weights[item.id] || 0), 0) / totalWeight;return Object.assign({}, student, {total: Math.round(total), failing: total < 60});});const failingOnly = this.data.get('failingOnly');const filtered = failingOnly ? rows.filter(row => row.failing) : rows;const sortMode = this.data.get('sortMode');return filtered.slice().sort((a, b) => sortMode === 'score' ? b.total - a.total : a.name.localeCompare(b.name, 'zh-CN'));},classAverage() {const rows = this.data.get('rows');return rows.length ? Math.round(rows.reduce((sum, row) => sum + row.total, 0) / rows.length) : 0;},passRate() {const rows = this.data.get('rows');return rows.length ? Math.round(rows.filter(row => !row.failing).length / rows.length * 100) : 0;},selectedStudent() {const students = this.data.get('students');const selectedId = this.data.get('selectedId');return students.find(item => item.id === selectedId) || null;}}});</script><style>.gradebook-matrix{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:6px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.gradebook-matrix *{box-sizing:border-box}.gradebook-matrix h2,.gradebook-matrix h3,.gradebook-matrix p{margin-top:0}.gradebook-matrix h2{margin-bottom:14px;font-size:21px}.gradebook-matrix button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:4px;background:#fff;color:#273746;cursor:pointer}.gradebook-matrix button.primary{border-color:#1d4ed8;background:#1d4ed8;color:#fff}.gradebook-matrix button:disabled{opacity:.45;cursor:not-allowed}.gradebook-matrix input,.gradebook-matrix select,.gradebook-matrix textarea{padding:8px;border:1px solid #b9c3cc;border-radius:4px;font:inherit}.gradebook-matrix .toolbar,.gradebook-matrix .summary,.gradebook-matrix .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.gradebook-matrix .muted{color:#71808e;font-size:12px}.gradebook-matrix .empty{padding:24px;color:#7c8792;text-align:center;border:1px dashed #c8d0d8}header,.metric-strip{display:flex;justify-content:space-between}.metric-strip{gap:8px;margin:12px 0}.metric-strip article{flex:1;padding:12px;background:#eff6ff}.metric-strip strong{display:block;font-size:24px}.gradebook-layout{display:grid;grid-template-columns:1fr auto;gap:12px;overflow:auto}table{width:100%;border-collapse:collapse}th,td{padding:8px;border:1px solid #dce2e8;text-align:center}thead input{width:54px}tbody input{width:60px}.low{border-color:#dc2626!important}.high{border-color:#15803d!important}tr.failing{background:#fff7ed}td small{display:block}aside{width:180px;padding:12px;background:#f8fafc}dl div{display:flex;justify-content:space-between}</style>",
