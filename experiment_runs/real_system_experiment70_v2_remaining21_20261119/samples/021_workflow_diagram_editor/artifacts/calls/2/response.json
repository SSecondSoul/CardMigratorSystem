{"model":"qwen-plus","id":"chatcmpl-6f8f57be-29a6-9030-9c1c-c8108da010b4","choices":[{"message":{"content":"<template><section class=\"workflow-diagram-editor\"><header><div><small>图校验 · {{validationErrors.length}} 个问题</small><h2>{{title}}</h2></div><div><button on-click=\"undo\" disabled=\"{{!undoStack.length}}\">撤销</button><button class=\"primary\" on-click=\"run\" disabled=\"{{!canRun}}\">模拟运行</button></div></header><nav><button s-for=\"type in nodeTypes trackby type\" on-click=\"addNode(type)\">新增 {{type}}</button><span>连线：{{edgeSummary || '暂无'}}</span></nav><div class=\"diagram-layout\"><main class=\"canvas\"><article s-for=\"node in nodes trackby node.id\" class=\"{{(selectedId === node.id ? 'selected ' : '') + (node.enabled ? '' : 'disabled')}}\" style=\"{{nodeStyle(node)}}\" on-click=\"selectNode(node.id)\"><strong>{{node.label}}</strong><small>{{node.type}} #{{node.id}}</small><button on-click=\"beginConnect(node.id)\">{{connectFrom === node.id ? '选择目标' : '连线'}}</button></article></main><aside><h3>节点属性</h3><div s-if=\"selectedNode\"><strong>{{selectedNode.label}}</strong><p>位置 {{selectedNode.x}}, {{selectedNode.y}}</p><div class=\"nudge\"><button on-click=\"nudgeNode(selectedNode.id, -5, 0)\">←</button><button on-click=\"nudgeNode(selectedNode.id, 0, -5)\">↑</button><button on-click=\"nudgeNode(selectedNode.id, 0, 5)\">↓</button><button on-click=\"nudgeNode(selectedNode.id, 5, 0)\">→</button></div><button on-click=\"toggleNode(selectedNode.id)\">{{selectedNode.enabled ? '停用' : '启用'}}</button></div><ul><li s-for=\"error in validationErrors trackby error\">{{error}}</li></ul></aside></div><footer><span s-for=\"entry in runLog trackby entry.id\">{{entry.text}}</span></footer></section></template><script>const san = require('san');\nconst DataTypes = san.DataTypes;\nmodule.exports = san.defineComponent({\n    name: 'WorkflowDiagramEditor',\n    dataTypes: {\n        title: DataTypes.string,\n        initialNodes: DataTypes.array,\n        initialEdges: DataTypes.array,\n        nodeTypes: DataTypes.array,\n        readonly: DataTypes.bool\n    },\n    initData() {\n        return {\n            title: \"订单履约工作流\",\n            initialNodes: [{\n                \"id\": 1,\n                \"label\": \"接收订单\",\n                \"type\": \"trigger\",\n                \"x\": 8,\n                \"y\": 18,\n                \"enabled\": true\n            }, {\n                \"id\": 2,\n                \"label\": \"库存校验\",\n                \"type\": \"condition\",\n                \"x\": 38,\n                \"y\": 48,\n                \"enabled\": true\n            }, {\n                \"id\": 3,\n                \"label\": \"创建运单\",\n                \"type\": \"action\",\n                \"x\": 70,\n                \"y\": 20,\n                \"enabled\": true\n            }],\n            initialEdges: [{\n                \"from\": 1,\n                \"to\": 2\n            }, {\n                \"from\": 2,\n                \"to\": 3\n            }],\n            nodeTypes: [\"trigger\", \"condition\", \"action\"],\n            readonly: false,\n            nodes: [],\n            edges: [],\n            selectedId: null,\n            connectFrom: null,\n            undoStack: [],\n            validationErrors: [],\n            runLog: [],\n            nextId: 10\n        };\n    },\n    inited() {\n        this.data.set('nodes', this.data.get('initialNodes').map(item => Object.assign({}, item)));\n        this.data.set('edges', this.data.get('initialEdges').map(item => Object.assign({}, item)));\n        this.validateGraph();\n    },\n    setValue(key, value) {\n        this.data.set(key, value);\n    },\n    emitEvent(name, payload) {\n        this.fire(name, payload);\n    },\n    snapshot() {\n        const nodes = this.data.get('nodes').map(item => Object.assign({}, item));\n        const edges = this.data.get('edges').map(item => Object.assign({}, item));\n        const currentStack = this.data.get('undoStack');\n        this.data.set('undoStack', [{ nodes, edges }].concat(currentStack).slice(0, 8));\n    },\n    selectNode(id) {\n        this.data.set('selectedId', id);\n    },\n    addNode(type) {\n        if (this.data.get('readonly')) return;\n        this.snapshot();\n        const id = this.data.get('nextId');\n        const newNode = {\n            id,\n            label: '新' + type,\n            type,\n            x: 12 + id * 5 % 70,\n            y: 15 + id * 9 % 60,\n            enabled: true\n        };\n        this.data.set('nodes', this.data.get('nodes').concat(newNode));\n        this.data.set('nextId', id + 1);\n        this.validateGraph();\n    },\n    nudgeNode(id, dx, dy) {\n        if (this.data.get('readonly')) return;\n        this.snapshot();\n        const nodes = this.data.get('nodes').map(node =>\n            node.id === id\n                ? Object.assign({}, node, {\n                    x: Math.max(0, Math.min(86, node.x + dx)),\n                    y: Math.max(0, Math.min(75, node.y + dy))\n                })\n                : node\n        );\n        this.data.set('nodes', nodes);\n        this.emitEvent('graph-change', {\n            nodes: this.data.get('nodes'),\n            edges: this.data.get('edges')\n        });\n    },\n    beginConnect(id) {\n        const connectFrom = this.data.get('connectFrom');\n        if (connectFrom === null) {\n            this.data.set('connectFrom', id);\n            return;\n        }\n        if (connectFrom !== id && !this.data.get('edges').some(edge => edge.from === connectFrom && edge.to === id)) {\n            this.snapshot();\n            this.data.set('edges', this.data.get('edges').concat({ from: connectFrom, to: id }));\n        }\n        this.data.set('connectFrom', null);\n        this.validateGraph();\n    },\n    toggleNode(id) {\n        this.snapshot();\n        const nodes = this.data.get('nodes').map(node =>\n            node.id === id\n                ? Object.assign({}, node, { enabled: !node.enabled })\n                : node\n        );\n        this.data.set('nodes', nodes);\n        this.validateGraph();\n    },\n    validateGraph() {\n        const nodes = this.data.get('nodes');\n        const edges = this.data.get('edges');\n        const ids = nodes.map(item => item.id);\n        const incoming = {};\n        edges.forEach(edge => { incoming[edge.to] = true; });\n        const errors = [];\n        if (!nodes.some(item => item.type === 'trigger')) errors.push('缺少触发节点');\n        nodes.forEach((node, index) => {\n            if (index && !incoming[node.id]) errors.push(node.label + ' 没有入边');\n        });\n        if (edges.some(edge => ids.indexOf(edge.from) < 0 || ids.indexOf(edge.to) < 0)) errors.push('存在悬空连线');\n        this.data.set('validationErrors', errors);\n        this.emitEvent('validate', errors);\n    },\n    run() {\n        if (!this.data.get('canRun')) return;\n        const enabledNodes = this.data.get('enabledNodes');\n        const runLog = enabledNodes.map((node, index) => ({\n            id: index + 1,\n            text: '执行：' + node.label\n        }));\n        this.data.set('runLog', runLog);\n        this.emitEvent('run', enabledNodes);\n    },\n    undo() {\n        const undoStack = this.data.get('undoStack');\n        if (!undoStack.length) return;\n        const previous = undoStack[0];\n        this.data.set('nodes', previous.nodes);\n        this.data.set('edges', previous.edges);\n        this.data.set('undoStack', undoStack.slice(1));\n        this.validateGraph();\n    },\n    nodeStyle(node) {\n        return 'left:' + node.x + '%;top:' + node.y + '%';\n    },\n    computed: {\n        selectedNode() {\n            const nodes = this.data.get('nodes');\n            const selectedId = this.data.get('selectedId');\n            return nodes.find(item => item.id === selectedId) || null;\n        },\n        enabledNodes() {\n            return this.data.get('nodes').filter(item => item.enabled);\n        },\n        canRun() {\n            return this.data.get('validationErrors').length === 0 && this.data.get('nodes').length > 1;\n        },\n        edgeSummary() {\n            return this.data.get('edges').map(edge => edge.from + '→' + edge.to).join('，');\n        }\n    }\n});</script><style>.workflow-diagram-editor{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.workflow-diagram-editor *{box-sizing:border-box}.workflow-diagram-editor h2,.workflow-diagram-editor h3,.workflow-diagram-editor p{margin-top:0}.workflow-diagram-editor button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.workflow-diagram-editor button.primary{border-color:#7c3aed;background:#7c3aed;color:#fff}.workflow-diagram-editor button:disabled{opacity:.45;cursor:not-allowed}.workflow-diagram-editor input,.workflow-diagram-editor select,.workflow-diagram-editor textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.workflow-diagram-editor .muted{color:#71808e;font-size:12px}.workflow-diagram-editor .toolbar,.workflow-diagram-editor .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header,nav{display:flex;justify-content:space-between;gap:8px;align-items:center}.diagram-layout{display:grid;grid-template-columns:1fr 210px;gap:12px;margin-top:12px}.canvas{position:relative;min-height:360px;background:linear-gradient(#eef2ff 1px,transparent 1px),linear-gradient(90deg,#eef2ff 1px,transparent 1px);background-size:24px 24px}.canvas article{position:absolute;width:130px;padding:10px;background:white;border:2px solid #a5b4fc;border-radius:10px}.canvas article.selected{border-color:#4f46e5;box-shadow:0 0 0 3px #e0e7ff}.canvas article.disabled{opacity:.45}.canvas small,.canvas button{display:block;margin-top:5px}.diagram-layout aside{padding:12px;background:#f8fafc}.nudge{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}.diagram-layout ul{padding-left:18px;color:#b91c1c}footer{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}footer span{padding:5px 8px;background:#ecfdf5}</style>","role":"assistant"},"index":0,"finish_reason":"stop"}],"created":1795026012,"object":"chat.completion","usage":{"total_tokens":20160,"completion_tokens":2515,"prompt_tokens":17645,"prompt_tokens_details":{"cached_tokens":0}}}