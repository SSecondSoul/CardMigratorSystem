{
  "code": "<template><section class=\"schema-mapping-workbench\"><header><div><p class=\"muted\">{{mappedCount}} \u6761\u89c4\u5219</p><h2>{{title}}</h2></div><div class=\"actions\"><button on-click=\"togglePreview\">{{previewMode ? '\u7f16\u8f91' : '\u9884\u89c8'}}</button><button on-click=\"validateMappings\">\u6821\u9a8c</button><button class=\"primary\" on-click=\"submit\">\u63d0\u4ea4</button></div></header><div class=\"mapping-layout\"><aside><h3>\u6e90\u5b57\u6bb5</h3><button s-for=\"field, index in unmappedSources trackby field.key\" class=\"{{field.key === sourceKey ? 'selected' : ''}}\" on-click=\"selectSource(field.key)\"><strong>{{field.key}}</strong><small>{{field.type}}</small></button></aside><main><article s-for=\"mapping, index in mappings trackby mapping.id\"><div><strong>{{mapping.source}}</strong><small>{{fieldType(mapping.source, sourceFields)}}</small></div><span>\u2192</span><select on-change=\"updateTransform(mapping.id, $event)\" value=\"{{mapping.transform}}\" disabled=\"{{previewMode}}\"><option s-for=\"transform, idx in transforms trackby transform\" value=\"{{transform}}\">{{transform}}</option></select><span>\u2192</span><div><strong>{{mapping.target}}</strong><small>{{fieldType(mapping.target, targetFields)}}</small></div><button s-if=\"!previewMode\" on-click=\"removeMapping(mapping.id)\">\u5220\u9664</button></article><p class=\"empty\" s-if=\"!mappings.length\">\u9009\u62e9\u5b57\u6bb5\u5efa\u7acb\u6620\u5c04</p><button class=\"connect\" on-click=\"connect\" disabled=\"{{!canConnect || previewMode}}\">\u8fde\u63a5\u6240\u9009\u5b57\u6bb5</button><section class=\"{{issues.length ? 'validation bad' : 'validation good'}}\" s-if=\"validated\"><h3>{{issues.length ? '\u53d1\u73b0\u95ee\u9898' : '\u6821\u9a8c\u901a\u8fc7'}}</h3><ul><li s-for=\"issue, idx in issues trackby issue\">{{issue}}</li></ul></section></main><aside><h3>\u76ee\u6807\u5b57\u6bb5</h3><button s-for=\"field, index in unmappedTargets trackby field.key\" class=\"{{field.key === targetKey ? 'selected' : ''}}\" on-click=\"selectTarget(field.key)\"><strong>{{field.key}}</strong><small>{{field.type}}{{field.required ? ' \u00b7 \u5fc5\u586b' : ''}}</small></button></aside></div></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: 'SchemaMappingWorkbench',dataTypes: {title: DataTypes.string,sourceFields: DataTypes.array,targetFields: DataTypes.array,initialMappings: DataTypes.array},initData() {return {title: \"\u5ba2\u6237\u6570\u636e\u6620\u5c04\",sourceFields: [{\"key\": \"full_name\",\"type\": \"string\"},{\"key\": \"birth_year\",\"type\": \"number\"},{\"key\": \"email_addr\",\"type\": \"string\"}],targetFields: [{\"key\": \"name\",\"type\": \"string\",\"required\": true},{\"key\": \"age\",\"type\": \"number\",\"required\": false},{\"key\": \"email\",\"type\": \"string\",\"required\": true}],initialMappings: [{\"id\": 1,\"source\": \"full_name\",\"target\": \"name\",\"transform\": \"trim\"}],mappings: [],sourceKey: \"\",targetKey: \"\",issues: [],validated: false,previewMode: false,nextId: 10,transforms: [\"none\", \"trim\", \"uppercase\", \"to-number\"]};},inited() {const initialMappings = this.data.get('initialMappings');this.data.set('mappings', initialMappings.map(item => Object.assign({}, item)));},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},selectSource(key) {this.data.set('sourceKey', key);this.data.set('validated', false);},selectTarget(key) {this.data.set('targetKey', key);this.data.set('validated', false);},connect() {if (!this.data.get('canConnect')) return;const nextId = this.data.get('nextId');const sourceKey = this.data.get('sourceKey');const targetKey = this.data.get('targetKey');const mappings = this.data.get('mappings');this.data.set('mappings', mappings.concat({id: nextId,source: sourceKey,target: targetKey,transform: 'none'}));this.data.set('nextId', nextId + 1);this.data.set('sourceKey', '');this.data.set('targetKey', '');this.data.set('validated', false);},removeMapping(id) {const mappings = this.data.get('mappings');this.data.set('mappings', mappings.filter(item => item.id !== id));this.data.set('validated', false);},updateTransform(id, event) {const mappings = this.data.get('mappings');this.data.set('mappings', mappings.map(item => item.id === id ? Object.assign({}, item, {transform: event.target.value}) : item));this.data.set('validated', false);},validateMappings() {const mappings = this.data.get('mappings');const issues = [];const targetFields = this.data.get('targetFields');targetFields.filter(field => field.required).forEach(field => {if (!mappings.some(item => item.target === field.key)) {issues.push('\u5fc5\u586b\u5b57\u6bb5 ' + field.key + ' \u672a\u6620\u5c04');}});mappings.forEach(item => {const source = this.data.get('sourceFields').find(field => field.key === item.source);const target = this.data.get('targetFields').find(field => field.key === item.target);if (source && target && source.type !== target.type && item.transform !== 'to-number') {issues.push(item.source + ' \u4e0e ' + item.target + ' \u7c7b\u578b\u4e0d\u4e00\u81f4');}});this.data.set('issues', issues);this.data.set('validated', true);this.emitEvent('validate', issues);},togglePreview() {this.data.set('previewMode', !this.data.get('previewMode'));},submit() {this.validateMappings();if (!this.data.get('issues').length) {this.emitEvent('submit', this.data.get('mappings'));}},fieldType(key, list) {const field = list.find(item => item.key === key);return field ? field.type : '';},computed: {unmappedSources() {const used = this.data.get('mappings').map(item => item.source);return this.data.get('sourceFields').filter(field => used.indexOf(field.key) < 0);},unmappedTargets() {const used = this.data.get('mappings').map(item => item.target);return this.data.get('targetFields').filter(field => used.indexOf(field.key) < 0);},mappedCount() {return this.data.get('mappings').length;},canConnect() {return !!this.data.get('sourceKey') && !!this.data.get('targetKey');}}});</script><style>.schema-mapping-workbench { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.schema-mapping-workbench * { box-sizing: border-box; }\n.schema-mapping-workbench h2, .schema-mapping-workbench h3, .schema-mapping-workbench p { margin-top: 0; }\n.schema-mapping-workbench h2 { margin-bottom: 14px; font-size: 21px; }\n.schema-mapping-workbench button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.schema-mapping-workbench button.primary { border-color: #7c3aed; background: #7c3aed; color: #fff; }\n.schema-mapping-workbench button:disabled { opacity: .45; cursor: not-allowed; }\n.schema-mapping-workbench input, .schema-mapping-workbench select, .schema-mapping-workbench textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.schema-mapping-workbench .toolbar, .schema-mapping-workbench .summary, .schema-mapping-workbench .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.schema-mapping-workbench .muted { color: #71808e; font-size: 12px; }\n.schema-mapping-workbench .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\nheader{display:flex;justify-content:space-between}.mapping-layout{display:grid;grid-template-columns:145px 1fr 145px;gap:12px;margin-top:14px}.mapping-layout>aside{padding:10px;background:#f6f5fb}.mapping-layout>aside button{display:block;width:100%;margin:6px 0;text-align:left}.mapping-layout>aside button.selected{background:#ede9fe;border-color:#7c3aed}.mapping-layout small{display:block}.mapping-layout main>article{display:grid;grid-template-columns:1fr 18px 100px 18px 1fr auto;align-items:center;gap:5px;padding:10px;border-bottom:1px solid #e3e2e9}.connect{display:block;margin:12px auto}.validation{padding:12px}.validation.bad{background:#fef2f2}.validation.good{background:#f0fdf4}\n</style>",
