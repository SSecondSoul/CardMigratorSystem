{
  "code": "<template><main class=\"forecast-simulator\"><header class=\"simulator-header\"><div><span class=\"eyebrow\">\u60c5\u666f\u63a8\u6f14</span><h1>{{title}}</h1><p>\u8c03\u6574\u7ecf\u8425\u5047\u8bbe\u5e76\u6bd4\u8f83\u9884\u6d4b\u7ed3\u679c</p></div><div class=\"header-actions\"><button class=\"secondary\" type=\"button\" on-click=\"reset\">\u6062\u590d\u57fa\u7ebf</button><button type=\"button\" on-click=\"runSimulation\" disabled=\"{{running}}\">{{running ? '\u8ba1\u7b97\u4e2d' : '\u8fd0\u884c\u6a21\u62df'}}</button></div></header><section class=\"simulator-layout\"><aside class=\"assumption-panel\"><div class=\"panel-title\"><strong>\u6a21\u578b\u53c2\u6570</strong><small>{{scenarioName}}</small></div><label>\u521d\u59cb\u6708\u6536\u5165<input min=\"1000\" type=\"number\" value=\"{{assumptions.baseRevenue}}\" on-input=\"updateAssumption('baseRevenue', $event)\"></label><label>\u6708\u589e\u957f\u7387 %<input max=\"50\" min=\"-20\" type=\"number\" value=\"{{assumptions.monthlyGrowth}}\" on-input=\"updateAssumption('monthlyGrowth', $event)\"></label><label>\u5ba2\u6237\u6d41\u5931\u7387 %<input max=\"30\" min=\"0\" type=\"number\" value=\"{{assumptions.churn}}\" on-input=\"updateAssumption('churn', $event)\"></label><label>\u8425\u9500\u6295\u5165<input min=\"0\" type=\"number\" value=\"{{assumptions.marketing}}\" on-input=\"updateAssumption('marketing', $event)\"></label><label>\u5355\u4f4d\u670d\u52a1\u6210\u672c<input min=\"0\" type=\"number\" value=\"{{assumptions.unitCost}}\" on-input=\"updateAssumption('unitCost', $event)\"></label><button class=\"save-scenario\" type=\"button\" on-click=\"saveScenario\">\u4fdd\u5b58\u5f53\u524d\u60c5\u666f</button><p class=\"error-message\" s-if=\"error\">{{error}}</p></aside><section class=\"forecast-panel\"><div class=\"metric-tabs\"><button type=\"button\" s-for=\"metric in metrics trackby metric.key\" on-click=\"selectMetric(metric.key)\" class=\"{{selectedMetric === metric.key ? 'active' : ''}}\">{{metric.label}}</button></div><div class=\"forecast-chart\"><div class=\"bar-column\" s-for=\"point in chartBars trackby point.month\"><span class=\"bar-value\">{{point.label}}</span><span class=\"bar\" style=\"{{'height: ' + point.height + '%'}}\"></span><small>M{{point.month}}</small></div></div><div class=\"forecast-summary\"><article><span>\u7d2f\u8ba1\u6536\u5165</span><strong>\u00a5{{formatNumber(totalRevenue)}}</strong></article><article><span>\u5cf0\u503c\u6708\u4efd</span><strong>M{{peakMonth}}</strong></article><article><span>\u671f\u672b\u5ba2\u6237</span><strong>{{endingCustomers}}</strong></article><article><span>\u9884\u8ba1\u5229\u6da6</span><strong>\u00a5{{formatNumber(totalProfit)}}</strong></article></div><details class=\"data-table\"><summary>\u67e5\u770b\u6708\u5ea6\u660e\u7ec6</summary><table><thead><tr><th>\u6708\u4efd</th><th>\u6536\u5165</th><th>\u5ba2\u6237</th><th>\u6210\u672c</th><th>\u5229\u6da6</th></tr></thead><tbody><tr s-for=\"row in series trackby row.month\"><td>M{{row.month}}</td><td>{{row.revenue}}</td><td>{{row.customers}}</td><td>{{row.cost}}</td><td>{{row.profit}}</td></tr></tbody></table></details></section></section><section class=\"scenario-panel\"><div class=\"panel-title\"><strong>\u5df2\u4fdd\u5b58\u60c5\u666f</strong><span>\u9009\u62e9\u6700\u591a\u4e24\u4e2a\u7528\u4e8e\u5bf9\u6bd4</span></div><div class=\"scenario-list\"><article s-for=\"scenario in savedScenarios trackby scenario.id\" class=\"{{isCompared(scenario.id, compareIds) ? 'compared' : ''}}\"><div><strong>{{scenario.name}}</strong><small>\u7d2f\u8ba1 \u00a5{{formatNumber(scenario.totalRevenue)}}</small></div><button type=\"button\" on-click=\"toggleCompare(scenario.id)\">{{isCompared(scenario.id, compareIds) ? '\u53d6\u6d88\u5bf9\u6bd4' : '\u52a0\u5165\u5bf9\u6bd4'}}</button><button class=\"remove\" type=\"button\" on-click=\"removeScenario(scenario.id)\">\u5220\u9664</button></article></div><p class=\"empty-state\" s-if=\"!savedScenarios.length\">\u5c1a\u672a\u4fdd\u5b58\u60c5\u666f</p></section><footer class=\"simulator-footer\"><span>\u5f53\u524d\u6307\u6807\uff1a{{selectedMetricLabel}}</span><span>\u6700\u540e\u8fd0\u884c\uff1a{{lastRun || '\u5c1a\u672a\u8fd0\u884c'}}</span></footer></main></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"ForecastSimulator\",dataTypes:{title:DataTypes.string,scenarioName:DataTypes.string,horizon:DataTypes.number,initialAssumptions:DataTypes.object},initData(){return {assumptions:{},series:[],savedScenarios:[],selectedMetric:\"revenue\",compareIds:[],running:false,error:\"\",lastRun:\"\",simulationTimer:null,nextScenarioId:1,metrics:[{key:\"revenue\",label:\"\u6536\u5165\"},{key:\"customers\",label:\"\u5ba2\u6237\"},{key:\"profit\",label:\"\u5229\u6da6\"}]}},inited(){this.data.set(\"assumptions\",Object.assign({},this.data.get(\"initialAssumptions\")));},attached(){this.runSimulation();},disposed(){clearTimeout(this.data.get(\"simulationTimer\"));},updateAssumption(key,event){const value=Number(event.target.value);const assumptions=this.data.get(\"assumptions\");const newAssumptions=Object.assign({},assumptions);newAssumptions[key]=value;this.data.set(\"assumptions\",newAssumptions);},buildSeries(){const rows=[];let revenue=this.data.get(\"assumptions\").baseRevenue;let customers=Math.max(1,Math.round(revenue/400));for(let month=1;month<=this.data.get(\"horizon\");month+=1){const acquired=Math.round(this.data.get(\"assumptions\").marketing/120);customers=Math.max(1,Math.round(customers*(1-this.data.get(\"assumptions\").churn/100)+acquired));revenue=Math.round(revenue*(1+this.data.get(\"assumptions\").monthlyGrowth/100)+acquired*90);const cost=Math.round(customers*this.data.get(\"assumptions\").unitCost+this.data.get(\"assumptions\").marketing);rows.push({month:month,revenue:revenue,customers:customers,cost:cost,profit:revenue-cost});}return rows;},runSimulation(){if(this.data.get(\"assumptions\").baseRevenue<=0||this.data.get(\"horizon\")<1){this.data.set(\"error\",\"\u8bf7\u8f93\u5165\u6709\u6548\u7684\u6536\u5165\u4e0e\u9884\u6d4b\u5468\u671f\");return;}this.data.set(\"running\",true);this.data.set(\"error\",\"\");return new Promise(resolve=>{this.data.set(\"simulationTimer\",setTimeout(resolve,120));}).then(()=>{this.data.set(\"series\",this.buildSeries());this.data.set(\"lastRun\",new Date().toLocaleTimeString(\"zh-CN\",{hour:\"2-digit\",minute:\"2-digit\"}));this.data.set(\"running\",false);this.fire(\"run\",this.data.get(\"series\").slice());});},selectMetric(key){this.data.set(\"selectedMetric\",key);},saveScenario(){const scenario={id:this.data.get(\"nextScenarioId\")++,name:`${this.data.get(\"scenarioName\")} ${this.data.get(\"savedScenarios\").length+1}`,totalRevenue:this.data.get(\"totalRevenue\"),assumptions:Object.assign({},this.data.get(\"assumptions\"))};const savedScenarios=this.data.get(\"savedScenarios\");savedScenarios.push(scenario);this.data.set(\"savedScenarios\",savedScenarios);},removeScenario(id){const savedScenarios=this.data.get(\"savedScenarios\").filter(scenario=>scenario.id!==id);const compareIds=this.data.get(\"compareIds\").filter(item=>item!==id);this.data.set(\"savedScenarios\",savedScenarios);this.data.set(\"compareIds\",compareIds);},toggleCompare(id){const compareIds=this.data.get(\"compareIds\");if(compareIds.indexOf(id)>=0){this.data.set(\"compareIds\",compareIds.filter(item=>item!==id));}else{this.data.set(\"compareIds\",compareIds.concat(id).slice(-2));}},formatNumber(value){return Number(value).toLocaleString(\"zh-CN\");},isCompared(id,compareIds){return compareIds.indexOf(id)>=0;},reset(){this.data.set(\"assumptions\",Object.assign({},this.data.get(\"initialAssumptions\")));this.data.set(\"compareIds\",[]);this.runSimulation();},computed:{totalRevenue(){const series=this.data.get(\"series\");return series.reduce((sum,row)=>sum+row.revenue,0);},totalProfit(){const series=this.data.get(\"series\");return series.reduce((sum,row)=>sum+row.profit,0);},peakMonth(){const series=this.data.get(\"series\");if(!series.length)return \"--\";return series.reduce((best,row)=>row.revenue>best.revenue?row:best,series[0]).month;},endingCustomers(){const series=this.data.get(\"series\");return series.length?series[series.length-1].customers:0;},chartBars(){const series=this.data.get(\"series\");const selectedMetric=this.data.get(\"selectedMetric\");const values=series.map(row=>row[selectedMetric]);const max=Math.max.apply(null,values.concat(1));return series.map(row=>({month:row.month,height:Math.max(4,Math.round((row[selectedMetric]/max)*100)),label:row[selectedMetric]}));},selectedMetricLabel(){const metrics=this.data.get(\"metrics\");const metric=metrics.find(item=>item.key===this.data.get(\"selectedMetric\"));return metric?metric.label:\"\";}}});</script><style>.forecast-simulator { width: 900px; padding: 24px; border: 1px solid #cbd5e1; border-radius: 7px; background: #f8fafc; color: #172026; font-family: Arial, sans-serif; }\n.simulator-header { display: flex; justify-content: space-between; gap: 24px; }\n.simulator-header h1 { margin: 3px 0; font-size: 24px; }\n.simulator-header p, .eyebrow { color: #64748b; font-size: 12px; }\n.header-actions { display: flex; gap: 8px; }\n.forecast-simulator button { padding: 8px 11px; border: 1px solid #7c2d12; border-radius: 4px; background: #7c2d12; color: #ffffff; cursor: pointer; }\n.forecast-simulator button.secondary { border-color: #94a3b8; background: #ffffff; color: #334155; }\n.simulator-layout { display: grid; grid-template-columns: 230px 1fr; gap: 16px; margin-top: 20px; }\n.assumption-panel { display: grid; gap: 11px; padding: 16px; border: 1px solid #d6d3d1; background: #fff7ed; }\n.panel-title { display: flex; justify-content: space-between; gap: 14px; }\n.panel-title small, .panel-title span { color: #78716c; font-size: 12px; }\n.assumption-panel label { display: grid; gap: 5px; color: #57534e; font-size: 12px; }\n.assumption-panel input { padding: 8px; border: 1px solid #a8a29e; background: #ffffff; }\n.save-scenario { margin-top: 4px; }\n.error-message { color: #b91c1c; font-size: 12px; }\n.forecast-panel { padding: 16px; border: 1px solid #d1d5db; background: #ffffff; }\n.metric-tabs { display: flex; gap: 5px; }\n.metric-tabs button { background: #ffffff; color: #57534e; border-color: #d6d3d1; }\n.metric-tabs button.active { background: #ffedd5; border-color: #c2410c; color: #9a3412; }\n.forecast-chart { height: 230px; display: grid; grid-template-columns: repeat(12, 1fr); align-items: end; gap: 5px; margin: 18px 0; padding-top: 22px; border-bottom: 1px solid #a8a29e; }\n.bar-column { height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 4px; min-width: 0; }\n.bar { width: 70%; min-height: 4px; background: #c2410c; transition: height 0.25s ease; }\n.bar-value { overflow: hidden; width: 100%; color: #78716c; font-size: 9px; text-align: center; }\n.bar-column small { font-size: 10px; }\n.forecast-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }\n.forecast-summary article { padding: 10px; border-left: 3px solid #c2410c; background: #fff7ed; }\n.forecast-summary span { display: block; color: #78716c; font-size: 11px; }\n.forecast-summary strong { font-size: 16px; }\n.data-table { margin-top: 14px; }\n.data-table table { width: 100%; margin-top: 10px; border-collapse: collapse; font-size: 12px; }\n.data-table th, .data-table td { padding: 7px; border: 1px solid #e7e5e4; }\n.scenario-panel { margin-top: 16px; padding: 16px; border: 1px solid #d1d5db; background: #ffffff; }\n.scenario-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 12px; }\n.scenario-list article { padding: 10px; border: 1px solid #d6d3d1; }\n.scenario-list article.compared { border-color: #c2410c; background: #fff7ed; }\n.scenario-list small { display: block; margin: 4px 0 9px; color: #78716c; }\n.scenario-list button { padding: 5px 7px; font-size: 11px; }\n.scenario-list button.remove { border-color: #a8a29e; background: #ffffff; color: #991b1b; }\n.empty-state { text-align: center; color: #a8a29e; }\n.simulator-footer { display: flex; justify-content: space-between; margin-top: 14px; color: #64748b; font-size: 12px; }\n</style>",
