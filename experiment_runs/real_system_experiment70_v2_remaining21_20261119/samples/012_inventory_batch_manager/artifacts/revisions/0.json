{
  "code": "<template><section class=\"inventory-batch-manager\"><header class=\"page-head\"><div><p class=\"muted\">\u6700\u540e\u540c\u6b65 {{lastSynced}}</p><h2>{{title}}</h2></div><button on-click=\"exportData\">\u5bfc\u51fa\u89c6\u56fe</button></header><div class=\"metric-strip\"><article><span>\u5e93\u5b58\u4ef6\u6570</span><strong>{{summary.units}}</strong></article><article><span>\u4e34\u671f\u6279\u6b21</span><strong>{{summary.expiring}}</strong></article><article><span>\u4f4e\u5e93\u5b58</span><strong>{{summary.low}}</strong></article></div><div class=\"toolbar\"><select on-change=\"updateWarehouse\"><option value=\"all\">\u5168\u90e8\u4ed3\u5e93</option><option s-for=\"item in warehouses\" key=\"{{item}}\" value=\"{{item}}\">{{item}}</option></select><label><input type=\"checkbox\" on-change=\"toggleRisk\" checked=\"{{riskOnly}}\"/> \u4ec5\u770b\u98ce\u9669</label><button on-click=\"selectVisible\">\u5168\u9009\u7ed3\u679c</button><button on-click=\"undo\" disabled=\"{{!history.length}}\">\u64a4\u9500</button></div><div class=\"inventory-layout\"><div><table><thead><tr><th></th><th>\u6279\u6b21</th><th>\u4ed3\u5e93</th><th>\u5e93\u5b58</th><th>\u4fdd\u8d28\u671f</th></tr></thead><tbody><tr s-for=\"batch in visibleBatches\" key=\"{{batch.id}}\" class=\"{{batchRowClass(batch)}}\"><td><input type=\"checkbox\" on-change=\"toggleBatch(batch.id)\" checked=\"{{isSelected(batch.id)}}\"/></td><td><strong>{{batch.product}}</strong><small>{{batch.sku}}</small></td><td>{{batch.warehouse}}</td><td><div class=\"stock-bar\"><span style=\"{{stockStyle(batch)}}\"></span></div>{{batch.quantity}}/{{batch.capacity}}</td><td>{{batch.expiryDays}} \u5929</td></tr></tbody></table><p class=\"empty\" s-if=\"{{!visibleBatches.length}}\">\u6ca1\u6709\u5339\u914d\u6279\u6b21</p></div><aside><h3>\u6279\u91cf\u8c03\u6574</h3><p>\u5df2\u9009 {{selectedCount}} \u6279</p><label>\u6570\u91cf\u53d8\u5316<input type=\"number\" on-input=\"updateAdjustment\" value=\"{{adjustment}}\"/></label><label>\u539f\u56e0<select on-change=\"updateReason\" value=\"{{reason}}\"><option>\u76d8\u70b9\u4fee\u6b63</option><option>\u635f\u8017\u767b\u8bb0</option><option>\u5165\u5e93\u8865\u5f55</option></select></label><button class=\"primary\" on-click=\"applyAdjustment\" disabled=\"{{!canApply}}\">\u5e94\u7528</button><h3>\u64cd\u4f5c\u5386\u53f2</h3><ol><li s-for=\"entry in history\" key=\"{{entry.id}}\">{{entry.reason}}\uff1a{{entry.count}} \u6279</li></ol></aside></div></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"InventoryBatchManager\",dataTypes:{title:DataTypes.string,warehouses:DataTypes.array,initialBatches:DataTypes.array},initData(){return {batches:[],warehouse:\"all\",riskOnly:false,selectedIds:[],adjustment:0,reason:\"\u76d8\u70b9\u4fee\u6b63\",history:[],lastSynced:\"\",timer:null}},inited(){this.setValue(\"batches\",this.initialBatches.map(item=>Object.assign({},item)))},attached(){this.refreshClock();this._timer=setInterval(()=>this.refreshClock(),30000)},disposed(){clearInterval(this._timer)},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},refreshClock(){this.setValue(\"lastSynced\",new Date().toLocaleTimeString(\"zh-CN\",{hour12:false}))},updateWarehouse(event){this.setValue(\"warehouse\",event.target.value);this.setValue(\"selectedIds\",[])},toggleRisk(event){this.setValue(\"riskOnly\",event.target.checked)},isSelected(id){return this.data.get(\"selectedIds\").indexOf(id)>=0},toggleBatch(id){const list=this.data.get(\"selectedIds\");this.setValue(\"selectedIds\",list.indexOf(id)>=0?list.filter(item=>item!==id):list.concat(id))},selectVisible(){this.setValue(\"selectedIds\",this.data.get(\"visibleBatches\").map(item=>item.id))},updateAdjustment(event){this.setValue(\"adjustment\",Number(event.target.value)||0)},updateReason(event){this.setValue(\"reason\",event.target.value)},applyAdjustment(){if(!this.data.get(\"canApply\"))return;const ids=this.data.get(\"selectedIds\");const before=this.data.get(\"batches\").map(item=>Object.assign({},item));const next=this.data.get(\"batches\").map(item=>ids.indexOf(item.id)>=0?Object.assign({},item,{quantity:Math.max(0,Math.min(item.capacity,item.quantity+this.data.get(\"adjustment\")))}) : item);this.setValue(\"batches\",next);this.setValue(\"history\",[{\"id\":Date.now(),\"reason\":this.data.get(\"reason\"),\"count\":ids.length,\"delta\":this.data.get(\"adjustment\"),\"before\":before}].concat(this.data.get(\"history\")).slice(0,5));this.setValue(\"selectedIds\",[]);this.setValue(\"adjustment\",0);this.emitEvent(\"inventory-change\",next)},undo(){const history=this.data.get(\"history\");if(!history.length)return;this.setValue(\"batches\",history[0].before.map(item=>Object.assign({},item)));this.setValue(\"history\",history.slice(1));this.emitEvent(\"inventory-change\",this.data.get(\"batches\"))},exportData(){this.emitEvent(\"export\",this.data.get(\"visibleBatches\"))},stockStyle(batch){return \"width:\"+Math.round(batch.quantity/batch.capacity*100)+\"%\"},batchRowClass(batch){return (this.isSelected(batch.id)?\"selected \":\"\")+(batch.expiryDays<=3?\"risk\":\"\")},computed:{visibleBatches(){return this.data.get(\"batches\").filter(item=>(this.data.get(\"warehouse\")===\"all\"||item.warehouse===this.data.get(\"warehouse\"))&&(!this.data.get(\"riskOnly\")||item.expiryDays<=3||item.quantity<=10))},summary(){return this.data.get(\"batches\").reduce((result,item)=>{result.units+=item.quantity;if(item.expiryDays<=3)result.expiring+=1;if(item.quantity<=10)result.low+=1;return result;},{\"units\":0,\"expiring\":0,\"low\":0})},selectedCount(){return this.data.get(\"selectedIds\").length},canApply(){return this.data.get(\"selectedCount\")>0&&this.data.get(\"adjustment\")!==0}}});</script><style>.inventory-batch-manager { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.inventory-batch-manager * { box-sizing: border-box; }\n.inventory-batch-manager h2, .inventory-batch-manager h3, .inventory-batch-manager p { margin-top: 0; }\n.inventory-batch-manager h2 { margin-bottom: 14px; font-size: 21px; }\n.inventory-batch-manager button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.inventory-batch-manager button.primary { border-color: #0f766e; background: #0f766e; color: #fff; }\n.inventory-batch-manager button:disabled { opacity: .45; cursor: not-allowed; }\n.inventory-batch-manager input, .inventory-batch-manager select, .inventory-batch-manager textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.inventory-batch-manager .toolbar, .inventory-batch-manager .summary, .inventory-batch-manager .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.inventory-batch-manager .muted { color: #71808e; font-size: 12px; }\n.inventory-batch-manager .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\n.page-head,.metric-strip{display:flex;justify-content:space-between}.metric-strip{margin:12px 0;gap:8px}.metric-strip article{flex:1;padding:12px;background:#edf7f5}.metric-strip strong{display:block;font-size:23px}.inventory-layout{display:grid;grid-template-columns:1fr 200px;gap:14px}table{width:100%;border-collapse:collapse}th,td{padding:9px;border-bottom:1px solid #e0e5e9;text-align:left}td small{display:block}tr.selected{background:#ecfdf5}tr.risk{box-shadow:inset 3px 0 #dc2626}.stock-bar{width:75px;height:6px;background:#e5e7eb}.stock-bar span{display:block;height:100%;background:#0f766e}aside{padding:12px;background:#f7f9fa}aside label{display:grid;gap:5px;margin:8px 0}</style>",
