{"model":"qwen-plus","id":"chatcmpl-1da34828-5fe4-92b2-b5b5-1668a2187eb8","choices":[{"message":{"content":"<template><div class=\"task-manager {{isDarkMode ? 'dark-theme' : ''}} {{isCompactMode ? 'compact-mode' : ''}}\" on-dragover=\"\" on-drop=\"onDropToEnd\"><header class=\"app-header\"><div class=\"logo-area\"><span class=\"logo\">✅</span><h1 class=\"title\">智能任务管家</h1><span class=\"version\">v3.0</span></div><div class=\"header-actions\"><button class=\"icon-btn\" on-click=\"toggleCompactMode\" title=\"{{isCompactMode ? '展开模式' : '紧凑模式'}}\">{{isCompactMode ? '📐' : '📏'}}</button><button class=\"icon-btn\" on-click=\"toggleTheme\" title=\"{{isDarkMode ? '亮色模式' : '暗色模式'}}\">{{isDarkMode ? '☀️' : '🌙'}}</button><button class=\"icon-btn\" on-click=\"exportData\" title=\"导出数据\"> 📥 </button><button class=\"icon-btn\" on-click=\"showSettings = true\" title=\"设置\"> ⚙️ </button></div></header><div class=\"stats-section\"><stat-card s-for=\"stat in statistics\" key=\"{{stat.id}}\" label=\"{{stat.label}}\" value=\"{{stat.value}}\" icon=\"{{stat.icon}}\" trend=\"{{stat.trend}}\" color=\"{{stat.color}}\" on-click=\"onStatClick(stat)\"></stat-card></div><div class=\"main-workspace\"><div class=\"tasks-panel\"><div class=\"panel-header\"><h2>📋 任务列表</h2><div class=\"task-controls\"><button class=\"primary-btn\" on-click=\"openTaskModal\"> + 新建任务 </button><div class=\"search-box\"><input type=\"text\" placeholder=\"搜索任务...\" value=\"{{searchKeyword}}\" on-input=\"onSearchChange\"/><span class=\"search-icon\">🔍</span></div></div></div><div class=\"filter-tabs\"><button class=\"filter-tab {{currentFilter === filter.value ? 'active' : ''}}\" s-for=\"filter in filters\" key=\"{{filter.value}}\" on-click=\"setFilter(filter.value)\">{{filter.label}} <span class=\"count\">{{getTaskCount(filter.value)}}</span></button></div><div class=\"task-list\" on-dragover=\"\" on-drop=\"onDropToEnd\"><task-item s-for=\"(task, index) in filteredTasks\" key=\"{{task.id}}\" task=\"{{task}}\" index=\"{{index}}\" draggable=\"true\" on-toggle=\"toggleTaskStatus\" on-edit=\"editTask\" on-view=\"selectTask\" on-delete=\"deleteTask\" on-drag-start=\"onDragStart\" on-drag-end=\"onDragEnd\" on-drop-on=\"onDropOnTask\"></task-item><div class=\"empty-state\" s-if=\"filteredTasks.length === 0\"><span class=\"empty-icon\">📭</span><p>暂无任务，创建一个吧！</p></div></div></div><div class=\"detail-panel\" s-if=\"selectedTask\"><task-detail task=\"{{selectedTask}}\" on-close=\"closeDetail\" on-update=\"updateTask\" on-comment=\"addComment\"></task-detail></div></div><div class=\"modal-overlay\" s-if=\"isModalOpen\" on-click=\"closeModal\"><div class=\"modal-content\"><div class=\"modal-header\"><h3>{{editingTask ? '编辑任务' : '新建任务'}}</h3><button class=\"close-btn\" on-click=\"closeModal\">✕</button></div><task-form key=\"{{editingTask ? editingTask.id : 'new-task'}}\" task=\"{{editingTask}}\" users=\"{{users}}\" tags=\"{{availableTags}}\" on-submit=\"handleTaskSubmit\" on-cancel=\"closeModal\"></task-form></div></div><div class=\"modal-overlay\" s-if=\"showSettings\" on-click=\"showSettings = false\"><div class=\"modal-content\"><div class=\"modal-header\"><h3>⚙️ 系统设置</h3><button class=\"close-btn\" on-click=\"showSettings = false\">✕</button></div><settings-panel settings=\"{{settings}}\" on-update=\"updateSettings\"></settings-panel></div></div><div class=\"notification {{notification.type}}\" s-if=\"notification.show\"><span>{{notification.message}}</span><button on-click=\"hideNotification\">✕</button></div></div></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;const StatCard=san.defineComponent({name:\"StatCard\",props:[\"label\",\"value\",\"icon\",\"trend\",\"color\"],template:`<div class=\"stat-card\" on-click=\"fire('click')\"><div class=\"stat-card-icon\" style=\"{{'background: ' + color + ';'}}\">{{icon}}</div><div class=\"stat-card-content\"><div class=\"stat-card-label\">{{label}}</div><div class=\"stat-card-value\">{{value}}</div><div class=\"stat-card