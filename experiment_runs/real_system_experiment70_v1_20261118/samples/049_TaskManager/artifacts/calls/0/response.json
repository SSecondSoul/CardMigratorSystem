\",\"syncInterval\",e.target.value)}},events:[\"update\"]});module.exports=san.defineComponent({name:\"TaskManager\",dataTypes:{isDarkMode:DataTypes.bool,isCompactMode:DataTypes.bool,showSettings:DataTypes.bool,isModalOpen:DataTypes.bool,tasks:DataTypes.array,selectedTask:DataTypes.any,editingTask:DataTypes.any,currentFilter:DataTypes.string,searchKeyword:DataTypes.string,dragStartIndex:DataTypes.any,users:DataTypes.array,availableTags:DataTypes.array,statistics:DataTypes.array,filters:DataTypes.array,settings:DataTypes.object,notification:DataTypes.object,syncTimer:DataTypes.any,storageKey:DataTypes.string},initData(){return{isDarkMode:false,isCompactMode:false,showSettings:false,isModalOpen:false,tasks:[],selectedTask:null,editingTask:null,currentFilter:\"all\",searchKeyword:\"\",dragStartIndex:null,users:[{id:1,name:\"张三\"},{id:2,name:\"李四\"},{id:3,name:\"王五\"}],availableTags:[\"工作\",\"个人\",\"紧急\",\"学习\",\"休闲\",\"会议\"],statistics:[{color:\"#3b82f6\",icon:\"📊\",id:1,label:\"总任务\",trend:12,value:0},{color:\"#10b981\",icon:\"✅\",id:2,label:\"已完成\",trend:8,value:0},{color:\"#f59e0b\",icon:\"🔄\",id:3,label:\"进行中\",trend:-3,value:0},{color:\"#ef4444\",icon:\"⚠️\",id:4,label:\"逾期任务\",trend:5,value:0}],filters:[{label:\"全部\",value:\"all\"},{label:\"进行中\",value:\"active\"},{label:\"已完成\",value:\"completed\"},{label:\"已逾期\",value:\"overdue\"},{label:\"紧急\",value:\"urgent\"}],settings:{autoSave:true,defaultView:\"list\",notifications:true,syncInterval:60},notification:{message:\"\",show:false,type:\"info\"},syncTimer:null,storageKey:\"task_manager_data\"}},components:{\"stat-card\":StatCard,\"task-item\":TaskItem,\"task-detail\":TaskDetail,\"task-form\":TaskForm,\"settings-panel\":SettingsPanel},attached(){this.loadInitialData();this.startAutoSync();this.showNotification(\"系统初始化完成\",\"success\")},disposed(){if(this.data.get(\"syncTimer\")){clearInterval(this.data.get(\"syncTimer\"))}this.saveToLocalStorage()},loadInitialData(){const saved=localStorage.getItem(this.data.get(\"storageKey\"));if(saved){try{const data=JSON.parse(saved);this.data.set(\"tasks\",data.tasks||this.getSampleTasks());this.data.set(\"settings\",{...this.data.get(\"settings\"),...data.settings})}catch(e){this.data.set(\"tasks\",this.getSampleTasks())}}else{this.data.set(\"tasks\",this.getSampleTasks())}this.updateStatistics()},getSampleTasks(){return[{id:1,title:\"完成项目报告\",description:\"编写Q4季度项目总结报告，包含数据分析和改进建议\",priority:\"high\",dueDate:new Date(Date.now()+2*86400000).toISOString().split(\"T\")[0],tags:[\"工作\",\"紧急\"],completed:false,comments:[],assignee:\"张三\"},{id:2,title:\"学习Vue高级特性\",description:\"深入学习Vue3组合式API和响应式原理\",priority:\"medium\",dueDate:new Date(Date.now()+5*86400000).toISOString().split(\"T\")[0],tags:[\"学习\"],completed:false,comments:[],assignee:\"李四\"},{id:3,title:\"团队会议\",description:\"周例会，讨论项目进展和下周计划\",priority:\"medium\",dueDate:new Date(Date.now()-1*86400000).toISOString().split(\"T\")[0],tags:[\"工作\",\"会议\"],completed:true,comments:[{user:\"张三\",text:\"会议纪要已更新\",time:Date.now()-86400000}],assignee:\"王五\"}]},updateStatistics(){const total=this.data.get(\"tasks\").length;const completed=this.data.get(\"tasks\").filter(function(t){return t.completed}).length;const active=this.data.get(\"tasks\").filter(function(t){return!t.completed&&!this.isOverdue(t)}).length;const overdue=this.data.get(\"tasks\").filter(function(t){return this.isOverdue(t)&&!t.completed}).length;this.data.set(\"statistics\",[{...this.data.get(\"statistics\")[0],value:total},{...this.data.get(\"statistics\")[1],value:completed},{...this.data.get(\"statistics\")[2],value:active},{...this.data.get(\"statistics\")[3],value:overdue}])},isOverdue:function(task){if(task.completed||!task.dueDate)return false;const dueDate=new Date(task.dueDate);const today=new Date();today.setHours(0,0,0,0);return dueDate<today},openTaskModal(){this.data.set(\"editingTask\",null);this.data.set(\"isModalOpen\",true)},editTask:function(task){this.data.set(\"editingTask\",{...task});this.data.set(\"isModalOpen\",true)},selectTask:function(task){this.data.set(\"selectedTask\",task)},handleTaskSubmit:function(formData){if(this.data.get(\"editingTask\")){const index=this.data.get(\"tasks\").findIndex(function(t){return t.id===this.data.get(\"editingTask\").id});if(index!==-1){this.data.set(\"tasks\",[...this.data.get(\"tasks\").slice(0,index),{...this.data.get(\"tasks\")[index],...formData,updatedAt:Date.now()},...this.data.get(\"tasks\").slice(index+1)]);this.showNotification(\"任务更新成功\",\"success\")}}else{const newTask={...formData,id:Date.now(),completed:false,comments:[],createdAt:Date.now()};this.data.set(\"tasks\",[newTask,...this.data.get(\"tasks\")]);this.showNotification(\"任务创建成功\",\"success\")}this.closeModal()},toggleTaskStatus:function(taskId){const task=this.data.get(\"tasks\").find(function(t){return t.id===taskId});if(task){task.completed=!task.completed;this.showNotification(task.completed?\"任务已完成\":\"任务已恢复\",\"info\")}},deleteTask:function(taskId){if(confirm(\"确定删除此任务吗？\")){this.data.set(\"tasks\",this.data.get(\"tasks\").filter(function(t){return t.id!==taskId}));if(this.data.get(\"selectedTask\")&&this.data.get(\"selectedTask\").id===taskId){this.data.set(\"selectedTask\",null)}this.showNotification(\"任务已删除\",\"warning\")}},updateTask:function(updatedData){this.editTask(updatedData)},addComment:function(commentData){const task=this.data.get(\"tasks\").find(function(t){return t.id===commentData.taskId});if(task){task.comments=task.comments||[];task.comments.push({user:\"当前用户\",text:commentData.text,time:Date.now()});this.showNotification(\"评论已添加\",\"success\")}},closeDetail(){this.data.set(\"selectedTask\",null)},onDragStart:function(index){this.data.set(\"dragStartIndex\",index)},onDropOnTask:function(dropIndex){this.moveTask(this.data.get(\"dragStartIndex\"),dropIndex)},onDropToEnd(){this.moveTask(this.data.get(\"dragStartIndex\"),this.data.get(\"filteredTasks\").length-1,true)},onDragEnd(){this.data.set(\"dragStartIndex\",null)},moveTask:functi