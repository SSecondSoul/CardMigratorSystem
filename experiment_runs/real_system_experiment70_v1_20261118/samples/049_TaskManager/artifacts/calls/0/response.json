`<div class=\"task-detail\"><div class=\"detail-header\"><h3>任务详情</h3><div class=\"detail-actions\"><button class=\"edit-detail\" on-click=\"fire('update', task)\">编辑</button><button class=\"close-detail\" on-click=\"fire('close')\">✕</button></div></div><div class=\"detail-content\"><div class=\"detail-field\"><label>标题</label><div class=\"field-value\">{{task.title}}</div></div><div class=\"detail-field\"><label>描述</label><div class=\"field-value\">{{task.description || '无描述'}}</div></div><div class=\"detail-field\"><label>优先级</label><div class=\"field-value\" class=\"{{task.priority}}\">{{getPriorityLabel(task.priority)}}</div></div><div class=\"detail-field\"><label>截止日期</label><div class=\"field-value\">{{formatDate(task.dueDate)}}</div></div><div class=\"detail-field\"><label>标签</label><div class=\"field-value\"><span s-for=\"tag in task.tags\" key=\"{{tag}}\" class=\"detail-tag\">{{tag}}</span></div></div><div class=\"detail-field\"><label>评论</label><div class=\"comments-section\"><div s-for=\"(comment, idx) in task.comments\" key=\"{{idx}}\" class=\"comment-item\"><strong>{{comment.user}}</strong>: {{comment.text}}<small>{{formatTime(comment.time)}}</small></div><div class=\"comment-input\"><input type=\"text\" placeholder=\"添加评论...\" value=\"{{newComment}}\" on-input=\"onInputComment\"/><button on-click=\"addComment\">发送</button></div></div></div></div></div>`,data:function(){return{newComment:\"\"}},methods:{getPriorityLabel:function(priority){const labels={high:\"高优先级\",medium:\"中优先级\",low:\"低优先级\"};return labels[priority]||priority},formatDate:function(date){if(!date)return\"无截止日期\";const d=new Date(date);return`${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`},formatTime:function(time){const d=new Date(time);return d.toLocaleTimeString()},onInputComment:function(e){this.data.set(\"newComment\",e.target.value)},addComment:function(){if(this.data.get(\"newComment\").trim()){this.fire(\"comment\",{taskId:this.data.get(\"task\").id,text:this.data.get(\"newComment\")});this.data.set(\"newComment\",\"\")}}},events:[\"close\",\"update\",\"comment\"]});const TaskForm=san.defineComponent({name:\"TaskForm\",props:[\"task\",\"users\",\"tags\"],template:`<form on-submit.prevent=\"handleSubmit\" class=\"task-form\"><div class=\"form-group\"><label>任务标题 *</label><input type=\"text\" required placeholder=\"输入任务标题\" value=\"{{formData.title}}\" on-input=\"onInputTitle\"/></div><div class=\"form-group\"><label>任务描述</label><textarea rows=\"3\" placeholder=\"详细描述...\" value=\"{{formData.description}}\" on-input=\"onInputDescription\"></textarea></div><div class=\"form-row\"><div class=\"form-group\"><label>优先级</label><select value=\"{{formData.priority}}\" on-change=\"onChangePriority\"><option value=\"low\">低优先级</option><option value=\"medium\">中优先级</option><option value=\"high\">高优先级</option></select></div><div class=\"form-group\"><label>截止日期</label><input type=\"date\" value=\"{{formData.dueDate}}\" on-input=\"onInputDueDate\"/></div></div><div class=\"form-group\"><label>标签</label><div class=\"tag-selector\"><span s-for=\"tag in tags\" key=\"{{tag}}\" class=\"selectable-tag\" class=\"{{formData.tags.includes(tag) ? 'selected' : ''}}\" on-click=\"toggleTag(tag)\">{{tag}}</span></div></div><div class=\"form-group\"><label>负责人</label><select value=\"{{formData.assignee}}\" on-change=\"onChangeAssignee\"><option value=\"\">未分配</option><option s-for=\"user in users\" key=\"{{user.id}}\" value=\"{{user.name}}\">{{user.name}}</option></select></div><div class=\"form-actions\"><button type=\"button\" class=\"cancel-btn\" on-click=\"fire('cancel')\">取消</button><button type=\"submit\" class=\"submit-btn\">{{task ? '更新' : '创建'}}</button></div></form>`,data:function(){return{formData:this.createFormData(this.data.get(\"task\"))}},methods:{createFormData:function(task){return task?{...task,tags:[...(task.tags||[])]}:{title:\"\",description:\"\",priority:\"medium\",dueDate:\"\",tags:[],assignee:\"\"}},onInputTitle:function(e){this.data.s