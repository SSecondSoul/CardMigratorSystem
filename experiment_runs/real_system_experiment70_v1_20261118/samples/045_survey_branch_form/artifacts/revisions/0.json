{
  "code": "<template><form class=\"survey-branch-form\" on-submit=\"submit\"><h2>{{title}}</h2><div s-if=\"!submitted\"><fieldset><legend>\u4f60\u7684\u89d2\u8272</legend><button type=\"button\" class=\"{{role === 'developer' ? 'selected' : ''}}\" on-click=\"selectRole('developer')\">\u5f00\u53d1\u8005</button><button type=\"button\" class=\"{{role === 'manager' ? 'selected' : ''}}\" on-click=\"selectRole('manager')\">\u7ba1\u7406\u8005</button></fieldset><fieldset s-if=\"role\"><legend>{{branchPrompt}}</legend><label s-for=\"tool in tools trackby tool\"><input type=\"checkbox\" checked=\"{{selectedTools.indexOf(tool) >= 0}}\" on-change=\"toggleTool(tool)\"> {{tool}}</label></fieldset><textarea placeholder=\"\u5176\u4ed6\u5efa\u8bae\" value=\"{{comment}}\" on-input=\"updateComment\"></textarea><p class=\"error\" s-if=\"error\">{{error}}</p><button type=\"submit\" class=\"primary\">\u63d0\u4ea4\u95ee\u5377</button></div><div s-else class=\"survey-result\"><strong>\u63d0\u4ea4\u6210\u529f</strong><p>{{summary}}</p><button type=\"button\" on-click=\"restart\">\u91cd\u65b0\u586b\u5199</button></div></form></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"SurveyBranchForm\",dataTypes:{title:DataTypes.string,tools:DataTypes.array},initData(){return {role:\"\",selectedTools:[],comment:\"\",submitted:false,error:\"\"}},computed:{branchPrompt(){const role=this.data.get(\"role\");return role===\"developer\"?\"\u65e5\u5e38\u4f7f\u7528\u54ea\u4e9b\u5de5\u5177\uff1f\":role===\"manager\"?\"\u6700\u5173\u6ce8\u54ea\u7c7b\u534f\u4f5c\u4fe1\u606f\uff1f\":\"\"},summary(){const role=this.data.get(\"role\");const selectedTools=this.data.get(\"selectedTools\");return role+\" / \"+(selectedTools.length?selectedTools.join(\"\u3001\"):\"\u672a\u9009\u62e9\u5de5\u5177\")}},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},selectRole(role){this.data.set(\"role\",role);this.data.set(\"selectedTools\",[])},toggleTool(tool){const list=this.data.get(\"selectedTools\");this.data.set(\"selectedTools\",list.indexOf(tool)>=0?list.filter(item=>item!==tool):list.concat(tool))},updateComment(event){this.data.set(\"comment\",event.target.value)},submit(event){event.preventDefault();if(!this.data.get(\"role\")){this.data.set(\"error\",\"\u8bf7\u9009\u62e9\u89d2\u8272\");return}this.data.set(\"error\",\"\");this.data.set(\"submitted\",true);this.fire(\"submit\",{role:this.data.get(\"role\"),tools:this.data.get(\"selectedTools\").slice(),comment:this.data.get(\"comment\")})},restart(){this.data.set(\"role\",\"\");this.data.set(\"selectedTools\",[]);this.data.set(\"comment\",\"\");this.data.set(\"submitted\",false)},isIncluded(list,value){return list.indexOf(value)>=0}});</script><style>\n.survey-branch-form { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.survey-branch-form * { box-sizing: border-box; }\n.survey-branch-form h2, .survey-branch-form h3, .survey-branch-form p { margin-top: 0; }\n.survey-branch-form h2 { margin-bottom: 14px; font-size: 21px; }\n.survey-branch-form button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.survey-branch-form button.primary { border-color: #6d28d9; background: #6d28d9; color: #fff; }\n.survey-branch-form button:disabled { opacity: .45; cursor: not-allowed; }\n.survey-branch-form input, .survey-branch-form select, .survey-branch-form textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.survey-branch-form .toolbar, .survey-branch-form .summary, .survey-branch-form .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.survey-branch-form .muted { color: #71808e; font-size: 12px; }\n.survey-branch-form .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\nfieldset{margin:12px 0;padding:12px;border:1px solid #ddd6fe}fieldset label{margin-right:12px}fieldset button.selected{background:#ede9fe;border-color:#6d28d9}textarea{width:100%;min-height:80px}.error{color:#b42318}.survey-result{text-align:center;padding:28px;background:#f5f3ff}\n</style>",
