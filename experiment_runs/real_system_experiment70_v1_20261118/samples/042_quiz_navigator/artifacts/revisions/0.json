{
  "code": "<template><section class=\"quiz-navigator\"><header><div><span class=\"eyebrow\">\u77e5\u8bc6\u6d4b\u9a8c</span><h2>{{title}}</h2></div><span>{{answeredCount}}/{{questions.length}}</span></header><div class=\"quiz-progress\"><span style=\"{{'width: ' + progress + '%'}}\"></span></div><div class=\"question-panel\" s-if=\"!finished\"><small>\u7b2c {{currentIndex + 1}} \u9898</small><h3>{{currentQuestion.prompt}}</h3><div class=\"option-list\"><button type=\"button\" s-for=\"option in currentQuestion.options trackby option\" class=\"{{answers[currentQuestion.id] === option ? 'selected' : ''}}\" on-click=\"choose(option)\">{{option}}</button></div><footer><button type=\"button\" disabled=\"{{currentIndex === 0}}\" on-click=\"previous\">\u4e0a\u4e00\u9898</button><button type=\"button\" s-if=\"currentIndex < questions.length - 1\" on-click=\"next\">\u4e0b\u4e00\u9898</button><button type=\"button\" s-else on-click=\"finish\">\u63d0\u4ea4\u7b54\u6848</button></footer></div><div class=\"result-panel\" s-else><strong>{{score}} / {{questions.length}}</strong><p>\u6d4b\u9a8c\u5df2\u5b8c\u6210\uff0c\u53ef\u91cd\u65b0\u4f5c\u7b54\u3002</p><button type=\"button\" on-click=\"restart\">\u91cd\u65b0\u5f00\u59cb</button></div></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"QuizNavigator\",dataTypes:{title:DataTypes.string,questions:DataTypes.array},initData(){return {currentIndex:0,answers:{},finished:false}},computed:{currentQuestion(){return this.data.get(\"questions\")[this.data.get(\"currentIndex\")]},answeredCount(){return Object.keys(this.data.get(\"answers\")).length},score(){const questions=this.data.get(\"questions\");const answers=this.data.get(\"answers\");return questions.filter(question=>answers[question.id]===question.answer).length},progress(){const answeredCount=this.data.get(\"answeredCount\");const questions=this.data.get(\"questions\");return Math.round((answeredCount/questions.length)*100)}},choose(option){const currentQuestion=this.data.get(\"currentQuestion\");const answers=Object.assign({},this.data.get(\"answers\"));answers[currentQuestion.id]=option;this.data.set(\"answers\",answers)},previous(){this.data.set(\"currentIndex\",Math.max(0,this.data.get(\"currentIndex\")-1))},next(){const questions=this.data.get(\"questions\");this.data.set(\"currentIndex\",Math.min(questions.length-1,this.data.get(\"currentIndex\")+1))},finish(){this.data.set(\"finished\",true)},restart(){this.data.set(\"currentIndex\",0);this.data.set(\"answers\",{});this.data.set(\"finished\",false)}});</script><style>.quiz-navigator { width: 520px; padding: 22px; border: 1px solid #d1d5db; border-radius: 7px; background: #fdfdfd; color: #1f2937; font-family: Arial, sans-serif; }\n.quiz-navigator header { display: flex; justify-content: space-between; align-items: flex-start; }\n.quiz-navigator h2 { margin: 3px 0 0; font-size: 21px; }\n.eyebrow, .question-panel small { color: #6b7280; font-size: 12px; }\n.quiz-progress { height: 6px; margin: 16px 0 20px; background: #e5e7eb; }\n.quiz-progress span { display: block; height: 100%; background: #7c3aed; transition: width 0.2s ease; }\n.question-panel h3 { min-height: 48px; }\n.option-list { display: grid; gap: 8px; }\n.option-list button { padding: 10px; border: 1px solid #c4b5fd; border-radius: 4px; background: #ffffff; cursor: pointer; text-align: left; }\n.option-list button.selected { border-color: #7c3aed; background: #ede9fe; }\n.question-panel footer { display: flex; justify-content: space-between; margin-top: 18px; }\n.question-panel footer button, .result-panel button { padding: 8px 12px; border: 1px solid #6d28d9; background: #6d28d9; color: #ffffff; cursor: pointer; }\n.result-panel { padding: 30px; text-align: center; background: #f5f3ff; }\n.result-panel strong { font-size: 30px; color: #5b21b6; }\n</style>",
