{"model":"qwen-plus","id":"chatcmpl-3bb33df3-79bc-9d45-879d-73e6eadd70f9","choices":[{"message":{"content":"<template><section class=\"quiz-navigator\"><header><div><span class=\"eyebrow\">知识测验</span><h2>{{title}}</h2></div><span>{{answeredCount}}/{{questions.length}}</span></header><div class=\"quiz-progress\"><span style=\"{{'width: ' + progress + '%'}}\"></span></div><div class=\"question-panel\" s-if=\"!finished\"><small>第 {{currentIndex + 1}} 题</small><h3>{{currentQuestion.prompt}}</h3><div class=\"option-list\"><button type=\"button\" s-for=\"option in currentQuestion.options trackby option\" class=\"{{answers[currentQuestion.id] === option ? 'selected' : ''}}\" on-click=\"choose(option)\">{{option}}</button></div><footer><button type=\"button\" disabled=\"{{currentIndex === 0}}\" on-click=\"previous\">上一题</button><button type=\"button\" s-if=\"currentIndex < questions.length - 1\" on-click=\"next\">下一题</button><button type=\"button\" s-else on-click=\"finish\">提交答案</button></footer></div><div class=\"result-panel\" s-else><strong>{{score}} / {{questions.length}}</strong><p>测验已完成，可重新作答。</p><button type=\"button\" on-click=\"restart\">重新开始</button></div></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"QuizNavigator\",dataTypes:{title:DataTypes.string,questions:DataTypes.array},initData(){return {currentIndex:0,answers:{},finished:false}},computed:{currentQuestion(){return this.data.get(\"questions\")[this.data.get(\"currentIndex\")]},answeredCount(){return Object.keys(this.data.get(\"answers\")).length},score(){const questions=this.data.get(\"questions\");const answers=this.data.get(\"answers\");return questions.filter(question=>answers[question.id]===question.answer).length},progress(){const answeredCount=this.data.get(\"answeredCount\");const questions=this.data.get(\"questions\");return Math.round((answeredCount/questions.length)*100)}},choose(option){const currentQuestion=this.data.get(\"currentQuestion\");const answers=Object.assign({},this.data.get(\"answers\"));answers[currentQuestion.id]=option;this.data.set(\"answers\",answers)},previous(){this.data.set(\"currentIndex\",Math.max(0,this.data.get(\"currentIndex\")-1))},next(){const questions=this.data.get(\"questions\");this.data.set(\"currentIndex\",Math.min(questions.length-1,this.data.get(\"currentIndex\")+1))},finish(){this.data.set(\"finished\",true)},restart(){this.data.set(\"currentIndex\",0);this.data.set(\"answers\",{});this.data.set(\"finished\",false)}});</script><style>.quiz-navigator { width: 520px; padding: 22px; border: 1px solid #d1d5db; border-radius: 7px; background: #fdfdfd; color: #1f2937; font-family: Arial, sans-serif; }\n.quiz-navigator header { display: flex; justify-content: space-between; align-items: flex-start; }\n.quiz-navigator h2 { margin: 3px 0 0; font-size: 21px; }\n.eyebrow, .question-panel small { color: #6b7280; font-size: 12px; }\n.quiz-progress { height: 6px; margin: 16px 0 20px; background: #e5e7eb; }\n.quiz-progress span { display: block; height: 100%; background: #7c3aed; transition: width 0.2s ease; }\n.question-panel h3 { min-height: 48px; }\n.option-list { display: grid; gap: 8px; }\n.option-list button { padding: 10px; border: 1px solid #c4b5fd; border-radius: 4px; background: #ffffff; cursor: pointer; text-align: left; }\n.option-list button.selected { border-color: #7c3aed; background: #ede9fe; }\n.question-panel footer { display: flex; justify-content: space-between; margin-top: 18px; }\n.question-panel footer button, .result-panel button { padding: 8px 12px; border: 1px solid #6d28d9; background: #6d28d9; color: #ffffff; cursor: pointer; }\n.result-panel { padding: 30px; text-align: center; background: #f5f3ff; }\n.result-panel strong { font-size: 30px; color: #5b21b6; }\n</style>","role":"assistant"},"index":0,"finish_reason":"stop"}],"created":1795014017,"object":"chat.completion","usage":{"total_tokens":22130,"completion_tokens":1014,"prompt_tokens":21116,"prompt_tokens_details":{"cached_tokens":4096}}}