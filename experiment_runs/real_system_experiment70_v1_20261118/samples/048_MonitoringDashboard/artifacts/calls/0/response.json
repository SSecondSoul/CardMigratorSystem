{"model":"qwen-plus","id":"chatcmpl-1068e82c-6f5c-9541-8363-4835d42b372b","choices":[{"message":{"content":"<template><div class=\"monitoring-dashboard{{ isDarkMode ? ' dark-mode' : '' }}\"><div class=\"status-bar\"><div class=\"system-status\"><span class=\"status-indicator{{ systemHealth }}\"></span><span class=\"status-text\">系统状态：{{systemHealthText}}</span></div><div class=\"time-display\"><span>📅 {{currentDate}}</span><span>⏰ {{currentTime}}</span></div><div class=\"action-buttons\"><button class=\"icon-btn\" on-click=\"toggleTheme\">🌓</button><button class=\"icon-btn\" on-click=\"exportReport\">📊</button><button class=\"icon-btn\" on-click=\"showSettings = true\">⚙️</button></div></div><div class=\"kpi-grid\"><kpi-card s-for=\"kpi in kpiData trackby kpi.id\" key=\"{{kpi.id}}\" title=\"{{kpi.title}}\" value=\"{{kpi.value}}\" unit=\"{{kpi.unit}}\" trend=\"{{kpi.trend}}\" status=\"{{kpi.status}}\" icon=\"{{kpi.icon}}\" on-click=\"onKPIClick(kpi)\"></kpi-card></div><div class=\"charts-grid\"><div class=\"chart-card\"><div class=\"chart-header\"><h3>实时 CPU / 内存 使用率</h3><div class=\"chart-controls\"><button class=\"period-btn{{ selectedPeriod === period.value ? ' active' : '' }}\" s-for=\"period in timePeriods trackby period.value\" key=\"{{period.value}}\" on-click=\"changePeriod(period.value)\">{{period.label}}</button></div></div><real-time-chart data=\"{{cpuHistory}}\" height=\"250\" color=\"#3b82f6\" loading=\"{{isChartLoading}}\"></real-time-chart><real-time-chart data=\"{{memoryHistory}}\" height=\"250\" color=\"#10b981\" loading=\"{{isChartLoading}}\"></real-time-chart></div><div class=\"chart-card\"><h3>服务请求统计</h3><request-chart data=\"{{requestStats}}\" height=\"300\" on-bar-click=\"onBarClick\"></request-chart></div></div><div class=\"events-grid\"><div class=\"alerts-panel\"><div class=\"panel-header\"><h3>🚨 实时告警</h3><span class=\"alert-count\">{{activeAlerts.length}}</span><button class=\"clear-btn\" s-if=\"activeAlerts.length\" on-click=\"clearAlerts\">清空</button></div><alert-list alerts=\"{{activeAlerts}}\" on-acknowledge=\"acknowledgeAlert\" on-resolve=\"resolveAlert\"></alert-list></div><div class=\"logs-panel\"><div class=\"panel-header\"><h3>📋 系统日志</h3><div class=\"log-filters\"><select on-change=\"filterLogs\"><option value=\"all\">全部</option><option value=\"info\">信息</option><option value=\"warning\">警告</option><option value=\"error\">错误</option></select><button class=\"clear-btn\" on-click=\"clearLogs\">清空</button></div></div><log-list logs=\"{{filteredLogs}}\" loading=\"{{isLogLoading}}\" on-log-click=\"onLogClick\"></log-list></div></div><div class=\"services-panel\"><div class=\"panel-header\"><h3>🔗 服务健康检查</h3><button class=\"refresh-btn\" disabled=\"{{isRefreshingServices}}\" on-click=\"refreshServices\">{{isRefreshingServices ? '刷新中...' : '刷新'}}</button></div><service-grid services=\"{{services}}\" on-service-click=\"onServiceClick\"></service-grid></div><div class=\"modal-overlay\" s-if=\"showSettings\" on-click=\"showSettings = false\"><div class=\"modal-content\"><div class=\"modal-header\"><h3>系统设置</h3><button class=\"close-btn\" on-click=\"showSettings = false\">✕</button></div><settings-form settings=\"{{settings}}\" on-save=\"saveSettings\" on-cancel=\"showSettings = false\"></settings-form></div></div><div class=\"notification{{ notification.type }}\" s-if=\"notification.show\"><span>{{notification.message}}</span><button on-click=\"hideNotification\">✕</button></div></div></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;const KPICard=san.defineComponent({name:\"KPICard\",dataTypes:{title:DataTypes.string,value:DataTypes.number,unit:DataTypes.string,trend:DataTypes.number,status:DataTypes.string,icon:DataTypes.string},template:`<div class=\"kpi-card{{ status }}\" on-click=\"fire('click')\"><div class=\"kpi-icon\">{{ icon }}</div><div class=\"kpi-content\"><div class=\"kpi-title\">{{ title }}</div><div class=\"kpi-value\">{{ value }}<span class=\"kpi-unit\">{{ unit }}</span></div><div class=\"kpi-trend{{ trend >= 0 ? ' up' : ' down' }}\">{{ trend >= 0 ? '▲' : '▼' }} {{ Math.abs(trend) }}%</div></div></div>`,methods:{}});const RealTimeChart=san.defineComponent({name:\"RealTimeChart\",dataTypes:{data:DataTypes.array,height:DataTypes.number,color:DataTypes.string,loading:DataTypes.bool},template:`<div class=\"chart-wrapper{{ loading ? ' loading' : '' }}\"><svg width=\"100%\" height=\"{{height}}\" viewBox=\"0 0 {{width}} {{height}}\"><defs><linearGradient id=\"{{gradientId}}\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"{{color}}\" stop-opacity=\"0.3\"/><stop offset=\"100%\" stop-color=\"{{color}}\" stop-opacity=\"0.0\"/></linearGradient></defs><g s-for=\"i in 4 trackby i\"><line x1=\"0\" y1=\"{{i * (height / 4)}}\" x2=\"{{width}}\" y2=\"{{i * (height / 4)}}\" stroke=\"#e2e8f0\" stroke-width=\"0.5\" stroke-dasharray=\"3,3\"/></g><polygon points=\"{{areaPoints}}\" fill=\"{{'url(#' + gradientId + ')'}}\"/><polyline points=\"{{linePoints}}\" fill=\"none\" stroke=\"{{color}}\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle s-for=\"(point, idx) in dataPoints trackby idx\" cx=\"{{getX(idx)}}\" cy=\"{{getY(point)}}\" r=\"3\" fill=\"{{color}}\" stroke=\"white\" stroke-width=\"2\"/></svg></div>`,initData(){return {width:600}},computed:{gradientId(){return `gradient-${this.data.get('color').replace('#','')}`},dataPoints(){return this.data.get('data').map(d=>d.value)},maxValue(){return Math.max(...this.data.get('dataPoints'),100)},minValue(){return Math.min(...this.data.get('dataPoints'),0)},linePoints(){return this.data.get('dataPoints').map((val,idx)=>`${this.getX(idx)},${this.getY(val)}`).join(' ')},areaPoints(){const points=this.data.get('dataPoints').map((val,idx)=>`${this.getX(idx)},${this.getY(val)}`);return `0,${this.data.get('height')} ${points.join(' ')} ${this.data.get('width')},${this.data.get('height')}`}},attached(){this.updateWidth();window.addEventListener('resize',this.updateWidth)},disposed(){window.removeEventListener('resize',this.updateWidth)},methods:{updateWidth(){if(this.el){this.data.set('width',this.el.clientWidth-20)}},getX(index){if(this.data.get('dataPoints').length<=1)return this.data.get('width')/2;return (index/(this.data.get('dataPoints').length-1))*this.data.get('width')},getY(value){const range=this.data.get('maxValue')-this.data.get('minValue');if(range===0)return this.data.get('height')/2;return this.data.get('height')-((value-this.data.get('minValue'))/range)*this.data.get('height')}});const RequestChart=san.defineComponent({name:\"RequestChart\",dataTypes:{data:DataTypes.array,height:DataTypes.number},template:`<div class=\"request-chart\"><svg width=\"100%\" height=\"{{height}}\" viewBox=\"0 0 800 300\"><g s-for=\"(item, idx) in data trackby idx\"><rect x=\"{{getX(idx)}}\" y=\"0\" width=\"{{barWidth}}\" height=\"{{getHeight(item.count)}}\" fill=\"{{getColor(item.status)}}\" on-click=\"fire('bar-click', item)\" style=\"cursor: pointer;\"/><text x=\"{{getX(idx) + barWidth / 2}}\" y=\"290\" text-anchor=\"middle\" font-size=\"10\" fill=\"#64748b\">{{ item.hour }}</text></g></svg><div class=\"chart-legend\"><span class=\"legend-item\" s-for=\"status in statusTypes trackby status.type\"><span class=\"legend-color\" style=\"{{'background: ' + status.color + ';'}}\"></span>{{ status.label }}</span></div></div>`,computed:{barWidth(){return 800/this.data.get('data').length-4},maxCount(){return Math.max(...this.data.get('data').map(d=>d.count),100)},statusTypes(){return[{type:'success',label:'成功',color:'#10b981'},{type:'warning',label:'警告',color:'#f59e0b'},{type:'error',label:'错误',color:'#ef4444'}]}},methods:{getX(index){return (index*800)/this.data.get('data').length+2},getHeight(count){return (count/this.data.get('maxCount'))*280},getColor(status){const colors={success:'#10b981',warning:'#f59e0b',error:'#ef4444'};return colors[status]||'#3b82f6'}},emits:['bar-click']});const AlertList=san.defineComponent({name:\"AlertList\",dataTypes:{alerts:DataTypes.array},template:`<div class=\"alert-list\"><div class=\"alert-item{{ alert.severity }}\" s-for=\"alert in alerts trackby alert.id\"><div class=\"alert-icon\">{{ alert.severity === 'critical' ? '🔴' : (alert.severity === 'warning' ? '🟡' : '🔵') }}</div><div class=\"alert-content\"><div class=\"alert-title\">{{ alert.title }}</div><div class=\"alert-desc\">{{ alert.description }}</div><div class=\"alert-time\">{{ formatTime(alert.timestamp) }}</div></div><div class=\"alert-actions\"><button on-click=\"fire('acknowledge', alert.id)\" class=\"alert-btn\">确认</button><button on-click=\"fire('resolve', alert.id)\" class=\"alert-btn resolve\">解决</button></div></div><div class=\"empty-alerts\" s-if=\"alerts.length === 0\">✅ 暂无告警，系统运行正常</div></div>`,methods:{formatTime(timestamp){const date=new Date(timestamp);return date.toLocaleTimeString()}},emits:['acknowledge','resolve']});const LogList=san.defineComponent({name:\"LogList\",dataTypes:{logs:DataTypes.array,loading:DataTypes.bool},template:`<div class=\"log-list\"><div class=\"log-loading\" s-if=\"loading\">加载日志中...</div><div s-if=\"!loading\"><div class=\"log-item\" s-for=\"log in logs trackby log.id\" on-click=\"fire('log-click', log)\"><span class=\"log-time\">{{ formatTime(log.timestamp) }}</span><span class=\"log-level{{ log.level }}\">{{ log.level.toUpperCase() }}</span><span class=\"log-message\">{{ log.message }}</span><span class=\"log-source\">{{ log.source }}</span></div><div class=\"empty-logs\" s-if=\"logs.length === 0\">暂无日志记录</div></div></div>`,methods:{formatTime(timestamp){const date=new Date(timestamp);return `${date.getHours().toString().padStart(2,'0')}:${date.getMinutes().toString().padStart(2,'0')}:${date.getSeconds().toString().padStart(2,'0')}`}},emits:['log-click']});const ServiceGrid=san.defineComponent({name:\"ServiceGrid\",dataTypes:{services:DataTypes.array},template:`<div class=\"service-grid\"><div class=\"service-card\" s-for=\"service in services trackby service.id\" on-click=\"fire('service-click', service)\"><div class=\"service-header\"><span class=\"service-name\">{{ service.name }}</span><span class=\"service-status{{ service.status }}\">{{ getStatusText(service.status) }}</span></div><div class=\"service-metrics\"><div class=\"metric\"><span class=\"metric-label\">响应时间</span><span class=\"metric-value\">{{ service.responseTime }}ms</span></div><div class=\"metric\"><span class=\"metric-label\">可用性</span><span class=\"metric-value\">{{ service.availability }}%</span></div></div><div class=\"service-progress\"><div class=\"progress-bar\" style=\"{{'width: ' + service.availability + '%; background: ' + getProgressColor(service.availability) + ';'}}\"></div></div></div></div>`,methods:{getStatusText(status){const texts={healthy:'健康',warning:'警告',down:'离线'};return texts[status]||status},getProgressColor(availability){if(availability>=95)return '#10b981';if(availability>=80)return '#f59e0b';return '#ef4444'}},emits:['service-click']});const SettingsForm=san.defineComponent({name:\"SettingsForm\",dataTypes:{settings:DataTypes.object},template:`<form on-submit.prevent=\"handleSubmit\" class=\"settings-form\"><div class=\"form-group\"><label>刷新间隔 (秒)</label><input type=\"number\" value=\"{{localSettings.refreshInterval}}\" min=\"1\" max=\"60\"/></div><div class=\"form-group\"><label>告警阈值 (%)</label><input type=\"number\" value=\"{{localSettings.alertThreshold}}\" min=\"0\" max=\"100\"/></div><div class=\"form-group\"><label>日志保留天数</label><select value=\"{{localSettings.logRetention}}\"><option value=\"1\">1天</option><option value=\"7\">7天</option><option value=\"30\">30天</option></select></div><div class=\"form-group\"><label><input type=\"checkbox\" checked=\"{{localSettings.autoRefresh}}\"/>自动刷新数据</label></div><div class=\"form-group\"><label><input type=\"checkbox\" checked=\"{{localSettings.desktopNotifications}}\"/>桌面通知</label></div><div class=\"form-actions\"><button type=\"button\" on-click=\"fire('cancel')\" class=\"cancel-btn\">取消</button><button type=\"submit\" class=\"submit-btn\">保存设置</button></div></form>`,initData(){return {localSettings:{...this.data.get('settings')}}},methods:{handleSubmit(){this.fire('save',this.data.get('localSettings'))}},emits:['save','cancel']});module.exports=san.defineComponent({name:\"MonitoringDashboard\",dataTypes:{isDarkMode:DataTypes.bool,showSettings:DataTypes.bool,selectedPeriod:DataTypes.string,isChartLoading:DataTypes.bool,isLogLoading:DataTypes.bool,isRefreshingServices:DataTypes.bool,currentDate:DataTypes.string,currentTime:DataTypes.string,timePeriods:DataTypes.array,kpiData:DataTypes.array,cpuHistory:DataTypes.array,memoryHistory:DataTypes.array,requestStats:DataTypes.array,activeAlerts:DataTypes.array,alertHistory:DataTypes.array,systemLogs:DataTypes.array,logFilter:DataTypes.string,services:DataTypes.array,settings:DataTypes.object,notification:DataTypes.object,refreshTimer:DataTypes.any,timeTimer:DataTypes.any,notificationTimer:DataTypes.any,dataGenerator:DataTypes.any,alertIdCounter:DataTypes.number},initData(){return {isDarkMode:false,showSettings:false,selectedPeriod:\"1h\",isChartLoading:false,isLogLoading:false,isRefreshingServices:false,currentDate:\"\",currentTime:\"\",timePeriods:[{value:\"1h\",label:\"1小时\"},{value:\"6h\",label:\"6小时\"},{value:\"24h\",label:\"24小时\"}],kpiData:[{id:1,title:\"CPU使用率\",value:45,unit:\"%\",trend:-5,status:\"healthy\",icon:\"💻\"},{id:2,title:\"内存使用率\",value:62,unit:\"%\",trend:8,status:\"warning\",icon:\"🧠\"},{id:3,title:\"请求成功率\",value:98.5,unit:\"%\",trend:1.2,status:\"healthy\",icon:\"✅\"},{id:4,title:\"平均响应时间\",value:156,unit:\"ms\",trend:-12,status:\"healthy\",icon:\"⚡\"}],cpuHistory:[],memoryHistory:[],requestStats:[],activeAlerts:[],alertHistory:[],systemLogs:[],logFilter:\"all\",services:[],settings:{refreshInterval:5,alertThreshold:80,logRetention:\"7\",autoRefresh:true,desktopNotifications:false},notification:{show:false,message:\"\",type:\"info\"},refreshTimer:null,timeTimer:null,notificationTimer:null,dataGenerator:null,alertIdCounter:100}},components:{'kpi-card':KPICard,'real-time-chart':RealTimeChart,'request-chart':RequestChart,'alert-list':AlertList,'log-list':LogList,'service-grid':ServiceGrid,'settings-form':SettingsForm},attached(){this.initData();this.startTimeUpdate();this.startDataSimulation();if(this.data.get('settings').autoRefresh){this.startAutoRefresh()}this.showNotification('监控仪表盘已启动','success')},disposed(){this.stopAutoRefresh();this.stopTimeUpdate();this.stopDataSimulation();if(this.data.get('notificationTimer')){clearTimeout(this.data.get('notificationTimer'));this.data.set('notificationTimer',null)}},initChartData(){const now=Date.now();for(let i=0;i<60;i++){this.data.set('cpuHistory',[...this.data.get('cpuHistory'),{time:now-(60-i)*60000,value:30+Math.random()*40}]);this.data.set('memoryHistory',[...this.data.get('memoryHistory'),{time:now-(60-i)*60000,value:40+Math.random()*30}])}},initRequestStats(){this.data.set('requestStats',[]);for(let i=0;i<12;i++){const hour=`${i.toString().padStart(2,'0')}:00`;const total=Math.floor(500+Math.random()*500);this.data.set('requestStats',[...this.data.get('requestStats'),{hour,count:total,success:Math.floor(total*(0.9+Math.random()*0.09)),warning:Math.floor(total*(0.05+Math.random()*0.03)),error:Math.floor(total*(0.02+Math.random()*0.02)),status:Math.random()>0.9?'error':(Math.random()>0.8?'warning':'success')}])}},initAlerts(){this.data.set('activeAlerts',[{id:1,title:\"CPU使用率过高\",description:\"CPU使用率已超过80%阈值，建议扩容\",severity:\"warning\",timestamp:Date.now()-1800000},{id:2,title:\"API响应超时\",description:\"用户服务API响应时间超过3秒\",severity:\"critical\",timestamp:Date.now()-3600000}])}},initLogs(){const levels=['info','warning','error'];const messages=['用户登录成功','数据库查询慢','API请求失败','缓存命中','服务重启','配置更新','磁盘空间不足','网络延迟增加'];const sources=['API Gateway','Auth Service','Database','Cache','Worker'];for(let i=0;i<50;i++){const level=levels[Math.floor(Math.random()*levels.length)];this.data.set('systemLogs',[{id:i,level,message:messages[Math.floor(Math.random()*messages.length)],source:sources[Math.floor(Math.random()*sources.length)],timestamp:Date.now()-Math.random()*86400000},...this.data.get('systemLogs')])}this.data.set('systemLogs',this.data.get('systemLogs').sort((a,b)=>b.timestamp-a.timestamp))},initServices(){this.data.set('services',[{id:1,name:\"API Gateway\",status:\"healthy\",responseTime:45,availability:99.9},{id:2,name:\"Auth Service\",status:\"healthy\",responseTime:67,availability:99.8},{id:3,name:\"User Service\",status:\"warning\",responseTime:234,availability:95.2},{id:4,name:\"Payment Service\",status:\"healthy\",responseTime:89,availability:99.5},{id:5,name:\"Database\",status:\"healthy\",responseTime:12,availability:99.99},{id:6,name:\"Cache Service\",status:\"warning\",responseTime:156,availability:97.3}])}},loadSettings(){const saved=localStorage.getItem('dashboard_settings');if(saved){try{const loaded=JSON.parse(saved);this.data.set('settings',{...this.data.get('settings'),...loaded})}catch(e){console.error('加载设置失败',e)}}},startDataSimulation(){this.data.set('dataGenerator',setInterval(()=>{this.simulateDataUpdate()},2000))},stopDataSimulation(){if(this.data.get('dataGenerator')){clearInterval(this.data.get('dataGenerator'))}},simulateDataUpdate(){this.data.set('kpiData',[{...this.data.get('kpiData')[0],value:Math.max(5,Math.min(95,this.data.get('kpiData')[0].value+(Math.random()-0.5)*3))},{...this.data.get('kpiData')[1],value:Math.max(30,Math.min(90,this.data.get('kpiData')[1].value+(Math.random()-0.5)*2))},{...this.data.get('kpiData')[2],value:Math.max(95,Math.min(100,this.data.get('kpiData')[2].value+(Math.random()-0.5)*0.5))},{...this.data.get('kpiData')[3],value:Math.max(50,Math.min(500,this.data.get('kpiData')[3].value+(Math.random()-0.5)*10))}]);const newCpuValue=30+Math.random()*50;const newMemoryValue=40+Math.random()*40;this.data.set('cpuHistory',[...this.data.get('cpuHistory'),{time:Date.now(),value:newCpuValue}]);this.data.set('memoryHistory',[...this.data.get('memoryHistory'),{time:Date.now(),value:newMemoryValue}]);if(this.data.get('cpuHistory').length>60)this.data.set('cpuHistory',this.data.get('cpuHistory').slice(1));if(this.data.get('memoryHistory').length>60)this.data.set('memoryHistory',this.data.get('memoryHistory').slice(1));if(newCpuValue>85&&Math.random()>0.7){this.addAlert('CPU使用率异常',`CPU使用率达到 ${newCpuValue.toFixed(1)}%`,'critical')}if(newMemoryValue>85&&Math.random()>0.8){this.addAlert('内存使用率过高',`内存使用率达到 ${newMemoryValue.toFixed(1)}%`,'warning')}if(Math.random()>0.7){const levels=['info','warning','error'];const level=levels[Math.floor(Math.random()*levels.length)];this.addLog(level,`系统运行状态更新`,'Monitor')}},refreshAllData(){this.data.set('isChartLoading',true);this.data.set('isRefreshingServices',true);this.showNotification('正在刷新数据...','info');setTimeout(()=>{this.initRequestStats();this.initServices();this.data.set('isChartLoading',false);this.data.set('isRefreshingServices',false);this.showNotification('数据刷新完成','success')},1000)},refreshServices(){this.refreshAllData()},startAutoRefresh(){this.stopAutoRefresh();this.data.set('refreshTimer',setInterval(()=>{this.refreshAllData()},this.data.get('settings').refreshInterval*1000))},stopAutoRefresh(){if(this.data.get('refreshTimer')){clearInterval(this.data.get('refreshTimer'));this.data.set('refreshTimer',null)}},startTimeUpdate(){this.data.set('timeTimer',setInterval(()=>{this.updateDateTime()},1000))},stopTimeUpdate(){if(this.data.get('timeTimer')){clearInterval(this.data.get('timeTimer'))}},updateDateTime(){const now=new Date();this.data.set('currentDate',now.toLocaleDateString('zh-CN'));this.data.set('currentTime',now.toLocaleTimeString('zh-CN'))},changePeriod(period){this.data.set('selectedPeriod',period);this.showNotification(`切换到 ${period} 视图`,'info')},addAlert(title,description,severity){const newAlert={id:++this.data.get('alertIdCounter'),title,description,severity,timestamp:Date.now()};this.data.set('activeAlerts',[newAlert,...this.data.get('activeAlerts')]);this.showNotification(`新告警: ${title}`,'warning');if(this.data.get('settings').desktopNotifications&&Notification.permission==='granted'){new Notification(title,{body:description})}},acknowledgeAlert(alertId){const alert=this.data.get('activeAlerts').find(a=>a.id===alertId);if(alert){alert.acknowledged=true;this.showNotification(`已确认告警: ${alert.title}`,'info')}},resolveAlert(alertId){const index=this.data.get('activeAlerts').findIndex(a=>a.id===alertId);if(index!==-1){const resolved=this.data.get('activeAlerts').splice(index,1)[0];this.data.set('alertHistory',[...this.data.get('alertHistory'),{...resolved,resolvedAt:Date.now()}]);this.showNotification(`已解决告警: ${resolved.title}`,'success')}},clearAlerts(){this.data.set('activeAlerts',[]);this.showNotification('已清空所有告警','info')},addLog(level,message,source){const newLog={id:Date.now(),level,message,source,timestamp:Date.now()};this.data.set('systemLogs',[newLog,...this.data.get('systemLogs')]);if(this.data.get('systemLogs').length>500){this.data.set('systemLogs',this.data.get('systemLogs').slice(0,500))}},filterLogs(){this.showNotification(`筛选日志: ${this.data.get('logFilter')}`,'info')},clearLogs(){this.data.set('systemLogs',[]);this.showNotification('日志已清空','info')},onKPIClick(kpi){this.showNotification(`查看详情: ${kpi.title}`,'info');this.addLog('info',`查看KPI指标: ${kpi.title}`,'Dashboard')},onBarClick(data){this.showNotification(`查看时段: ${data.hour} 请求量 ${data.count}`,'info')},onLogClick(log){this.showNotification(`日志详情: ${log.message}`,'info')},onServiceClick(service){this.showNotification(`服务详情: ${service.name} (${service.status})`,'info')},exportReport(){const report={exportTime:new Date().toISOString(),kpi:this.data.get('kpiData'),alerts:this.data.get('activeAlerts'),services:this.data.get('services'),summary:{totalAlerts:this.data.get('activeAlerts').length,healthyServices:this.data.get('services').filter(s=>s.status==='healthy').length,avgCpu:this.data.get('kpiData')[0].value,avgMemory:this.d