{
  "code": "<template><section class=\"kanban-column-board\"><header><h2>\u5185\u5bb9\u5236\u4f5c\u770b\u677f</h2><div class=\"actions\"><button on-click=\"move(-1)\" disabled=\"{{ !selectedTask }}\">\u2190 \u5de6\u79fb</button><button on-click=\"move(1)\" disabled=\"{{ !selectedTask }}\">\u53f3\u79fb \u2192</button></div></header><div class=\"board\" s-for=\"column in boardColumns trackby column.id\"><article key=\"{{ column.id }}\"><h3>{{column.label}} \u00b7 {{column.count}}</h3><button on-click=\"select(task.id)\" class=\"{{ task.id === selectedId ? 'selected' : '' }}\" s-for=\"task in column.tasks trackby task.id\">{{task.title}}</button></article></div><form on-submit=\"add\"><input placeholder=\"\u65b0\u589e\u5f85\u5904\u7406\u4efb\u52a1\" value=\"{{ draft }}\" on-input=\"updateDraft\"/><button class=\"primary\" type=\"submit\">\u6dfb\u52a0</button></form></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"KanbanColumnBoard\",dataTypes:{initialTasks:DataTypes.array,columns:DataTypes.array},initData(){return {tasks:[],selectedId:null,draft:\"\",nextId:10}},inited(){this.data.set(\"tasks\",this.data.get(\"initialTasks\").map(item=>Object.assign({},item)))},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},select(id){this.data.set(\"selectedId\",id)},move(delta){const task=this.data.get(\"selectedTask\");if(!task)return;const index=this.data.get(\"columns\").findIndex(item=>item.id===task.status);const target=this.data.get(\"columns\")[index+delta];if(!target)return;this.data.set(\"tasks\",this.data.get(\"tasks\").map(item=>item.id===task.id?Object.assign({},item,{status:target.id}):item));this.emitEvent(\"move\",{id:task.id,status:target.id})},updateDraft(event){this.data.set(\"draft\",event.target.value)},add(event){event.preventDefault();const title=this.data.get(\"draft\").trim();if(!title)return;const task={id:this.data.get(\"nextId\"),title,status:\"todo\"};this.data.set(\"tasks\",this.data.get(\"tasks\").concat(task));this.data.set(\"nextId\",this.data.get(\"nextId\")+1);this.data.set(\"draft\",\"\");this.emitEvent(\"add\",task)},computed:{boardColumns(){return this.data.get(\"columns\").map(column=>{const tasks=this.data.get(\"tasks\").filter(item=>item.status===column.id);return Object.assign({},column,{tasks,count:tasks.length})})},selectedTask(){return this.data.get(\"tasks\").find(item=>item.id===this.data.get(\"selectedId\"))||null}}});</script><style>.kanban-column-board{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.kanban-column-board *{box-sizing:border-box}.kanban-column-board h2,.kanban-column-board h3,.kanban-column-board p{margin-top:0}.kanban-column-board button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.kanban-column-board button.primary{border-color:#7c3aed;background:#7c3aed;color:#fff}.kanban-column-board button:disabled{opacity:.45;cursor:not-allowed}.kanban-column-board input,.kanban-column-board select,.kanban-column-board textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.kanban-column-board .muted{color:#71808e;font-size:12px}.kanban-column-board .toolbar,.kanban-column-board .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.board{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.board article{min-height:190px;padding:10px;background:#f8fafc}.board article>button{display:block;width:100%;margin:6px 0;text-align:left}.board button.selected{background:#ede9fe;border-color:#7c3aed}form{display:flex;gap:8px;margin-top:12px}form input{flex:1}</style>",
