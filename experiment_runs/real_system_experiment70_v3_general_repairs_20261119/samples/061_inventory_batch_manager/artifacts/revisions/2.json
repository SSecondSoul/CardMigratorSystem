{
  "code": "<template><section class=\"inventory-batch-manager\"><header class=\"page-head\"><div><p class=\"muted\">\u6700\u540e\u540c\u6b65 {{lastSynced}}</p><h2>{{title}}</h2></div><button on-click=\"exportData\">\u5bfc\u51fa\u89c6\u56fe</button></header><div class=\"metric-strip\"><article><span>\u5e93\u5b58\u4ef6\u6570</span><strong>{{summary.units}}</strong></article><article><span>\u4e34\u671f\u6279\u6b21</span><strong>{{summary.expiring}}</strong></article><article><span>\u4f4e\u5e93\u5b58</span><strong>{{summary.low}}</strong></article></div><div class=\"toolbar\"><select on-change=\"updateWarehouse\"><option value=\"all\">\u5168\u90e8\u4ed3\u5e93</option><option s-for=\"item in warehouses trackby item\" value=\"{{item}}\">{{item}}</option></select><label><input type=\"checkbox\" on-change=\"toggleRisk\" checked=\"{{riskOnly}}\"/> \u4ec5\u770b\u98ce\u9669</label><button on-click=\"selectVisible\">\u5168\u9009\u7ed3\u679c</button><button on-click=\"undo\" disabled=\"{{!history.length}}\">\u64a4\u9500</button></div><div class=\"inventory-layout\"><div><table><thead><tr><th></th><th>\u6279\u6b21</th><th>\u4ed3\u5e93</th><th>\u5e93\u5b58</th><th>\u4fdd\u8d28\u671f</th></tr></thead><tbody><tr s-for=\"batch in visibleBatches trackby batch.id\" class=\"{{batchRowClass(batch)}}\"><td><input type=\"checkbox\" on-change=\"toggleBatch(batch.id)\" checked=\"{{isSelected(batch.id)}}\"/></td><td><strong>{{batch.product}}</strong><small>{{batch.sku}}</small></td><td>{{batch.warehouse}}</td><td><div class=\"stock-bar\"><span style=\"{{stockStyle(batch)}}\"></span></div>{{batch.quantity}}/{{batch.capacity}}</td><td>{{batch.expiryDays}} \u5929</td></tr></tbody></table><p class=\"empty\" s-if=\"!visibleBatches.length\">\u6ca1\u6709\u5339\u914d\u6279\u6b21</p></div><aside><h3>\u6279\u91cf\u8c03\u6574</h3><p>\u5df2\u9009 {{selectedCount}} \u6279</p><label>\u6570\u91cf\u53d8\u5316<input type=\"number\" on-input=\"updateAdjustment\" value=\"{{adjustment}}\"/></label><label>\u539f\u56e0<select on-change=\"updateReason\" value=\"{{reason}}\"><option>\u76d8\u70b9\u4fee\u6b63</option><option>\u635f\u8017\u767b\u8bb0</option><option>\u5165\u5e93\u8865\u5f55</option></select></label><button class=\"primary\" on-click=\"applyAdjustment\" disabled=\"{{!canApply}}\">\u5e94\u7528</button><h3>\u64cd\u4f5c\u5386\u53f2</h3><ol><li s-for=\"entry in history trackby entry.id\">{{entry.reason}}\uff1a{{entry.count}} \u6279</li></ol></aside></div></section></template><script>const san = require('san'); const DataTypes = san.DataTypes; module.exports = san.defineComponent({ name: 'InventoryBatchManager', dataTypes: { title: DataTypes.string, warehouses: DataTypes.array, initialBatches: DataTypes.array }, initData() { return { title: '\u51b7\u94fe\u5e93\u5b58\u63a7\u5236\u53f0', warehouses: ['\u534e\u4e1c\u4ed3', '\u534e\u5357\u4ed3'], initialBatches: [{ 'id': 1, 'sku': 'FD-101', 'product': '\u9c9c\u5976', 'warehouse': '\u534e\u4e1c\u4ed3', 'quantity': 38, 'capacity': 80, 'expiryDays': 2 }, { 'id': 2, 'sku': 'FD-205', 'product': '\u9178\u5976', 'warehouse': '\u534e\u4e1c\u4ed3', 'quantity': 64, 'capacity': 80, 'expiryDays': 8 }, { 'id': 3, 'sku': 'FR-311', 'product': '\u679c\u6c41', 'warehouse': '\u534e\u5357\u4ed3', 'quantity': 21, 'capacity': 60, 'expiryDays': 14 }, { 'id': 4, 'sku': 'FD-402', 'product': '\u5976\u916a', 'warehouse': '\u534e\u5357\u4ed3', 'quantity': 9, 'capacity': 40, 'expiryDays': 1 }], batches: [], warehouse: 'all', riskOnly: false, selectedIds: [], adjustment: 0, reason: '\u76d8\u70b9\u4fee\u6b63', history: [], lastSynced: '', timer: null }; }, computed: { visibleBatches() { const batches = this.data.get('batches'); const warehouse = this.data.get('warehouse'); const riskOnly = this.data.get('riskOnly'); return batches.filter(item => (warehouse === 'all' || item.warehouse === warehouse) && (!riskOnly || item.expiryDays <= 3 || item.quantity <= 10)); }, summary() { const batches = this.data.get('batches'); return batches.reduce((result, item) => { result.units += item.quantity; if (item.expiryDays <= 3) result.expiring += 1; if (item.quantity <= 10) result.low += 1; return result; }, { units: 0, expiring: 0, low: 0 }); }, selectedCount() { return this.data.get('selectedIds').length; }, canApply() { return this.data.get('selectedCount') > 0 && this.data.get('adjustment') !== 0; } }, inited() { this.data.set('batches', this.data.get('initialBatches').map(item => Object.assign({}, item))); this.watch('warehouse', () => { this.data.set('selectedIds', []); }); }, attached() { this.refreshClock(); this._timer = setInterval(() => this.refreshClock(), 30000); }, disposed() { clearInterval(this._timer); }, setValue(key, value) { this.data.set(key, value); }, emitEvent(name, payload) { this.fire(name, payload); }, refreshClock() { this.data.set('lastSynced', new Date().toLocaleTimeString('zh-CN', { hour12: false })); }, updateWarehouse(event) { this.data.set('warehouse', event.target.value); }, toggleRisk(event) { this.data.set('riskOnly', event.target.checked); }, isSelected(id) { return this.data.get('selectedIds').indexOf(id) >= 0; }, toggleBatch(id) { const list = this.data.get('selectedIds'); this.data.set('selectedIds', list.indexOf(id) >= 0 ? list.filter(item => item !== id) : list.concat(id)); }, selectVisible() { this.data.set('selectedIds', this.data.get('visibleBatches').map(item => item.id)); }, updateAdjustment(event) { this.data.set('adjustment', Number(event.target.value) || 0); }, updateReason(event) { this.data.set('reason', event.target.value); }, applyAdjustment() { if (!this.data.get('canApply')) return; const ids = this.data.get('selectedIds'); const before = this.data.get('batches').map(item => Object.assign({}, item)); const next = this.data.get('batches').map(item => ids.indexOf(item.id) >= 0 ? Object.assign({}, item, { quantity: Math.max(0, Math.min(item.capacity, item.quantity + this.data.get('adjustment'))) }) : item); this.data.set('batches', next); this.data.set('history', [{ id: Date.now(), reason: this.data.get('reason'), count: ids.length, delta: this.data.get('adjustment'), before }].concat(this.data.get('history')).slice(0, 5)); this.data.set('selectedIds', []); this.data.set('adjustment', 0); this.emitEvent('inventory-change', next); }, undo() { const history = this.data.get('history'); if (!history.length) return; this.data.set('batches', history[0].before.map(item => Object.assign({}, item))); this.data.set('history', history.slice(1)); this.emitEvent('inventory-change', this.data.get('batches')); }, exportData() { this.emitEvent('export', this.data.get('visibleBatches')); }, stockStyle(batch) { return 'width:' + Math.round(batch.quantity / batch.capacity * 100) + '%'; }, batchRowClass(batch) { return (this.isSelected(batch.id) ? 'selected ' : '') + (batch.expiryDays <= 3 ? 'risk' : ''); } });</script><style>.inventory-batch-manager { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.inventory-batch-manager * { box-sizing: border-box; }\n.inventory-batch-manager h2, .inventory-batch-manager h3, .inventory-batch-manager p { margin-top: 0; }\n.inventory-batch-manager h2 { margin-bottom: 14px; font-size: 21px; }\n.inventory-batch-manager button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.inventory-batch-manager button.primary { border-color: #0f766e; background: #0f766e; color: #fff; }\n.inventory-batch-manager button:disabled { opacity: .45; cursor: not-allowed; }\n.inventory-batch-manager input, .inventory-batch-manager select, .inventory-batch-manager textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.inventory-batch-manager .toolbar, .inventory-batch-manager .summary, .inventory-batch-manager .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.inventory-batch-manager .muted { color: #71808e; font-size: 12px; }\n.inventory-batch-manager .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\n.page-head,.metric-strip{display:flex;justify-content:space-between}.metric-strip{margin:12px 0;gap:8px}.metric-strip article{flex:1;padding:12px;background:#edf7f5}.metric-strip strong{display:block;font-size:23px}.inventory-layout{display:grid;grid-template-columns:1fr 200px;gap:14px}table{width:100%;border-collapse:collapse}th,td{padding:9px;border-bottom:1px solid #e0e5e9;text-align:left}td small{display:block}tr.selected{background:#ecfdf5}tr.risk{box-shadow:inset 3px 0 #dc2626}.stock-bar{width:75px;height:6px;background:#e5e7eb}.stock-bar span{display:block;height:100%;background:#0f766e}aside{padding:12px;background:#f7f9fa}aside label{display:grid;gap:5px;margin:8px 0}</style>",
