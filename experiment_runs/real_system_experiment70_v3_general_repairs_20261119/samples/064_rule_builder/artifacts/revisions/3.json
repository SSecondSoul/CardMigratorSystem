{
  "code": "<template><main class=\"rule-builder\"><header class=\"builder-header\"><div><span class=\"eyebrow\">\u81ea\u52a8\u5316\u914d\u7f6e</span><h1>{{title}}</h1><p>\u5c06\u4e1a\u52a1\u6761\u4ef6\u7ec4\u5408\u4e3a\u53ef\u6267\u884c\u89c4\u5219</p></div><div class=\"header-actions\"><button class=\"secondary\" type=\"button\" on-click=\"togglePreview\">{{previewOpen ? '\u5173\u95ed\u9884\u89c8' : '\u9884\u89c8\u8868\u8fbe\u5f0f'}}</button><button type=\"button\" on-click=\"save\" disabled=\"{{readonly || invalidRuleCount > 0}}\">\u4fdd\u5b58\u89c4\u5219</button></div></header><section class=\"builder-stats\"><article><span>\u6761\u4ef6\u7ec4</span><strong>{{groups.length}}</strong></article><article><span>\u89c4\u5219\u6570</span><strong>{{ruleCount}}</strong></article><article class=\"{{invalidRuleCount ? 'warning' : ''}}\"><span>\u5f85\u4fee\u6b63</span><strong>{{invalidRuleCount}}</strong></article></section><section class=\"builder-workspace\"><aside class=\"group-sidebar\"><div class=\"sidebar-title\"><strong>\u6761\u4ef6\u7ec4</strong><button type=\"button\" on-click=\"addGroup\" disabled=\"{{readonly}}\">+</button></div><button type=\"button\" s-for=\"group, index in groups trackby group.id\" on-click=\"selectGroup(group.id)\" class=\"group-tab {{selectedGroupId === group.id ? 'active' : ''}}\"><span>{{group.name}}</span><small>{{group.rules.length}} \u6761</small></button></aside><div class=\"group-editor\" s-if=\"selectedGroup\"><div class=\"group-toolbar\"><input type=\"text\" value=\"{{selectedGroup.name}}\" on-input=\"renameGroup($event.target.value)\" disabled=\"{{readonly}}\"/><select value=\"{{selectedGroup.mode}}\" on-change=\"changeMode($event.target.value)\" disabled=\"{{readonly}}\"><option value=\"all\">\u6ee1\u8db3\u5168\u90e8</option><option value=\"any\">\u6ee1\u8db3\u4efb\u4e00</option></select><button type=\"button\" on-click=\"removeGroup(selectedGroup.id)\" disabled=\"{{readonly || groups.length === 1}}\">\u5220\u9664\u7ec4</button></div><div class=\"rule-list\"><article s-for=\"rule, index in selectedGroup.rules trackby rule.id\" class=\"rule-row {{!rule.value ? 'invalid' : ''}}\"><span class=\"rule-index\">{{index + 1}}</span><select value=\"{{rule.field}}\" on-change=\"updateRule(rule.id, 'field', $event.target.value)\" disabled=\"{{readonly}}\"><option s-for=\"field in availableFields trackby field.key\" value=\"{{field.key}}\">{{field.label}}</option></select><select value=\"{{rule.operator}}\" on-change=\"updateRule(rule.id, 'operator', $event.target.value)\" disabled=\"{{readonly}}\"><option value=\"equals\">\u7b49\u4e8e</option><option value=\"contains\">\u5305\u542b</option><option value=\"greater\">\u5927\u4e8e</option></select><input type=\"text\" placeholder=\"\u6bd4\u8f83\u503c\" value=\"{{rule.value}}\" on-input=\"updateRule(rule.id, 'value', $event.target.value)\" disabled=\"{{readonly}}\"/><button type=\"button\" on-click=\"removeRule(rule.id)\" disabled=\"{{readonly}}\">\u79fb\u9664</button></article></div><button class=\"add-rule\" type=\"button\" on-click=\"addRule\" disabled=\"{{readonly}}\">\u6dfb\u52a0\u6761\u4ef6</button></div><div class=\"empty-editor\" s-else>\u8bf7\u9009\u62e9\u6761\u4ef6\u7ec4</div></section><section class=\"expression-preview\" s-if=\"previewOpen\"><div><strong>\u903b\u8f91\u8868\u8fbe\u5f0f</strong><button type=\"button\" on-click=\"validate\">\u91cd\u65b0\u6821\u9a8c</button></div><code>{{expression}}</code><ul s-if=\"errors.length\"><li s-for=\"error in errors trackby error\">{{error}}</li></ul><p s-else>\u8868\u8fbe\u5f0f\u6821\u9a8c\u901a\u8fc7</p></section><footer class=\"builder-footer\"><span>\u6700\u8fd1\u4fdd\u5b58\uff1a<span>{{savedAt || '\u5c1a\u672a\u4fdd\u5b58'}}</span></span><span>{{readonly ? '\u53ea\u8bfb\u6a21\u5f0f' : '\u81ea\u52a8\u4fdd\u5b58\u5df2\u5f00\u542f'}}</span></footer></main></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: \"RuleBuilder\",dataTypes: {title: DataTypes.string,availableFields: DataTypes.array,initialGroups: DataTypes.array,readonly: DataTypes.bool},initData() {return {title: '\u5ba2\u6237\u5206\u7fa4\u89c4\u5219',availableFields: [{key: 'region',label: '\u5730\u533a'},{key: 'score',label: '\u6d3b\u8dc3\u5206'},{key: 'tag',label: '\u6807\u7b7e'}],initialGroups: [{id: 1,name: '\u57fa\u7840\u6761\u4ef6',mode: 'all',rules: [{id: 1,field: 'region',operator: 'equals',value: '\u897f\u5357'}]},{id: 2,name: '\u884c\u4e3a\u6761\u4ef6',mode: 'any',rules: [{id: 2,field: 'score',operator: 'greater',value: '80'}]}],readonly: false,groups: null,selectedGroupId: null,previewOpen: false,errors: [],nextGroupId: 3,nextRuleId: 3,savedAt: \"\",autosaveTimer: null,draftName: \"\",testPayload: {}};},inited() {const initialGroups = this.data.get('initialGroups');let groups;if (typeof initialGroups === 'function') {groups = initialGroups();} else {groups = initialGroups || [];}this.data.set('groups', groups);this.data.set('selectedGroupId', groups.length ? groups[0].id : 0);const availableFields = this.data.get('availableFields');if (typeof availableFields === 'function') {this.data.set('availableFields', availableFields());} else {this.data.set('availableFields', availableFields || []);}},attached() {this.validate();this.scheduleAutosave();},disposed() {clearTimeout(this.data.get('autosaveTimer'));},computed: {selectedGroup() {const groups = this.data.get('groups');const selectedGroupId = this.data.get('selectedGroupId');return groups.find((group) => group.id === selectedGroupId);},ruleCount() {const groups = this.data.get('groups');return groups.reduce((sum, group) => sum + group.rules.length, 0);},invalidRuleCount() {const groups = this.data.get('groups');return groups.reduce((sum, group) => sum + group.rules.filter((rule) => !String(rule.value).trim()).length, 0);},expression() {const groups = this.data.get('groups');return groups.map((group) => {const joiner = group.mode === 'all' ? ' AND ' : ' OR ';return `(${group.rules.map((rule) => `${rule.field} ${rule.operator} \"${rule.value}\"`).join(joiner)})`;}).join(' AND ');}},selectGroup(id) {this.data.set('selectedGroupId', id);},addGroup() {const nextGroupId = this.data.get('nextGroupId');const groups = this.data.get('groups');const group = {id: nextGroupId,name: `\u6761\u4ef6\u7ec4 ${groups.length + 1}`,mode: 'all',rules: []};const newGroups = [...groups, group];this.data.set('groups', newGroups);this.data.set('selectedGroupId', group.id);this.data.set('nextGroupId', nextGroupId + 1);this.changed();},removeGroup(id) {const groups = this.data.get('groups');const filteredGroups = groups.filter((group) => group.id !== id);this.data.set('groups', filteredGroups);this.data.set('selectedGroupId', filteredGroups.length ? filteredGroups[0].id : 0);this.changed();},renameGroup(value) {const selectedGroup = this.data.get('selectedGroup');if (!selectedGroup) return;const newSelectedGroup = {...selectedGroup, name: value};const groups = this.data.get('groups');const newGroups = groups.map(group => group.id === selectedGroup.id ? newSelectedGroup : group);this.data.set('groups', newGroups);this.changed();},changeMode(value) {const selectedGroup = this.data.get('selectedGroup');if (!selectedGroup) return;const newSelectedGroup = {...selectedGroup, mode: value};const groups = this.data.get('groups');const newGroups = groups.map(group => group.id === selectedGroup.id ? newSelectedGroup : group);this.data.set('groups', newGroups);this.changed();},addRule() {const nextRuleId = this.data.get('nextRuleId');const selectedGroup = this.data.get('selectedGroup');if (!selectedGroup) return;const availableFields = this.data.get('availableFields');const newRule = {id: nextRuleId,field: availableFields[0].key,operator: 'equals',value: ''};const newRules = [...selectedGroup.rules, newRule];const newSelectedGroup = {...selectedGroup, rules: newRules};const groups = this.data.get('groups');const newGroups = groups.map(group => group.id === selectedGroup.id ? newSelectedGroup : group);this.data.set('groups', newGroups);this.data.set('nextRuleId', nextRuleId + 1);this.changed();},removeRule(id) {const selectedGroup = this.data.get('selectedGroup');if (!selectedGroup) return;const newRules = selectedGroup.rules.filter((rule) => rule.id !== id);const newSelectedGroup = {...selectedGroup, rules: newRules};const groups = this.data.get('groups');const newGroups = groups.map(group => group.id === selectedGroup.id ? newSelectedGroup : group);this.data.set('groups', newGroups);this.changed();},updateRule(id, key, value) {const selectedGroup = this.data.get('selectedGroup');if (!selectedGroup) return;const rule = selectedGroup.rules.find((item) => item.id === id);if (!rule) return;const newRule = {...rule, [key]: value};const newRules = selectedGroup.rules.map(r => r.id === id ? newRule : r);const newSelectedGroup = {...selectedGroup, rules: newRules};const groups = this.data.get('groups');const newGroups = groups.map(group => group.id === selectedGroup.id ? newSelectedGroup : group);this.data.set('groups', newGroups);this.changed();},validate() {const groups = this.data.get('groups');const errors = [];groups.forEach((group) => {if (!group.name.trim()) errors.push('\u6761\u4ef6\u7ec4\u540d\u79f0\u4e0d\u80fd\u4e3a\u7a7a');group.rules.forEach((rule) => {if (!String(rule.value).trim()) errors.push(`${group.name} \u5b58\u5728\u7a7a\u6bd4\u8f83\u503c`);});});this.data.set('errors', errors);return !errors.length;},changed() {this.validate();this.scheduleAutosave();},scheduleAutosave() {clearTimeout(this.data.get('autosaveTimer'));if (!this.data.get('readonly')) {this.data.set('autosaveTimer', setTimeout(() => {this.data.set('savedAt', '\u81ea\u52a8\u4fdd\u5b58\u5b8c\u6210');}, 400));}},save() {if (!this.validate()) return;this.data.set('savedAt', new Date().toLocaleTimeString('zh-CN', {hour: '2-digit', minute: '2-digit'}));this.fire('save', {groups: JSON.parse(JSON.stringify(this.data.get('groups'))), expression: this.data.get('expression')});},togglePreview() {this.data.set('previewOpen', !this.data.get('previewOpen'));}});</script><style>.rule-builder { width: 820px; padding: 24px; border: 1px solid #cbd5e1; border-radius: 7px; background: #f8fafc; color: #172026; font-family: Arial, sans-serif; }\n.builder-header { display: flex; justify-content: space-between; gap: 24px; }\n.builder-header h1 { margin: 3px 0; font-size: 24px; }\n.builder-header p, .eyebrow { color: #64748b; font-size: 12px; }\n.header-actions { display: flex; gap: 8px; }\n.rule-builder button { padding: 8px 11px; border: 1px solid #334155; border-radius: 4px; background: #334155; color: #ffffff; cursor: pointer; }\n.rule-builder button.secondary, .group-toolbar button, .rule-row button { background: #ffffff; color: #334155; border-color: #94a3b8; }\n.builder-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px 0; }\n.builder-stats article { padding: 12px; border-left: 3px solid #0f766e; background: #ffffff; }\n.builder-stats article.warning { border-left-color: #dc2626; }\n.builder-stats span { display: block; color: #64748b; font-size: 12px; }\n.builder-stats strong { font-size: 22px; }\n.builder-workspace { display: grid; grid-template-columns: 180px 1fr; min-height: 310px; border: 1px solid #d1d5db; background: #ffffff; }\n.group-sidebar { padding: 12px; border-right: 1px solid #e2e8f0; background: #f1f5f9; }\n.sidebar-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }\n.group-tab { width: 100%; display: flex; justify-content: space-between; margin-bottom: 6px; background: #ffffff !important; color: #334155 !important; border-color: #cbd5e1 !important; text-align: left; }\n.group-tab.active { border-color: #0f766e !important; background: #ccfbf1 !important; }\n.group-editor { padding: 16px; }\n.group-toolbar { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; }\n.group-toolbar input, .group-toolbar select, .rule-row input, .rule-row select { padding: 8px; border: 1px solid #94a3b8; }\n.rule-list { display: grid; gap: 8px; margin: 16px 0; }\n.rule-row { display: grid; grid-template-columns: 28px 1fr 1fr 1fr auto; gap: 7px; padding: 9px; border: 1px solid #e2e8f0; }\n.rule-row.invalid { border-color: #fca5a5; background: #fff1f2; }\n.rule-index { display: grid; place-items: center; color: #64748b; }\n.add-rule { background: #0f766e !important; border-color: #0f766e !important; }\n.empty-editor { display: grid; place-items: center; color: #94a3b8; }\n.expression-preview { margin-top: 16px; padding: 14px; border: 1px solid #a7f3d0; background: #ecfdf5; }\n.expression-preview > div { display: flex; justify-content: space-between; }\n.expression-preview code { display: block; margin: 12px 0; white-space: normal; color: #065f46; }\n.expression-preview ul { color: #b91c1c; }\n.builder-footer { display: flex; justify-content: space-between; margin-top: 14px; color: #64748b; font-size: 12px; }\n</style>",
