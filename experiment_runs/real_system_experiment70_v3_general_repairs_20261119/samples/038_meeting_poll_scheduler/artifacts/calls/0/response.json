{"model":"qwen-plus","id":"chatcmpl-c4e31d6d-e149-9442-b226-9042bea3c42f","choices":[{"message":{"content":"<template><section class=\"meeting-poll-scheduler\"><header><h2>会议时间投票</h2><select on-change=\"updateParticipant\" value=\"{{participant}}\"><option s-for=\"name in participants\" key=\"{{name}}\" value=\"{{name}}\">{{name}}</option></select></header><div class=\"slots\"><article s-for=\"slot in slots\" key=\"{{slot.id}}\" class=\"{{slot.id === bestId ? 'best' : ''}}\"><strong>{{slot.label}}</strong><span>{{voteCount(slot.id, votes)}} 票</span><button class=\"{{hasVote(slot.id, participant, votes) ? 'selected' : ''}}\" on-click=\"toggleVote(slot.id)\">{{hasVote(slot.id, participant, votes) ? '取消可参加' : '我可参加'}}</button><button on-click=\"confirm(slot.id)\">确定此时间</button></article></div><p s-if=\"confirmedId\">已确定候选 #{{confirmedId}}</p></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"MeetingPollScheduler\",dataTypes:{participants:DataTypes.array,slots:DataTypes.array},initData(){return {participant:\"林晓\",votes:{},confirmedId:null}},inited(){const votes={};this.data.get(\"slots\").forEach(slot=>{votes[slot.id]=[]});this.data.set(\"votes\",votes);this.data.set(\"participant\",this.data.get(\"participants\")[0]||\"\")},bestId(){const votes=this.data.get(\"votes\")||{};const rows=this.data.get(\"slots\").slice().sort((a,b)=>((votes[b.id]||[]).length-(votes[a.id]||[]).length));return rows[0]?rows[0].id:null},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},updateParticipant(event){this.data.set(\"participant\",event.target.value)},toggleVote(slotId){const votes=Object.assign({},this.data.get(\"votes\"));const list=(votes[slotId]||[]).slice();const index=list.indexOf(this.data.get(\"participant\"));votes[slotId]=index>=0?list.filter(name=>name!==this.data.get(\"participant\")):list.concat(this.data.get(\"participant\"));this.data.set(\"votes\",votes);this.emitEvent(\"vote\",{slotId,participants:votes[slotId]})},hasVote(slotId,participant,votes){return(votes[slotId]||[]).indexOf(participant)>=0},voteCount(slotId,votes){return(votes[slotId]||[]).length},confirm(id){this.data.set(\"confirmedId\",id);this.emitEvent(\"confirm\",id)}});</script><style>.meeting-poll-scheduler{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.meeting-poll-scheduler *{box-sizing:border-box}.meeting-poll-scheduler h2,.meeting-poll-scheduler h3,.meeting-poll-scheduler p{margin-top:0}.meeting-poll-scheduler button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.meeting-poll-scheduler button.primary{border-color:#0369a1;background:#0369a1;color:#fff}.meeting-poll-scheduler button:disabled{opacity:.45;cursor:not-allowed}.meeting-poll-scheduler input,.meeting-poll-scheduler select,.meeting-poll-scheduler textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.meeting-poll-scheduler .muted{color:#71808e;font-size:12px}.meeting-poll-scheduler .toolbar,.meeting-poll-scheduler .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.slots{display:grid;gap:8px}.slots article{display:grid;grid-template-columns:1fr 55px auto auto;gap:8px;align-items:center;padding:10px;border:1px solid #e2e8f0}.slots article.best{border-color:#0369a1;background:#f0f9ff}.slots button.selected{background:#dbeafe}</style>","role":"assistant"},"index":0,"finish_reason":"stop"}],"created":1795076952,"object":"chat.completion","usage":{"total_tokens":15786,"completion_tokens":972,"prompt_tokens":14814,"prompt_tokens_details":{"cached_tokens":4480}}}