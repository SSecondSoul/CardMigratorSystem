{
  "code": "<template><section class=\"meeting-poll-scheduler\"><header><h2>\u4f1a\u8bae\u65f6\u95f4\u6295\u7968</h2><select on-change=\"updateParticipant\" value=\"{{participant}}\"><option s-for=\"name in participants trackby name\" value=\"{{name}}\">{{name}}</option></select></header><div class=\"slots\"><article s-for=\"slot in slots trackby slot.id\" class=\"{{slot.id === bestId ? 'best' : ''}}\"><strong>{{slot.label}}</strong><span>{{voteCount(slot.id, votes)}} \u7968</span><button class=\"{{hasVote(slot.id, participant, votes) ? 'selected' : ''}}\" on-click=\"toggleVote(slot.id)\">{{hasVote(slot.id, participant, votes) ? '\u53d6\u6d88\u53ef\u53c2\u52a0' : '\u6211\u53ef\u53c2\u52a0'}}</button><button on-click=\"confirm(slot.id)\">\u786e\u5b9a\u6b64\u65f6\u95f4</button></article></div><p s-if=\"confirmedId\">\u5df2\u786e\u5b9a\u5019\u9009 #{{confirmedId}}</p></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: \"MeetingPollScheduler\",dataTypes: {participants: DataTypes.array,slots: DataTypes.array},initData() {return {participants: [\"\u6797\u6653\", \"\u5468\u5b81\", \"\u9648\u96e8\"],slots: [{\"id\": 1,\"label\": \"\u5468\u4e8c 10:00\"},{\"id\": 2,\"label\": \"\u5468\u4e09 14:00\"},{\"id\": 3,\"label\": \"\u5468\u4e94 16:00\"}],participant: \"\u6797\u6653\",votes: {},confirmedId: null};},inited() {const votes = {};this.data.get(\"slots\").forEach(slot => votes[slot.id] = []);this.data.set(\"votes\", votes);this.data.set(\"participant\", this.data.get(\"participants\")[0] || \"\");},computed: {bestId() {const votes = this.data.get(\"votes\") || {};const rows = this.data.get(\"slots\").slice().sort((a, b) => ((votes[b.id] || []).length - (votes[a.id] || []).length));return rows[0] ? rows[0].id : null;}},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},updateParticipant(event) {this.data.set(\"participant\", event.target.value);},toggleVote(slotId) {const votes = Object.assign({}, this.data.get(\"votes\"));const list = (votes[slotId] || []).slice();const index = list.indexOf(this.data.get(\"participant\"));votes[slotId] = index >= 0 ? list.filter(name => name !== this.data.get(\"participant\")) : list.concat(this.data.get(\"participant\"));this.data.set(\"votes\", votes);this.emitEvent(\"vote\", {slotId, participants: votes[slotId]});},hasVote(slotId, participant, votes) {return (votes[slotId] || []).indexOf(participant) >= 0;},voteCount(slotId, votes) {return (votes[slotId] || []).length;},confirm(id) {this.data.set(\"confirmedId\", id);this.emitEvent(\"confirm\", id);}});</script><style>.meeting-poll-scheduler{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.meeting-poll-scheduler *{box-sizing:border-box}.meeting-poll-scheduler h2,.meeting-poll-scheduler h3,.meeting-poll-scheduler p{margin-top:0}.meeting-poll-scheduler button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.meeting-poll-scheduler button.primary{border-color:#0369a1;background:#0369a1;color:#fff}.meeting-poll-scheduler button:disabled{opacity:.45;cursor:not-allowed}.meeting-poll-scheduler input,.meeting-poll-scheduler select,.meeting-poll-scheduler textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.meeting-poll-scheduler .muted{color:#71808e;font-size:12px}.meeting-poll-scheduler .toolbar,.meeting-poll-scheduler .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.slots{display:grid;gap:8px}.slots article{display:grid;grid-template-columns:1fr 55px auto auto;gap:8px;align-items:center;padding:10px;border:1px solid #e2e8f0}.slots article.best{border-color:#0369a1;background:#f0f9ff}.slots button.selected{background:#dbeafe}</style>",
