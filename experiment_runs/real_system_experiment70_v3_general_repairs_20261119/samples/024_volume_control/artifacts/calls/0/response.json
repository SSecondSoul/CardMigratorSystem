{"model":"qwen-plus","id":"chatcmpl-1514bfa0-7077-968d-a009-f87d36425c74","choices":[{"message":{"content":"<template><section class=\"volume-control\"><header><h2>播放音量</h2><strong>{{volumeLabel}}</strong></header><input class=\"volume-slider\" type=\"range\" min=\"0\" max=\"100\" value=\"{{volume}}\" on-input=\"updateVolume\"/><button class=\"primary\" on-click=\"toggleMute\">{{volume === 0 ? '恢复音量' : '静音'}}</button></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"VolumeControl\",dataTypes:{initialVolume:DataTypes.number},initData(){return {volume:45,lastVolume:45}},computed:{volumeLabel(){return this.data.get(\"volume\")===0?\"已静音\":this.data.get(\"volume\")+\"%\"}},\"inited\"(){this.data.set(\"volume\",this.data.get(\"initialVolume\")||45);this.data.set(\"lastVolume\",this.data.get(\"initialVolume\")||45)},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},updateVolume(event){const value=Number(event.target.value);this.data.set(\"volume\",value);if(value>0)this.data.set(\"lastVolume\",value);this.fire(\"change\",value)},toggleMute(){const next=this.data.get(\"volume\")===0?this.data.get(\"lastVolume\"):0;this.data.set(\"volume\",next);this.fire(\"change\",next)}});</script><style>.volume-control { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.volume-control * { box-sizing: border-box; }\n.volume-control h2, .volume-control h3, .volume-control p { margin-top: 0; }\n.volume-control h2 { margin-bottom: 14px; font-size: 21px; }\n.volume-control button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.volume-control button.primary { border-color: #0f766e; background: #0f766e; color: #fff; }\n.volume-control button:disabled { opacity: .45; cursor: not-allowed; }\n.volume-control input, .volume-control select, .volume-control textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.volume-control .toolbar, .volume-control .summary, .volume-control .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.volume-control .muted { color: #71808e; font-size: 12px; }\n.volume-control .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\nheader{display:flex;justify-content:space-between}.volume-slider{width:100%;margin:12px 0;accent-color:#0f766e}\n</style>","role":"assistant"},"index":0,"finish_reason":"stop"}],"created":1795073416,"object":"chat.completion","usage":{"total_tokens":11387,"completion_tokens":749,"prompt_tokens":10638,"prompt_tokens_details":{"cached_tokens":4480}}}