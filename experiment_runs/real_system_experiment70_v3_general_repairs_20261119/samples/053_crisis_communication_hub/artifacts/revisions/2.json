{
  "code": "<template><section class=\"crisis-communication-hub\"><header><div><small>\u53d7\u4f17 {{recipientCount}} \u4eba \u00b7 \u5ba1\u6279 {{approvals.length}}/{{requiredApprovals}}</small><h2>{{incidentTitle}}</h2></div><button class=\"primary\" on-click=\"send\" disabled=\"{{!canSend}}\">\u7acb\u5373\u53d1\u9001</button></header><div class=\"crisis-layout\"><aside><h3>\u6d88\u606f\u7248\u672c</h3><button s-for=\"version, index in versions trackby version.id\" class=\"{{activeVersionId === version.id ? 'active' : ''}}\" on-click=\"selectVersion(version.id)\"><strong>v{{version.id}} \u00b7 {{version.status}}</strong><span>{{version.subject}}</span></button><button on-click=\"saveVersion\">\u53e6\u5b58\u4e3a\u65b0\u7248\u672c</button></aside><main><label>\u6807\u9898<input value=\"{{editSubject}}\" on-input=\"updateDraft('editSubject', $event)\"></label><label>\u6b63\u6587<textarea value=\"{{editBody}}\" on-input=\"updateDraft('editBody', $event)\"></textarea></label><div class=\"selectors\"><section><h3>\u53d7\u4f17</h3><button s-for=\"audience, index in audiences trackby audience.id\" class=\"{{isSelected(audience.id, selectedAudienceIds) ? 'selected' : ''}}\" on-click=\"toggleAudience(audience.id)\">{{audience.name}} \u00b7 {{audience.count}}</button></section><section><h3>\u6e20\u9053</h3><button s-for=\"channel, index in channels trackby channel.id\" class=\"{{isSelected(channel.id, selectedChannelIds) ? 'selected' : ''}}\" on-click=\"toggleChannel(channel.id)\">{{channel.name}}</button></section></div><button on-click=\"requestApproval\" disabled=\"{{!canRequestApproval}}\">\u63d0\u4ea4\u5ba1\u6279</button></main><aside class=\"approval\"><h3>\u5ba1\u6279\u94fe</h3><button s-for=\"person, index in approvers trackby person\" class=\"{{hasApproval(person, approvals) ? 'approved' : ''}}\" on-click=\"approve(person)\">{{person}} \u00b7 {{hasApproval(person, approvals) ? '\u5df2\u6279\u51c6' : '\u5f85\u6279\u51c6'}}</button><h3>\u53d1\u9001\u8bb0\u5f55</h3><p s-for=\"entry, index in deliveryLog trackby entry.id\">{{entry.channelId}} \u00b7 {{entry.recipients}}\u4eba \u00b7 {{entry.status}}</p></aside></div></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: 'CrisisCommunicationHub',dataTypes: {incidentTitle: DataTypes.string,audiences: DataTypes.array,channels: DataTypes.array,approvers: DataTypes.array,requiredApprovals: DataTypes.number},initData() {return {incidentTitle: '\u533a\u57df\u670d\u52a1\u4e2d\u65ad\u901a\u62a5',audiences: [{id: 'customers',name: '\u53d7\u5f71\u54cd\u5ba2\u6237',count: 1280},{id: 'staff',name: '\u5185\u90e8\u5458\u5de5',count: 230},{id: 'media',name: '\u5a92\u4f53\u8054\u7cfb\u4eba',count: 18}],channels: [{id: 'sms',name: '\u77ed\u4fe1'},{id: 'email',name: '\u90ae\u4ef6'},{id: 'status',name: '\u72b6\u6001\u9875'}],approvers: ['\u503c\u73ed\u7ecf\u7406', '\u6cd5\u52a1\u8d1f\u8d23\u4eba'],requiredApprovals: 2,versions: [{id: 1,subject: '\u670d\u52a1\u5f02\u5e38\u901a\u77e5',body: '\u6211\u4eec\u6b63\u5728\u5904\u7406\u533a\u57df\u670d\u52a1\u4e2d\u65ad\uff0c\u4e0b\u4e00\u6b21\u66f4\u65b0\u5c06\u572830\u5206\u949f\u5185\u53d1\u5e03\u3002',author: '\u54cd\u5e94\u7ec4',status: 'draft'}],activeVersionId: 1,selectedAudienceIds: ['customers'],selectedChannelIds: ['email', 'status'],approvals: [],deliveryLog: [],editSubject: '',editBody: '',nextVersionId: 2};},inited() {const versions = this.data.get('versions');const active = versions[0];this.data.set('editSubject', active.subject);this.data.set('editBody', active.body);},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},updateDraft(field, event) {this.data.set(field, event.target.value);this.data.set('approvals', []);const versions = this.data.get('versions');const activeVersionId = this.data.get('activeVersionId');this.data.set('versions', versions.map(item => item.id === activeVersionId ? Object.assign({}, item, {status: 'draft'}) : item));},toggleAudience(id) {const ids = this.data.get('selectedAudienceIds');this.data.set('selectedAudienceIds', ids.indexOf(id) >= 0 ? ids.filter(item => item !== id) : ids.concat(id));this.data.set('approvals', []);},toggleChannel(id) {const ids = this.data.get('selectedChannelIds');this.data.set('selectedChannelIds', ids.indexOf(id) >= 0 ? ids.filter(item => item !== id) : ids.concat(id));this.data.set('approvals', []);},saveVersion() {if (!this.data.get('canRequestApproval')) return;const nextVersionId = this.data.get('nextVersionId');const editSubject = this.data.get('editSubject');const editBody = this.data.get('editBody');const version = {id: nextVersionId,subject: editSubject,body: editBody,author: '\u54cd\u5e94\u7ec4',status: 'draft'};const versions = this.data.get('versions');this.data.set('versions', versions.concat(version));this.data.set('activeVersionId', version.id);this.data.set('nextVersionId', version.id + 1);this.data.set('approvals', []);this.fire('version', version);},selectVersion(id) {const versions = this.data.get('versions');const version = versions.find(item => item.id === id);if (!version) return;this.data.set('activeVersionId', id);this.data.set('editSubject', version.subject);this.data.set('editBody', version.body);this.data.set('approvals', []);},requestApproval() {if (!this.data.get('canRequestApproval')) return;const versions = this.data.get('versions');const activeVersionId = this.data.get('activeVersionId');const editSubject = this.data.get('editSubject');const editBody = this.data.get('editBody');this.data.set('versions', versions.map(item => item.id === activeVersionId ? Object.assign({}, item, {subject: editSubject, body: editBody, status: 'reviewing'}) : item));this.fire('review', activeVersionId);},approve(person) {const activeVersion = this.data.get('activeVersion');const approvals = this.data.get('approvals');const requiredApprovals = this.data.get('requiredApprovals');const versions = this.data.get('versions');const activeVersionId = this.data.get('activeVersionId');if (!activeVersion || activeVersion.status !== 'reviewing' || approvals.indexOf(person) >= 0) return;const newApprovals = approvals.concat(person);this.data.set('approvals', newApprovals);if (newApprovals.length >= requiredApprovals) {this.data.set('versions', versions.map(item => item.id === activeVersionId ? Object.assign({}, item, {status: 'approved'}) : item));}this.fire('approve', {person, versionId: activeVersionId});},send() {if (!this.data.get('canSend')) return;const selectedChannelIds = this.data.get('selectedChannelIds');const recipientCount = this.data.get('recipientCount');const deliveries = selectedChannelIds.map((channelId, index) => ({id: Date.now() + index,channelId,recipients: recipientCount,status: 'sent'}));const deliveryLog = this.data.get('deliveryLog');this.data.set('deliveryLog', deliveries.concat(deliveryLog));const versions = this.data.get('versions');const activeVersionId = this.data.get('activeVersionId');this.data.set('versions', versions.map(item => item.id === activeVersionId ? Object.assign({}, item, {status: 'sent'}) : item));this.fire('send', {versionId: activeVersionId,audiences: this.data.get('selectedAudienceIds'),channels: selectedChannelIds});},isSelected(id, list) {return list.indexOf(id) >= 0;},hasApproval(person, approvals) {return approvals.indexOf(person) >= 0;},computed: {activeVersion() {const versions = this.data.get('versions');const activeVersionId = this.data.get('activeVersionId');return versions.find(item => item.id === activeVersionId) || null;},recipientCount() {const audiences = this.data.get('audiences');const selectedAudienceIds = this.data.get('selectedAudienceIds');return audiences.filter(item => selectedAudienceIds.indexOf(item.id) >= 0).reduce((sum, item) => sum + item.count, 0);},canRequestApproval() {const editSubject = this.data.get('editSubject');const editBody = this.data.get('editBody');const selectedAudienceIds = this.data.get('selectedAudienceIds');const selectedChannelIds = this.data.get('selectedChannelIds');return editSubject.trim().length > 0 && editBody.trim().length >= 20 && selectedAudienceIds.length > 0 && selectedChannelIds.length > 0;},canSend() {const canRequestApproval = this.data.get('canRequestApproval');const approvals = this.data.get('approvals');const requiredApprovals = this.data.get('requiredApprovals');const activeVersion = this.data.get('activeVersion');return canRequestApproval && approvals.length >= requiredApprovals && activeVersion && activeVersion.status === 'approved';}}});</script><style>.crisis-communication-hub{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.crisis-communication-hub *{box-sizing:border-box}.crisis-communication-hub h2,.crisis-communication-hub h3,.crisis-communication-hub p{margin-top:0}.crisis-communication-hub button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.crisis-communication-hub button.primary{border-color:#b91c1c;background:#b91c1c;color:#fff}.crisis-communication-hub button:disabled{opacity:.45;cursor:not-allowed}.crisis-communication-hub input,.crisis-communication-hub select,.crisis-communication-hub textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.crisis-communication-hub .muted{color:#71808e;font-size:12px}.crisis-communication-hub .toolbar,.crisis-communication-hub .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.crisis-layout{display:grid;grid-template-columns:200px 1fr 220px;gap:12px}.crisis-layout>aside{padding:10px;background:#f8fafc}.crisis-layout>aside>button{display:grid;width:100%;text-align:left;margin-bottom:7px}.crisis-layout>aside>button.active{background:#fef3c7;border-color:#d97706}.crisis-layout main label{display:grid;margin-bottom:10px}.crisis-layout textarea{min-height:150px}.selectors{display:grid;grid-template-columns:1fr 1fr;gap:10px}.selectors section{padding:10px;border:1px solid #e2e8f0}.selectors button{display:block;width:100%;margin:5px 0}.selectors button.selected{background:#fef3c7}.approval button.approved{background:#dcfce7;color:#166534}.approval p{padding:6px;background:white}</style>",
