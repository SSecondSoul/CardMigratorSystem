{"model":"qwen-plus","id":"chatcmpl-23976786-8b09-962d-93a3-d5b1dc82e3ac","choices":[{"message":{"content":"<template><section class=\"crisis-communication-hub\"><header><div><small>受众 {{recipientCount}} 人 · 审批 {{approvals.length}}/{{requiredApprovals}}</small><h2>{{incidentTitle}}</h2></div><button class=\"primary\" on-click=\"send\" disabled=\"{{!canSend}}\">立即发送</button></header><div class=\"crisis-layout\"><aside><h3>消息版本</h3><button s-for=\"version in versions trackby version.id\" class=\"{{activeVersionId === version.id ? 'active' : ''}}\" on-click=\"selectVersion(version.id)\"><strong>v{{version.id}} · {{version.status}}</strong><span>{{version.subject}}</span></button><button on-click=\"saveVersion\">另存为新版本</button></aside><main><label>标题<input value=\"{{editSubject}}\" on-input=\"updateDraft('editSubject', $event)\"></label><label>正文<textarea value=\"{{editBody}}\" on-input=\"updateDraft('editBody', $event)\"></textarea></label><div class=\"selectors\"><section><h3>受众</h3><button s-for=\"audience in audiences trackby audience.id\" class=\"{{isSelected(audience.id, selectedAudienceIds) ? 'selected' : ''}}\" on-click=\"toggleAudience(audience.id)\">{{audience.name}} · {{audience.count}}</button></section><section><h3>渠道</h3><button s-for=\"channel in channels trackby channel.id\" class=\"{{isSelected(channel.id, selectedChannelIds) ? 'selected' : ''}}\" on-click=\"toggleChannel(channel.id)\">{{channel.name}}</button></section></div><button on-click=\"requestApproval\" disabled=\"{{!canRequestApproval}}\">提交审批</button></main><aside class=\"approval\"><h3>审批链</h3><button s-for=\"person in approvers trackby person\" class=\"{{hasApproval(person, approvals) ? 'approved' : ''}}\" on-click=\"approve(person)\">{{person}} · {{hasApproval(person, approvals) ? '已批准' : '待批准'}}</button><h3>发送记录</h3><p s-for=\"entry in deliveryLog trackby entry.id\">{{entry.channelId}} · {{entry.recipients}}人 · {{entry.status}}</p></aside></div></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"CrisisCommunicationHub\",dataTypes:{incidentTitle:DataTypes.string,audiences:DataTypes.array,channels:DataTypes.array,approvers:DataTypes.array,requiredApprovals:DataTypes.number},initData(){return {versions:[{id:1,subject:\"服务异常通知\",body:\"我们正在处理区域服务中断，下一次更新将在30分钟内发布。\",author:\"响应组\",status:\"draft\"}],activeVersionId:1,selectedAudienceIds:[\"customers\"],selectedChannelIds:[\"email\",\"status\"],approvals:[],deliveryLog:[],editSubject:\"\",editBody:\"\",nextVersionId:2}},inited(){const active=this.data.get(\"versions\")[0];this.data.set(\"editSubject\",active.subject);this.data.set(\"editBody\",active.body)},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},updateDraft(field,event){this.data.set(field,event.target.value);this.data.set(\"approvals\",[]);const versions=this.data.get(\"versions\");const activeVersionId=this.data.get(\"activeVersionId\");this.data.set(\"versions\",versions.map(item=>item.id===activeVersionId?Object.assign({},item,{status:\"draft\"}):item))},toggleAudience(id){const ids=this.data.get(\"selectedAudienceIds\");this.data.set(\"selectedAudienceIds\",ids.indexOf(id)>=0?ids.filter(item=>item!==id):ids.concat(id));this.data.set(\"approvals\",[])},toggleChannel(id){const ids=this.data.get(\"selectedChannelIds\");this.data.set(\"selectedChannelIds\",ids.indexOf(id)>=0?ids.filter(item=>item!==id):ids.concat(id));this.data.set(\"approvals\",[])},saveVersion(){if(!this.data.get(\"canRequestApproval\"))return;const nextVersionId=this.data.get(\"nextVersionId\");const editSubject=this.data.get(\"editSubject\");const editBody=this.data.get(\"editBody\");const version={id:nextVersionId,subject:editSubject,body:editBody,author:\"响应组\",status:\"draft\"};const versions=this.data.get(\"versions\");this.data.set(\"versions\",versions.concat(version));this.data.set(\"activeVersionId\",version.id);this.data.set(\"nextVersionId\",version.id+1);this.data.set(\"approvals\",[]);this.fire(\"version\",version)},selectVersion(id){const versions=this.data.get(\"versions\");const version=versions.find(item=>item.id===id);if(!version)return;this.data.set(\"activeVersionId\",id);this.data.set(\"editSubject\",version.subject);this.data.set(\"editBody\",version.body);this.data.set(\"approvals\",[])},requestApproval(){if(!this.data.get(\"canRequestApproval\"))return;const versions=this.data.get(\"versions\");const activeVersionId=this.data.get(\"activeVersionId\");const editSubject=this.data.get(\"editSubject\");const editBody=this.data.get(\"editBody\");this.data.set(\"versions\",versions.map(item=>item.id===activeVersionId?Object.assign({},item,{subject:editSubject,body:editBody,status:\"reviewing\"}):item));this.fire(\"review\",activeVersionId)},approve(person){const activeVersion=this.data.get(\"activeVersion\");const approvals=this.data.get(\"approvals\");const requiredApprovals=this.data.get(\"requiredApprovals\");const versions=this.data.get(\"versions\");const activeVersionId=this.data.get(\"activeVersionId\");if(!activeVersion||activeVersion.status!==\"reviewing\"||approvals.indexOf(person)>=0)return;const newApprovals=approvals.concat(person);this.data.set(\"approvals\",newApprovals);if(newApprovals.length>=requiredApprovals){this.data.set(\"versions\",versions.map(item=>item.id===activeVersionId?Object.assign({},item,{status:\"approved\"}):item))}this.fire(\"approve\",{person,versionId:activeVersionId})},send(){if(!this.data.get(\"canSend\"))return;const selectedChannelIds=this.data.get(\"selectedChannelIds\");const recipientCount=this.data.get(\"recipientCount\");const deliveries=selectedChannelIds.map((channelId,index)=>({id:Date.now()+index,channelId,recipients:recipientCount,status:\"sent\"}));const deliveryLog=this.data.get(\"deliveryLog\");this.data.set(\"deliveryLog\",deliveries.concat(deliveryLog));const versions=this.data.get(\"versions\");const activeVersionId=this.data.get(\"activeVersionId\");this.data.set(\"versions\",versions.map(item=>item.id===activeVersionId?Object.assign({},item,{status:\"sent\"}):item));this.fire(\"send\",{versionId:activeVersionId,audiences:this.data.get(\"selectedAudienceIds\"),channels:selectedChannelIds})},isSelected(id,list){return list.indexOf(id)>=0},hasApproval(person,approvals){return approvals.indexOf(person)>=0},computed:{activeVersion(){const versions=this.data.get(\"versions\");const activeVersionId=this.data.get(\"activeVersionId\");return versions.find(item=>item.id===activeVersionId)||null},recipientCount(){const audiences=this.data.get(\"audiences\");const selectedAudienceIds=this.data.get(\"selectedAudienceIds\");return audiences.filter(item=>selectedAudienceIds.indexOf(item.id)>=0).reduce((sum,item)=>sum+item.count,0)},canRequestApproval(){const editSubject=this.data.get(\"editSubject\");const editBody=this.data.get(\"editBody\");const selectedAudienceIds=this.data.get(\"selectedAudienceIds\");const selectedChannelIds=this.data.get(\"selectedChannelIds\");return editSubject.trim().length>0&&editBody.trim().length>=20&&selectedAudienceIds.length>0&&selectedChannelIds.length>0},canSend(){const canRequestApproval=this.data.get(\"canRequestApproval\");const approvals=this.data.get(\"approvals\");const requiredApprovals=this.data.get(\"requiredApprovals\");const activeVersion=this.data.get(\"activeVersion\");return canRequestApproval&&approvals.length>=requiredApprovals&&activeVersion&&activeVersion.status===\"approved\"}}});</script><style>.crisis-communication-hub{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.crisis-communication-hub *{box-sizing:border-box}.crisis-communication-hub h2,.crisis-communication-hub h3,.crisis-communication-hub p{margin-top:0}.crisis-communication-hub button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.crisis-communication-hub button.primary{border-color:#b91c1c;background:#b91c1c;color:#fff}.crisis-communication-hub button:disabled{opacity:.45;cursor:not-allowed}.crisis-communication-hub input,.crisis-communication-hub select,.crisis-communication-hub textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.crisis-communication-hub .muted{color:#71808e;font-size:12px}.crisis-communication-hub .toolbar,.crisis-communication-hub .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}header{display:flex;justify-content:space-between}.crisis-layout{display:grid;grid-template-columns:200px 1fr 220px;gap:12px}.crisis-layout>aside{padding:10px;background:#f8fafc}.crisis-layout>aside>button{display:grid;width:100%;text-align:left;margin-bottom:7px}.crisis-layout>aside>button.active{background:#fef3c7;border-color:#d97706}.crisis-layout main label{display:grid;margin-bottom:10px}.crisis-layout textarea{min-height:150px}.selectors{display:grid;grid-template-columns:1fr 1fr;gap:10px}.selectors section{padding:10px;border:1px solid #e2e8f0}.selectors button{display:block;width:100%;margin:5px 0}.selectors button.selected{background:#fef3c7}.approval button.approved{background:#dcfce7;color:#166534}.approval p{padding:6px;background:white}</style>","role":"assistant"},"index":0,"finish_reason":"stop"}],"created":1795084403,"object":"chat.completion","usage":{"total_tokens":29958,"completion_tokens":2335,"prompt_tokens":27623,"prompt_tokens_details":{"cached_tokens":0}}}