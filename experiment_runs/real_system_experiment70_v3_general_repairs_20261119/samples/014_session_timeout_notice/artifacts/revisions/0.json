{
  "code": "<template><section class=\"session-timeout-notice {{ stateClass === 'warning' ? 'warning' : stateClass === 'expired' ? 'expired' : '' }}\"><h2>{{remaining ? '\u4f1a\u8bdd\u5269\u4f59 ' + remaining + ' \u79d2' : '\u4f1a\u8bdd\u5df2\u8fc7\u671f'}}</h2><p>{{paused ? '\u8ba1\u65f6\u5df2\u6682\u505c' : '\u8bf7\u53ca\u65f6\u4fdd\u5b58\u5f53\u524d\u5de5\u4f5c'}}</p><div class=\"actions\"><button on-click=\"togglePause\" disabled=\"{{remaining === 0}}\">{{paused ? '\u7ee7\u7eed' : '\u6682\u505c'}}</button><button class=\"primary\" on-click=\"extend\">\u5ef6\u957f\u4f1a\u8bdd</button></div></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"SessionTimeoutNotice\",dataTypes:{initialSeconds:DataTypes.number,warningAt:DataTypes.number},initData(){return {remaining:15,paused:false}},inited(){this.data.set(\"remaining\",this.data.get(\"initialSeconds\"))},attached(){this._timer=setInterval(()=>this.tick(),1000)},disposed(){clearInterval(this._timer)},computed:{stateClass(){const remaining=this.data.get(\"remaining\");const warningAt=this.data.get(\"warningAt\");return remaining===0?\"expired\":remaining<=warningAt?\"warning\":\"active\"}},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},tick(){if(this.data.get(\"paused\")||this.data.get(\"remaining\")<=0)return;const next=this.data.get(\"remaining\")-1;this.data.set(\"remaining\",next);if(next===0)this.emitEvent(\"expire\")},togglePause(){this.data.set(\"paused\",!this.data.get(\"paused\"))},extend(){this.data.set(\"remaining\",this.data.get(\"initialSeconds\"));this.data.set(\"paused\",false)}});</script><style>.session-timeout-notice{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.session-timeout-notice *{box-sizing:border-box}.session-timeout-notice h2,.session-timeout-notice h3,.session-timeout-notice p{margin-top:0}.session-timeout-notice button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.session-timeout-notice button.primary{border-color:#b91c1c;background:#b91c1c;color:#fff}.session-timeout-notice button:disabled{opacity:.45;cursor:not-allowed}.session-timeout-notice input,.session-timeout-notice select,.session-timeout-notice textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.session-timeout-notice .muted{color:#71808e;font-size:12px}.session-timeout-notice .toolbar,.session-timeout-notice .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.session-timeout-notice.warning{border-color:#d97706;background:#fffbeb}.session-timeout-notice.expired{border-color:#dc2626;background:#fef2f2}</style>",
