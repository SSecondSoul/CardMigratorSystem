{
  "code": "<template><section class=\"price-stepper\"><div><h2>\u624b\u51b2\u5496\u5561\u8c46</h2><span>\u00a5{{unitPrice}} / \u888b</span></div><div class=\"step\"><button on-click=\"change(-1)\" disabled=\"{{quantity <= min}}\">\u2212</button><strong>{{quantity}}</strong><button on-click=\"change(1)\" disabled=\"{{quantity >= max}}\">\uff0b</button></div><output>\u5408\u8ba1 \u00a5{{total}}</output></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"PriceStepper\",dataTypes:{unitPrice:DataTypes.number,min:DataTypes.number,max:DataTypes.number},initData(){return {\nunitPrice: 36,\nmin: 1,\nmax: 8,\nquantity:1}},computed:{total(){return (this.data.get(\"unitPrice\")*this.data.get(\"quantity\")).toFixed(2)}},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},change(delta){const next=Math.max(this.data.get(\"min\"),Math.min(this.data.get(\"max\"),this.data.get(\"quantity\")+delta));this.setValue(\"quantity\",next);this.emitEvent(\"change\",next)}});</script><style>.price-stepper{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.price-stepper *{box-sizing:border-box}.price-stepper h2,.price-stepper h3,.price-stepper p{margin-top:0}.price-stepper button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.price-stepper button.primary{border-color:#059669;background:#059669;color:#fff}.price-stepper button:disabled{opacity:.45;cursor:not-allowed}.price-stepper input,.price-stepper select,.price-stepper textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.price-stepper .muted{color:#71808e;font-size:12px}.price-stepper .toolbar,.price-stepper .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.price-stepper{display:grid;grid-template-columns:1fr auto;gap:12px}.step{display:flex;align-items:center;gap:10px}.price-stepper output{grid-column:1/-1;padding:12px;background:#ecfdf5;font-size:20px}</style>",
