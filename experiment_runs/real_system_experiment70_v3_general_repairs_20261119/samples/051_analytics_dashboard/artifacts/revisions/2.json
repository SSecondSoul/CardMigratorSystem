{
  "code": "<template><div class=\"analytics-dashboard{{ isDarkMode ? ' dark-mode' : '' }}{{ isCompactView ? ' compact' : '' }}\"><div class=\"dashboard-navbar\"><div class=\"logo-section\"><span class=\"logo-icon\">\ud83d\udcc8</span><h1 class=\"logo-text\">Analytics Pro</h1></div><div class=\"nav-controls\"><button class=\"view-toggle\" on-click=\"toggleView\">{{isCompactView ? '\ud83d\udcca \u5c55\u5f00\u89c6\u56fe' : '\ud83d\udccb \u7d27\u51d1\u89c6\u56fe'}}</button><button class=\"theme-toggle\" on-click=\"toggleTheme\">{{isDarkMode ? '\u2600\ufe0f \u4eae\u8272' : '\ud83c\udf19 \u6697\u8272'}}</button><button class=\"refresh-btn\" disabled=\"{{ isLoading }}\" on-click=\"manualRefresh\">{{isLoading ? '\u23f3 \u52a0\u8f7d\u4e2d...' : '\ud83d\udd04 \u5237\u65b0\u6570\u636e'}}</button></div></div><div class=\"stats-grid\"><stat-card s-for=\"stat, index in statistics trackby stat.id\" title=\"{{stat.title}}\" value=\"{{stat.value}}\" change=\"{{stat.change}}\" icon=\"{{stat.icon}}\" loading=\"{{ isLoading }}\" on-click=\"onStatClick(stat)\"/></div><div class=\"visualization-section\"><div class=\"chart-container\"><h3 class=\"section-title\"><span>\ud83d\udcca \u5b9e\u65f6\u8bbf\u95ee\u8d8b\u52bf</span><select class=\"period-selector\" value=\"{{ selectedPeriod }}\" on-change=\"onPeriodChange\"><option value=\"7d\">\u6700\u8fd17\u5929</option><option value=\"30d\">\u6700\u8fd130\u5929</option><option value=\"90d\">\u6700\u8fd190\u5929</option></select></h3><trend-chart data=\"{{ chartData }}\" height=\"300\" loading=\"{{ isLoading }}\" on-data-point-click=\"onDataPointClick\"/></div><div class=\"insights-panel\"><h3 class=\"section-title\">\ud83d\udca1 \u667a\u80fd\u6d1e\u5bdf</h3><insight-list insights=\"{{ insights }}\" loading=\"{{ isLoading }}\" on-insight-click=\"onInsightClick\"/></div></div><div class=\"activity-section\"><div class=\"activity-header\"><h3 class=\"section-title\">\ud83d\udccb \u5b9e\u65f6\u7528\u6237\u6d3b\u52a8</h3><div class=\"filter-controls\"><input class=\"search-input\" type=\"text\" placeholder=\"\u641c\u7d22\u7528\u6237\u6216\u64cd\u4f5c...\" value=\"{{ searchQuery }}\" on-input=\"onSearchChange\"/><select class=\"filter-select\" value=\"{{ activityFilter }}\" on-change=\"onFilterChange\"><option value=\"all\">\u6240\u6709\u6d3b\u52a8</option><option value=\"login\">\u767b\u5f55</option><option value=\"purchase\">\u8d2d\u4e70</option><option value=\"view\">\u6d4f\u89c8</option><option value=\"share\">\u5206\u4eab</option></select></div></div><activity-table activities=\"{{ filteredActivities }}\" loading=\"{{ isLoading }}\" on-row-click=\"onActivityClick\"/></div><div class=\"loading-overlay\" s-if=\"isLoading\"><div class=\"spinner\"></div><p>\u6b63\u5728\u52a0\u8f7d\u6700\u65b0\u6570\u636e...</p></div></div></template><script>const san = require('san');const DataTypes = san.DataTypes;const StatCard = san.defineComponent({name: 'StatCard',dataTypes: {title: DataTypes.any,value: DataTypes.any,change: DataTypes.any,icon: DataTypes.any,loading: DataTypes.any},template: `<div class=\"stat-card{{ loading ? ' loading' : '' }}\" on-click=\"fire('click')\"><div class=\"stat-icon\">{{ icon }}</div><div class=\"stat-content\"><div class=\"stat-title\">{{ title }}</div><div class=\"stat-value\">{{ formatValue(value) }}</div><div class=\"stat-change{{ change > 0 ? ' positive' : '' }}{{ change < 0 ? ' negative' : '' }}{{ change === 0 ? ' neutral' : '' }}\"> {{ changeIcon(change) }} {{ formatChange(change) }}%</div></div></div>`,computed: {},formatValue: function(value) {if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';if (value >= 1000) return (value / 1000).toFixed(1) + 'K';return value.toString();},formatChange: function(change) {return Math.abs(change);},changeIcon: function(change) {if (change > 0) return '\u25b2';if (change < 0) return '\u25bc';return '\u25cf';}});const TrendChart = san.defineComponent({name: 'TrendChart',dataTypes: {data: DataTypes.any,height: DataTypes.any,loading: DataTypes.any},template: `<div class=\"trend-chart{{ loading ? ' chart-loading' : '' }}\"><svg width=\"100%\" height=\"{{ height }}\" viewBox=\"0 0 800 300\" preserveAspectRatio=\"none\"><!-- \u7f51\u683c\u7ebf --><g s-for=\"i in 5 trackby i\"><line x1=\"0\" y1=\"{{ i * 60 }}\" x2=\"800\" y2=\"{{ i * 60 }}\" stroke=\"#e2e8f0\" stroke-width=\"0.5\" stroke-dasharray=\"4,4\"/></g><!-- \u9762\u79ef\u586b\u5145 --><polygon points=\"{{ areaPoints }}\" fill=\"rgba(59, 130, 246, 0.1)\" stroke=\"none\"/><!-- \u6570\u636e\u7ebf\u6761 --><polyline points=\"{{ linePoints }}\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><!-- \u6570\u636e\u70b9 --><g s-for=\"point, idx in data trackby point.id\"><circle cx=\"{{ getX(idx) }}\" cy=\"{{ getY(point.value) }}\" r=\"4\" fill=\"#ef4444\" stroke=\"white\" stroke-width=\"2\" on-mouseenter=\"setHoveredIndex(idx)\" on-mouseleave=\"setHoveredIndex(null)\" on-click=\"stop:onPointClick(idx, point)\" style=\"cursor: pointer;\"/><text s-if=\"hoveredIndex === idx\" x=\"{{ getX(idx) }}\" y=\"{{ getY(point.value) - 10 }}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#475569\">{{ point.value }}</text></g></svg><div class=\"chart-legend\"><span class=\"legend-item\">\ud83d\udcc8 \u8bbf\u95ee\u91cf</span><span class=\"legend-item\">\ud83d\uddb1\ufe0f \u70b9\u51fb\u6570\u636e\u70b9\u67e5\u770b\u8be6\u60c5</span></div></div>`,initData: function() {return {hoveredIndex: null};},computed: {maxValue: function() {const data = this.data.get('data');if (!Array.isArray(data) || data.length === 0) return 100;return Math.max(...data.map(function(d) {return d.value;}), 100);},minValue: function() {const data = this.data.get('data');if (!Array.isArray(data) || data.length === 0) return 0;return Math.min(...data.map(function(d) {return d.value;}), 0);},linePoints: function() {const data = this.data.get('data');if (!Array.isArray(data)) return '';return data.map(function(point, idx) {return this.getX(idx) + ',' + this.getY(point.value);}).join(' ');},areaPoints: function() {const data = this.data.get('data');if (!Array.isArray(data)) return '0,300 800,300';const points = data.map(function(point, idx) {return this.getX(idx) + ',' + this.getY(point.value);});return '0,300 ' + points.join(' ') + ' 800,300';}},getX: function(index) {const data = this.data.get('data');if (!Array.isArray(data) || data.length <= 1) return 400;return (index / (data.length - 1)) * 800;},getY: function(value) {const maxValue = this.data.get('maxValue');const minValue = this.data.get('minValue');const range = maxValue - minValue;if (range === 0) return 150;return 300 - ((value - minValue) / range) * 280;},onPointClick: function(index, point) {this.fire('data-point-click', {index: index,value: point.value,date: point.date,label: point.label});},setHoveredIndex: function(idx) {this.data.set('hoveredIndex', idx);},inited: function() {this.watch('hoveredIndex', function() {});}});const InsightList = san.defineComponent({name: 'InsightList',dataTypes: {insights: DataTypes.any,loading: DataTypes.any},template: `<div class=\"insight-list{{ loading ? ' loading' : '' }}\"><div s-for=\"insight in insights trackby insight.id\" class=\"insight-item\" on-click=\"fire('insight-click', insight)\"><div class=\"insight-icon\" style=\"{{ 'background-color: ' + insight.color + ';' }}\">{{ insight.icon }}</div><div class=\"insight-content\"><div class=\"insight-title\">{{ insight.title }}</div><div class=\"insight-desc\">{{ insight.description }}</div><div class=\"insight-meta\">{{ insight.timestamp }}</div></div><div class=\"insight-trend{{ insight.trend > 0 ? ' up' : ' down' }}\"> {{ insight.trend > 0 ? '+' : '' }}{{ insight.trend }}%</div></div><div s-if=\"insights.length === 0 && !loading\" class=\"empty-insights\">\u6682\u65e0\u667a\u80fd\u6d1e\u5bdf\u6570\u636e</div></div>`,inited: function() {this.watch('insights', function() {});}});const ActivityTable = san.defineComponent({name: 'ActivityTable',dataTypes: {activities: DataTypes.any,loading: DataTypes.any},template: `<div class=\"activity-table-wrapper\"><table class=\"activity-table\"><thead><tr><th>\u65f6\u95f4</th><th>\u7528\u6237</th><th>\u64cd\u4f5c\u7c7b\u578b</th><th>\u8be6\u7ec6\u4fe1\u606f</th><th>\u72b6\u6001</th></tr></thead><tbody><tr s-for=\"activity in activities trackby activity.id\" class=\"activity-row\" on-click=\"fire('row-click', activity)\"><td class=\"time-cell\">{{ formatTime(activity.timestamp) }}</td><td class=\"user-cell\">{{ activity.user }}</td><td class=\"type-cell\"><span class=\"activity-badge{{ ' ' + activity.type }}\"> {{ getTypeLabel(activity.type) }}</span></td><td class=\"detail-cell\">{{ activity.detail }}</td><td class=\"status-cell\"><span class=\"status-badge{{ ' ' + activity.status }}\"> {{ getStatusLabel(activity.status) }}</span></td></tr><tr s-if=\"activities.length === 0 && !loading\"><td colspan=\"5\" class=\"empty-cell\">\u6682\u65e0\u6d3b\u52a8\u8bb0\u5f55</td></tr></tbody></table></div>`,formatTime: function(timestamp) {const date = new Date(timestamp);return date.toLocaleTimeString();},getTypeLabel: function(type) {const labels = {login: '\u767b\u5f55',purchase: '\u8d2d\u4e70',view: '\u6d4f\u89c8',share: '\u5206\u4eab'};return labels[type] || type;},getStatusLabel: function(status) {const labels = {success: '\u6210\u529f',pending: '\u5904\u7406\u4e2d',failed: '\u5931\u8d25'};return labels[status] || status;},inited: function() {this.watch('activities', function() {});}});module.exports = san.defineComponent({components: {'stat-card': StatCard,'trend-chart': TrendChart,'insight-list': InsightList,'activity-table': ActivityTable},name: 'AnalyticsDashboard',dataTypes: {userId: DataTypes.string,apiEndpoint: DataTypes.string},initData: function() {return {isDarkMode: false,isCompactView: false,isLoading: false,selectedPeriod: '30d',searchQuery: '',activityFilter: 'all',statistics: [{id: 1,title: '\u603b\u8bbf\u95ee\u91cf',value: 28450,change: 12.5,icon: '\ud83d\udc65'},{id: 2,title: '\u65b0\u589e\u7528\u6237',value: 3240,change: -2.3,icon: '\ud83c\udd95'},{id: 3,title: '\u8f6c\u5316\u7387',value: 3.8,change: 0.7,icon: '\ud83c\udfaf'},{id: 4,title: '\u603b\u6536\u5165',value: 187500,change: 18.9,icon: '\ud83d\udcb0'}],chartData: [],insights: [],activities: [],dataCache: {'7d': null,'30d': null,'90d': null},eventHistory: [],userId: 'anonymous',apiEndpoint: 'https://api.example.com/analytics'}},computed: {filteredActivities: function() {const activities = this.data.get('activities');const searchQuery = this.data.get('searchQuery');const activityFilter = this.data.get('activityFilter');let filtered = [...activities];if (searchQuery) {const query = searchQuery.toLowerCase();filtered = filtered.filter(activity => activity.user.toLowerCase().includes(query) || activity.detail.toLowerCase().includes(query));}if (activityFilter !== 'all') {filtered = filtered.filter(activity => activity.type === activityFilter);}return filtered;}},inited: function() {this.watch('isDarkMode', function(newVal) {this.addEventToHistory('theme', `\u4e3b\u9898\u5207\u6362\u4e3a ${newVal ? '\u6697\u8272' : '\u4eae\u8272'} \u6a21\u5f0f`);this.fire('theme-changed', {darkMode: newVal,timestamp: Date.now()});});this.watch('isCompactView', function(newVal) {this.addEventToHistory('view', `\u89c6\u56fe\u5207\u6362\u4e3a ${newVal ? '\u7d27\u51d1' : '\u5c55\u5f00'} \u6a21\u5f0f`);});},attached: function() {this.initializeDashboard();this.startAutoRefresh();this.addEventToHistory('system', '\u4eea\u8868\u76d8\u521d\u59cb\u5316\u5b8c\u6210');},disposed: function() {const refreshInterval = this.data.get('refreshInterval');if (refreshInterval) {clearInterval(refreshInterval);}this.addEventToHistory('system', '\u4eea\u8868\u76d8\u7ec4\u4ef6\u5373\u5c06\u9500\u6bc1');},initializeDashboard: async function() {this.data.set('isLoading', true);try {await Promise.all([this.loadChartData(),this.loadInsights(),this.loadActivities()]);this.addEventToHistory('success', '\u6240\u6709\u6570\u636e\u52a0\u8f7d\u6210\u529f');} catch (error) {this.addEventToHistory('error', `\u6570\u636e\u52a0\u8f7d\u5931\u8d25: ${error.message}`);this.fire('error', {message: error.message,timestamp: Date.now()});} finally {this.data.set('isLoading', false);}},loadChartData: async function() {const selectedPeriod = this.data.get('selectedPeriod');const dataCache = this.data.get('dataCache');if (dataCache[selectedPeriod]) {this.data.set('chartData', dataCache[selectedPeriod]);this.addEventToHistory('cache', `\u4f7f\u7528\u7f13\u5b58\u7684 ${selectedPeriod} \u56fe\u8868\u6570\u636e`);return;}await new Promise(resolve => setTimeout(resolve, 800));const days = selectedPeriod === '7d' ? 7 : (selectedPeriod === '30d' ? 30 : 90);const data = [];let baseValue = 1000;for (let i = 0; i < days; i++) {const variance = Math.sin(i * 0.2) * 200;const trend = i * 2;baseValue += Math.random() * 30 - 15;const value = Math.max(100, Math.floor(baseValue + variance + trend));const date = new Date();date.setDate(date.getDate() - (days - i));data.push({date: date.toISOString().split('T')[0],label: this.formatDateLabel(date, days),value: value});}this.data.set('chartData', data);const newDataCache = Object.assign({}, dataCache);newDataCache[selectedPeriod] = data;this.data.set('dataCache', newDataCache);this.addEventToHistory('fetch', `\u52a0\u8f7d\u4e86 ${days} \u5929\u7684\u56fe\u8868\u6570\u636e`);},loadInsights: async function() {await new Promise(resolve => setTimeout(resolve, 600));const insightsData = [{id: 1,title: '\u7528\u6237\u6d3b\u8dc3\u5ea6\u63d0\u5347',description: '\u8fc7\u53bb7\u5929\u7528\u6237\u8bbf\u95ee\u65f6\u957f\u589e\u52a0\u4e8623%\uff0c\u4e3b\u8981\u96c6\u4e2d\u5728\u79fb\u52a8\u7aef',icon: '\ud83d\ude80',color: '#10b981',trend: 23,timestamp: '2\u5206\u949f\u524d'},{id: 2,title: '\u8f6c\u5316\u7387\u4f18\u5316\u5efa\u8bae',description: '\u8d2d\u7269\u8f66\u653e\u5f03\u7387\u8f83\u9ad8\uff0c\u5efa\u8bae\u4f18\u5316\u7ed3\u8d26\u6d41\u7a0b',icon: '\ud83d\uded2',color: '#f59e0b',trend: -5,timestamp: '15\u5206\u949f\u524d'},{id: 3,title: '\u65b0\u7528\u6237\u589e\u957f\u9ad8\u5cf0',description: '\u793e\u4ea4\u5a92\u4f53\u6e20\u9053\u5e26\u6765\u5927\u91cf\u65b0\u7528\u6237\uff0c\u589e\u957f42%',icon: '\ud83d\udcf1',color: '#3b82f6',trend: 42,timestamp: '1\u5c0f\u65f6\u524d'},{id: 4,title: '\u670d\u52a1\u5668\u54cd\u5e94\u4f18\u5316',description: 'API\u54cd\u5e94\u65f6\u95f4\u964d\u4f4e15%\uff0c\u7528\u6237\u4f53\u9a8c\u6539\u5584',icon: '\u26a1',color: '#8b5cf6',trend: 15,timestamp: '3\u5c0f\u65f6\u524d'}];this.data.set('insights', insightsData);},loadActivities: async function() {await new Promise(resolve => setTimeout(resolve, 500));const activities = [];const users = ['\u5f20\u4e09', '\u674e\u56db', '\u738b\u4e94', '\u8d75\u516d', '\u94b1\u4e03'];const types = ['login', 'purchase', 'view', 'share'];const details = {login: ['\u767b\u5f55\u6210\u529f', '\u767b\u5f55\u5931\u8d25', '\u5f02\u5730\u767b\u5f55'],purchase: ['\u8d2d\u4e70\u5546\u54c1A', '\u8d2d\u4e70\u5546\u54c1B', '\u8ba2\u9605\u4f1a\u5458'],view: ['\u6d4f\u89c8\u9996\u9875', '\u67e5\u770b\u8be6\u60c5\u9875', '\u641c\u7d22\u5173\u952e\u8bcd'],share: ['\u5206\u4eab\u94fe\u63a5', '\u9080\u8bf7\u597d\u53cb', '\u53d1\u5e03\u8bc4\u8bba']};for (let i = 0; i < 15; i++) {const type = types[Math.floor(Math.random() * types.length)];const status = Math.random() > 0.8 ? 'failed' : (Math.random() > 0.9 ? 'pending' : 'success');activities.push({id: Date.now() + i,timestamp: Date.now() - Math.random() * 3600000,user: users[Math.floor(Math.random() * users.length)],type: type,detail: details[type][Math.floor(Math.random() * details[type].length)],status: status});}const sortedActivities = [...activities].sort((a, b) => b.timestamp - a.timestamp);this.data.set('activities', sortedActivities);},manualRefresh: async function() {if (this.data.get('isLoading')) return;this.data.set('isLoading', true);this.addEventToHistory('action', '\u7528\u6237\u624b\u52a8\u5237\u65b0\u6570\u636e');try {const selectedPeriod = this.data.get('selectedPeriod');const dataCache = this.data.get('dataCache');const newDataCache = Object.assign({}, dataCache);newDataCache[selectedPeriod] = null;this.data.set('dataCache', newDataCache);await Promise.all([this.loadChartData(),this.loadInsights(),this.loadActivities()]);this.addEventToHistory('success', '\u6570\u636e\u5237\u65b0\u5b8c\u6210');this.fire('data-refreshed', {timestamp: Date.now(),period: selectedPeriod,statistics: this.data.get('statistics')});} catch (error) {this.addEventToHistory('error', `\u5237\u65b0\u5931\u8d25: ${error.message}`);this.fire('error', {message: error.message});} finally {this.data.set('isLoading', false);}},startAutoRefresh: function() {const refreshInterval = setInterval(() => {if (!this.data.get('isLoading')) {this.autoRefresh();}}, 30000);this.data.set('refreshInterval', refreshInterval);},autoRefresh: async function() {this.addEventToHistory('system', '\u81ea\u52a8\u5237\u65b0\u6570\u636e');try {const selectedPeriod = this.data.get('selectedPeriod');const dataCache = this.data.get('dataCache');const newDataCache = Object.assign({}, dataCache);newDataCache[selectedPeriod] = null;this.data.set('dataCache', newDataCache);await this.loadChartData();await this.loadInsights();await this.loadActivities();this.addEventToHistory('success', '\u81ea\u52a8\u6570\u636e\u540c\u6b65\u5b8c\u6210');} catch (error) {this.addEventToHistory('error', `\u81ea\u52a8\u5237\u65b0\u5931\u8d25: ${error.message}`);}},toggleTheme: function() {this.data.set('isDarkMode', !this.data.get('isDarkMode'));},toggleView: function() {this.data.set('isCompactView', !this.data.get('isCompactView'));},onPeriodChange: function() {this.addEventToHistory('filter', `\u5207\u6362\u65f6\u95f4\u6bb5\u4e3a: ${this.data.get('selectedPeriod')}`);this.loadChartData();},onSearchChange: function() {this.addEventToHistory('filter', `\u641c\u7d22\u5173\u952e\u8bcd: ${this.data.get('searchQuery') || '\u6e05\u7a7a'}`);},onFilterChange: function() {this.addEventToHistory('filter', `\u6d3b\u52a8\u7c7b\u578b\u8fc7\u6ee4: ${this.data.get('activityFilter')}`);},onStatClick: function(stat) {this.addEventToHistory('click', `\u70b9\u51fb\u7edf\u8ba1\u5361\u7247: ${stat.title} (${stat.value})`);this.fire('stat-click', {stat: stat,timestamp: Date.now()});},onDataPointClick: function(data) {this.addEventToHistory('chart', `\u70b9\u51fb\u6570\u636e\u70b9: \u65e5\u671f ${data.date}, \u503c ${data.value}`);this.fire('chart-point-click', data);},onInsightClick: function(insight) {this.addEventToHistory('insight', `\u67e5\u770b\u6d1e\u5bdf: ${insight.title}`);this.fire('insight-click', insight);},onActivityClick: function(activity) {this.addEventToHistory('activity', `\u67e5\u770b\u6d3b\u52a8: ${activity.user} - ${activity.type}`);this.fire('activity-click', activity);},formatDateLabel: function(date, totalDays) {if (totalDays <= 30) {return `${date.getMonth() + 1}/${date.getDate()}`;}return `${date.getMonth() + 1}\u6708`;},addEventToHistory: function(type, message) {const event = {type: type,message: message,timestamp: Date.now(),timeStr: new Date().toLocaleTimeString()};const eventHistory = this.data.get('eventHistory');const newEventHistory = [event, ...eventHistory];if (newEventHistory.length > 50) {newEventHistory.pop();}this.data.set('eventHistory', newEventHistory);if (typeof console !== 'undefined') {console.log(`[${event.timeStr}] ${message}`);}}});</script><style>/* \u4e3b\u5bb9\u5668\u6837\u5f0f */ .analytics-dashboard { max-width: 1400px; margin: 0 auto; padding: 20px; background: #f8fafc; color: #1e293b; transition: all 0.3s ease; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; } .analytics-dashboard.dark-mode { background: #0f172a; color: #e2e8f0; } .analytics-dashboard.compact { padding: 12px; } /* \u5bfc\u822a\u680f */ .dashboard-navbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding: 16px 20px; background: white; border-radius