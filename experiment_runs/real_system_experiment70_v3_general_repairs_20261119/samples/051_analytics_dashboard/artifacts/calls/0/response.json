{"model":"qwen-plus","id":"chatcmpl-c6f5b4d2-9d49-982c-97a8-c37b492748c0","choices":[{"message":{"content":"<template><div class=\"analytics-dashboard{{ isDarkMode ? ' dark-mode' : '' }}{{ isCompactView ? ' compact' : '' }}\"><div class=\"dashboard-navbar\"><div class=\"logo-section\"><span class=\"logo-icon\">📈</span><h1 class=\"logo-text\">Analytics Pro</h1></div><div class=\"nav-controls\"><button class=\"view-toggle\" on-click=\"toggleView\">{{isCompactView ? '📊 展开视图' : '📋 紧凑视图'}}</button><button class=\"theme-toggle\" on-click=\"toggleTheme\">{{isDarkMode ? '☀️ 亮色' : '🌙 暗色'}}</button><button class=\"refresh-btn\" disabled=\"{{ isLoading }}\" on-click=\"manualRefresh\">{{isLoading ? '⏳ 加载中...' : '🔄 刷新数据'}}</button></div></div><div class=\"stats-grid\"><stat-card s-for=\"stat in statistics trackby stat.id\" key=\"{{stat.id}}\" title=\"{{stat.title}}\" value=\"{{stat.value}}\" change=\"{{stat.change}}\" icon=\"{{stat.icon}}\" loading=\"{{ isLoading }}\" on-click=\"onStatClick(stat)\"/></div><div class=\"visualization-section\"><div class=\"chart-container\"><h3 class=\"section-title\"><span>📊 实时访问趋势</span><select class=\"period-selector\" value=\"{{ selectedPeriod }}\" on-change=\"onPeriodChange\"><option value=\"7d\">最近7天</option><option value=\"30d\">最近30天</option><option value=\"90d\">最近90天</option></select></h3><trend-chart data=\"{{ chartData }}\" height=\"300\" loading=\"{{ isLoading }}\" on-data-point-click=\"onDataPointClick\"/></div><div class=\"insights-panel\"><h3 class=\"section-title\">💡 智能洞察</h3><insight-list insights=\"{{ insights }}\" loading=\"{{ isLoading }}\" on-insight-click=\"onInsightClick\"/></div></div><div class=\"activity-section\"><div class=\"activity-header\"><h3 class=\"section-title\">📋 实时用户活动</h3><div class=\"filter-controls\"><input class=\"search-input\" type=\"text\" placeholder=\"搜索用户或操作...\" value=\"{{ searchQuery }}\" on-input=\"onSearchChange\"/><select class=\"filter-select\" value=\"{{ activityFilter }}\" on-change=\"onFilterChange\"><option value=\"all\">所有活动</option><option value=\"login\">登录</option><option value=\"purchase\">购买</option><option value=\"view\">浏览</option><option value=\"share\">分享</option></select></div></div><activity-table activities=\"{{ filteredActivities }}\" loading=\"{{ isLoading }}\" on-row-click=\"onActivityClick\"/></div><div class=\"loading-overlay\" s-if=\"isLoading\"><div class=\"spinner\"></div><p>正在加载最新数据...</p></div></div></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;const StatCard=san.defineComponent({name:\"StatCard\",props:[\"title\",\"value\",\"change\",\"icon\",\"loading\"],template:`<div class=\"stat-card\" s-if=\"!loading\" on-click=\"fire('click')\"><div class=\"stat-icon\">{{ icon }}</div><div class=\"stat-content\"><div class=\"stat-title\">{{ title }}</div><div class=\"stat-value\">{{ formatValue(value) }}</div><div class=\"stat-change\" s-if=\"change > 0\" class=\"positive\">▲ {{ Math.abs(change) }}%</div><div class=\"stat-change\" s-if=\"change < 0\" class=\"negative\">▼ {{ Math.abs(change) }}%</div><div class=\"stat-change\" s-if=\"change === 0\" class=\"neutral\">● {{ Math.abs(change) }}%</div></div></div><div class=\"stat-card loading\" s-if=\"loading\"></div>`,computed:{},methods:{formatValue:function(value){if(value>=1000000)return(value/1000000).toFixed(1)+\"M\";if(value>=1000)return(value/1000).toFixed(1)+\"K\";return value.toString()}}});const TrendChart=san.defineComponent({name:\"TrendChart\",props:[\"data\",\"height\",\"loading\"],template:`<div class=\"trend-chart\" s-if=\"!loading\"><svg width=\"100%\" height=\"{{ height }}\" viewBox=\"0 0 800 300\" preserveAspectRatio=\"none\"><g s-for=\"i in 5 trackby i\"><line x1=\"0\" y1=\"{{ i * 60 }}\" x2=\"800\" y2=\"{{ i * 60 }}\" stroke=\"#e2e8f0\" stroke-width=\"0.5\" stroke-dasharray=\"4,4\"/></g><polygon points=\"{{ areaPoints }}\" fill=\"rgba(59, 130, 246, 0.1)\" stroke=\"none\"/><polyline points=\"{{ linePoints }}\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><g s-for=\"point, idx in data trackby point.id\"><circle cx=\"{{ getX(idx) }}\" cy=\"{{ getY(point.value) }}\" r=\"4\" fill=\"#ef4444\" stroke=\"white\" stroke-width=\"2\" on-mouseenter=\"setHoveredIndex(idx)\" on-mouseleave=\"setHoveredIndex(null)\" on-click=\"stop:onPointClick(idx, point)\" style=\"cursor: pointer;\"/><text s-if=\"hoveredIndex === idx\" x=\"{{ getX(idx) }}\" y=\"{{ getY(point.value) - 10 }}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#475569\">{{ point.value }}</text></g></svg><div class=\"chart-legend\"><span class=\"legend-item\">📈 访问量</span><span class=\"legend-item\">🖱️ 点击数据点查看详情</span></div></div><div class=\"trend-chart chart-loading\" s-if=\"loading\"></div>`,data:function(){return{hoveredIndex:null}},computed:{maxValue:function(){const data=this.data.get(\"data\");if(!Array.isArray(data)||data.length===0)return 100;return Math.max(...data.map(function(d){return d.value}),100)},minValue:function(){const data=this.data.get(\"data\");if(!Array.isArray(data)||data.length===0)return 0;return Math.min(...data.map(function(d){return d.value}),0)},linePoints:function(){const data=this.data.get(\"data\");if(!Array.isArray(data))return\"\";return data.map(function(point,idx){return this.getX(idx)+\",\"+this.getY(point.value)}).join(\" \")},areaPoints:function(){const data=this.data.get(\"data\");if(!Array.isArray(data))return\"0,300 800,300\";const points=data.map(function(point,idx){return this.getX(idx)+\",\"+this.getY(point.value)});return\"0,300 \"+points.join(\" \")+\" 800,300\"}},methods:{getX:function(index){const data=this.data.get(\"data\");if(!Array.isArray(data)||data.length<=1)return 400;return(index/(data.length-1))*800},getY:function(value){const maxValue=this.data.get(\"maxValue\");const minValue=this.data.get(\"minValue\");const range=maxValue-minValue;if(range===0)return 150;return 300-((value-minValue)/range)*280},onPointClick:function(index,point){this.fire(\"data-point-click\",{index:index,value:point.value,date:point.date,label:point.label})},setHoveredIndex:function(idx){this.data.set(\"hoveredIndex\",idx)}},inited:function(){this.watch(\"hoveredIndex\",function(){})}});const InsightList=san.defineComponent({name:\"InsightList\",props:[\"insights\",\"loading\"],template:`<div class=\"insight-list\" s-if=\"!loading\"><div s-for=\"insight in insights trackby insight.id\" class=\"insight-item\" on-click=\"fire('insight-click', insight)\"><div class=\"insight-icon\" style=\"{{ 'background-color: ' + insight.color + ';' }}\">{{ insight.icon }}</div><div class=\"insight-content\"><div class=\"insight-title\">{{ insight.title }}</div><div class=\"insight-desc\">{{ insight.description }}</div><div class=\"insight-meta\">{{ insight.timestamp }}</div></div><div class=\"insight-trend\" s-if=\"insight.trend > 0\" class=\"up\">+{{ insight.trend }}%</div><div class=\"insight-trend\" s-if=\"insight.trend < 0\" class=\"down\">{{ insight.trend }}%</div></div><div s-if=\"insights.length === 0\" class=\"empty-insights\">暂无智能洞察数据</div></div><div class=\"insight-list loading\" s-if=\"loading\"></div>`,inited:function(){this.watch(\"insights\",function(){})}});const ActivityTable=san.defineComponent({name:\"ActivityTable\",props:[\"activities\",\"loading\"],template:`<div class=\"activity-table-wrapper\"><table class=\"activity-table\"><thead><tr><th>时间</th><th>用户</th><th>操作类型</th><th>详细信息</th><th>状态</th></tr></thead><tbody><tr s-for=\"activity in activities trackby activity.id\" class=\"activity-row\" on-click=\"fire('row-click', activity)\"><td class=\"time-cell\">{{ formatTime(activity.timestamp) }}</td><td class=\"user-cell\">{{ activity.user }}</td><td class=\"type-cell\"><span class=\"activity-badge\" s-if=\"activity.type==='login'\" class=\"login\">{{ getTypeLabel(activity.type) }}</span><span class=\"activity-badge\" s-if=\"activity.type==='purchase'\" class=\"purchase\">{{ getTypeLabel(activity.type) }}</span><span class=\"activity-badge\" s-if=\"activity.type==='view'\" class=\"view\">{{ getTypeLabel(activity.type) }}</span><span class=\"activity-badge\" s-if=\"activity.type==='share'\" class=\"share\">{{ getTypeLabel(activity.type) }}</span></td><td class=\"detail-cell\">{{ activity.detail }}</td><td class=\"status-cell\"><span class=\"status-badge\" s-if=\"activity.status==='success'\" class=\"success\">{{ getStatusLabel(activity.status) }}</span><span class=\"status-badge\" s-if=\"activity.status==='pending'\" class=\"pending\">{{ getStatusLabel(activity.status) }}</span><span class=\"status-badge\" s-if=\"activity.status==='failed'\" class=\"failed\">{{ getStatusLabel(activity.status) }}</span></td></tr><tr s-if=\"activities.length === 0\"><td colspan=\"5\" class=\"empty-cell\">暂无活动记录</td></tr></tbody></table></div><div class=\"activity-table-wrapper loading\" s-if=\"loading\"></div>`,methods:{formatTime:function(timestamp){const date=new Date(timestamp);return date.toLocaleTimeString()},getTypeLabel:function(type){const labels={\"login\":\"登录\",\"purchase\":\"购买\",\"view\":\"浏览\",\"share\":\"分享\"};return labels[type]||type},getStatusLabel:function(status){const labels={\"success\":\"成功\",\"pending\":\"处理中\",\"failed\":\"失败\"};return labels[status]||status}},inited:function(){this.watch(\"activities\",function(){})}});module.exports=san.defineComponent({name:\"AnalyticsDashboard\",dataTypes:{userId:DataTypes.string,apiEndpoint:DataTypes.string},initData:function(){return{isDarkMode:false,isCompactView:false,isLoading:false,selectedPeriod:\"30d\",searchQuery:\"\",activityFilter:\"all\",statistics:[{id:1,title:\"总访问量\",value:28450,change:12.5,icon:\"👥\"},{id:2,title:\"新增用户\",value:3240,change:-2.3,icon:\"🆕\"},{id:3,title:\"转化率\",value:3.8,change:0.7,icon:\"🎯\"},{id:4,title:\"总收入\",value:187500,change:18.9,icon:\"💰\"}],chartData:[],insights:[],activities:[],dataCache:{\"7d\":null,\"30d\":null,\"90d\":null},eventHistory:[]}},components:{\"stat-card\":StatCard,\"trend-chart\":TrendChart,\"insight-list\":InsightList,\"activity-table\":ActivityTable},attached:function(){this.initializeDashboard();this.startAutoRefresh();this.addEventToHistory(\"system\",\"仪表盘初始化完成\")},disposed:function(){if(this.data.get(\"refreshInterval\")){clearInterval(this.data.get(\"refreshInterval\"))}this.addEventToHistory(\"system\",\"仪表盘组件即将销毁\")},watchers:function(){this.watch(\"isDarkMode\",function(newVal){this.addEventToHistory(\"theme\",`主题切换为 ${newVal?\"暗色\":\"亮色\"} 模式`);this.fire(\"theme-changed\",{darkMode:newVal,timestamp:Date.now()})});this.watch(\"isCompactView\",function(newVal){this.addEventToHistory(\"view\",`视图切换为 ${newVal?\"紧凑\":\"展开\"} 模式`)})},initializeDashboard:async function(){this.data.set(\"isLoading\",true);try{await Promise.all([this.loadChartData(),this.loadInsights(),this.loadActivities()]);this.addEventToHistory(\"success\",\"所有数据加载成功\")}catch(error){this.addEventToHistory(\"error\",`数据加载失败: ${error.message}`);this.fire(\"error\",{message:error.message,timestamp:Date.now()})}finally{this.data.set(\"isLoading\",false)}},loadChartData:async function(){const selectedPeriod=this.data.get(\"selectedPeriod\");const dataCache=this.data.get(\"dataCache\");if(dataCache[selectedPeriod]){this.data.set(\"chartData\",dataCache[selectedPeriod]);this.addEventToHistory(\"cache\",`使用缓存的 ${selectedPeriod} 图表数据`);return}await new Promise(resolve=>setTimeout(resolve,800));const days=selectedPeriod===\"7d\"?7:(selectedPeriod===\"30d\"?30:90);const data=[];let baseValue=1000;for(let i=0;i<days;i++){const variance=Math.sin(i*0.2)*200;const trend=i*2;baseValue+=Math.random()*30-15;const value=Math.max(100,Math.floor(baseValue+variance+trend));const date=new Date();date.setDate(date.getDate()-(days-i));data.push({date:date.toISOString().split(\"T\")[0],label:this.formatDateLabel(date,days),value:value})}this.data.set(\"chartData\",data);dataCache[selectedPeriod]=data;this.data.set(\"dataCache\",dataCache);this.addEventToHistory(\"fetch\",`加载了 ${days} 天的图表数据`)},loadInsights:async function(){await new Promise(resolve=>setTimeout(resolve,600));const insightsData=[{id:1,title:\"用户活跃度提升\",description:\"过去7天用户访问时长增加了23%，主要集中在移动端\",icon:\"🚀\",color:\"#10b981\",trend:23,timestamp:\"2分钟前\"},{id:2,title:\"转化率优化建议\",description:\"购物车放弃率较高，建议优化结账流程\",icon:\"🛒\",color:\"#f59e0b\",trend:-5,timestamp:\"15分钟前\"},{id:3,title:\"新用户增长高峰\",description:\"社交媒体渠道带来大量新用户，增长42%\",icon:\"📱\",color:\"#3b82f6\",trend:42,timestamp:\"1小时前\"},{id:4,title:\"服务器响应优化\",description:\"API响应时间降低15%，用户体验改善\",icon:\"⚡\",color:\"#8b5cf6\",trend:15,timestamp:\"3小时前\"}];this.data.set(\"insights\",insightsData)},loadActivities:async function(){await new Promise(resolve=>setTimeout(resolve,500));const activities=[];const users=[\"张三\",\"李四\",\"王五\",\"赵六\",\"钱七\"];const types=[\"login\",\"purchase\",\"view\",\"share\"];const details={\"login\":[\"登录成功\",\"登录失败\",\"异地登录\"],\"purchase\":[\"购买商品A\",\"购买商品B\",\"订阅会员\"],\"view\":[\"浏览首页\",\"查看详情页\",\"搜索关键词\"],\"share\":[\"分享链接\",\"邀请好友\",\"发布评论\"]};for(let i=0;i<15;i++){const type=types[Math.floor(Math.random()*types.length)];const status=Math.random()>0.8?\"failed\":(Math.random()>0.9?\"pending\":\"success\");activities.push({id:Date.now()+i,timestamp:Date.now()-Math.random()*3600000,user:users[Math.floor(Math.random()*users.length)],type:type,detail:details[type][Math.floor(Math.random()*details[type].length)],status:status})}activities.sort(function(a,b){return b.timestamp-a.timestamp});this.data.set(\"activities\",activities)},manualRefresh:async function(){if(this.data.get(\"isLoading\"))return;this.data.set(\"isLoading\",true);this.addEventToHistory(\"action\",\"用户手动刷新数据\");try{const selectedPeriod=this.data.get(\"selectedPeriod\");const dataCache=this.data.get(\"dataCache\");dataCache[selectedPeriod]=null;this.data.set(\"dataCache\",dataCache);await Promise.all([this.loadChartData(),this.loadInsights(),this.loadActivities()]);this.addEventToHistory(\"success\",\"数据刷新完成\");this.fire(\"data-refreshed\",{timestamp:Date.now(),period:selectedPeriod,statistics:this.data.get(\"statistics\")})}catch(error){this.addEventToHistory(\"error\",`刷新失败: ${error.message}`);this.fire(\"error\",{message:error.message})}finally{this.data.set(\"isLoading\",false)}},startAutoRefresh:function(){const refreshInterval=setInterval(()=>{if(!this.data.get(\"isLoading\")){this.autoRefresh()}},30000);this.data.set(\"refreshInterval\",refreshInterval)},autoRefresh:async function(){this.addEventToHistory(\"system\",\"自动刷新数据\");try{const selectedPeriod=this.data.get(\"selectedPeriod\");const dataCache=this.data.get(\"dataCache\");dataCache[selectedPeriod]=null;this.data.set(\"dataCache\",dataCache);await this.loadChartData();await this.loadInsights();await this.loadActivities();this.addEventToHistory(\"success\",\"自动数据同步完成\")}catch(error){this.addEventToHistory(\"error\",`自动刷新失败: ${error.message}`)}},toggleTheme:function(){this.data.set(\"isDarkMode\",!this.data.get(\"isDarkMode\"))},toggleView:function(){this.data.set(\"isCompactView\",!this.data.get(\"isCompactView\"))},onPeriodChange:function(){this.addEventToHistory(\"filter\",`切换时间段为: ${this.data.get(\"selectedPeriod\")}`);this.loadChartData()},onSearchChange:function(){this.addEventToHistory(\"filter\",`搜索关键词: ${this.data.get(\"searchQuery\")||\"清空\"}`)},onFilterChange:function(){this.addEventToHistory(\"filter\",`活动类型过滤: ${this.data.get(\"activityFilter\")}`)},onStatClick:function(stat){this.addEventToHistory(\"click\",`点击统计卡片: ${stat.title} (${stat.value})`);this.fire(\"stat-click\",{stat:stat,timestamp:Date.now()})},onDataPointClick:function(data){this.addEventToHistory(\"chart\",`点击数据点: 日期 ${data.date}, 值 ${data.value}`);this.fire(\"chart-point-click\",data)},onInsightClick:function(insight){this.addEventToHistory(\"insight\",`查看洞察: ${insight.title}`);this.fire(\"insight-click\",insight)},onActivityClick:function(activity){this.addEventToHistory(\"activity\",`查看活动: ${activity.user} - ${activity.type}`);this.fire(\"activity-click\",activity)},formatDateLabel:function(date,totalDays){if(totalDays<=30){return`${date.getMonth()+1}/${date.getDate()}`}return`${date.getMonth()+1}月`},addEventToHistory:function(type,message){const event={type:type,message:message,timestamp:Date.now(),timeStr:new Date().toLocaleTimeString()};const eventHistory=this.data.get(\"eventHistory\");eventHistory.unshift(event);if(eventHistory.length>50){eventHistory.pop()}this.data.set(\"eventHistory\",eventHistory);if(typeof console!==\"undefined\"){console.log(`[${event.timeStr}] ${message}`)}}});</script><style>/* 主容器样式 */ .analytics-dashboard { max-width: 1400px; margin: 0 auto; padding: 20px; background: #f8fafc; color: #1e293b; transition: all 0.3s ease; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; } .analytics-dashboard.dark-mode { background: #0f172a; color: #e2e8f0; } .analytics-dashboard.compact { padding: 12px; } /* 导航栏 */ .dashboard-navbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding: 16px 20px; background: white; border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); } .dark-mode .dashboard-navbar { background: #1e293b; box-shadow: 0 2px 8px rgba(0,0,0,0.2); } .logo-section { display: flex; align-items: center; gap: 12px; } .logo-icon { font-size: 28px; } .logo-text { font-size: 20px; font-weight: 700; margin: 0; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; } .nav-controls { display: flex; gap: 12px; } .nav-controls button { padding: 8px 16px; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; transition: all 0.2s; background: #f1f5f9; color: #475569; } .dark-mode .nav-controls button { background: #334155; color: #cbd5e1; } .nav-controls button:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,0,0,0.1); } .refresh-btn:disabled { opacity: 0.6; cursor: not-allowed; } /* 统计卡片网格 */ .stats-grid { display: grid; grid