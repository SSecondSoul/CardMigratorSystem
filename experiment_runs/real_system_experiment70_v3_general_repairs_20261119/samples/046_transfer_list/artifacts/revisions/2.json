{
  "code": "<template><section class=\"transfer-list\"><h2>\u9879\u76ee\u89d2\u8272\u5206\u914d</h2><input class=\"transfer-search\" placeholder=\"\u7b5b\u9009\u53ef\u7528\u89d2\u8272\" value=\"{{ query }}\" on-input=\"updateQuery\"/><div class=\"transfer-grid\"><div class=\"list-panel\"><h3>\u53ef\u7528</h3><button s-for=\"item, index in filteredAvailable trackby item.id\" class=\"{{item.id === leftId ? 'selected' : ''}}\" on-click=\"selectLeft(item.id)\">{{item.name}}</button></div><div class=\"transfer-actions\"><button disabled=\"{{leftId === null}}\" on-click=\"moveRight\">\u2192</button><button disabled=\"{{rightId === null}}\" on-click=\"moveLeft\">\u2190</button></div><div class=\"list-panel\"><h3>\u5df2\u9009</h3><button s-for=\"item, index in chosen trackby item.id\" class=\"{{item.id === rightId ? 'selected' : ''}}\" on-click=\"selectRight(item.id)\">{{item.name}}</button></div></div></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: 'TransferList',dataTypes: {initialAvailable: DataTypes.array,initialChosen: DataTypes.array},initData() {return {available: [],chosen: [],leftId: null,rightId: null,query: ''};},computed: {filteredAvailable() {const q = this.data.get('query').toLowerCase();return this.data.get('available').filter(item => item.name.toLowerCase().indexOf(q) >= 0);}},inited() {const initialAvailable = this.data.get('initialAvailable') || [];const initialChosen = this.data.get('initialChosen') || [];this.data.set('available', initialAvailable.map(item => Object.assign({}, item)));this.data.set('chosen', initialChosen.map(item => Object.assign({}, item)));},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},updateQuery(event) {this.data.set('query', event.target.value);},selectLeft(id) {this.data.set('leftId', id);},selectRight(id) {this.data.set('rightId', id);},moveRight() {const id = this.data.get('leftId');const item = this.data.get('available').find(row => row.id === id);if (!item) return;this.data.set('available', this.data.get('available').filter(row => row.id !== id));this.data.set('chosen', this.data.get('chosen').concat(item));this.data.set('leftId', null);this.notify();},moveLeft() {const id = this.data.get('rightId');const item = this.data.get('chosen').find(row => row.id === id);if (!item) return;this.data.set('chosen', this.data.get('chosen').filter(row => row.id !== id));this.data.set('available', this.data.get('available').concat(item));this.data.set('rightId', null);this.notify();},notify() {this.emitEvent('change', this.data.get('chosen').slice());}});</script><style>.transfer-list { max-width: 760px; margin: 18px auto; padding: 20px; border: 1px solid #cfd6dd; border-radius: 6px; background: #fff; color: #24313d; font-family: Arial, sans-serif; box-sizing: border-box; }\n.transfer-list * { box-sizing: border-box; }\n.transfer-list h2, .transfer-list h3, .transfer-list p { margin-top: 0; }\n.transfer-list h2 { margin-bottom: 14px; font-size: 21px; }\n.transfer-list button { padding: 7px 11px; border: 1px solid #aeb8c2; border-radius: 4px; background: #fff; color: #273746; cursor: pointer; }\n.transfer-list button.primary { border-color: #2563eb; background: #2563eb; color: #fff; }\n.transfer-list button:disabled { opacity: .45; cursor: not-allowed; }\n.transfer-list input, .transfer-list select, .transfer-list textarea { padding: 8px; border: 1px solid #b9c3cc; border-radius: 4px; font: inherit; }\n.transfer-list .toolbar, .transfer-list .summary, .transfer-list .actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.transfer-list .muted { color: #71808e; font-size: 12px; }\n.transfer-list .empty { padding: 24px; color: #7c8792; text-align: center; border: 1px dashed #c8d0d8; }\n.transfer-search{width:100%;margin-bottom:12px}.transfer-grid{display:grid;grid-template-columns:1fr 44px 1fr;gap:10px}.list-panel{min-height:190px;padding:10px;border:1px solid #d6dde4}.list-panel button{display:block;width:100%;margin:5px 0;text-align:left}.list-panel button.selected{background:#dbeafe;border-color:#2563eb}.transfer-actions{display:grid;align-content:center;gap:8px}\n</style>",
