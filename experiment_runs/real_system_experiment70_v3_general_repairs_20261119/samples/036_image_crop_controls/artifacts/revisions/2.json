{
  "code": "<template><section class=\"image-crop-controls\"><h2>\u88c1\u526a\u53c2\u6570</h2><div class=\"crop-layout\"><div class=\"canvas\"><div class=\"crop-box\" style=\"{{cropStyle}}\"></div></div><div class=\"controls\"><label s-for=\"field, index in ['x','y','width','height'] trackby field\"><input type=\"number\" value=\"{{crop[field]}}\" on-input=\"update(field, $event)\"/><span>{{field}}</span></label><label><input type=\"checkbox\" checked=\"{{locked}}\" on-change=\"toggleLock\"/><span> \u9501\u5b9a\u5bbd\u9ad8\u6bd4</span></label><button on-click=\"reset\">\u91cd\u7f6e</button></div></div></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: 'ImageCropControls',dataTypes: {canvas: DataTypes.object,initialCrop: DataTypes.object},initData() {return {crop: {},locked: false,canvas: {width: 640,height: 360},initialCrop: {x: 10,y: 10,width: 45,height: 55}}},computed: {cropStyle() {const crop = this.data.get('crop');return 'left:' + (crop.x || 0) + '%;top:' + (crop.y || 0) + '%;width:' + (crop.width || 0) + '%;height:' + (crop.height || 0) + '%';}},inited() {this.data.set('crop', Object.assign({}, this.data.get('initialCrop')));this.watch('locked', () => {if (this.data.get('locked')) {const crop = this.data.get('crop');const canvas = this.data.get('canvas');const newHeight = Math.round(crop.width * canvas.width / canvas.height);this.data.set('crop', Object.assign({}, crop, {height: Math.min(100, newHeight)}));}});},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},update(field, event) {let value = Math.max(0, Math.min(100, Number(event.target.value) || 0));const crop = Object.assign({}, this.data.get('crop'), {[field]: value});if (this.data.get('locked') && field === 'width') {const canvas = this.data.get('canvas');crop.height = Math.min(100, Math.round(value * canvas.width / canvas.height));}this.setValue('crop', crop);this.emitEvent('change', crop);},toggleLock(event) {this.setValue('locked', event.target.checked);},reset() {this.setValue('crop', Object.assign({}, this.data.get('initialCrop')));}});</script><style>.image-crop-controls{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.image-crop-controls *{box-sizing:border-box}.image-crop-controls h2,.image-crop-controls h3,.image-crop-controls p{margin-top:0}.image-crop-controls button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.image-crop-controls button.primary{border-color:#db2777;background:#db2777;color:#fff}.image-crop-controls button:disabled{opacity:.45;cursor:not-allowed}.image-crop-controls input,.image-crop-controls select,.image-crop-controls textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.image-crop-controls .muted{color:#71808e;font-size:12px}.image-crop-controls .toolbar,.image-crop-controls .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.crop-layout{display:grid;grid-template-columns:1fr 190px;gap:14px}.canvas{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#dbeafe,#fce7f3);overflow:hidden}.crop-box{position:absolute;border:3px solid #db2777;background:#fff4}.controls{display:grid;gap:7px}.controls label{display:grid;grid-template-columns:55px 1fr;align-items:center}</style>",
