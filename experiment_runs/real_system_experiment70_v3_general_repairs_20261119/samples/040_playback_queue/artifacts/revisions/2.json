{
  "code": "<template><section class=\"playback-queue\"><header><div><p class=\"muted\">\u6b63\u5728\u64ad\u653e</p><h2>{{currentTrack ? currentTrack.title : '\u5c1a\u672a\u9009\u62e9'}}</h2></div><button class=\"{{loop ? 'active' : ''}}\" on-click=\"toggleLoop\">\u5faa\u73af {{loop ? '\u5f00' : '\u5173'}}</button></header><ol><li s-for=\"track, index in queue trackby track.id\" class=\"{{track.id === currentId ? 'playing' : ''}}\"><button class=\"track-title\" on-click=\"play(track.id)\">{{track.title}}</button><span>{{formatTime(track.duration)}}</span><button disabled=\"{{index === 0}}\" on-click=\"moveUp(index)\">\u2191</button><button on-click=\"remove(track.id)\">\u79fb\u9664</button></li></ol><footer>\u603b\u65f6\u957f {{formatTime(totalDuration)}}</footer></section></template><script>const san = require('san');const DataTypes = san.DataTypes;module.exports = san.defineComponent({name: 'PlaybackQueue',dataTypes: {tracks: DataTypes.array},initData() {return {queue: [],currentId: null,loop: false}},inited() {const tracks = this.data.get('tracks') || [];this.data.set('queue', tracks.map(item => Object.assign({}, item)));},setValue(key, value) {this.data.set(key, value);},emitEvent(name, payload) {this.fire(name, payload);},play(id) {this.data.set('currentId', id);this.fire('play', id);},moveUp(index) {if (index < 1) return;const queue = this.data.get('queue');const list = [...queue];const item = list.splice(index, 1)[0];list.splice(index - 1, 0, item);this.data.set('queue', list);this.fire('change', list.slice());},remove(id) {const queue = this.data.get('queue');const list = queue.filter(item => item.id !== id);this.data.set('queue', list);if (this.data.get('currentId') === id) {this.data.set('currentId', null);}this.fire('change', list.slice());},toggleLoop() {this.data.set('loop', !this.data.get('loop'));},formatTime(seconds) {const minutes = Math.floor(seconds / 60);return minutes + ':' + String(seconds % 60).padStart(2, '0');},computed: {currentTrack() {const queue = this.data.get('queue');const currentId = this.data.get('currentId');return queue.find(item => item.id === currentId) || null;},totalDuration() {const queue = this.data.get('queue');return queue.reduce((sum, item) => sum + item.duration, 0);}}});</script><style>.playback-queue{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:6px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.playback-queue *{box-sizing:border-box}.playback-queue h2,.playback-queue h3,.playback-queue p{margin-top:0}.playback-queue h2{margin-bottom:14px;font-size:21px}.playback-queue button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:4px;background:#fff;color:#273746;cursor:pointer}.playback-queue button.primary{border-color:#be185d;background:#be185d;color:#fff}.playback-queue button:disabled{opacity:.45;cursor:not-allowed}.playback-queue input,.playback-queue select,.playback-queue textarea{padding:8px;border:1px solid #b9c3cc;border-radius:4px;font:inherit}.playback-queue .toolbar,.playback-queue .summary,.playback-queue .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.playback-queue .muted{color:#71808e;font-size:12px}.playback-queue .empty{padding:24px;color:#7c8792;text-align:center;border:1px dashed #c8d0d8}header{display:flex;justify-content:space-between}header button.active{background:#fce7f3;border-color:#be185d}ol{padding-left:24px}li{display:grid;grid-template-columns:1fr 55px 38px auto;gap:7px;padding:8px}li.playing{background:#fdf2f8}.track-title{text-align:left;border:0}</style>",
