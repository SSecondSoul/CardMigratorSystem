{
  "code": "<template><section class=\"color-contrast-badge\"><h2>\u8272\u5f69\u53ef\u8bfb\u6027</h2><div class=\"sample\" style=\"{{sampleStyle}}\">Aa \u793a\u4f8b\u6587\u672c</div><p class=\"{{rating === '\u5bf9\u6bd4\u660e\u663e' ? 'good' : 'warn'}}\">{{rating}}</p><button class=\"primary\" on-click=\"swap\">\u4ea4\u6362\u524d\u666f\u4e0e\u80cc\u666f</button></section></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;module.exports=san.defineComponent({name:\"ColorContrastBadge\",dataTypes:{foreground:DataTypes.string,background:DataTypes.string},initData(){return {\nforeground: \"#172554\",\nbackground: \"#dbeafe\",\nswapped:false}},computed:{front(){return this.data.get(\"swapped\")?this.data.get(\"background\"):this.data.get(\"foreground\")},back(){return this.data.get(\"swapped\")?this.data.get(\"foreground\"):this.data.get(\"background\")},sampleStyle(){return \"color:\"+this.data.get(\"front\")+\";background:\"+this.data.get(\"back\")},rating(){const a=parseInt(this.data.get(\"front\").slice(1),16);const b=parseInt(this.data.get(\"back\").slice(1),16);return Math.abs(a-b)>5000000?\"\u5bf9\u6bd4\u660e\u663e\":\"\u5efa\u8bae\u590d\u6838\"}},setValue(key,value){this.data.set(key,value)},emitEvent(name,payload){this.fire(name,payload)},swap(){this.setValue(\"swapped\",!this.data.get(\"swapped\"))}});</script><style>.color-contrast-badge{max-width:760px;margin:18px auto;padding:20px;border:1px solid #cfd6dd;border-radius:8px;background:#fff;color:#24313d;font-family:Arial,sans-serif;box-sizing:border-box}.color-contrast-badge *{box-sizing:border-box}.color-contrast-badge h2,.color-contrast-badge h3,.color-contrast-badge p{margin-top:0}.color-contrast-badge button{padding:7px 11px;border:1px solid #aeb8c2;border-radius:5px;background:#fff;color:#273746;cursor:pointer}.color-contrast-badge button.primary{border-color:#9333ea;background:#9333ea;color:#fff}.color-contrast-badge button:disabled{opacity:.45;cursor:not-allowed}.color-contrast-badge input,.color-contrast-badge select,.color-contrast-badge textarea{padding:8px;border:1px solid #b9c3cc;border-radius:5px;font:inherit}.color-contrast-badge .muted{color:#71808e;font-size:12px}.color-contrast-badge .toolbar,.color-contrast-badge .actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.sample{padding:24px;text-align:center;font-size:26px}.good{color:#15803d}.warn{color:#b45309}</style>",
