{"model":"qwen-plus","id":"chatcmpl-a9d04279-43b7-9bb6-9148-aa5b8c1784f7","choices":[{"message":{"content":"<template><div class=\"task-manager\" s-class=\"{'dark-theme': this.data.get('isDarkMode'), 'compact-mode': this.data.get('isCompactMode')}\"><header class=\"app-header\"><div class=\"logo-area\"><span class=\"logo\">✅</span><h1 class=\"title\">智能任务管家</h1><span class=\"version\">v3.0</span></div><div class=\"header-actions\"><button class=\"icon-btn\" on-click=\"toggleCompactMode\" title=\"{{ this.data.get('isCompactMode') ? '展开模式' : '紧凑模式' }}\">{{ this.data.get('isCompactMode') ? '📐' : '📏' }}</button><button class=\"icon-btn\" on-click=\"toggleTheme\" title=\"{{ this.data.get('isDarkMode') ? '亮色模式' : '暗色模式' }}\">{{ this.data.get('isDarkMode') ? '☀️' : '🌙' }}</button><button class=\"icon-btn\" on-click=\"exportData\" title=\"导出数据\"> 📥 </button><button class=\"icon-btn\" on-click=\"showSettings = true\" title=\"设置\"> ⚙️ </button></div></header><div class=\"stats-section\"><stat-card key=\"{{ stat.id }}\" label=\"{{ stat.label }}\" value=\"{{ stat.value }}\" icon=\"{{ stat.icon }}\" trend=\"{{ stat.trend }}\" color=\"{{ stat.color }}\" on-click=\"onStatClick(stat)\" s-for=\"stat in this.data.get('statistics') trackby stat.id\"></stat-card></div><div class=\"main-workspace\"><div class=\"tasks-panel\"><div class=\"panel-header\"><h2>📋 任务列表</h2><div class=\"task-controls\"><button class=\"primary-btn\" on-click=\"openTaskModal\"> + 新建任务 </button><div class=\"search-box\"><input type=\"text\" placeholder=\"搜索任务...\" on-input=\"onSearchChange\" value=\"{{ this.data.get('searchKeyword') }}\"><span class=\"search-icon\">🔍</span></div></div></div><div class=\"filter-tabs\"><button class=\"filter-tab {{ this.data.get('currentFilter') === filter.value ? 'active' : '' }}\" key=\"{{ filter.value }}\" on-click=\"setFilter(filter.value)\" s-for=\"filter in this.data.get('filters') trackby filter.value\">{{ filter.label }} <span class=\"count\">{{ getTaskCount(filter.value) }}</span></button></div><div class=\"task-list\" on-dragover=\"\" on-drop=\"onDropToEnd\"><task-item key=\"{{ task.id }}\" task=\"{{ task }}\" index=\"{{ index }}\" draggable=\"true\" on-toggle=\"toggleTaskStatus\" on-edit=\"editTask\" on-view=\"selectTask\" on-delete=\"deleteTask\" on-drag-start=\"onDragStart\" on-drag-end=\"onDragEnd\" on-drop-on=\"onDropOnTask\" s-for=\"(task, index) in this.data.get('filteredTasks') trackby task.id\"></task-item><div class=\"empty-state\" s-if=\"{{ this.data.get('filteredTasks').length === 0 }}\"><span class=\"empty-icon\">📭</span><p>暂无任务，创建一个吧！</p></div></div></div><div class=\"detail-panel\" s-if=\"{{ this.data.get('selectedTask') }}\"><task-detail task=\"{{ this.data.get('selectedTask') }}\" on-close=\"closeDetail\" on-update=\"updateTask\" on-comment=\"addComment\"></task-detail></div></div><div class=\"modal-overlay\" s-if=\"{{ this.data.get('isModalOpen') }}\" on-click=\"closeModal\"><div class=\"modal-content\"><div class=\"modal-header\"><h3>{{ this.data.get('editingTask') ? '编辑任务' : '新建任务' }}</h3><button class=\"close-btn\" on-click=\"closeModal\">✕</button></div><task-form key=\"{{ this.data.get('editingTask') ? this.data.get('editingTask').id : 'new-task' }}\" task=\"{{ this.data.get('editingTask') }}\" users=\"{{ this.data.get('users') }}\" tags=\"{{ this.data.get('availableTags') }}\" on-submit=\"handleTaskSubmit\" on-cancel=\"closeModal\"></task-form></div></div><div class=\"modal-overlay\" s-if=\"{{ this.data.get('showSettings') }}\" on-click=\"showSettings = false\"><div class=\"modal-content\"><div class=\"modal-header\"><h3>⚙️ 系统设置</h3><button class=\"close-btn\" on-click=\"showSettings = false\">✕</button></div><settings-panel settings=\"{{ this.data.get('settings') }}\" on-update=\"updateSettings\"></settings-panel></div></div><div class=\"notification {{ this.data.get('notification').type }}\" s-if=\"{{ this.data.get('notification').show }}\"><span>{{ this.data.get('notification').message }}</span><button on-click=\"hideNotification\">✕</button></div></div></template><script>const san=require(\"san\");const DataTypes=san.DataTypes;const StatCard=san.defineComponent({name:\"StatCard\",props:[\"label\",\"value\",\"icon\",\"trend\",\"color\"],template:`<div class=\"stat-card\" on-click=\"fire('click')\"><div class=\"stat-card-icon\" style=\"{{ 'background: ' + this.data.get('color') + ';' }}\">{{ this.data.get('icon') }}</div><div class=\"stat-card-content\"><div class=\"stat-card-label\">{{ this.data.get('label') }}</div><div class=\"stat-card-value\">{{ this.data.get('value') }}</div><div class=\"stat-card-trend {{ this.data.get('trend') >= 0 ? 'positive' : 'negative' }}\">{{ this.data.get('trend') >= 0 ? '↑' : '↓' }} {{ Math.abs(this.data.get('trend')) }}%</div></div></div>`,methods:{fire:function(e){this.fire(e)}}});const TaskItem=san.defineComponent({name:\"TaskItem\",props:[\"task\",\"index\",\"draggable\"],template:`<div class=\"task-item {{ this.data.get('task').completed ? 'completed' : '' }} {{ this.data.get('task').priority === 'high' ? 'urgent' : '' }}\" draggable=\"true\" on-drag-start=\"onDragStart\" on-drag-over.prevent=\"\" on-drop.stop=\"onDrop\" on-drag-end=\"onDragEnd\"><div class=\"task-checkbox\" on-click=\"fire('toggle', this.data.get('task').id)\"><span class=\"checkbox\">{{ this.data.get('task').completed ? '☑' : '☐' }}</span></div><div class=\"task-content\" on-click=\"fire('view', this.data.get('task'))\"><div class=\"task-title\">{{ this.data.get('task').title }}</div><div class=\"task-meta\"><span class=\"task-priority {{ this.data.get('task').priority }}\">{{ getPriorityLabel(this.data.get('task').priority) }}</span><span class=\"task-due-date\">📅 {{ formatDate(this.data.get('task').dueDate) }}</span></div><div class=\"task-tags\"><span s-for=\"tag in this.data.get('task').tags trackby tag\" class=\"task-tag\">{{ tag }}</span></div></div><div class=\"task-actions\"><button class=\"task-action-btn\" on-click.stop=\"fire('edit', this.data.get('task'))\">✏️</button><button class=\"task-action-btn\" on-click.stop=\"fire('delete', this.data.get('task').id)\">🗑️</button></div></div>`,methods:{getPriorityLabel:function(priority){const labels={high:\"高优先级\",medium:\"中优先级\",low:\"低优先级\"};return labels[priority]||priority},formatDate:function(date){if(!date)return\"无截止日期\";const d=new Date(date);return`${d.getMonth()+1}/${d.getDate()}`},onDragStart:function(e){if(!this.data.get('draggable'))return;e.dataTransfer.setData(\"text/plain\",this.data.get('index'));e.dataTransfer.effectAllowed=\"move\";this.fire(\"drag-start\",this.data.get('index'))},onDrop:function(){this.fire(\"drop-on\",this.data.get('index'))},onDragEnd:function(){this.fire(\"drag-end\")},fire:function(e,a){this.fire(e,a)}}});const TaskDetail=san.defineComponent({name:\"TaskDetail\",props:[\"task\"],template:`<div class=\"task-detail\"><div class=\"detail-header\"><h3>任务详情</h3><div class=\"detail-actions\"><button class=\"edit-detail\" on-click=\"fire('update', this.data.get('task'))\">编辑</button><button class=\"close-detail\" on-click=\"fire('close')\">✕</button></div></div><div class=\"detail-content\"><div class=\"detail-field\"><label>标题</label><div class=\"field-value\">{{ this.data.get('task').title }}</div></div><div class=\"detail-field\"><label>描述</label><div class=\"field-value\">{{ this.data.get('task').description || '无描述' }}</div></div><div class=\"detail-field\"><label>优先级</label><div class=\"field-value {{ this.data.get('task').priority }}\">{{ getPriorityLabel(this.data.get('task').priority) }}</div></div><div class=\"detail-field\"><label>截止日期</label><div class=\"field-value\">{{ formatDate(this.data.get('task').dueDate) }}</div></div><div class=\"detail-field\"><label>标签</label><div class=\"field-value\"><span s-for=\"tag in this.data.get('task').tags trackby tag\" class=\"detail-tag\">{{ tag }}</span></div></div><div class=\"detail-field\"><label>评论</label><div class=\"comments-section\"><div s-for=\"(comment, idx) in this.data.get('task').comments trackby idx\" class=\"comment-item\"><strong>{{ comment.user }}</strong>: {{ comment.text }}<small>{{ formatTime(comment.time) }}</small></div><div class=\"comment-input\"><input type=\"text\" placeholder=\"添加评论...\" on-keyup.enter=\"addComment\" value=\"{{ this.data.get('newComment') }}\"><button on-click=\"addComment\">发送</button></div></div></div></div></div>`,data:function(){return{newComment:\"\"}},methods:{getPriorityLabel:function(priority){const labels={high:\"高优先级\",medium:\"中优先级\",low:\"低优先级\"};return labels[priority]||priority},formatDate:function(date){if(!date)return\"无截止日期\";const d=new Date(date);return`${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`},formatTime:function(time){const d=new Date(time);return d.toLocaleTimeString()},addComment:function(){if(this.data.get('newComment').trim()){this.fire('comment',{taskId:this.data.get('task').id,text:this.data.get('newComment')});this.data.set('newComment',\"\")}},fire:function(e,a){this.fire(e,a)}}});const TaskForm=san.defineComponent({name:\"TaskForm\",props:[\"task\",\"users\",\"tags\"],template:`<form class=\"task-form\" on-submit.prevent=\"handleSubmit\"><div class=\"form-group\"><label>任务标题 *</label><input type=\"text\" required placeholder=\"输入任务标题\" value=\"{{ this.data.get('formData').title }}\"></div><div class=\"form-group\"><label>任务描述</label><textarea rows=\"3\" placeholder=\"详细描述...\">{{ this.data.get('formData').description }}</textarea></div><div class=\"form-row\"><div class=\"form-group\"><label>优先级</label><select value=\"{{ this.data.get('formData').priority }}\"><option value=\"low\">低优先级</option><option value=\"medium\">中优先级</option><option value=\"high\">高优先级</option></select></div><div class=\"form-group\"><label>截止日期</label><input type=\"date\" value=\"{{ this.data.get('formData').dueDate }}\"></div></div><div class=\"form-group\"><label>标签</label><div class=\"tag-selector\"><span s-for=\"tag in this.data.get('tags') trackby tag\" class=\"selectable-tag {{ this.data.get('formData').tags.includes(tag) ? 'selected' : '' }}\" on-click=\"toggleTag(tag)\">{{ tag }}</span></div></div><div class=\"form-group\"><label>负责人</label><select value=\"{{ this.data.get('formData').assignee }}\"><option value=\"\">未分配</option><option s-for=\"user in this.data.get('users') trackby user.id\" value=\"{{ user.name }}\">{{ user.name }}</option></select></div><div class=\"form-actions\"><button type=\"button\" class=\"cancel-btn\" on-click=\"fire('cancel')\">取消</button><button type=\"submit\" class=\"submit-btn\">{{ this.data.get('task') ? '更新' : '创建' }}</button></div></form>`,data:function(){return{formData:this.createFormData(this.data.get('task'))}},methods:{createFormData:function(task){return task?{...task,tags:[...(task.tags||[])]}:{title:\"\",description:\"\",priority:\"medium\",dueDate:\"\",tags:[],assignee:\"\"}},toggleTag:function(tag){if(this.data.get('formData').tags.includes(tag)){this.data.set('formData',{...this.data.get('formData'),tags:this.data.get('formData').tags.filter(t=>t!==tag)})}else{this.data.set('formData',{...this.data.get('formData'),tags:[...this.data.get('formData').tags,tag]})}},handleSubmit:function(){if(!this.data.get('formData').title.trim())return;this.fire('submit',this.data.get('formData'))},fire:function(e,a){this.fire(e,a)}}});const SettingsPanel=san.defineComponent({name:\"SettingsPanel\",props:[\"settings\"],template:`<div class=\"settings-panel\"><div class=\"setting-group\"><label>默认视图</label><select value=\"{{ this.data.get('settings').defaultView }}\" on-change=\"fire('update', 'defaultView', event.target.value)\"><option value=\"list\">列表视图</option><option value=\"board\">看板视图</option></select></div><div class=\"setting-group\"><label>自动保存</label><input type=\"checkbox\" checked=\"{{ this.data.get('settings').autoSave }}\" on-change=\"fire('update', 'autoSave', event.target.checked)\"></div><div class=\"setting-group\"><label>通知提醒</label><input type=\"checkbox\" checked=\"{{ this.data.get('settings').notifications }}\" on-change=\"fire('update', 'notifications', event.target.checked)\"></div><div class=\"setting-group\"><label>数据同步间隔</label><select value=\"{{ this.data.get('settings').syncInterval }}\" on-change=\"fire('update', 'syncInterval', event.target.value)\"><option value=\"0\">手动同步</option><option value=\"30\">30秒</option><option value=\"60\">1分钟</option><option value=\"300\">5分钟</option></select></div></div>`,methods:{fire:function(e,a,b){this.fire(e,a,b)}}});module.exports=san.defineComponent({name:\"TaskManager\",dataTypes:{isDarkMode:DataTypes.bool,isCompactMode:DataTypes.bool,showSettings:DataTypes.bool,isModalOpen:DataTypes.bool,tasks:DataTypes.array,selectedTask:DataTypes.any,editingTask:DataTypes.any,currentFilter:DataTypes.string,searchKeyword:DataTypes.string,dragStartIndex:DataTypes.any,users:DataTypes.array,availableTags:DataTypes.array,statistics:DataTypes.array,filters:DataTypes.array,settings:DataTypes.object,notification:DataTypes.object,syncTimer:DataTypes.any,storageKey:DataTypes.string},initData(){return{isDarkMode:false,isCompactMode:false,showSettings:false,isModalOpen:false,tasks:[],selectedTask:null,editingTask:null,currentFilter:\"all\",searchKeyword:\"\",dragStartIndex:null,users:[{id:1,name:\"张三\"},{id:2,name:\"李四\"},{id:3,name:\"王五\"}],availableTags:[\"工作\",\"个人\",\"紧急\",\"学习\",\"休闲\",\"会议\"],statistics:[{id:1,label:\"总任务\",value:0,icon:\"📊\",trend:12,color:\"#3b82f6\"},{id:2,label:\"已完成\",value:0,icon:\"✅\",trend:8,color:\"#10b981\"},{id:3,label:\"进行中\",value:0,icon:\"🔄\",trend:-3,color:\"#f59e0b\"},{id:4,label:\"逾期任务\",value:0,icon:\"⚠️\",trend:5,color:\"#ef4444\"}],filters:[{value:\"all\",label:\"全部\"},{value:\"active\",label:\"进行中\"},{value:\"completed\",label:\"已完成\"},{value:\"overdue\",label:\"已逾期\"},{value:\"urgent\",label:\"紧急\"}],settings:{defaultView:\"list\",autoSave:true,notifications:true,syncInterval:60},notification:{show:false,message:\"\",type:\"info\"},syncTimer:null,storageKey:\"task_manager_data\"}},components:{'stat-card':StatCard,'task-item':TaskItem,'task-detail':TaskDetail,'task-form':TaskForm,'settings-panel':SettingsPanel},attached(){this.loadInitialData();this.startAutoSync();this.showNotification(\"系统初始化完成\",\"success\")},disposed(){if(this.data.get('syncTimer')){clearInterval(this.data.get('syncTimer'))}this.saveToLocalStorage()},loadInitialData(){const saved=localStorage.getItem(this.data.get('storageKey'));if(saved){try{const data=JSON.parse(saved);this.data.set('tasks',data.tasks||this.getSampleTasks());this.data.set('settings',{...this.data.get('settings'),...data.settings})}catch(e){this.data.set('tasks',this.getSampleTasks())}}else{this.data.set('tasks',this.getSampleTasks())}this.updateStatistics()},getSampleTasks(){return[{id:1,title:\"完成项目报告\",description:\"编写Q4季度项目总结报告，包含数据分析和改进建议\",priority:\"high\",dueDate:new Date(Date.now()+2*86400000).toISOString().split(\"T\")[0],tags:[\"工作\",\"紧急\"],completed:false,comments:[],assignee:\"张三\"},{id:2,title:\"学习Vue高级特性\",description:\"深入学习Vue3组合式API和响应式原理\",priority:\"medium\",dueDate:new Date(Date.now()+5*86400000).toISOString().split(\"T\")[0],tags:[\"学习\"],completed:false,comments:[],assignee:\"李四\"},{id:3,title:\"团队会议\",description:\"周例会，讨论项目进展和下周计划\",priority:\"medium\",dueDate:new Date(Date.now()-1*86400000).toISOString().split(\"T\")[0],tags:[\"工作\",\"会议\"],completed:true,comments:[{user:\"张三\",text:\"会议纪要已更新\",time:Date.now()-86400000}],assignee:\"王五\"}]},updateStatistics(){const total=this.data.get('tasks').length;const completed=this.data.get('tasks').filter(t=>t.completed).length;const active=this.data.get('tasks').filter(t=>!t.completed&&!this.isOverdue(t)).length;const overdue=this.data.get('tasks').filter(t=>this.isOverdue(t)&&!t.completed).length;this.data.set('statistics',[{...this.data.get('statistics')[0],value:total},{...this.data.get('statistics')[1],value:completed},{...this.data.get('statistics')[2],value:active},{...this.data.get('statistics')[3],value:overdue}])},isOverdue(task){if(task.completed||!task.dueDate)return false;const dueDate=new Date(task.dueDate);const today=new Date();today.setHours(0,0,0,0);return dueDate<today},openTaskModal(){this.data.set('editingTask',null);this.data.set('isModalOpen',true)},editTask(task){this.data.set('editingTask',{...task});this.data.set('isModalOpen',true)},selectTask(task){this.data.set('selectedTask',task)},handleTaskSubmit(formData){if(this.data.get('editingTask')){const index=this.data.get('tasks').findIndex(t=>t.id===this.data.get('editingTask').id);if(index!==-1){this.data.set('tasks',[...this.data.get('tasks').slice(0,index),{...this.data.get('tasks')[index],...formData,updatedAt:Date.now()},...this.data.get('tasks').slice(index+1)])}this.showNotification(\"任务更新成功\",\"success\")}else{const newTask={...formData,id:Date.now(),completed:false,comments:[],createdAt:Date.now()};this.data.set('tasks',[newTask,...this.data.get('tasks')]);this.showNotification(\"任务创建成功\",\"success\")}this.closeModal()},toggleTaskStatus(taskId){const task=this.data.get('tasks').find(t=>t.id===taskId);if(task){task.completed=!task.completed;this.showNotification(task.completed?\"任务已完成\":\"任务已恢复\",\"info\")}},deleteTask(taskId){if(confirm(\"确定删除此任务吗？\")){this.data.set('tasks',this.data.get('tasks').filter(t=>t.id!==taskId));if(this.data.get('selectedTask')?.id===taskId){this.data.set('selectedTask',null)}this.showNotification(\"任务已删除\",\"warning\")}},updateTask(updatedData){this.editTask(updatedData)},addComment(commentData){const task=this.data.get('tasks').find(t=>t.id===commentData.taskId);if(task){task.comments=task.comments||[];task.comments.push({user:\"当前用户\",text:commentData.text,time:Date.now()});this.showNotification(\"评论已添加\",\"success\")}},closeDetail(){this.data.set('selectedTask',null)},onDragStart(index){this.data.set('dragStartIndex',index)},onDropOnTask(dropIndex){this.moveTask(this.data.get('dragStartIndex'),dropIndex)},onDropToEnd(){this.moveTask(this.data.get('dragStartIndex'),this.data.get('filteredTas